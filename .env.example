# =============================================================================
# SalesMetrics Environment Variables — copy to .env (never commit .env)
# =============================================================================
# .NET reads these as connection-string overrides at startup.
# Full connection strings are provided as environment variables so that no
# credentials ever appear in appsettings.json or source control.
#
# USAGE (Windows IIS / App Pool):
#   Set each variable in the system environment or in the app pool identity.
# USAGE (Docker / Linux):
#   Set in the container environment or in a .env file loaded by your runner.
#
# The ${...} placeholders in appsettings.json are replaced by the .NET
# configuration system when the matching environment variables are present.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=74.114.167.52
DB_USER=sfc
DB_PASSWORD=CHANGE_ME

# ── AES-256 Encryption Key (base64, 32 bytes) ─────────────────────────────────
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME

# ── Google OAuth (https://console.cloud.google.com/) ──────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ── SMTP (Gmail App Password recommended) ────────────────────────────────────
SMTP_USER=CHANGE_ME@domain.com
SMTP_PASS=CHANGE_ME
SMTP_FROM_EMAIL=CHANGE_ME@domain.com

# ── Allowed Hosts (production domain, comma-separated) ────────────────────────
# Override the AllowedHosts setting to match your deployment domain.
# Example: ASPNETCORE_AllowedHosts=salesmetrics.seamlessflooring.com
ASPNETCORE_AllowedHosts=salesmetrics.seamlessflooring.com

# ── Override full connection strings (alternative to per-credential vars) ──────
# You may also override entire connection strings:
# ConnectionStrings__SalesMetrics=Server=host,1433;Database=SalesMetrics;User Id=user;Password=pass;Encrypt=True;TrustServerCertificate=True;
# ConnectionStrings__SalesMetricsEF=Server=host,1433;Database=SalesMetrics;User Id=user;Password=pass;Encrypt=True;TrustServerCertificate=True;
# ConnectionStrings__LAX=Data Source=host;Initial Catalog=CompUFloorLA;User ID=user;Password=pass;Encrypt=True;TrustServerCertificate=True
# ConnectionStrings__LSV=Data Source=host;Initial Catalog=CompUFloorLV;User ID=user;Password=pass;Encrypt=True;TrustServerCertificate=True
# ConnectionStrings__CHN=Data Source=host;Initial Catalog=CompUFloorChino;User ID=user;Password=pass;Encrypt=True;TrustServerCertificate=True
# ConnectionStrings__PHX=Data Source=host;Initial Catalog=CompUFloorPHX;User ID=user;Password=pass;Encrypt=True;TrustServerCertificate=True
# ConnectionStrings__SND=Data Source=host;Initial Catalog=CompUFloorSD;User ID=user;Password=pass;Encrypt=True;TrustServerCertificate=True
