@model SalesMetrics.Models.BulkLocationAssignmentViewModel
@{
    ViewData["Title"] = "Bulk Location Assignment";
    int totalUsers    = Model.Users.Count;
    int assignedCount = Model.Users.Count(u => u.IsAssigned);
}

@section Styles {
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
<style>
    .filter-card  { background:#fff; border:1px solid #dee2e6; border-radius:8px; padding:20px 24px; margin-bottom:24px; }
    .results-card { background:#fff; border:1px solid #dee2e6; border-radius:8px; overflow:hidden; }
    .results-header { display:flex; align-items:center; justify-content:space-between; padding:14px 20px; background:#f8f9fa; border-bottom:1px solid #dee2e6; gap:12px; flex-wrap:wrap; }
    .results-title  { font-size:.95rem; font-weight:600; color:#2e6da4; margin:0; }
    .bulk-btn-group { display:flex; gap:8px; flex-wrap:wrap; }
    .table-bulk thead th { background:#f2f4f8; font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#6c757d; border-bottom:2px solid #dee2e6; white-space:nowrap; }
    .table-bulk tbody tr:hover { background:#f9fbff; }
    .access-badge { display:inline-block; padding:2px 10px; border-radius:12px; font-size:.75rem; font-weight:600; }
    .access-badge.on  { background:#d4edda; color:#155724; }
    .access-badge.off { background:#f8d7da; color:#721c24; }
    .stat-pill { background:#e8f0fb; color:#2e6da4; border-radius:12px; padding:3px 12px; font-size:.8rem; font-weight:600; }
    .empty-state { text-align:center; padding:60px 20px; color:#6c757d; }
    .empty-state i { font-size:2.5rem; margin-bottom:12px; color:#dee2e6; }
    #selectAllRow { background:#f0f4ff; }
    #bulkTable_wrapper .dataTables_filter input { font-size:.85rem; }
    #bulkTable_wrapper .dataTables_length select { font-size:.85rem; }
    #bulkTable_wrapper .dataTables_info { font-size:.8rem; color:#6c757d; }
    #bulkTable thead th.sorting,
    #bulkTable thead th.sorting_asc,
    #bulkTable thead th.sorting_desc { cursor:pointer; }
</style>
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex align-items-center gap-3">
                <div style="width:42px;height:42px;background:#e8f0fb;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-map-marker-alt" style="font-size:1.1rem;color:#3b6cc5;"></i>
                </div>
                <div>
                    <h1 class="h4 mb-0 fw-bold">Bulk Location Assignment</h1>
                    <p class="text-muted mb-0" style="font-size:.85rem;">
                        Select a location, filter by role or primary location, then assign or remove access for multiple users at once.
                    </p>
                </div>
                <div class="ms-auto">
                    <a href="/Settings/Hub" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Settings Hub
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Form -->
    <div class="filter-card">
        <form method="get" action="/Accounts/BulkLocationAssignment" id="filterForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold" style="font-size:.85rem;">
                        <i class="fas fa-map-marker-alt me-1 text-primary"></i> Location to Assign
                    </label>
                    <select name="locationId" id="locationSelect" class="form-select">
                        @foreach (var loc in Model.AllLocations)
                        {
                            @if (loc.Selected)
                            {
                                <option value="@loc.Value" selected="selected">@loc.Text</option>
                            }
                            else
                            {
                                <option value="@loc.Value">@loc.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold" style="font-size:.85rem;">
                        <i class="fas fa-user-tag me-1 text-secondary"></i> Filter by Role
                    </label>
                    <select name="roleId" class="form-select">
                        @foreach (var r in Model.AllRoles)
                        {
                            @if (r.Selected)
                            {
                                <option value="@r.Value" selected="selected">@r.Text</option>
                            }
                            else
                            {
                                <option value="@r.Value">@r.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold" style="font-size:.85rem;">
                        <i class="fas fa-building me-1 text-secondary"></i> Filter by Primary Location
                    </label>
                    <select name="primaryLocationId" class="form-select">
                        <option value="">— All Primary Locations —</option>
                        <option value="1" @(Model.FilterPrimaryLocationId == 1 ? "selected" : "")>LAX — Los Angeles</option>
                        <option value="2" @(Model.FilterPrimaryLocationId == 2 ? "selected" : "")>LSV — Las Vegas</option>
                        <option value="3" @(Model.FilterPrimaryLocationId == 3 ? "selected" : "")>CHN — Chino</option>
                        <option value="4" @(Model.FilterPrimaryLocationId == 4 ? "selected" : "")>PHX — Phoenix</option>
                        <option value="5" @(Model.FilterPrimaryLocationId == 5 ? "selected" : "")>SND — San Diego</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-users me-1"></i> Load Users
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Results -->
    @if (Model.SelectedLocationId > 0)
    {
        <form method="post" action="/Accounts/BulkUpdateLocationAssignment" id="bulkForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="locationId"         value="@Model.SelectedLocationId" />
            <input type="hidden" name="roleId"             value="@Model.FilterRoleId" />
            <input type="hidden" name="primaryLocationId"  value="@Model.FilterPrimaryLocationId" />

            @if (!Model.Users.Any())
            {
                <div class="results-card">
                    <div class="empty-state">
                        <i class="fas fa-users"></i>
                        <p class="mt-2 mb-0">No active users match the selected filters.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="results-card">
                    <div class="results-header">
                        <span class="results-title">
                            <i class="fas fa-map-marker-alt me-2 text-primary"></i>
                            @(Model.LocationName ?? $"Location {Model.SelectedLocationId}")
                        </span>
                        <span class="stat-pill" id="statPill">
                            <span id="statCount">@assignedCount</span> of @totalUsers users assigned
                        </span>
                        <div class="bulk-btn-group">
                            <button type="button" class="btn btn-sm btn-success" onclick="setAll(true)">
                                <i class="fas fa-check-double me-1"></i> Assign All
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="setAll(false)">
                                <i class="fas fa-times me-1"></i> Remove All
                            </button>
                            <button type="submit" class="btn btn-sm btn-primary" onclick="return confirmSave()">
                                <i class="fas fa-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table id="bulkTable" class="table table-bulk table-hover mb-0">
                            <thead>
                                <tr>
                                    <th style="width:46px;">
                                        <input type="checkbox" id="masterCb" onchange="toggleAll(this.checked)" title="Select all" />
                                    </th>
                                    <th>Name</th>
                                    <th>Role</th>
                                    <th>Primary Location</th>
                                    <th>Assignment Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users)
                                {
                                    <tr id="row-@user.Users_ID">
                                        <td>
                                            <input type="checkbox"
                                                   class="user-cb"
                                                   name="assignedUserIds"
                                                   value="@user.Users_ID"
                                                   @(user.IsAssigned ? "checked" : "")
                                                   onchange="updateRow(this)" />
                                        </td>
                                        <td class="fw-semibold">@user.FullName</td>
                                        <td>@user.RoleName</td>
                                        <td>@user.PrimaryLocation</td>
                                        <td>
                                            <span class="access-badge @(user.IsAssigned ? "on" : "off")"
                                                  id="badge-@user.Users_ID">
                                                @(user.IsAssigned ? "Assigned" : "Not Assigned")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </form>
    }
    else
    {
        <div class="results-card">
            <div class="empty-state">
                <i class="fas fa-map-marker-alt"></i>
                <p class="mt-2 mb-0 fw-semibold">Select a location above and click <em>Load Users</em> to begin.</p>
            </div>
        </div>
    }
</div>

@section Scripts {
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script>
$(function () {
    if ($('#bulkTable tbody tr').length > 0) {
        $('#bulkTable').DataTable({
            pageLength: 25,
            order: [[1, 'asc']],
            language: {
                search: "Search users:",
                lengthMenu: "Show _MENU_ users",
                info: "Showing _START_ to _END_ of _TOTAL_ users",
                paginate: { previous: "Prev", next: "Next" }
            },
            columnDefs: [{ orderable: false, targets: [0, 4] }]
        });
    }
    syncMaster();
});

function setAll(assign) {
    $('.user-cb').each(function () {
        this.checked = assign;
        updateRow(this);
    });
    syncMaster();
    updateCount();
}

function toggleAll(checked) {
    $('.user-cb').each(function () {
        this.checked = checked;
        updateRow(this);
    });
    updateCount();
}

function updateRow(cb) {
    const userId = cb.value;
    const badge  = document.getElementById('badge-' + userId);
    if (cb.checked) {
        badge.className = 'access-badge on';
        badge.textContent = 'Assigned';
    } else {
        badge.className = 'access-badge off';
        badge.textContent = 'Not Assigned';
    }
    syncMaster();
    updateCount();
}

function updateCount() {
    const total   = $('.user-cb').length;
    const checked = $('.user-cb:checked').length;
    $('#statCount').text(checked);
}

function syncMaster() {
    const total   = $('.user-cb').length;
    const checked = $('.user-cb:checked').length;
    const master  = document.getElementById('masterCb');
    if (master) {
        master.checked       = checked === total && total > 0;
        master.indeterminate = checked > 0 && checked < total;
    }
}

function confirmSave() {
    const assigned = $('.user-cb:checked').length;
    const total    = $('.user-cb').length;
    return confirm(
        `Save changes?\n\n${assigned} of ${total} users will have this location assigned.\n\nUsers in the current filter who are NOT checked will have this location removed.`
    );
}
</script>
}
