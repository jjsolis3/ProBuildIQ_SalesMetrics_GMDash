@model SalesMetrics.Models.BulkPermissionViewModel
@{
    ViewData["Title"] = "Bulk Permission Manager";
    int totalUsers   = Model.Users.Count;
    int grantedCount = Model.Users.Count(u => u.HasAccess);
}

@section Styles {
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
<style>
    .filter-card  { background:#fff; border:1px solid #dee2e6; border-radius:8px; padding:20px 24px; margin-bottom:24px; }
    .results-card { background:#fff; border:1px solid #dee2e6; border-radius:8px; overflow:hidden; }
    .results-header { display:flex; align-items:center; justify-content:space-between; padding:14px 20px; background:#f8f9fa; border-bottom:1px solid #dee2e6; gap:12px; flex-wrap:wrap; }
    .results-title  { font-size:.95rem; font-weight:600; color:#2e6da4; margin:0; }
    .bulk-btn-group { display:flex; gap:8px; flex-wrap:wrap; }
    .table-bulk thead th { background:#f2f4f8; font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#6c757d; border-bottom:2px solid #dee2e6; white-space:nowrap; }
    .table-bulk tbody tr:hover { background:#f9fbff; }
    .access-badge { display:inline-block; padding:2px 10px; border-radius:12px; font-size:.75rem; font-weight:600; }
    .access-badge.on  { background:#d4edda; color:#155724; }
    .access-badge.off { background:#f8d7da; color:#721c24; }
    .stat-pill { background:#e8f0fb; color:#2e6da4; border-radius:12px; padding:3px 12px; font-size:.8rem; font-weight:600; }
    .empty-state { text-align:center; padding:60px 20px; color:#6c757d; }
    .empty-state i { font-size:2.5rem; margin-bottom:12px; color:#dee2e6; }
    /* select-all row */
    #selectAllRow { background:#f0f4ff; }
    /* DataTables integration */
    #bulkTable_wrapper .dataTables_filter input { font-size:.85rem; }
    #bulkTable_wrapper .dataTables_length select { font-size:.85rem; }
    #bulkTable_wrapper .dataTables_info { font-size:.8rem; color:#6c757d; }
    #bulkTable thead th.sorting, #bulkTable thead th.sorting_asc, #bulkTable thead th.sorting_desc { cursor:pointer; }
</style>
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="d-flex align-items-center gap-3">
                <div style="width:42px;height:42px;background:#e8f0fb;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-layer-group" style="font-size:1.1rem;color:#3b6cc5;"></i>
                </div>
                <div>
                    <h1 class="h4 mb-0 fw-bold">Bulk Permission Manager</h1>
                    <p class="text-muted mb-0" style="font-size:.85rem;">
                        Select a feature, filter by role or location, then grant or revoke access for multiple users at once.
                    </p>
                </div>
                <div class="ms-auto">
                    <a href="/Settings/Hub" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Settings Hub
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Form -->
    <div class="filter-card">
        <form method="get" action="/Accounts/BulkPermissions" id="filterForm">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold" style="font-size:.85rem;">
                        <i class="fas fa-puzzle-piece me-1 text-primary"></i> Feature
                    </label>
                    <select name="featureId" id="featureSelect" class="form-select">
                        @foreach (var f in Model.AllFeatures)
                        {
                            @if (f.Selected)
                            {
                                <option value="@f.Value" selected="selected">@f.Text</option>
                            }
                            else
                            {
                                <option value="@f.Value">@f.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold" style="font-size:.85rem;">
                        <i class="fas fa-user-tag me-1 text-secondary"></i> Role
                    </label>
                    <select name="roleId" class="form-select">
                        @foreach (var r in Model.AllRoles)
                        {
                            @if (r.Selected)
                            {
                                <option value="@r.Value" selected="selected">@r.Text</option>
                            }
                            else
                            {
                                <option value="@r.Value">@r.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold" style="font-size:.85rem;">
                        <i class="fas fa-map-marker-alt me-1 text-secondary"></i> Location
                    </label>
                    <select name="locationId" class="form-select">
                        @{ var locId = Model.SelectedLocationId; }
                        @if (locId == null) { <option value="" selected="selected">— All Locations —</option> } else { <option value="">— All Locations —</option> }
                        @if (locId == 1) { <option value="1" selected="selected">LAX – Los Angeles</option> } else { <option value="1">LAX – Los Angeles</option> }
                        @if (locId == 2) { <option value="2" selected="selected">LSV – Las Vegas</option> } else { <option value="2">LSV – Las Vegas</option> }
                        @if (locId == 3) { <option value="3" selected="selected">CHN – Chino</option> } else { <option value="3">CHN – Chino</option> }
                        @if (locId == 4) { <option value="4" selected="selected">PHX – Phoenix</option> } else { <option value="4">PHX – Phoenix</option> }
                        @if (locId == 5) { <option value="5" selected="selected">SND – San Diego</option> } else { <option value="5">SND – San Diego</option> }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i> Load Users
                    </button>
                </div>
            </div>
        </form>
    </div>

    @if (Model.SelectedFeatureId > 0)
    {
        <!-- Results + Save Form -->
        <form method="post" action="/Accounts/BulkUpdatePermissions" id="bulkForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="featureId"   value="@Model.SelectedFeatureId" />
            <input type="hidden" name="roleId"      value="@Model.SelectedRoleId" />
            <input type="hidden" name="locationId"  value="@Model.SelectedLocationId" />

            <div class="results-card">
                <div class="results-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="results-title">
                            <i class="fas fa-list-check me-1"></i>
                            @Model.FeatureName — User Access
                        </span>
                        <span class="stat-pill">@grantedCount / @totalUsers granted</span>
                    </div>
                    <div class="bulk-btn-group">
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="setAll(true)">
                            <i class="fas fa-check-double me-1"></i> Grant All
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="setAll(false)">
                            <i class="fas fa-times me-1"></i> Revoke All
                        </button>
                        <button type="submit" class="btn btn-sm btn-primary" id="saveBtn">
                            <i class="fas fa-save me-1"></i> Save Changes
                        </button>
                    </div>
                </div>

                @if (Model.Users.Any())
                {
                    <div class="table-responsive">
                        <table id="bulkTable" class="table table-bulk table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th style="width:46px; padding:10px 16px;">
                                        <input type="checkbox" id="masterCheck" class="form-check-input"
                                               title="Toggle all" onchange="toggleAll(this.checked)" />
                                    </th>
                                    <th>Name</th>
                                    <th>Role</th>
                                    <th>Location</th>
                                    <th style="width:110px; text-align:center;">Access</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users)
                                {
                                    <tr class="user-row @(user.HasAccess ? "table-success bg-opacity-25" : "")">
                                        <td style="padding:10px 16px;">
                                            <input type="checkbox"
                                                   name="grantedUserIds"
                                                   value="@user.Users_ID"
                                                   class="form-check-input user-check"
                                                   @(user.HasAccess ? "checked" : "")
                                                   onchange="onCheckChange(this)" />
                                        </td>
                                        <td>
                                            <div class="fw-semibold" style="font-size:.9rem;">@user.FullName</div>
                                            <div style="font-size:.75rem; color:#6c757d;">ID: @user.Users_ID</div>
                                        </td>
                                        <td style="font-size:.875rem;">@user.RoleName</td>
                                        <td style="font-size:.875rem;">@user.Location</td>
                                        <td style="text-align:center;">
                                            <span class="access-badge @(user.HasAccess ? "on" : "off") row-badge">
                                                @(user.HasAccess ? "Granted" : "Revoked")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top bg-light" style="font-size:.8rem; color:#6c757d;">
                        <span id="selectionCount">@grantedCount of @totalUsers users will have access</span>
                        <button type="submit" class="btn btn-sm btn-primary">
                            <i class="fas fa-save me-1"></i> Save Changes
                        </button>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-users d-block"></i>
                        <p class="mb-0">No active users match the selected filters.</p>
                    </div>
                }
            </div>
        </form>
    }
    else
    {
        <div class="results-card">
            <div class="empty-state">
                <i class="fas fa-puzzle-piece d-block"></i>
                <p class="mb-1 fw-semibold">Select a feature above to get started</p>
                <p class="mb-0" style="font-size:.85rem;">Choose a feature from the dropdown, optionally filter by role or location, then click <strong>Load Users</strong>.</p>
            </div>
        </div>
    }

</div>

@section Scripts {
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script>
    // ── DataTables init ──────────────────────────────────────────────────────
    var bulkTable;
    $(document).ready(function () {
        var tableEl = document.getElementById('bulkTable');
        if (tableEl) {
            bulkTable = $('#bulkTable').DataTable({
                pageLength: 25,
                order: [[1, 'asc']],       // default: sort by Name ascending
                columnDefs: [
                    { orderable: false, targets: 0 }   // checkbox column – not sortable
                ],
                language: {
                    search: 'Search users:',
                    lengthMenu: 'Show _MENU_ users',
                    info: 'Showing _START_ to _END_ of _TOTAL_ users',
                    infoFiltered: '(filtered from _MAX_ total)'
                }
            });
        }
    });

    // ── Bulk helpers ─────────────────────────────────────────────────────────
    function setAll(grant) {
        document.querySelectorAll('.user-check').forEach(cb => {
            cb.checked = grant;
            updateRow(cb);
        });
        updateCount();
        syncMaster();
    }

    function toggleAll(checked) {
        setAll(checked);
    }

    function onCheckChange(cb) {
        updateRow(cb);
        updateCount();
        syncMaster();
    }

    function updateRow(cb) {
        const row   = cb.closest('tr');
        const badge = row.querySelector('.row-badge');
        if (cb.checked) {
            row.classList.add('table-success', 'bg-opacity-25');
            badge.textContent = 'Granted';
            badge.className = 'access-badge on row-badge';
        } else {
            row.classList.remove('table-success', 'bg-opacity-25');
            badge.textContent = 'Revoked';
            badge.className = 'access-badge off row-badge';
        }
    }

    function updateCount() {
        const total   = document.querySelectorAll('.user-check').length;
        const granted = document.querySelectorAll('.user-check:checked').length;
        const el = document.getElementById('selectionCount');
        if (el) el.textContent = `${granted} of ${total} users will have access`;
    }

    function syncMaster() {
        const all     = document.querySelectorAll('.user-check');
        const checked = document.querySelectorAll('.user-check:checked');
        const master  = document.getElementById('masterCheck');
        if (!master) return;
        master.indeterminate = checked.length > 0 && checked.length < all.length;
        master.checked = checked.length === all.length && all.length > 0;
    }

    // Confirm before saving
    document.getElementById('bulkForm')?.addEventListener('submit', function (e) {
        const granted = document.querySelectorAll('.user-check:checked').length;
        const total   = document.querySelectorAll('.user-check').length;
        const feature = '@Html.Raw(Model.FeatureName ?? "this feature")';
        if (!confirm(`Save changes?\n\n${granted} of ${total} users will have access to "${feature}".`)) {
            e.preventDefault();
        }
    });
</script>
}
