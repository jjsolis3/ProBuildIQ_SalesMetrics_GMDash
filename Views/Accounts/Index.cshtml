@model List<SalesMetrics.Models.UserWithAssignmentsViewModel>

@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="mb-3 text-end">
    <button class="btn btn-success open-create-user">
        ➕ Add New User
    </button>
</div>

<h4 class="mt-4 mb-4">Users Management</h4>

<div style="overflow-x: auto;">
    <table id="usersTable" class="table table-striped table-bordered w-100">
        <thead class="sticky-top bg-light">
            <tr>
                <th>User ID</th>
                <th>First</th>
                <th>Last</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Sales ID</th>
                <th>Location</th>
                <th>Assigned Locations</th>
                <th>Active</th>
                <th>Last Login</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Users_ID</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td><span class="badge bg-info">@user.RoleName</span></td>
                    <td>@user.SalesmanId</td>
                    <td><span class="badge bg-secondary">@user.LocationName</span></td>
                    <td>
                        @if (user.AssignedLocations.Any())
                        {
                            @foreach (var loc in user.AssignedLocations)
                            {
                                <span class="badge bg-primary me-1">@loc</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No</span>
                        }
                    </td>
                    <td>@(user.LastLoginDate?.ToString("g") ?? "-")</td>
                    <td>
                        <button class="btn btn-sm btn-primary open-edit-user" data-id="@user.Users_ID">Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div>
    <form asp-controller="Accounts" asp-action="RehashAllUserPasswords" method="post" onsubmit="return confirm('Are you sure you want to rehash all user passwords?');">
        <button type="submit" class="btn btn-danger mb-3">
            🔐 Rehash All Passwords
        </button>
    </form>
</div>

@if (ViewBag.FlaggedUsers != null)
{
    <h4 class="mt-5">⚠️ Users With Potential Login Issues</h4>
    <div style="overflow-x: auto;">
        <table id="flaggedUsersTable" class="table table-bordered table-warning table-striped w-100">
            <thead class="sticky-top">
                <tr>
                    <th>User ID</th>
                    <th>First</th>
                    <th>Last</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Location</th>
                    <th>Issue</th>
                    <th>Fix</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in ViewBag.FlaggedUsers as List<SalesMetrics.Models.FlaggedUserViewModel>)
            {
                <tr>
                    <td>@user.Users_ID</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@user.LocationName()</td>
                    <td><strong>@user.Reason</strong></td>
                    <td>
                        <form method="post" asp-controller="Accounts" asp-action="FixUserPassword" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.Users_ID" />
                            <input type="hidden" name="locationId" value="@user.LocationId" />
                            <button type="submit" class="btn btn-sm btn-warning">Fix</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<!-- Edit Modal Template (can be populated via JS later) -->
<!-- Placeholder for dynamically loaded modal -->
<div id="modalContainer"></div>


@section Scripts {
    <link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            $('#usersTable').DataTable({
                scrollY: "500px",
                scrollCollapse: true,
                paging: true,
                pageLength: 10,
                fixedHeader: true
            });

            // Show SweetAlert messages from TempData
            @if (TempData["Success"] != null)
            {
                <text>
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: '@TempData["Success"]'
                        });
                </text>
            }
            @if (TempData["Error"] != null)
            {
                <text>
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: '@TempData["Error"]'
                        });
                </text>
            }
        });

        // OPEN CREATE USER MODAL
        $(document).on('click', '.open-create-user', function () {
            $.get('/Accounts/GetCreateUserModal', function (html) {
                $('#modalContainer').html(html);
                const modalEl = document.getElementById('createUserModal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            });
        });

        // OPEN EDIT USER MODAL
        $(document).on('click', '.open-edit-user', function () {
            var userId = $(this).data('id');

            $.get('/Accounts/GetEditUserModal', { id: userId }, function (html) {
                // Inject modal into placeholder
                $('#modalContainer').html(html);

                // Wait for DOM insertion to complete before calling Bootstrap Modal
                setTimeout(function () {
                    var modalEl = document.getElementById('editUserModal');
                    if (modalEl) {
                        var modal = new bootstrap.Modal(modalEl);
                        modal.show();
                    }
                }, 100); // Small delay ensures modal HTML is rendered
            });
        });

    </script>
    <script>
        $('#flaggedUsersTable').DataTable({
            scrollY: "500px",
            scrollCollapse: true,
            paging: true,
            pageLength: 10,
            fixedHeader: true
        });

    </script>


}
