@model List<SalesMetrics.Models.EFCore.UserEntity>

@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h4 class="mt-4 mb-4">Users Management</h4>

<div style="overflow-x: auto;">
    <table id="usersTable" class="table table-striped table-bordered w-100">
        <thead class="sticky-top bg-light">
            <tr>
                <th>User ID</th>
                <th>First</th>
                <th>Last</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Location</th>
                <th>Active</th>
                <th>Last Login</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Users_ID</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@user.RoleId</td>
                    <td>@user.Location</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No</span>
                        }
                    </td>
                    <td>@(user.LastLoginDate?.ToString("g") ?? "-")</td>
                    <td>
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editUserModal" data-id="@user.Users_ID">Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div>
    <form asp-controller="Accounts" asp-action="RehashAllUserPasswords" method="post" onsubmit="return confirm('Are you sure you want to rehash all user passwords?');">
        <button type="submit" class="btn btn-danger mb-3">
            🔐 Rehash All Passwords
        </button>
    </form>
</div>

<!-- Edit Modal Template (can be populated via JS later) -->
@await Html.PartialAsync("_EditUserModal", new SalesMetrics.Models.RegisterViewModel())

@section Scripts {
    <link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#usersTable').DataTable({
                scrollY: "500px",
                scrollCollapse: true,
                paging: true,
                pageLength: 10,
                fixedHeader: true
            });

            // Prepare modal open event
            $('#editUserModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var userId = button.data('id');
                var modal = $(this);

                modal.find('.modal-body').html('<p>Loading user data for ID ' + userId + '...</p>');
                // TODO: Replace with AJAX call to load user details
            });
        });
    </script>
}
