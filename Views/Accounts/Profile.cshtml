
@{
    ViewBag.Title = "Users Access";
    ViewBag.PTitle = "Users";
    ViewBag.PLink = "/Accounts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* @model SalesMetrics.Models.UserProfileViewModel *@
@model SalesMetrics.Models.SalesRepProfilePageViewModel

<div class="row">
    <div class="col-xl-4">
        <div class="card overflow-hidden">
            <div class="bg-orange-subtle">
                <div class="row align-items-center">
                    <div class="col-6">
                        <div class="text-primary p-3 mb-3">
                            <h5 class="text-orange mb-4">Welcome @Model.UserProfile.FirstName!</h5>
                            <p class="mb-3 mt-3"> </p>
                            <div class="align-self-end">
                            <form method="post" action="/auth/logout" asp-antiforgery="true" class="d-inline">
                                <button type="submit" class="btn btn-label-danger w-75">
                                    <i class="mdi mdi-logout me-1"></i> Sign out
                                </button>
                            </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 d-flex justify-content-end pe-4">
                        <div class="avatar avatar-xl avatar-circle border-2 border-primary bg-light p-1 mt-4 mb-4">
                            <img src="~/assets/images/users/@($"{Model.UserProfile.FirstName}{Model.UserProfile.LastName}.jpg")"
                                 onerror="this.onerror=null;this.src='~/assets/images/users/GenericPhoto.png';"
                                 alt="@Model.UserProfile.FullName"
                                 class="img-fluid rounded-circle" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body pt-0">
                <div class="row align-items-end">
                    <div class="col-sm-4">
                        @* <div class="avatar-lg mb-3 mt-3">
                            <img src="~/assets/images/users/@($"{Model.FirstName}{Model.LastName}.jpg")" onerror="this.onerror=null;this.src='~/assets/images/users/GenericPhoto.png';" alt="" class="img-fluid avatar-circle bg-light p-2 border-2 border-primary">
                        </div> *@
                        <h5 class="fs-16 mt-4 mb-1 text-truncate">@Model.UserProfile.FullName</h5>
                        <p class="text-muted mb-0 text-truncate">Seamless Rep.</p>
                    </div>

                    <div class="col-sm-8">
                        <div class="row ms-3">
                            <div class="col-6">
                                <h5 class="fs-15 mb-1"></h5>
                                <p class="text-muted mb-0">Projects</p>
                            </div>
                            <div class="col-6">
                                <h5 class="fs-15 mb-1">$</h5>
                                <p class="text-muted mb-0">Revenue</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body border-top">
                <h4 class="card-title mb-4">About</h4>
                <p class="text-muted mb-4"></p>
                <div class="table-responsive">
                    <table class="table table-nowrap table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th scope="row"><i class="mdi mdi-account align-middle text-primary me-2"></i> Full Name :</th>
                                <td>@Model.UserProfile.FullName</td>
                            </tr>
                            <tr>
                                <th scope="row"><i class="mdi mdi-email text-primary me-2"></i> E-mail :</th>
                                <td>@Model.UserProfile.Email</td>
                            </tr>
                            <tr>
                                <th scope="row"><i class="mdi mdi-google text-danger me-2"></i> Google :</th>
                                <td>
                                    @if (string.IsNullOrEmpty(Model.UserProfile.GoogleEmail)
                                    || string.IsNullOrEmpty(Model.UserProfile.GoogleAccessToken)
                                    || string.IsNullOrEmpty(Model.UserProfile.GoogleRefreshToken))
                                    {
                                        <a href="/auth/connect-google" class="btn btn-danger btn-sm">
                                            <i class="mdi mdi-google me-1"></i> Connect to Google Calendar
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge bg-success fs-6 py-1 px-2">
                                                <i class="mdi mdi-check-circle me-1"></i>Connected as @Model.UserProfile.GoogleEmail
                                            </span>
                                            <form method="post" action="/auth/disconnect-google" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('Disconnect your Google account? You can reconnect at any time.')">
                                                    <i class="mdi mdi-link-off me-1"></i> Disconnect
                                                </button>
                                            </form>
                                            <a href="/auth/connect-google" class="btn btn-outline-secondary btn-sm">
                                                <i class="mdi mdi-refresh me-1"></i> Reconnect
                                            </a>
                                        </div>
                                    }
                                </td>
                            </tr>
                            @* @if (!string.IsNullOrEmpty(Model.GoogleEmail))
                            {
                                <tr>
                                    <th>Task Test</th>
                                    <td>
                                        <div>
                                            <form asp-action="TestGoogleTask" asp-controller="Accounts" method="get">
                                                <button type="submit" class="btn btn-primary">
                                                    Test Google Task
                                                </button>
                                            </form>
                                        </div>
                                        <div>
                                            <a href="/auth/connect-google" class="btn btn-outline-danger btn-sm">
                                                <i class="mdi mdi-refresh"></i> Reconnect Google
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            } *@
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-body border-top">
                <h4 class="card-title mb-4"></h4>
                <div class="">
                    <ul class="verti-timeline list-unstyled">
                        
                        <li class="active mb-3">
                            <div class="d-flex">
                                <div class="flex-shrink-0 me-3">
                                    <i class="mdi mdi-server h4 text-primary"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div>
                                        <h5 class="fs-15 mb-1"><a href="javascript: void(0);" class="text-body"></a></h5>
                                        <span class="text-muted"></span>
                                    </div>
                                </div>
                            </div>
                        </li>
                        
                    </ul>
                </div>

            </div>
        </div>
        <!-- end card -->


    </div>

    <div class="col-xl-8">

        @* ── Date-range filter (sales reps only) ── *@
        @if (Model.UserProfile.RoleId == 2)
        {
            <div class="card mb-3">
                <div class="card-body py-2">
                    <form method="get" asp-controller="Accounts" asp-action="Profile" class="row align-items-end g-2">
                        <div class="col-md-5">
                            @await Html.PartialAsync("_DateRangePicker", (Model.StartDate, Model.EndDate))
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Filter</button>
                        </div>
                    </form>
                </div>
            </div>

            @* ── Monthly Performance Summary ── *@
            <div class="card mb-4">
                <div class="card-header bg-orange">
                    <h4 class="card-title text-white mb-0">Activity</h4>
                </div>
                <div class="card-body">
                    @if (Model.Metrics?.PerformanceKPI?.MonthlyPerformance != null
                        && Model.Metrics.PerformanceKPI.MonthlyPerformance.Any())
                    {
                        <h5 class="mb-1">
                            Monthly Performance Summary
                        </h5>
                        <p class="text-muted mb-3" style="font-size:.83rem;">
                            @Model.StartDate.ToShortDateString() – @Model.EndDate.ToShortDateString()
                        </p>
                        <div class="table-responsive">
                            <table class="table table-bordered text-center mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Month</th>
                                        <th>Invoices</th>
                                        <th>Actual</th>
                                        <th>Expected (Avg)</th>
                                        <th>Δ Diff</th>
                                        <th>Month Goal (x1.1)</th>
                                        <th>% to Goal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var month in Model.Metrics.PerformanceKPI.MonthlyPerformance)
                                    {
                                        <tr class="@(month.PercentToGoal < 75 ? "table-danger" : "")">
                                            <td>@month.MonthLabel</td>
                                            <td>@month.InvoiceCount</td>
                                            <td class="fw-bold">$@month.Actual.ToString("N0")</td>
                                            <td>$@month.Average.ToString("N0")</td>
                                            <td class="@(month.Difference > 0 ? "text-success fw-bold" : month.Difference < 0 ? "text-danger fw-bold" : "")">
                                                @month.Difference.ToString("+#,##0;-#,##0")
                                            </td>
                                            <td>$@month.Goal.ToString("N0")</td>
                                            <td>@month.PercentToGoal.ToString("F1")%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No sales trend data available for the selected date range.</p>
                    }
                </div>
            </div>

            @* ── New Account Metrics ── *@
            <div class="card mb-2">
                <div class="card-header bg-orange">
                    <h5 class="card-title text-white mb-0">New Account Metrics</h5>
                </div>
            </div>
            <div class="row text-center mb-3">
                <div class="col-md-2">
                    <div class="card card-animate">
                        <div class="card-body">
                            <p class="text-muted mb-1">New Accounts</p>
                            <h4 class="mb-0">@Model.Metrics.NewAccounts</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card card-animate">
                        <div class="card-body">
                            <p class="text-muted mb-1">Total Orders</p>
                            <h4 class="mb-0">@Model.Metrics.OrdersCount</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card card-animate">
                        <div class="card-body">
                            <p class="text-muted mb-1">Total Invoices</p>
                            <h4 class="mb-0">@Model.Metrics.InvoicesCount</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card card-animate">
                        <div class="card-body">
                            <p class="text-muted mb-1">Total Un-Invoiced Amount</p>
                            <h4 class="mb-0 text-danger fw-bold">$@Model.Metrics.TotalSalesAmount.ToString("N0")</h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card card-animate">
                        <div class="card-body">
                            <p class="text-muted mb-1">Total Invoiced Amount</p>
                            <h4 class="mb-0 text-success fw-bold">$@Model.Metrics.TotalInvoiceAmount.ToString("N0")</h4>
                        </div>
                    </div>
                </div>
            </div>

            @* ── New Account Property Details ── *@
            <div class="card mb-4">
                <div class="card-header bg-orange text-white">
                    <h5 class="card-title mb-0">New Account Property Details</h5>
                </div>
                <div class="card-body">
                    <table id="propertyDetailsTable" class="table table-striped table-bordered dt-responsive w-100">
                        <thead>
                            <tr>
                                <th>Property</th>
                                <th>Mgmt Co</th>
                                <th>Established</th>
                                <th>Orders</th>
                                <th>Not Invoiced $</th>
                                <th>Invoices</th>
                                <th>Invoiced $</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Metrics.PropertyDetails)
                            {
                                <tr>
                                    <td>@item.Property</td>
                                    <td>@item.ManagementCompany</td>
                                    <td>@item.EstablishedDate.ToShortDateString()</td>
                                    <td>@item.Orders</td>
                                    <td>@item.TotalSalesAmount.ToString("C2")</td>
                                    <td>@item.Invoices</td>
                                    <td>@item.TotalInvoiceAmount.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* ── Lost & Returning Customers ── *@
            @if (Model.Metrics?.LostAndReturningCustomers != null
                && Model.Metrics.LostAndReturningCustomers.TotalReturningCustomers > 0)
            {
                <div class="card mb-2" style="border-left:4px solid #ffc107;">
                    <div class="card-header bg-warning">
                        <h5 class="card-title text-dark mb-0">
                            <i class="fas fa-user-clock me-2"></i>Lost &amp; Returning Customers Analysis
                        </h5>
                    </div>
                </div>

                <div class="row text-center mb-3">
                    <div class="col-md-2">
                        <div class="card card-animate border-warning">
                            <div class="card-body">
                                <p class="text-muted mb-1 small">Returning Customers</p>
                                <h4 class="mb-0 text-warning fw-bold">@Model.Metrics.LostAndReturningCustomers.TotalReturningCustomers</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card card-animate border-danger">
                            <div class="card-body">
                                <p class="text-muted mb-1 small">Salesperson Changed</p>
                                <h4 class="mb-0 text-danger fw-bold">@Model.Metrics.LostAndReturningCustomers.CustomersWithSalespersonChange</h4>
                                <small class="text-muted">(@Model.Metrics.LostAndReturningCustomers.PercentageWithSalespersonChange.ToString("F1")%)</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card card-animate border-success">
                            <div class="card-body">
                                <p class="text-muted mb-1 small">Same Salesperson</p>
                                <h4 class="mb-0 text-success fw-bold">@Model.Metrics.LostAndReturningCustomers.CustomersWithSameSalesperson</h4>
                                <small class="text-muted">(@((100 - Model.Metrics.LostAndReturningCustomers.PercentageWithSalespersonChange).ToString("F1"))%)</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card card-animate border-info">
                            <div class="card-body">
                                <p class="text-muted mb-1 small">Revenue Recovered</p>
                                <h4 class="mb-0 text-info fw-bold">$@Model.Metrics.LostAndReturningCustomers.TotalRevenueRecovered.ToString("N0")</h4>
                                <small class="text-muted">Avg: $@Model.Metrics.LostAndReturningCustomers.AverageReturningOrderValue.ToString("N0")</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card card-animate border-secondary">
                            <div class="card-body">
                                <p class="text-muted mb-1 small">Average Gap</p>
                                <h4 class="mb-0 text-secondary fw-bold">@Model.Metrics.LostAndReturningCustomers.AverageGapInMonths.ToString("F1")</h4>
                                <small class="text-muted">months inactive</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header bg-warning">
                        <h5 class="card-title text-dark mb-0">Customer Details - Lost &amp; Returned</h5>
                    </div>
                    <div class="card-body">
                        <table id="lostReturningTable" class="table table-hover table-striped table-bordered dt-responsive w-100">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Management Co</th>
                                    <th>Last Order Before Gap</th>
                                    <th>Previous Rep</th>
                                    <th>Gap (Months)</th>
                                    <th>Returned Date</th>
                                    <th>Current Rep</th>
                                    <th>Rep Changed?</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Metrics.LostAndReturningCustomers.CustomerDetails)
                                {
                                    <tr class="@(c.SalespersonChanged ? "table-warning" : "table-light")">
                                        <td>@c.CustomerName</td>
                                        <td>@c.ManagementCompany</td>
                                        <td>
                                            @c.LastOrderBeforeGap.ToShortDateString()
                                            <br /><small class="text-muted">$@c.LastOrderAmount.ToString("N0")</small>
                                        </td>
                                        <td>@c.PreviousSalesperson</td>
                                        <td>
                                            <span class="badge bg-@(c.MonthsInactive > 24 ? "danger" : c.MonthsInactive > 18 ? "warning" : "secondary")">
                                                @c.MonthsInactive
                                            </span>
                                        </td>
                                        <td>
                                            @c.FirstOrderAfterReturn.ToShortDateString()
                                            <br /><small class="text-muted">$@c.ReturningOrderAmount.ToString("N0")</small>
                                        </td>
                                        <td>@c.ReturningSalesperson</td>
                                        <td>
                                            @if (c.SalespersonChanged)
                                            {
                                                <span class="badge bg-danger"><i class="fas fa-exchange-alt"></i> Changed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success"><i class="fas fa-check"></i> Same</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else
        {
            @* ── Non-sales-rep: show a simple account info card ── *@
            <div class="card">
                <div class="card-header bg-orange">
                    <h4 class="card-title text-white mb-0">Account Overview</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Sales performance metrics are available for Sales Representatives.
                        Use the navigation menu to access dashboards and reports for your role.
                    </p>
                </div>
            </div>
        }

    </div>
</div>
@section scripts{

    <!-- apexcharts -->
    <script src="~/assets/libs/apexcharts/apexcharts.min.js"></script>
    <!-- Required datatable js -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>

    <!-- Responsive examples -->
    <script src="~/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/libs/datatables.net-responsive-bs5/js/responsive.bootstrap5.min.js"></script>

    <!-- contact init js -->
    <script src="~/assets/js/pages/profile.init.js"></script>

    <!-- Datatable init js -->
    <script src="~/assets/js/pages/datatables-base.init.js"></script>

    <!-- Date Range Picker -->
    <script src="~/assets/libs/daterangepicker/moment.min.js"></script>
    <script src="~/assets/libs/daterangepicker/daterangepicker.js"></script>
        
    <script>
        $(function () {
            initDateRangePicker('@Model.StartDate.ToString("yyyy-MM-dd")', '@Model.EndDate.ToString("yyyy-MM-dd")');
        });
    </script>

    <script src="~/assets/js/shared/date-range.init.js"></script>

    <script>
        $(document).ready(function () {
            const dtConfig = {
                responsive: true,
                paging: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                searching: true,
                dom: '<"top d-flex justify-content-between align-items-center mb-2" lBf>rt<"bottom d-flex justify-content-between align-items-center mt-2"ip>',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bi bi-file-earmark-excel"></i> Export to Excel',
                        className: 'btn btn-outline-success rounded-pill shadow-sm me-3'
                    }
                ]
            };

            if ($('#propertyDetailsTable').length) {
                $('#propertyDetailsTable').DataTable({
                    ...dtConfig,
                    order: [[2, 'desc']],
                    buttons: [{
                        extend: 'excelHtml5',
                        text: '<i class="bi bi-file-earmark-excel"></i> Export to Excel',
                        className: 'btn btn-outline-success rounded-pill shadow-sm me-3',
                        title: 'New Accounts'
                    }]
                });
            }

            if ($('#lostReturningTable').length) {
                $('#lostReturningTable').DataTable({
                    ...dtConfig,
                    order: [[5, 'desc']],
                    buttons: [{
                        extend: 'excelHtml5',
                        text: '<i class="bi bi-file-earmark-excel"></i> Export Lost &amp; Returning',
                        className: 'btn btn-outline-warning rounded-pill shadow-sm me-3',
                        title: 'Lost and Returning Customers'
                    }]
                });
            }
        });
    </script>


}
