@model SalesMetrics.Models.RegisterViewModel

<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form asp-action="CreateUser" asp-controller="Accounts" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add New User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.UserId)
                    <!-- Repeat fields just like the edit modal, but for registration -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.FirstName)
                            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.LastName)
                            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Username)
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Password)
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(m => m.Email)
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                        </div>
                        <div class="col-md-3 mb-3">
                            @Html.LabelFor(m => m.RoleId)
                            @Html.DropDownListFor(m => m.RoleId, new SelectList(new[] {
                            new { Value = 1, Text = "ADMIN" },
                            new { Value = 2, Text = "SALES" },
                            new { Value = 3, Text = "SALES ADMIN" },
                            new { Value = 4, Text = "GENERAL MANAGER" },
                            new { Value = 5, Text = "OFFICE" }
                            }, "Value", "Text"), "Select Role", new { @class = "form-select" })
                        </div>
                        <div class="col-md-3 mb-3">
                            @Html.LabelFor(m => m.UserId)
                            @Html.TextBoxFor(m => m.UserId, new { @class = "form-control" })
                        </div>
                    </div>

                    <!-- LOCATION SELECTOR PARTIAL -->
                    @await Html.PartialAsync("_UserLocationSelector", Model)

                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Create User</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
