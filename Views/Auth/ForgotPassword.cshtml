@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Shared/AuthLayout.cshtml";
}

<div class="container-fluid authentication-bg overflow-hidden">
    <div class="bg-overlay"></div>
    <div class="row align-items-center justify-content-center min-vh-100">
        <div class="col-10 col-md-6 col-lg-4 col-xxl-3">
            <div class="card mb-0">
                <div class="card-body">
                    <div class="text-center">
                        <a href="/" class="logo-dark">
                            <img src="~/assets/images/logo.png" alt="SM Logo" height="275" class="auth-logo logo-dark mx-auto">
                        </a>

                        <h4 class="mt-4">Reset Password</h4>
                        <p class="text-muted fs-5">SalesMetrics Account Recovery</p>
                    </div>

                    <div class="p-2 mt-3">
                        @if (ViewBag.Submitted == true)
                        {
                            <div class="alert alert-success text-center">
                                <i class="mdi mdi-check-circle me-1"></i>
                                If an account with that email exists, a reset link has been sent. The link expires in 1 hour.
                                If you do not receive an email, please contact your IT Department.
                            </div>
                            <div class="pt-2 text-center">
                                <a href="@Url.Action("Login", "Auth")" class="btn btn-outline-primary w-xl">Back to Login</a>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center mb-4">
                                Enter your email address below. If it matches an account, a password reset link will be sent to that address.
                            </p>

                            <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
                                @Html.AntiForgeryToken()
                                <div class="input-group auth-form-group-custom mb-4">
                                    <span class="input-group-text bg-primary bg-opacity-10 fs-16"><i class="mdi mdi-email-outline auti-custom-input-icon"></i></span>
                                    <input type="email" class="form-control" name="email" placeholder="Enter your email address" required>
                                </div>

                                <div class="pt-2 text-center">
                                    <button class="btn btn-primary w-xl waves-effect waves-light" type="submit">Send Reset Request</button>
                                </div>
                            </form>

                            <div class="text-center mt-3">
                                <a href="@Url.Action("Login", "Auth")" class="text-muted"><i class="mdi mdi-arrow-left me-1"></i> Back to Login</a>
                            </div>
                        }
                    </div>

                    <div class="mt-5 text-center">
                        <p>
                            &copy;
                            <script>document.write(new Date().getFullYear())</script> ProBuildIQ SalesMetrics. Crafted by 774FxEnt
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/assets/js/app.js" asp-append-version="true"></script>
}
