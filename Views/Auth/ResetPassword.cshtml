@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/AuthLayout.cshtml";
}

<div class="container-fluid authentication-bg overflow-hidden">
    <div class="bg-overlay"></div>
    <div class="row align-items-center justify-content-center min-vh-100">
        <div class="col-10 col-md-6 col-lg-4 col-xxl-3">
            <div class="card mb-0">
                <div class="card-body">
                    <div class="text-center">
                        <a href="/" class="logo-dark">
                            <img src="~/assets/images/logo.png" alt="SM Logo" height="275" class="auth-logo logo-dark mx-auto">
                        </a>
                        <h4 class="mt-4">Set New Password</h4>
                        <p class="text-muted fs-5">SalesMetrics Account Recovery</p>
                    </div>

                    <div class="p-2 mt-3">
                        @if (ViewBag.Success == true)
                        {
                            <div class="alert alert-success text-center">
                                <i class="mdi mdi-check-circle me-1"></i>
                                Your password has been updated successfully.
                            </div>
                            <div class="pt-2 text-center">
                                <a href="@Url.Action("Login", "Auth")" class="btn btn-primary w-xl">Back to Login</a>
                            </div>
                        }
                        else if (ViewBag.InvalidToken == true)
                        {
                            <div class="alert alert-danger text-center">
                                <i class="mdi mdi-alert-circle me-1"></i>
                                This password reset link is invalid or has expired.
                            </div>
                            <div class="pt-2 text-center">
                                <a href="@Url.Action("ForgotPassword", "Auth")" class="btn btn-outline-primary w-xl">Request a New Link</a>
                            </div>
                        }
                        else
                        {
                            if (!string.IsNullOrEmpty(ViewBag.Error as string))
                            {
                                <div class="alert alert-danger text-center">
                                    <i class="mdi mdi-alert-circle me-1"></i>
                                    @ViewBag.Error
                                </div>
                            }

                            <form asp-controller="Auth" asp-action="ResetPassword" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="token" value="@ViewBag.Token" />

                                <div class="input-group auth-form-group-custom mb-4">
                                    <span class="input-group-text bg-primary bg-opacity-10 fs-16">
                                        <i class="mdi mdi-lock-outline auti-custom-input-icon"></i>
                                    </span>
                                    <input type="password" class="form-control" name="newPassword"
                                           placeholder="New password (min 8 characters)" required minlength="8">
                                </div>

                                <div class="input-group auth-form-group-custom mb-4">
                                    <span class="input-group-text bg-primary bg-opacity-10 fs-16">
                                        <i class="mdi mdi-lock-check-outline auti-custom-input-icon"></i>
                                    </span>
                                    <input type="password" class="form-control" name="confirmPassword"
                                           placeholder="Confirm new password" required minlength="8">
                                </div>

                                <div class="pt-2 text-center">
                                    <button class="btn btn-primary w-xl waves-effect waves-light" type="submit">
                                        Update Password
                                    </button>
                                </div>
                            </form>

                            <div class="text-center mt-3">
                                <a href="@Url.Action("Login", "Auth")" class="text-muted">
                                    <i class="mdi mdi-arrow-left me-1"></i> Back to Login
                                </a>
                            </div>
                        }
                    </div>

                    <div class="mt-5 text-center">
                        <p>
                            &copy;
                            <script>document.write(new Date().getFullYear())</script> ProBuildIQ SalesMetrics. Crafted by 774FxEnt
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/assets/js/app.js" asp-append-version="true"></script>
}
