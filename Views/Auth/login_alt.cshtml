@{
    ViewBag.Title = "Login Alternative";
    Layout = "~/Views/Shared/AuthLayout.cshtml";
}

<div class="container-fluid authentication-bg overflow-hidden">
    <div class="bg-overlay"></div>
    <div class="row align-items-center justify-content-center min-vh-100">
        <div class="col-10 col-md-6 col-lg-4 col-xxl-3">
            <div class="card mb-0">
                <div class="card-body">
                    <div class="text-center">
                        <a href="/" class="logo-dark">
                            <img src="~/assets/images/logo.png" alt="SM Logo" height="275" class="auth-logo logo-dark mx-auto">
                        </a>
                        <a href="index.html" class="logo-dark">
                            <img src="~/assets/images/logo.png" alt="SM Logo" height="275" class="auth-logo logo-light mx-auto">
                        </a>

                        <h4 class="mt-4">Welcome Back !</h4>
                        <p class="text-muted">Sign in to continue to SalesMetrics.</p>
                    </div>

                    <div class="p-2 mt-5">
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger text-center">@ViewBag.Error</div>
                        }
                        @if (TempData["LoginSuccess"] != null)
                        {
                            <div class="alert alert-success text-center">@TempData["LoginSuccess"]</div>
                        }

                        <form asp-controller="Auth" asp-action="Login_Alt" method="post">
                            @Html.AntiForgeryToken()
                            <div class="input-group auth-form-group-custom mb-3">
                                <span class="input-group-text bg-primary bg-opacity-10 fs-16 " id="basic-addon1"><i class="mdi mdi-account-outline auti-custom-input-icon"></i></span>
                                <input type="text" class="form-control" name="username" placeholder="Enter username" required>
                            </div>

                            <div class="input-group auth-form-group-custom mb-3">
                                <span class="input-group-text bg-primary bg-opacity-10 fs-16" id="basic-addon2"><i class="mdi mdi-lock-outline auti-custom-input-icon"></i></span>
                                <input type="password" class="form-control" name="password" placeholder="Enter password" required>
                            </div>

                            <div class="input-group auth-form-group-custom mb-3">
                                <span class="input-group-text bg-primary bg-opacity-10 fs-16" id="basic-addon3"><i class="mdi mdi-map-marker-outline auti-custom-input-icon"></i></span>
                                <select class="form-control" name="officeLocation" required>
                                    <option value="">Select Office Location</option>
                                    <option value="LAX">Los Angeles</option>
                                    <option value="LSV">Las Vegas</option>
                                    <option value="CHN">Chino</option>
                                    <option value="SND">San Diego</option>
                                    <option value="PHX">Phoenix</option>
                                </select>
                            </div>

                            <div class="mb-sm-5">
                                <div class="form-check float-sm-start">
                                    <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe">
                                    <label class="form-check-label" for="rememberMe">Remember me</label>
                                </div>
                                <div class="float-sm-end">
                                    <a href="@Url.Action("ForgotPassword", "Auth")" class="text-muted"><i class="mdi mdi-lock me-1"></i> Forgot your password?</a>
                                </div>
                            </div>

                            <div class="pt-3 text-center">
                                <button class="btn btn-primary w-xl waves-effect waves-light" type="submit">Log In</button>
                            </div>
                        </form>
                    </div>

                    <div class="text-center mt-3">
                        <a href="@Url.Action("Login", "Auth")" class="text-primary">Switch to Email Login</a>
                    </div>

                    <div class="mt-5 text-center">
                        <p>
                            ©
                            <script>document.write(new Date().getFullYear())</script> ProBuildIQ SalesMetrics. Crafted by 774FxEnt
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/assets/js/app.js" asp-append-version="true"></script>
}

