    <!-- Weekly Radar Chart -->
    <script>
        let chartInstance; // Global variable to store the chart instance
        const urlParams = new URLSearchParams(window.location.search);
        const weekOffset = urlParams.get("weekOffset") || 0;

        fetch(`/Dashboard/GetWeeklyOrders?weekOffset=${weekOffset}`)
            .then(res => res.json())
            .then(data => {
                if (!data || data.length === 0) {
                    console.error("No data received from the server.");
                    return;
                }

                const daysOrder = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                const orderData = Array(7).fill(0);
                let maxOrders = 0;

                data.forEach(item => {
                    const idx = daysOrder.indexOf(item.weekdayName);
                    if (idx >= 0) {
                        orderData[idx] = item.ordersCount;
                        maxOrders = Math.max(maxOrders, item.ordersCount);
                    }
                });

                // Update progress bars dynamically
                document.querySelectorAll(".progress-bar").forEach((bar, index) => {
                    if (index < orderData.length) {
                        let percentage = maxOrders > 0 ? Math.round((orderData[index] / maxOrders) * 100) : 0;
                        bar.style.width = percentage + "%";
                        let orderCount = orderData[index];

                        bar.parentElement?.previousElementSibling.firstElementChild.textContent = `Orders: ${orderCount} ( ${percentage}% )`;
                    }
                });
            })
            .catch(error => console.error("Error fetching data:", error));
    </script>
    <script>
        // Initialize the linked datepickers
