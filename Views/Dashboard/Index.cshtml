@{
    ViewBag.Title = "Dashboard";
    ViewBag.pTitle = "Sales Metrics";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var salesData = ViewBag.SalesData as Dictionary<string, object>;
}

@section styles {
    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/bootstrap-datepicker/css/bootstrap-datepicker.min.css" rel="stylesheet">

    <!-- buttons datatable -->
    <link href="~/assets/libs/datatables.net-buttons-bs5/css/buttons.bootstrap5.min.css" rel="stylesheet" type="text/css" />

    <!-- Responsive datatable examples -->
    <link href="~/assets/libs/datatables.net-responsive-bs5/css/responsive.bootstrap5.min.css" rel="stylesheet" type="text/css" />

    <style>
        .daily-task-card {
        animation: fadeIn 0.3s ease-in;
        }

        .bg-orange {
            background-color: darkorange;
        }

        .kpi-tile {
            height: 100%;
            min-height: 100px;
            transition: all 0.3s ease-in-out;
        }

        .kpi-label {
            font-size: clamp(0.8rem, 1.1vw, 1.0rem);
            font-weight: 300;
            opacity: 0.9;
        }

        .kpi-value {
            font-size: clamp(1.2rem, 2.3vw, 2.0rem);
            font-weight: 500;
            line-height: 1.1;
            word-break: break-word;
            color: white
        }

    </style>
}

<input type="hidden" id="CurrentRoleId" value="@ViewBag.RoleId" />
<input type="hidden" id="CurrentUserId" value="@ViewBag.UserId" />

<div class="row">
    <div class="col-3">
        <div class="page-title-box d-flex align-items-center justify-content-between">
            <div>
                <h4 class="fs-16 fw-semibold mb-1 mb-md-2">
                    @ViewBag.Greeting, <span class="text-primary">@ViewBag.Username!</span>
                </h4>
                <p class="text-muted mb-0">Here's what's happening with your sales today.</p>
            </div>
        </div>
    </div>
    <div class="col-3">
        <!-- 🔥 Filter Row (Dropdown + Toggle) -->
        <div class="row mb-3 align-items-center">

            @if (ViewBag.RoleId == 1 || ViewBag.RoleId == 3 || ViewBag.RoleId == 4)
            {
                <!-- Admin/SalesAdmin: User Filter -->
                <div class="col-auto">
                    <label for="userFilter" class="form-label fw-bold mb-1">Filter by Salesperson:</label>
                    <select id="userFilter" class="form-select fw-bold" style="min-width: 200px;">
                        <option value="">All Users</option>

                        @foreach (var user in (List<User>)ViewBag.Users)
                        {
                            bool isSelected = (ViewBag.SelectedSalesmanId != null && (int)ViewBag.SelectedSalesmanId == user.SalesmanID);
                            @if (isSelected)
                            {
                                <option class="fw-bold" value="@user.SalesmanID" selected="selected">@($"{user.FirstName} {user.LastName}")</option>
                            }
                            else
                            {
                                <option class="fw-bold" value="@user.SalesmanID">@($"{user.FirstName} {user.LastName}")</option>
                            }
                        }
                    </select>
                </div>
            }
        </div>
    </div>    
    <div class="col-4">
        <div class="row mb-2">
            <p class="mb-0 text-muted">Select Date Range for Dashboard Data</p>
            <div class="col-sm-7">
                <select class="form-select" id="quickRangeSelector">
                    <option value="0" selected="@(ViewBag.SelectedRangeType == 0 ? "selected" : null)">Current Month</option>
                    <option value="1" selected="@(ViewBag.SelectedRangeType == 1 ? "selected" : null)">Last Month</option>
                    <option value="2" selected="@(ViewBag.SelectedRangeType == 2 ? "selected" : null)">Start of Last Quarter</option>
                    <option value="3" selected="@(ViewBag.SelectedRangeType == 3 ? "selected" : null)">Start of This Year</option>
                    <option value="4" selected="@(ViewBag.SelectedRangeType == 4 ? "selected" : null)">Start of Last Year</option>
                </select>
            </div>
            <div class="col-sm-5 d-flex align-items-center">
                <button id="applyQuickRange" class="btn btn-primary w-100">Apply</button>
            </div>
        </div>
    </div>
    <div class="col-2 align-items-center">
        <div class="col-sm-12 mt-1 ">
            <p id="selectedRangeLabel" class="text-dark fs-5 text-center">
                Selected Range: <br/><strong>@ViewBag.StartDate</strong> to <strong>@ViewBag.EndDate</strong>
            </p>
        </div>
    </div>
</div>

<!-- Top Row: Total Sales, Total Due, MTD, YTD -->
<div class="row">
    <!-- MTD Ranking -->
    <div class="col-md-3">
        <div class="card shadow">
            <div class="card-header">
                <h5 class="mb-0">MTD Ranking <span class="badge bg-info ms-2">@ViewBag.MTDRange</span></h5>
            </div>
            <div class="card-body table-responsive p-2">
                @{
                    var mtd = ViewBag.MTDRanking as List<SalesMetrics.Models.SalesRanking>;
                    int mtdRank = 1;
                }
                <table class="table table-sm table-bordered mb-0">
                    <thead>
                        <tr><th>#</th><th>Salesperson</th><th>Amount</th></tr>
                    </thead>
                    <tbody>
                        @if (mtd != null && mtd.Any())
                        {
                            foreach (var person in mtd)
                            {
                                <tr>
                                    <td>@mtdRank</td>
                                    <td>@person.SalespersonName</td>
                                    <td>@person.MTDSales.ToString("C")</td>
                                </tr>
                                mtdRank++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center">No data</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- YTD Ranking -->
    <div class="col-md-3">
        <div class="card shadow">
            <div class="card-header">
                <h5 class="mb-0">YTD Ranking <span class="badge bg-info ms-2">@ViewBag.YTDRange</span></h5>
            </div>
            <div class="card-body table-responsive p-2">
                @{
                    var ytd = ViewBag.YTDRanking as List<SalesMetrics.Models.SalesRanking>;
                    int ytdRank = 1;
                }
                <table class="table table-sm table-bordered mb-0">
                    <thead>
                        <tr><th>#</th><th>Salesperson</th><th>Amount</th></tr>
                    </thead>
                    <tbody>
                        @if (ytd != null && ytd.Any())
                        {
                            foreach (var person in ytd)
                            {
                                <tr>
                                    <td>@ytdRank</td>
                                    <td>@person.SalespersonName</td>
                                    <td>@person.YTDSales.ToString("C")</td>
                                </tr>
                                ytdRank++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center">No data</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Columns 1 -->
    <div class="col-md-3 mt-2">
        <!-- Total Sales -->
        <div class="col-12 mb-3">
            <div class="kpi-tile bg-orange text-white shadow-lg rounded p-1 d-flex flex-column justify-content-center align-items-start">
                <p class="kpi-label mb-1">Total Sales</p>
                <h3 class="kpi-value" style="margin: 0 auto;">$@Convert.ToDecimal(salesData["TotalSales"]).ToString("N2")</h3>
            </div>
        </div>

        <!-- Total Invoices -->
        <div class="col-12 mb-3">
            <div class="kpi-tile bg-orange text-white shadow-lg rounded p-1 d-flex flex-column justify-content-center align-items-start">
                <p class="kpi-label mb-1">Total Invoices</p>
                <h3 class="kpi-value" style="margin: 0 auto;">@Convert.ToInt32(salesData["TotalInvoices"]).ToString("N0")</h3>
            </div>
        </div>
    </div>

    <!-- Columns 2 -->
    <div class="col-md-3 mt-2">
        <!-- Total Due -->
        <div class="col-12 mb-3">
            <div class="kpi-tile bg-orange text-white shadow-lg rounded p-1 d-flex flex-column justify-content-center align-items-start">
                <p class="kpi-label mb-1">Total Due</p>
                <h3 class="kpi-value" style="margin: 0 auto;">$@Convert.ToDecimal(salesData["AmountDue"]).ToString("N2")</h3>
            </div>
        </div>
        <!-- Active Properties -->
        <div class="col-12 mb-3">
            <div class="kpi-tile bg-orange text-white shadow-lg rounded p-1 d-flex flex-column justify-content-center align-items-start">
                <p class="kpi-label mb-1">Active Properties</p>
                <h3 class="kpi-value" style="margin: 0 auto;">@Convert.ToInt32(salesData["PropertyCount"]).ToString("N0")</h3>
            </div>
        </div>
    </div>
</div>

<!-- Daily Task, Weekly Orders, Receivable Risk Summary -->
<div class="row">
    <!-- Daily Task Placeholder or Card -->
    <div class="col-xl-4">
        <div class="card">
            @{
                var todayTasks = ViewBag.TodayTasks as List<SalesMetrics.Models.SalesTask>;
                var groupedTasks = todayTasks
                .Where(t => t.DueDate != null)
                .OrderBy(t => t.DueDate)
                .GroupBy(t => t.DueDate.Value.Date)
                .ToList();
            }
            <div class="card-header d-flex justify-content-between align-items-center">
                <!-- Left: Daily Task Section -->
                <h4 class="card-title mb-0">
                    Upcoming Tasks
                    <span class="badge bg-primary ms-2">@(todayTasks?.Count ?? 0)</span>
                </h4>
                <!-- Right: Daily Task Section -->
                <div class="col-md-4 col-sm-12 text-end">
                    <div class="dropdown">
                        <a href="/Tasks/Task" class="btn btn-sm btn-outline-info float-end">
                            View All Tasks
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body" style="max-height: 500px; overflow-y:auto;">
                @if (groupedTasks.Any())
                {
                    foreach (var group in groupedTasks)
                    {
                        <h6 class="mt-0 mb-1 text-primary border-bottom pb-1">
                            <i class="fas fa-calendar-alt me-1"></i>
                            @group.Key.ToString("dddd, MMMM d")
                        </h6>

                        <ul class="list-group list-group-flush">
                            @foreach (var task in group)
                            {
                                <li class="list-group-item">
                                    <div class="card mb-0 p-0 shadow-sm">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="fw-bold">@task.Title</h6>
                                                <p class="mb-1 fs-6 text-muted">
                                                    <i class="far fa-clock me-1"></i> @task.DueDate?.ToString("hh:mm tt") |
                                                    <i class="fas fa-calendar-day me-1"></i> @task.DueDate?.ToString("MMM dd, yyyy")
                                                </p>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge fs-6 bg-success">@task.Status</span>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <p class="mb-1"><strong>Property:</strong> <span class="badge bg-info text-white me-1 fs-6"><i class="fas fa-map-marker-alt me-1"></i>@task.Property</span></p>

                                                @if (!string.IsNullOrEmpty(task.CreatedBy))
                                                {
                                                    <p class="mb-1">
                                                        <strong>Created By:</strong>
                                                        <span class="badge bg-secondary text-white me-1 fs-6">
                                                            <i class="fas fa-user-circle me-1"></i>@task.CreatedBy
                                                        </span>
                                                    </p>
                                                }
                                            </div>
                                            <div>
                                                <p class="mb-1"><strong>Type:</strong> <span class="badge bg-light text-dark me-1 fs-6"><i class="fas fa-tag me-1"></i>@task.Type</span></p>
                                            </div>
                                        </div>
                                        <a href="javascript:void(0);"
                                           class="stretched-link daily-task-card"
                                           data-task-id="@task.TaskID"
                                           data-bs-toggle="modal"
                                           data-bs-target="#editTaskModal">
                                        </a>

                                    </div>
                                </li>
                            }
                        </ul>
                    }
                }
                else
                {
                    <p class="text-muted">No tasks scheduled for today.</p>
                }

            </div>
        </div>
    </div>

    <!-- Weekly Orders Bar Graph -->
    <div class="col-xl-3">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center w-100">
                    <!-- Left: Title -->
                    <div class="col-md-4 col-sm-12">
                        <div class="d-flex align-items-center gap-2">
                            <div class="card-icon">
                                <i class="fas fa-layer-group fs-16 text-muted me-1"></i>
                            </div>
                            <h4 class="card-title mb-0">Orders</h4>
                        </div>
                    </div>

                    <!-- Center: Date Range -->
                    <div class="col-md-4 col-sm-12 text-center">
                        <span class="text-muted fw-medium fs-6 fw-bold ">
                            @(((DateTime)ViewBag.WeeklyStart).ToString("M/d")) to @(((DateTime)ViewBag.WeeklyEnd).ToString("M/d"))
                        </span>
                    </div>

                    <!-- Right: Select Week -->
                    <div class="col-md-4 col-sm-12 text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" id="weekFilterBtn" data-bs-toggle="dropdown">
                                Select Week
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="weekFilterBtn">
                                <li><a class="dropdown-item week-range-option @(ViewBag.WeekOffset == 0 ? "active" : "")" data-offset="0">This Week</a></li>
                                <li><a class="dropdown-item week-range-option @(ViewBag.WeekOffset == -1 ? "active" : "")" data-offset="-1">Last Week</a></li>
                                <li><a class="dropdown-item week-range-option @(ViewBag.WeekOffset == 1 ? "active" : "")" data-offset="1">Next Week</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body">
                @{
                    var daysOfWeek = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
                    var weeklyOrders = ViewBag.WeeklyOrders as List<DailyOrderCount>;
                    var maxOrders = weeklyOrders != null && weeklyOrders.Any() ? weeklyOrders.Max(o => o.OrdersCount) : 1;
                    var totalOrders = weeklyOrders?.Sum(o => o.OrdersCount) ?? 1;

                    var dayColors = new Dictionary<string, string>
                    {
                        { "Sunday", "bg-danger" },
                        { "Monday", "bg-primary" },
                        { "Tuesday", "bg-success" },
                        { "Wednesday", "bg-info" },
                        { "Thursday", "bg-warning" },
                        { "Friday", "bg-secondary" },
                        { "Saturday", "bg-dark" }
                    };
                }

                <div class="d-grid gap-3" >
                    @foreach (var day in daysOfWeek)
                    {
                        var order = weeklyOrders?.FirstOrDefault(o => o.WeekdayName == day);
                        var percentage = order != null && totalOrders > 0 ? (int)(((double)order.OrdersCount / totalOrders) * 100) : 0;
                        var barWidth = order != null && maxOrders > 0 ? (int)(((double)order.OrdersCount / maxOrders) * 100) : 0;
                        var barColor = dayColors.ContainsKey(day) ? dayColors[day] : "bg-primary";

                            <div class="mb-1" style="font-size: clamp(0.875rem, .95vw, 1.0rem);">
                            <div class="d-flex justify-content-between">
                                @* <span class="text-muted">@order?.OrdersCount (@percentage%)</span> *@
                                <span class="text-muted">@((order?.OrdersCount ?? 0) + " (" + percentage + "%)")</span>
                                <a href="#" class="text-muted day-link" data-day="@day">@day</a>

                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated @barColor" style="width: @barWidth%;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Receivable Risk Summary -->
    <div class="col-xl-5">
        <div class="card">
            <div class="card-header justify-content-between">
                <div class="card-icon text-muted"><i class="fas fa-sort-amount-up fs-6"></i></div>
                <h4 class="card-title">Receivable Risk Summary</h4>
                <div class="card-addon dropdown">
                    @* <button class="btn btn-label-primary py-0 btn-sm dropdown-toggle" data-bs-toggle="dropdown">Option</button>
                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-animated">
                        <a class="dropdown-item" href="#"><i class="fa fa-poll me-2"></i>Report</a>
                        <a class="dropdown-item" href="#"><i class="fa fa-chart-pie me-2"></i>Charts</a>
                        <a class="dropdown-item" href="#"><i class="fa fa-chart-line me-2"></i>Statistics</a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#"><i class="fa fa-cog me-2"></i>Settings</a>
                    </div> *@
                </div>
            </div>
            <div class="card-body">
                @{
                    var summary = ViewBag.TransactionSummary as TransactionSummary;
                }
                <div class="border-bottom text-center pb-3">
                    <div class="d-flex align-items-center justify-content-center">
                        <span class="text-primary me-2" style="font-size: clamp(1rem, 2vw, 2rem)">
                            <i class="fas fa-file-invoice"></i>
                        </span>
                        @* <h5 class="display-5 mb-0">@summary?.PendingInvoicesAmount.ToString("C")</h5> *@
                        <h5 class="mb-0" style="font-size: clamp(1.2rem, 2.3vw, 2.2rem);">
                            @summary?.PendingInvoicesAmount.ToString("C")
                        </h5>

                    </div>
                    <p class="text-muted mb-0" style="font-size: clamp(0.75rem, 1.5vw, 1rem);">Total Unpaid Invoices</p>
                </div>
                <div class="d-flex justify-content-between py-3">
                    <p class="text-muted fs-5 mb-0 fw-bold">Invoice Aging details</p>
                </div>
                <div class="hstack gap-4 justify-content-center pb-3 flex-wrap">
                    <div class="text-center">
                        <div class="d-flex align-items-center justify-content-center text-nowrap">
                            <span class="text-info me-2" style="font-size: clamp(1rem, 1.4vw, 1.5rem);">
                                <i class="fas fa-exclamation-circle"></i>
                            </span>
                            <span class="mb-0" style="font-size: clamp(1rem, 1.4vw, 1.5rem); font-weight:500;">
                                @summary?.Due30to60Amount.ToString("C")
                            </span>

                        </div>
                        <p class="text-muted mb-0" style="font-size: clamp(0.75rem, 1.1vw, .95rem);">30-60 Days</p>
                    </div>
                    <div class="text-center">
                        <div class="d-flex align-items-center justify-content-center text-nowrap">
                            <span class="text-warning me-2" style="font-size: clamp(1rem, 1.4vw, 1.5rem);">
                                <i class="fas fa-exclamation-triangle"></i>
                            </span>
                            <span class="mb-0" style="font-size: clamp(1rem, 1.4vw, 1.5rem); font-weight:500;">
                                @summary?.Due60to90Amount.ToString("C")
                            </span>
                        </div>
                        <p class="text-muted mb-0" style="font-size: clamp(0.75rem, 1.1vw, .95rem);">60-90 Days</p>
                    </div>
                    <div class="text-center">
                        <div class="d-flex align-items-center justify-content-center text-nowrap">
                            <span class="text-danger me-2" style="font-size: clamp(1rem, 1.4vw, 1.5rem);">
                                <i class="fas fa-radiation"></i>
                                </span>
                            <span class="mb-0" style="font-size: clamp(1rem, 1.4vw, 1.5rem); font-weight:500;">
                                @summary?.Due90to120Amount.ToString("C")
                            </span>
                        </div>
                        <p class="text-muted mb-0" style="font-size: clamp(0.75rem, 1.1vw, .95rem);">90-120 Days</p>
                    </div>
                    @if (summary != null && summary.DueOver120 != 0)
                    {
                        <div class="text-center">
                            <div class="d-flex align-items-center justify-content-center text-nowrap">
                                <span class="text-danger me-2" style="font-size: clamp(1rem, 1.4vw, 1.5rem);">
                                    <img src="~/assets/images/dog-house.png" alt="Delinquent" class="icon-img ms-1" />
                                </span>
                                <span class="mb-0" style="font-size: clamp(1rem, 1.4vw, 1.5rem); font-weight:500;">
                                    @summary.DueOver120Amount.ToString("C")
                                </span>
                            </div>
                            <p class="text-muted mb-0" style="font-size: clamp(0.75rem, 1.1vw, .95rem);">Over 120 Days</p>
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-between py-3">
                    <p class="text-muted fs-5 mb-0 fw-bold">Top 5 <strong>Dog-House</strong> Customers</p>
                </div>
                <div>
                    @foreach (var customer in summary?.TopDelinquentCustomers ?? new List<CustomerOutstanding>())
                    {
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <a asp-controller="Properties" asp-action="PropertyDetails" asp-route-id="@customer.CustomerId">
                                <h5 class="mb-0" style="font-size: clamp(0.75rem, 1vw, 0.85rem);"><i class="fas fa-user text-danger me-2"></i>@customer.CustomerName</h5>
                            </a>
                            <p class="text-muted mb-0" style="font-size: clamp(0.75rem, 1vw, 0.85rem); font-weight:400;">@customer.OutstandingAmount.ToString("C")</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Inactive Customers Table -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">Inactive Customers - No Activity in 30 Day to 14 Months (480 Days)</h4>
            </div>
            <div class="card-body" style="overflow-x:auto;">
                <table id="inactive-customers-table" class="table table-hover table-bordered table-striped dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;" >
                    <thead>
                        <tr>
                            <th>Customer #</th>
                            <th>Property Name</th>
                            <th>Mgmt Co</th>
                            <th># Units</th>
                            <th>Last Order</th>
                            <th>Last Install</th>
                            <th>YTD (This)</th>
                            <th>YTD (Last)</th>
                            <th>Balance</th>
                            <th>Salesperson</th>
                            <th>Established</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cust in ViewBag.InactiveCustomers as List<SalesMetrics.Models.InactiveCustomerViewModel>)
                        {
                            <tr>
                                <td>@cust.CustomerNumber</td>
                                <td>
                                    <a asp-controller="Properties" asp-action="PropertyDetails" asp-route-id="@cust.CustomerId">
                                        @cust.CustomerName
                                    </a>
                                </td>
                                <td>@cust.MgmtCo</td>
                                <td>@cust.Units</td>
                                <td data-order="@cust.LastOrderDate?.ToString("yyyy-MM-ddTHH:mm:ss")">@(cust.LastOrderDate?.ToString("d") ?? "N.A")</td>
                                <td data-order="@cust.LastInstallDate?.ToString("yyyy-MM-ddTHH:mm:ss")">@(cust.LastInstallDate?.ToString("d") ?? "N/A")</td>
                                <td>@cust.YTDCurrent.ToString("C")</td>
                                <td>@cust.YTDPrevious.ToString("C")</td>
                                <td>@cust.Balance.ToString("C")</td>
                                <td>@cust.Salesperson</td>
                                <td data-order="@cust.EstablishedDate?.ToString("yyyy-MM-ddTHH:mm:ss")">@cust.EstablishedDate?.ToString("MM/dd/yyyy")</td>
                                <td>
                                    <button class="btn btn-sm btn-orange create-task-from-inactive"
                                            data-property="@cust.CustomerName"
                                            data-id="@cust.CustomerNumber"
