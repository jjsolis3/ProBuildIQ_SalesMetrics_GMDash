    <script>
        document.getElementById("applyQuickRange").addEventListener("click", function () {
            const selectedOption = parseInt(document.getElementById("quickRangeSelector").value);

            let startDate = new Date();
            let endDate = new Date();

            if (selectedOption === 0) {
                startDate = new Date(endDate.getFullYear(), endDate.getMonth(), 1);
            } else if (selectedOption === 1) {
                startDate = new Date(endDate.getFullYear(), endDate.getMonth() - 1, 1);
                endDate.setMonth(endDate.getMonth() - 1);
                endDate.setDate(new Date(endDate.getFullYear(), endDate.getMonth() + 1, 0).getDate());
            } else if (selectedOption === 2) {
                const currentMonth = endDate.getMonth();
                const currentQuarterStartMonth = Math.floor(currentMonth / 3) * 3;
                startDate = new Date(endDate.getFullYear(), currentQuarterStartMonth - 3, 1);
                endDate.setMonth(currentQuarterStartMonth - 1);
                endDate.setDate(new Date(endDate.getFullYear(), endDate.getMonth() + 1, 0).getDate());
            } else if (selectedOption === 3) {
                startDate = new Date(endDate.getFullYear(), 0, 1);
            } else if (selectedOption === 4) {
                startDate = new Date(endDate.getFullYear() - 1, 0, 1);
                endDate.setFullYear(endDate.getFullYear() - 1);
                endDate.setMonth(11);
                endDate.setDate(31);
            }

            const format = date => date.toISOString().split("T")[0];
            const start = format(startDate);
            const end = format(endDate);

            // THEN continue with navigation (full reload)
            const existingParams = new URLSearchParams(window.location.search);
            const currentSalesmanId = existingParams.get("filterSalesmanId") || "";

            let url = `/Dashboard/Index?startDate=${start}&endDate=${end}&rangeType=${selectedOption}`;
            if (currentSalesmanId) {
                url += `&filterSalesmanId=${currentSalesmanId}`;
            }
            window.location.href = url;

        });
    </script>
    <script>
        document.querySelectorAll('.week-range-option').forEach(item => {
            item.addEventListener('click', function () {
                const offset = this.getAttribute('data-offset');
                const urlParams = new URLSearchParams(window.location.search);

                // Preserve existing filters
                const startDate = urlParams.get("startDate");
                const endDate = urlParams.get("endDate");
                const rangeType = urlParams.get("rangeType");
                const filterSalesmanId = urlParams.get("filterSalesmanId");

                let newUrl = `/Dashboard/Index?weekOffset=${offset}`;

                if (startDate) newUrl += `&startDate=${startDate}`;
                if (endDate) newUrl += `&endDate=${endDate}`;
                if (rangeType) newUrl += `&rangeType=${rangeType}`;
                if (filterSalesmanId) newUrl += `&filterSalesmanId=${filterSalesmanId}`;

                window.location.href = newUrl;
            });
        });
    </script>

