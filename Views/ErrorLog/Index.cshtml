@model List<SalesMetrics.Models.ErrorLog>
@{
    ViewData["Title"] = "Error Log";
    var currentLevel = ViewBag.CurrentLevel as string ?? "All";
    var currentPage = (int)ViewBag.CurrentPage;
    var pageSize = (int)ViewBag.PageSize;
}

<!-- Add DataTables CSS in head section -->
@section Styles {
    <!-- DataTables CSS -->
    <link href="~/assets/libs/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-responsive-bs5/css/responsive.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/assets/libs/datatables.net-buttons-bs5/css/buttons.bootstrap5.min.css" rel="stylesheet" />
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                <h4 class="mb-sm-0">Error Log</h4>
                <div class="page-title-right">
                    <a href="@Url.Action("Dashboard")" class="btn btn-primary">
                        <i class="fas fa-chart-bar"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Controls -->
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="btn-group" role="group">
                <a href="@Url.Action("Index", new { level = "All" })"
                   class="btn @(currentLevel == "All" ? "btn-primary" : "btn-outline-primary")">All</a>
                <a href="@Url.Action("Index", new { level = "Error" })"
                   class="btn @(currentLevel == "Error" ? "btn-danger" : "btn-outline-danger")">Errors</a>
                <a href="@Url.Action("Index", new { level = "Warning" })"
                   class="btn @(currentLevel == "Warning" ? "btn-warning" : "btn-outline-warning")">Warnings</a>
                <a href="@Url.Action("Index", new { level = "Information" })"
                   class="btn @(currentLevel == "Information" ? "btn-info" : "btn-outline-info")">Info</a>
            </div>
        </div>
        <div class="col-md-6 text-end">
            @if (Model.Any(e => !e.IsResolved))
            {
                <button class="btn btn-success" id="bulkQuickCloseBtn" onclick="bulkQuickClose()">
                    <i class="fas fa-check-double"></i> Quick Close Selected
                </button>
            }
        </div>
    </div>

    <!-- Error Log Table -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Error List</h5>
                    <div class="d-flex align-items-center">
                        <span class="badge bg-secondary me-2">Total: @Model.Count</span>
                        <span class="badge bg-warning">Unresolved: @Model.Count(e => !e.IsResolved)</span>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table id="errorlog_table" class="table table-striped table-hover dt-responsive nowrap w-100" style="width:100%">
                                <thead class="table-dark">
                                    <tr>
                                        <th>
                                            <input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)">
                                        </th>
                                        <th>Timestamp</th>
                                        <th>Level</th>
                                        <th>Message</th>
                                        <th>User</th>
                                        <th>Path</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var error in Model)
                                    {
                                        <tr class="@(error.Level == "Error" ? "table-danger" : error.Level == "Warning" ? "table-warning" : "")" data-error-id="@error.ErrorID">
                                            <td>
                                                @if (!error.IsResolved)
                                                {
                                                    <input type="checkbox" class="error-checkbox" value="@error.ErrorID">
                                                }
                                            </td>
                                            <td data-order="@error.Timestamp.ToString("yyyyMMddHHmmss")">
                                                <small>@error.Timestamp.ToString("MM/dd/yyyy HH:mm:ss")</small>
                                            </td>
                                            <td>
                                                <span class="badge @(error.Level == "Error" ? "bg-danger" : error.Level == "Warning" ? "bg-warning" : "bg-info")">
                                                    @error.Level
                                                </span>
                                            </td>
                                            <td>
                                                @if (error.Message.Length > 60)
                                                {
                                                    <span title="@error.Message">@error.Message.Substring(0, 60)...</span>
                                                }
                                                else
                                                {
                                                    @error.Message
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(error.Username))
                                                {
                                                    <small>@error.Username</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">Anonymous</small>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(error.RequestPath))
                                                {
                                                    <small class="font-monospace" title="@error.RequestPath">
                                                        @if (error.RequestPath.Length > 25)
                                                        {
                                                            @($"...{error.RequestPath.Substring(error.RequestPath.Length - 22)}")
                                                        }
                                                        else
                                                        {
                                                            @error.RequestPath
                                                        }
                                                    </small>
                                                }
                                            </td>
                                            <td>
                                                @if (error.IsResolved)
                                                {
                                                    <span class="badge bg-success">Resolved</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary status-badge">Open</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="@Url.Action("Details", new { id = error.ErrorID })"
                                                       class="btn btn-outline-primary" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    @if (!error.IsResolved)
                                                    {
                                                        <button class="btn btn-outline-success quick-close-btn"
                                                                data-error-id="@error.ErrorID"
                                                                onclick="quickCloseError(@error.ErrorID, this)"
                                                                title="Quick Close">
                                                            <i class="fas fa-check"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <h5>No errors found</h5>
                            <p class="text-muted">Great! No errors match your current filter.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Quick Close Individual Error
    function quickCloseError(errorId, button) {
        if (confirm('Are you sure you want to quick close this error?')) {
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

            fetch('@Url.Action("QuickClose")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: 'id=' + errorId + '&returnUrl=' + encodeURIComponent(window.location.href)
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Update the row to show resolved status
                        const row = document.querySelector(`tr[data-error-id="${errorId}"]`);
                        const statusBadge = row.querySelector('.status-badge');
                        statusBadge.className = 'badge bg-success';
                        statusBadge.textContent = 'Resolved';

                        // Remove the quick close button
                        button.remove();

                        // Remove checkbox
                        const checkbox = row.querySelector('.error-checkbox');
                        if (checkbox) {
                            checkbox.parentElement.innerHTML = '';
                        }

                        // Show success message
                        showToast('Success', 'Error resolved successfully', 'success');

                        // Update header badges
                        updateHeaderBadges();
                    } else {
                        button.disabled = false;
                        button.innerHTML = '<i class="fas fa-check"></i>';
                        showToast('Error', 'Failed to resolve error', 'error');
                    }
                })
                .catch(error => {
                    button.disabled = false;
                    button.innerHTML = '<i class="fas fa-check"></i>';
                    showToast('Error', 'An error occurred', 'error');
                });
        }
    }

    // Bulk Quick Close
    function bulkQuickClose() {
        const checkedBoxes = document.querySelectorAll('.error-checkbox:checked');
        if (checkedBoxes.length === 0) {
            alert('Please select at least one error to resolve.');
            return;
        }

        if (confirm(`Are you sure you want to quick close ${checkedBoxes.length} error(s)?`)) {
            const errorIds = Array.from(checkedBoxes).map(cb => parseInt(cb.value));
            const bulkBtn = document.getElementById('bulkQuickCloseBtn');

            bulkBtn.disabled = true;
            bulkBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

            // Send as an object with errorIds property
            fetch('@Url.Action("BulkQuickClose")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: JSON.stringify({ errorIds: errorIds })
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        showToast('Success', data.message, 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        bulkBtn.disabled = false;
                        bulkBtn.innerHTML = '<i class="fas fa-check-double"></i> Quick Close Selected';
                        showToast('Error', data.message || 'Bulk operation failed', 'error');
                    }
                })
                .catch(error => {
                    bulkBtn.disabled = false;
                    bulkBtn.innerHTML = '<i class="fas fa-check-double"></i> Quick Close Selected';
                    showToast('Error', 'Network error occurred during bulk operation', 'error');
                });
        }
    }

    // Select All Functionality
    function toggleSelectAll(selectAllCheckbox) {
        const checkboxes = document.querySelectorAll('.error-checkbox');
        checkboxes.forEach(checkbox => {
            checkbox.checked = selectAllCheckbox.checked;
        });
    }

    // Update Header Badges
    function updateHeaderBadges() {
        setTimeout(() => {
            const totalRows = document.querySelectorAll('#errorlog_table tbody tr').length;
            const unresolvedRows = document.querySelectorAll('#errorlog_table .status-badge').length;

            const totalBadge = document.querySelector('.badge.bg-secondary');
            const unresolvedBadge = document.querySelector('.badge.bg-warning');

            if (totalBadge) totalBadge.textContent = `Total: ${totalRows}`;
            if (unresolvedBadge) unresolvedBadge.textContent = `Unresolved: ${unresolvedRows}`;
        }, 100);
    }

    // Simple Toast Notification
    function showToast(title, message, type) {
        // Create a simple alert if no toast library is available
        const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
        const alertHtml = `
            <div class="alert ${alertClass} alert-dismissible fade show position-fixed"
                 style="top: 20px; right: 20px; z-index: 9999;" role="alert">
                <strong>${title}:</strong> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;
        document.body.insertAdjacentHTML('beforeend', alertHtml);

        // Auto remove after 3 seconds
        setTimeout(() => {
            const alert = document.querySelector('.alert');
            if (alert) alert.remove();
        }, 3000);
    }
</script>

@section Scripts {
    <!-- Required datatable js -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>

    <!-- Responsive examples -->
    <script src="~/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/libs/datatables.net-responsive-bs5/js/responsive.bootstrap5.min.js"></script>

    <!-- Buttons examples -->
    <script src="~/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons-bs5/js/buttons.bootstrap5.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons/js/buttons.colVis.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons/js/buttons.print.min.js"></script>

    <!-- JSZip for Excel export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <!-- PDFMake for PDF export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>

    <script>
        $(document).ready(function () {
            $('#errorlog_table').DataTable({
                pageLength: 50,  // Show more entries by default since this is the full list
                responsive: true,
                scrollX: true,
                autoWidth: false,
                dom: `<"row"<"col-sm-12 col-md-3"l><"col-sm-12 col-md-6 text-center"B><"col-sm-12 col-md-3"f>>
                      <"row"<"col-sm-12"tr>>
                      <"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>`,
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="fas fa-file-excel"></i> Export Excel',
                        className: 'btn btn-success btn-sm me-2',
                        title: 'Error Log Export - ' + new Date().toLocaleDateString(),
                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6] // Exclude checkbox and actions columns
                        }
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="fas fa-file-pdf"></i> Export PDF',
                        className: 'btn btn-danger btn-sm me-2',
                        title: 'Error Log Export',
                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6] // Exclude checkbox and actions columns
                        }
                    },
                    {
                        extend: 'print',
                        text: '<i class="fas fa-print"></i> Print',
                        className: 'btn btn-info btn-sm',
                        exportOptions: {
                            columns: [1, 2, 3, 4, 5, 6] // Exclude checkbox and actions columns
                        }
                    }
                ],
                lengthMenu: [[25, 50, 100, 200, -1], [25, 50, 100, 200, "All"]],
                lengthChange: true,
                ordering: true,
                order: [[1, 'desc']], // Sort by timestamp column descending
                columnDefs: [
                    { orderable: false, targets: 0 }, // Disable sorting for checkbox column
                    { orderable: false, targets: 7 }, // Disable sorting for actions column
                    { width: "40px", targets: 0 },    // Set width for checkbox column
                    { width: "140px", targets: 1 },   // Set width for timestamp
                    { width: "80px", targets: 2 },    // Set width for level
                    { width: "auto", targets: 3 },    // Auto width for message (longest column)
                    { width: "100px", targets: 4 },   // Set width for user
                    { width: "150px", targets: 5 },   // Set width for path
                    { width: "80px", targets: 6 },    // Set width for status
                    { width: "100px", targets: 7 }    // Set width for actions
                ],
                language: {
                    search: "Search errors:",
                    lengthMenu: "Show _MENU_ errors per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ errors",
                    infoEmpty: "Showing 0 to 0 of 0 errors",
                    infoFiltered: "(filtered from _MAX_ total errors)",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                },
                // Add search highlighting
                searchHighlight: true,
                // Add state saving to remember user preferences
                stateSave: true,
                stateDuration: 60 * 60 * 24 // Save state for 24 hours
            });

            // Custom search for level badges
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                // If we're not on the errorlog_table, don't filter
                if (settings.nTable.id !== 'errorlog_table') {
                    return true;
                }

                // This allows normal search to work on all columns including badge text
                return true;
            });
        });
    </script>
}