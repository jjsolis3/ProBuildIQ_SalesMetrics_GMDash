@using SalesMetrics.Models.ViewModels
@using Newtonsoft.Json

@{
    ViewBag.Title = "Executive Dashboard";
    ViewBag.pTitle = "Sales Metrics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
<style>
    .daily-task-card {
    animation: fadeIn 0.3s ease-in;
    }

    .bg-orange {
    background-color: darkorange;
    }

    .kpi-tile {
    height: 100%;
    min-height: 60px;
    transition: all 0.3s ease-in-out;
    }

    .kpi-label {
    font-size: clamp(0.8rem, 1.1vw, 1.8rem);
    font-weight: 300;
    opacity: 0.9;
    }

    .kpi-value {
    font-size: clamp(1.0rem, 1.8vw, 1.5rem);
    font-weight: 500;
    line-height: 0.5;
    word-break: break-word;
    color: black;
    }

</style>
}

<!-- SELECT OFFICE DROP-DOWN -->
<div class="col-xl-3 col-md-3 col-sm-12 justify-content-center align-items-start">
    <div class="card shadow p-2">
        <form method="get" asp-controller="GM" asp-action="Index" class="mb-3">
            <label for="locationId" class="form-label">Select Seamless Branch:</label>
            <select id="locationId" name="locationId" class="form-select" onchange="this.form.submit()">
                <option value="0" selected="@(ViewBag.SelectedLocationsId == 0)">All Branches</option>
                <option value="1" selected="@(ViewBag.SelectedLocationId == 1)">LAX</option>
                <option value="2" selected="@(ViewBag.SelectedLocationId == 2)">LSV</option>
                <option value="3" selected="@(ViewBag.SelectedLocationId == 3)">CHN</option>
                <option value="4" selected="@(ViewBag.SelectedLocationId == 4)">PHX</option>
                <option value="5" selected="@(ViewBag.SelectedLocationId == 5)">SND</option>
            </select>
        </form>
    </div>
</div>
<!-- KPI TOP BUBBLES -->
<div class="row">
    <!-- SALES DATA -->
    <div class="col-xl-3 col-md-3 col-sm-12 ">
        <div class="card shadow mb-3">
            <div class="card-header">
                <h5 class="mb-0">
                    @(string.IsNullOrEmpty(ViewBag.LocationFullName as string) ? "MTD All Branches" : $"MTD for {ViewBag.LocationFullName}")
                    <span class="badge bg-info ms-2">@ViewBag.MTDStartDateRange</span>
                </h5>
            </div>
            <div class="card-body table-responsive p-2">
                <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                    <h6 class="kpi-value" style="margin: 0 auto;">$ @ViewBag.MTDSales</h6>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-3 col-sm-12">
        <div class="card shadow mb-3">
            <div class="card-header">
                <h5 class="mb-0">
                    @(string.IsNullOrEmpty(ViewBag.LocationFullName as string) ? "YTD All Branches" : $"YTD for {ViewBag.LocationFullName}")
                    <span class="badge bg-info ms-2">@ViewBag.YTDStartDateRange</span>
                </h5>
            </div>
            <div class="card-body table-responsive p-2">
                <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                    <h6 class="kpi-value" style="margin: 0 auto;">$ @ViewBag.YTDSales</h6>
                </div>
            </div>
        </div>
    </div>
    <!-- ONLINE ORDERING KPI -->
    @{
        var onlineOrders = (List<SalesMetrics.Models.ViewModels.GMOnlineOrders>)Model.OnlineOrders;
        var totalOrdersCount = onlineOrders.Sum(x => x.TotalOrders);
        var onlineOrdersCount = onlineOrders.Sum(x => x.OnlineOrders);
        var totalAmount = onlineOrders.Sum(x => x.TotalOrdersAmount);
        var onlineAmount = onlineOrders.Sum(x => x.OnlineOrdersAmount);
    }
    <div class="col-xl-3 col-md-3 col-sm-12">
        <div class="card shadow mb-3">
            <div class="card-header">
                <h5 class="mb-0">
                    Online Orders
                    @(string.IsNullOrEmpty(ViewBag.LocationFullName as string) ? " | All Branches" : $" for {ViewBag.LocationFullName}")
                </h5>
            </div>
            <div class="card-body table-responsive p-2 mt-2">
                <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                    <h5 class="kpi-value" style="margin: 0 auto;">@onlineAmount.ToString("C") <span class="badge bg-primary ms-2">ONLINE</span></h5>
                    <p style="margin: 8px auto;">(of @totalAmount.ToString("C") in total orders)</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-3 col-sm-12">
        <div class="card shadow mb-3">
            <div class="card-header">
                <h5 class="mb-0">
                    Online Orders
                    @(string.IsNullOrEmpty(ViewBag.LocationFullName as string) ? " | All Branches" : $" for {ViewBag.LocationFullName}")
                </h5>
            </div>            
            <div class="card-body table-responsive p-2">
                <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                    <h5 class="kpi-value" style="margin: 0 auto;">
                        @Model.OnlineOrderPercentageOverall.ToString("0.0")% of Orders
                    </h5>
                    <p style="margin: 10px auto;">@onlineOrdersCount.ToString("N0") of @totalOrdersCount.ToString("N0") orders placed online)</p>
                </div>
            </div>
        </div>
    </div>
    
</div>

<!-- BEGIN GM DASHBOARD MODULES -->
<div class="row">
    <!-- SALES RANKING BY OFFICE -->
    <div class="col-xl-4 col-md-4 col-sm-12">
        <div class="card shadow">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Sales Ranking by Seamless Location</h5>
                </div>
                <table class="table table-bordered table-striped">
                @* <table class="table table-hover table-bordered table-striped dt-responsive nowrap"> *@
                    <thead>
                        <tr>
                            <th>Location</th>
                            <th>MTD</th>
                            <th>YTD</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var branch in Model.GMOfficeSalesRankings)
                        {
                            <tr>
                                <td class="text-center" style="font-weight: bold;">@branch.LocationFullName</td>
                                <td>@branch.MTDSales.ToString("C")</td>
                                <td>@branch.YTDSales.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- AR BREAKDOWN -->
    <div class="col-xl-4 col-md-4 col-sm-12">
        <div class="card shadow">
            <div class="card-header">
                <h5>
                    AR Aging Breakdown
                    @(string.IsNullOrEmpty(ViewBag.LocationFullName as string) ? " | All Branches" : $" for {ViewBag.LocationFullName}")
                </h5>
            </div>
            <div class="card-body table-responsive p-2">
                <canvas id="arChart" width="200" height="200"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Online Ordering by Branch Table -->
    <div class="col-xl-4 col-md-4 col-sm-12">
        <div class="card shadow mb-3">
            <div class="card-header">
                <h5 class="mb-0">Online Ordering by Branch</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Location</th>
                            <th>Online $</th>
                            <th>Online %</th>
                            <th>Total $</th>
                        </tr>
                    </thead>
                    <tbody>
                            @foreach (var item in Model.OnlineOrders)
                            {
                                <tr>
                                    <td><strong>@item.LocationName</strong></td>
                                    <td>@item.OnlineOrdersAmount.ToString("C")</td>
                                    <td>@item.OnlineOrderPercentage.ToString("0.0")%</td>
                                    <td>@item.TotalOrdersAmount.ToString("C")</td>
                                </tr>
                            }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="row">
    

</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

    @{
        var chartData = (List<SalesMetrics.Models.ViewModels.ARChartSlice>)Model.AgingChartData;
    }
    <script>
        const ctx = document.getElementById('arChart').getContext('2d');

        const labels = @Html.Raw(Json.Serialize(chartData.Select(x => x.Label)));
        const data = @Html.Raw(Json.Serialize(chartData.Select(x => x.Value)));

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: ['#7aff4d', '#ffff00', '#ffa500', '#ff8989', '#ff0000']
                }]
            },
            options: {
                plugins: {
                    datalabels: {
                        color: '#000',
                        backgroundColor: 'rgba(249,249,245,0.5)',
                        borderRadius: 4,
                        padding: 3,
                        formatter: function(value, context) {
                            return new Intl.NumberFormat('en-US', {
                                style: 'currency',
                                currency: 'USD',
                                minimumFractionDigits: 0
                            }).format(value);
                        }
                    },
                    tooltip: {
                        enabled: true,
                        callbacks: {
                            label: function(context) {
                                let value = context.raw;
                                let formatted = new Intl.NumberFormat('en-US', {
                                    style: 'currency',
                                    currency: 'USD'
                                }).format(value);
                                return context.label + ': ' + formatted;
                            }
                        }
                    }
                }
            },
            plugins: [ChartDataLabels]
        });
    </script>
}