    <script>
        // SALES DATE CHANGE
        $('#salesRange').change(function () {
            const selected = $(this).val();
            const locationId = $('#locationId').val();

            $.get('/GMDash/GetSalesSummaryTable', { range: selected, locationId: locationId }, function (html) {
                $('#salesSummaryContainer').html(html);

                // ✅ Only grab the correct element
                const newLabel = $('#salesSummaryContainer').find('.sales-range-label').text().replace('Showing:', '').trim();
                $('#salesRangeLabel').text(newLabel);
            });
