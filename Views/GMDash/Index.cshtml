    <script>
        // ### OPEN INVENTORY MODAL ###
        $(document).on('click', '[data-bs-target="#inventoryModal"]', function () {
            const office = $(this).data('office');
            const officeLabel = $(this).text().trim();

            // Update the modal title dynamically
            $('#inventoryModalTitleOffice').text(officeLabel);
            window.currentInventoryOfficeLabel = officeLabel;

            // Show loading text while content is fetched
            $('#inventoryModalBody').html('<p class="text-muted">Loading inventory details...</p>');

            // Fetch modal content
            $.get(`/GMDash/GetInventoryModal?office=${office}`, function (html) {
                $('#inventoryModalBody').html(html);
            });
        });
    </script>

    <script>
        // ##### RTJ MODAL - Load content dynamically #####
        $(document).on('click', '[data-bs-target="#rtjModal"]', function () {
            const location = $(this).data('location');
            const selectedRange = $('#rtjRange').val() || 'mtd';

            // Save to global scope for reuse in DataTable export
            window.currentRTJLocation = location;

            // Update modal title
            $('#rtjModalTitle').text(location);
            $('#rtjModalBody').html('<p class="text-muted">Loading RTJ details...</p>');

            // Fetch and inject modal content
            $.get('/GMDash/GetRTJDetails', { location: location, range: selectedRange }, function (html) {
                $('#rtjModalBody').html(html);

                // Initialize DataTable after content loads
                const $table = $('#rtjModalBody').find('table');
                if ($table.length && !$.fn.DataTable.isDataTable($table)) {
                    $table.DataTable({
                        order: [[0, 'desc']],
                        responsive: true,
                        paging: true,
                        pageLength: 10,
                        lengthMenu: [5, 10, 25, 50, 100],
                        searching: true,
                        dom: `
                            <"top d-flex justify-content-between align-items-center mb-2" lBf>
                            rt
                            <"bottom d-flex justify-content-between align-items-center mt-2"ip>
                        `,
                        buttons: [
                            {
                                extend: 'excelHtml5',
                                text: '<i class="bi bi-file-earmark-excel"></i> Export to Excel',
                                className: 'btn btn-outline-success rounded-pill shadow-sm me-3',
                                title: function () {
                                    return 'RTJ Adjustment Details - ' + (window.currentRTJLocation || 'All Locations');
                                },
                                filename: function () {
                                    const label = window.currentRTJLocation || 'AllLocations';
                                    const date = new Date().toISOString().slice(0, 10);
                                    return `RTJ_${label}_${date}`;
                                }
                            }
                        ]
                    });
                }
            });
        });
    </script>
