<div class="row mt-2">
    <!-- AR BREAKDOWN CHART -->
    <div class="col-xl-5 col-md-5 col-sm-12">
        <div class="card shadow">
            <div class="card-header">
                <h5>
                    AR Aging Breakdown
                    @(string.IsNullOrEmpty(ViewBag.LocationFullName as string) ? " | All Branches" : $" for {ViewBag.LocationFullName}")
                </h5>
            </div>
            <div class="card-body table-responsive p-2">
                <canvas id="arChart" width="150" height="150"></canvas>
            </div>
        </div>
    </div>
    <!-- AR BRACKDOWN TABLE -->
    <div class="col-xl-7">
        <div class="col-sm-12">
            <div class="card shadow">
                <div class="card-header">
                    <h5>AR Aging by Branch</h5>
                </div>
                <div class="card-body table-responsive p-2">
                    <table class="table table-bordered table-striped text-end">
                        <thead class="table-orange-light text-center">
                            <tr>
                                <th class="text-start text-center">Location</th>
                                <th>Under 30</th>
                                <th>30–60</th>
                                <th>60–90</th>
                                <th>90–120</th>
                                <th>Over 120</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                            @foreach (var row in Model.ARBranchBreakdown)
                            {
                                <tr>
                                    <td class="text-start fw-bold">@row.Location</td>
                                    <td>@row.DueUnder30.ToString("C0")</td>
                                    <td>@row.Due30to60.ToString("C0")</td>
                                    <td>@row.Due60to90.ToString("C0")</td>
                                    <td>@row.Due90to120.ToString("C0")</td>
                                    <td>@row.DueOver120.ToString("C0")</td>
                                    <td class="text-center fw-bold">@row.TotalAR.ToString("C0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- INVENTORY SUMMARY BY BRANCH -->
        <div class="col-sm-12">
            <div class="card shadow">
                <div class="card">
                    <div class="card-header">
                        <h5>Inventory Evaluation by Product Class | All Seamless Branches</h5>
                    </div>
                    <div class="card-body table-responsive p-2">
                        @{
                            var officeTotals = new Dictionary<string, decimal>
                        {
                        { "LAX", Model.InventoryByClass.Sum(x => x.LAX_InventoryCost) },
                        { "LSV", Model.InventoryByClass.Sum(x => x.LSV_InventoryCost) },
                        { "CHN", Model.InventoryByClass.Sum(x => x.CHN_InventoryCost) },
                        { "PHX", Model.InventoryByClass.Sum(x => x.PHX_InventoryCost) },
                        { "SND", Model.InventoryByClass.Sum(x => x.SND_InventoryCost) }
                        };
                        }
                        <table class="table table-bordered table-striped text-end">
                            <thead class="table-light text-center">
                                <tr>
                                    <th>Product Class</th>
                                    @foreach (var office in new[] { "LAX", "LSV", "CHN", "PHX", "SND" })
                                    {
                                        var hasData = officeTotals[office] > 0;
                                        <th>
                                            @if (hasData)
                                            {
                                                <a href="#" class="text-decoration-underline text-info fw-bold"
                                                   data-bs-toggle="modal"
                                                   data-bs-target="#inventoryModal"
                                                   data-office="@office">
                                                    @office
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-dark fw-bold">@office</span>
                                            }
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody class="text-center">
                                @foreach (var row in Model.InventoryByClass)
                                {
                                    <tr>
                                        <td class="text-start fw-bold">@row.ProductClass</td>
                                        <td>@row.LAX_InventoryCost.ToString("C")</td>
                                        <td>@row.LSV_InventoryCost.ToString("C")</td>
                                        <td>@row.CHN_InventoryCost.ToString("C")</td>
                                        <td>@row.PHX_InventoryCost.ToString("C")</td>
                                        <td>@row.SND_InventoryCost.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
