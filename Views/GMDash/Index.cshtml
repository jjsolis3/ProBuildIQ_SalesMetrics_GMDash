@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

    @{
        var chartData = Model.ARData != null ? Model.ARData.ChartData : new List<GMARChartSlice>();
    }

    <script>
        // Store Chart.js instance for cleanup
        let arChartInstance = null;

        const ctx = document.getElementById('arChart').getContext('2d');

        const labels = @Html.Raw(Json.Serialize(chartData.Select(x => x.Label)));
        const data = @Html.Raw(Json.Serialize(chartData.Select(x => x.Value)));

        arChartInstance = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: ['#7aff4d', '#ffff00', '#ffa500', '#ff8989', '#ff0000']
                }]
            },
            options: {
                plugins: {
                    datalabels: {
                        color: '#000',
                        backgroundColor: 'rgba(249,249,245,0.5)',
                        borderRadius: 4,
                        padding: 3,
                        formatter: function(value, context) {
                            return new Intl.NumberFormat('en-US', {
                                style: 'currency',
                                currency: 'USD',
                                minimumFractionDigits: 0
                            }).format(value);
                        }
                    },
                    tooltip: {
                        enabled: true,
                        callbacks: {
                            label: function(context) {
                                let value = context.raw;
                                let formatted = new Intl.NumberFormat('en-US', {
                                    style: 'currency',
                                    currency: 'USD'
                                }).format(value);
                                return context.label + ': ' + formatted;
                            }
                        }
                    }
                }
            },
            plugins: [ChartDataLabels]
        });
    </script>

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
