@model SalesMetrics.Models.GMFullDashboardViewModel
@using Newtonsoft.Json

@{
    ViewBag.Title = "GM Executive Dashboard";
    ViewBag.pTitle = "Sales Metrics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <style>
        .daily-task-card {
            animation: fadeIn 0.3s ease-in;
        }

        .bg-orange {
            background-color: darkorange;
        }

        .kpi-tile {
            height: 100%;
            min-height: 60px;
            transition: all 0.3s ease-in-out;
        }

        .kpi-label {
            font-size: clamp(0.8rem, 1.1vw, 1.8rem);
            font-weight: 300;
            opacity: 0.9;
        }

        .kpi-value {
            font-size: clamp(1.0rem, 1.8vw, 1.5rem);
            font-weight: 500;
            line-height: 0.5;
            word-break: break-word;
            color: black;
        }

    </style>
}

@{
    var mtd = Model.BranchSalesMetrics.Sum(x => x.MTDSales);
    var ytd = Model.BranchSalesMetrics.Sum(x => x.YTDSales);
    var totalOrders = Model.BranchSalesMetrics.Sum(x => x.TotalOrders);
    var onlineOrders = Model.BranchSalesMetrics.Sum(x => x.OnlineOrders);
    var totalAmount = Model.BranchSalesMetrics.Sum(x => x.TotalOrderAmount);
    var onlineAmount = Model.BranchSalesMetrics.Sum(x => x.OnlineOrderAmount);
    var onlinePercent = totalOrders > 0 ? (double)onlineOrders / (double)totalOrders * 100 : 0;
}

<!-- SELECT OFFICE DROP-DOWN -->
<div class="col-xl-3 col-md-3 col-sm-12 justify-content-center align-items-start">
    <div class="card shadow p-2">
        <form method="get" asp-controller="GMDash" asp-action="Index" class="mb-3">
            <label for="locationId" class="form-label">Select Seamless Branch:</label>
            <select id="locationId" name="locationId" class="form-select" onchange="this.form.submit()">
                <option value="0" selected="@(ViewBag.SelectedLocationsId == 0)">All Branches</option>
                <option value="1" selected="@(ViewBag.SelectedLocationsId == 1)">LAX</option>
                <option value="2" selected="@(ViewBag.SelectedLocationsId == 2)">LSV</option>
                <option value="3" selected="@(ViewBag.SelectedLocationsId == 3)">CHN</option>
                <option value="4" selected="@(ViewBag.SelectedLocationsId == 4)">PHX</option>
                <option value="5" selected="@(ViewBag.SelectedLocationsId == 5)">SND</option>
            </select>
        </form>
    </div>
</div>

@if (ViewBag.SelectedLocationsId != 0)
{
    <!-- KPI TOP BUBBLES -->
    <div class="row">
        <!-- SALES DATA | MTD -->
        <div class="col-xl-3 col-md-3 col-sm-12">
            <div class="card shadow mb-0">
                <div class="card p-1">
                    <div class="card-header">
                        <h5 class="mb-0">
                            @(ViewBag.SelectedLocationsId == 0 ? "MTD All Branches" : $"MTD for {ViewBag.LocationFullName}")
                            <span class="badge bg-info ms-2">@ViewBag.MTDStartDateRange</span>
                        </h5>
                    </div>
                    <div class="card-body table-responsive p-1 mt-1">
                        <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                            <h5 class="kpi-value" style="margin: 0 auto;">@mtd.ToString("C")</h5>
                            <p style="margin: 0 auto;"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- SALES DATA | YTD -->
        <div class="col-xl-3 col-md-3 col-sm-12">
            <div class="card shadow mb-0">
                <div class="card p-1">
                    <div class="card-header">
                        <h5 class="mb-0">
                            @(ViewBag.SelectedLocationsId == 0 ? "YTD All Branches" : $"YTD for {ViewBag.LocationFullName}")
                            <span class="badge bg-info ms-2">@ViewBag.YTDStartDateRange</span>
                        </h5>
                    </div>
                    <div class="card-body table-responsive p-1 mt-1">
                        <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                            <h5 class="kpi-value" style="margin: 0 auto;">@ytd.ToString("C")</h5>
                            <p style="margin: 0 auto;"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- SALES DATA | ONLINE AMOUNT $ -->
        <div class="col-xl-3 col-md-3 col-sm-12">
            <div class="card shadow mb-0">
                <div class="card p-1">
                    <div class="card-header">
                        <h5 class="mb-0">
                            @(ViewBag.SelectedLocationsId == 0 ? "Online Order | All Branches" : $"Online Orders for {ViewBag.LocationFullName}")
                        </h5>
                    </div>
                    <div class="card-body table-responsive p-1 mt-1">
                        <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                            <h5 class="kpi-value" style="margin: 0 auto;">@onlineAmount.ToString("C")</h5>
                            <p style="margin: 0 auto;"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- SALES DATA | ONLINE PERCENTAGE % -->
        <div class="col-xl-3 col-md-3 col-sm-12">
            <div class="card shadow mb-0">
                <div class="card p-1">
                    <div class="card-header">
                        <h5 class="mb-0">
                            @(ViewBag.SelectedLocationsId == 0 ? "Online % | All Branches" : $"Online % for {ViewBag.LocationFullName}")
                        </h5>
                    </div>
                    <div class="card-body table-responsive p-1 mt-1">
                        <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                            <h5 class="kpi-value" style="margin: 0 auto;">@onlinePercent.ToString("0.0")%</h5>
                            <p style="margin: 0 auto;"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- SALES RANKING BY OFFICE -->
    <div class="row mt-4">
        <!-- SALES RANKING BY OFFICE | MTD / YTD -->
        <div class="col-md-4 col-sm-12">
            <div class="card shadow">
                <div class="card">
                    <div class="card-header">
                        <h5>Sales Ranking by Seamless Branch</h5>
                    </div>
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Location</th>
                                <th>MTD</th>
                                <th>YTD</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BranchSalesMetrics)
                            {
                                <tr>
                                    <td class="text-center" style="font-weight: bold;">@item.LocationFullName</td>
                                    <td>@item.MTDSales.ToString("C")</td>
                                    <td>@item.YTDSales.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- Online Ordering by Branch Table -->
        <div class="col-md-4 col-sm-12">
            <div class="card shadow">
                <div class="card">
                    <div class="card-header">
                        <h5>Online Orders by Seamless Branch</h5>
                    </div>
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Location</th>
                                <th>Online $</th>
                                <th>Online %</th>
                                <th>Total $</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BranchSalesMetrics)
                            {
                                <tr>
                                    <td class="text-center" style="font-weight: bold;">@item.LocationFullName</td>
                                    <td>@item.OnlineOrderAmount.ToString("C")</td>
                                    <td>@item.OnlineOrderPercentage.ToString("0.0")%</td>
                                    <td>@item.TotalOrderAmount.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
<div class="row">
    <!-- AR BREAKDOWN -->
    <div class="col-xl-4 col-md-4 col-sm-12">
        <div class="card shadow">
            <div class="card-header">
                <h5>
                    AR Aging Breakdown
                    @(string.IsNullOrEmpty(ViewBag.LocationFullName as string) ? " | All Branches" : $" for {ViewBag.LocationFullName}")
                </h5>
            </div>
            <div class="card-body table-responsive p-2">
                <canvas id="arChart" width="200" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

    @{
        var chartData = Model.ARData != null ? Model.ARData.ChartData : new List<GMARChartSlice>();
    }

    <script>
        const ctx = document.getElementById('arChart').getContext('2d');

        const labels = @Html.Raw(Json.Serialize(chartData.Select(x => x.Label)));
        const data = @Html.Raw(Json.Serialize(chartData.Select(x => x.Value)));

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: ['#7aff4d', '#ffff00', '#ffa500', '#ff8989', '#ff0000']
                }]
            },
            options: {
                plugins: {
                    datalabels: {
                        color: '#000',
                        backgroundColor: 'rgba(249,249,245,0.5)',
                        borderRadius: 4,
                        padding: 3,
                        formatter: function(value, context) {
                            return new Intl.NumberFormat('en-US', {
                                style: 'currency',
                                currency: 'USD',
                                minimumFractionDigits: 0
                            }).format(value);
                        }
                    },
                    tooltip: {
                        enabled: true,
                        callbacks: {
                            label: function(context) {
                                let value = context.raw;
                                let formatted = new Intl.NumberFormat('en-US', {
                                    style: 'currency',
                                    currency: 'USD'
                                }).format(value);
                                return context.label + ': ' + formatted;
                            }
                        }
                    }
                }
            },
            plugins: [ChartDataLabels]
        });
    </script>
}