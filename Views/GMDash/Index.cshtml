    <!-- Cleanup on page unload -->
    <script>
        window.addEventListener('beforeunload', function() {
            // Cleanup Chart.js instance
            if (typeof arChartInstance !== 'undefined' && arChartInstance) {
                arChartInstance.destroy();
                arChartInstance = null;
            }

            // Cleanup DataTables
            if ($.fn.DataTable.isDataTable('#installerDetailTable')) {
                $('#installerDetailTable').DataTable().destroy();
            }

            // Cleanup DataTables in modals
            $('#rtjModalBody table, #inventoryModalBody table').each(function() {
                if ($.fn.DataTable.isDataTable(this)) {
                    $(this).DataTable().destroy();
                }
            });

            // Cleanup global variables
            window.currentInventoryOfficeLabel = null;
            window.currentRTJLocation = null;
            window.currentInstallerOfficeLabel = null;
        });
    </script>
