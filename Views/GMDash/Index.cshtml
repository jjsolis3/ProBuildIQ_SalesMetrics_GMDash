@model SalesMetrics.Models.GMFullDashboardViewModel
@using Newtonsoft.Json

@{
    ViewBag.Title = "GM Executive Dashboard";
    ViewBag.pTitle = "Sales Metrics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <style>
        .daily-task-card {
            animation: fadeIn 0.3s ease-in;
        }

        .bg-orange {
            background-color: darkorange;
        }

        .kpi-tile {
            height: 100%;
            min-height: 60px;
            transition: all 0.3s ease-in-out;
        }

        .kpi-label {
            font-size: clamp(0.8rem, 1.1vw, 1.8rem);
            font-weight: 300;
            opacity: 0.9;
        }

        .kpi-value {
            font-size: clamp(1.0rem, 1.8vw, 1.5rem);
            font-weight: 500;
            line-height: 0.5;
            word-break: break-word;
            color: black;
        }

        .table-orange-light {
            background-color: #ffd1bc !important;
        }

        .header-orange-subtle {
            background-color: #ffd1bc;
        }

        .header-sf-orange {
            background-color: #ff6720;
            color: white;
        }

        .header-blue {
            background-color: #d9edf7;
        }

        .header-yellow {
            background-color: #fcf8e3;
        }

        #installerRange:hover {
            border-color: var(--bs-orange);
            background-color: #fff3e0;
        }

    </style>
}

@{
    var mtd = Model.BranchSalesMetrics.Sum(x => x.MTDSales);
    var ytd = Model.BranchSalesMetrics.Sum(x => x.YTDSales);
    var totalOrders = Model.BranchSalesMetrics.Sum(x => x.TotalOrders);
    var onlineOrders = Model.BranchSalesMetrics.Sum(x => x.OnlineOrders);
    var totalAmount = Model.BranchSalesMetrics.Sum(x => x.TotalOrderAmount);
    var onlineAmount = Model.BranchSalesMetrics.Sum(x => x.OnlineOrderAmount);
    var onlinePercent = totalOrders > 0 ? (double)onlineOrders / (double)totalOrders * 100 : 0;
}

<!-- SELECT OFFICE DROP-DOWN -->
<div class="col-xl-3 col-md-3 col-sm-12 justify-content-center align-items-start">
    <div class="card shadow p-2">
        <form method="get" asp-controller="GMDash" asp-action="Index" class="mb-3">
            <label for="locationId" class="form-label">Select Seamless Branch:</label>
            <select id="locationId" name="locationId" class="form-select" onchange="this.form.submit()">
                <option value="0" selected="@(ViewBag.SelectedLocationsId == 0)">All Branches</option>
                <option value="1" selected="@(ViewBag.SelectedLocationsId == 1)">LAX</option>
                <option value="2" selected="@(ViewBag.SelectedLocationsId == 2)">LSV</option>
                <option value="3" selected="@(ViewBag.SelectedLocationsId == 3)">CHN</option>
                <option value="4" selected="@(ViewBag.SelectedLocationsId == 4)">PHX</option>
                <option value="5" selected="@(ViewBag.SelectedLocationsId == 5)">SND</option>
            </select>
        </form>
    </div>
</div>


<!-- KPI TOP BUBBLES -->
<div class="row">
    <!-- SALES DATA | MTD -->
    <div class="col-xl-3 col-md-3 col-sm-6">
        <div class="card shadow">
            <div class="card p-1">
                <div class="card-header">
                    <h5 class="mb-0">
                        @(ViewBag.SelectedLocationsId == 0 ? "MTD All Branches" : $"MTD for {ViewBag.LocationFullName}")
                        <span class="badge bg-info ms-2">@ViewBag.MTDStartDateRange</span>
                    </h5>
                </div>
                <div class="card-body table-responsive p-1 mt-1">
                    <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                        <h5 class="kpi-value" style="margin: 0 auto;">@mtd.ToString("C")</h5>
                        <p style="margin: 0 auto;"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- SALES DATA | YTD -->
    <div class="col-xl-3 col-md-3 col-sm-6">
        <div class="card shadow">
            <div class="card p-1">
                <div class="card-header">
                    <h5 class="mb-0">
                        @(ViewBag.SelectedLocationsId == 0 ? "YTD All Branches" : $"YTD for {ViewBag.LocationFullName}")
                        <span class="badge bg-info ms-2">@ViewBag.YTDStartDateRange</span>
                    </h5>
                </div>
                <div class="card-body table-responsive p-1 mt-1">
                    <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                        <h5 class="kpi-value" style="margin: 0 auto;">@ytd.ToString("C")</h5>
                        <p style="margin: 0 auto;"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- SALES DATA | ONLINE AMOUNT $ -->
    <div class="col-xl-3 col-md-3 col-sm-6">
        <div class="card shadow">
            <div class="card p-1">
                <div class="card-header">
                    <h5 class="mb-0">
                        @(ViewBag.SelectedLocationsId == 0 ? "Online Order | All Branches" : $"Online Orders for {ViewBag.LocationFullName}")
                    </h5>
                </div>
                <div class="card-body table-responsive p-1 mt-1">
                    <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                        <h5 class="kpi-value" style="margin: 0 auto;">@onlineAmount.ToString("C")</h5>
                        <p style="margin: 0 auto;"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- SALES DATA | ONLINE PERCENTAGE % -->
    <div class="col-xl-3 col-md-3 col-sm-6">
        <div class="card shadow">
            <div class="card p-1">
                <div class="card-header">
                    <h5 class="mb-0">
                        @(ViewBag.SelectedLocationsId == 0 ? "Online % | All Branches" : $"Online % for {ViewBag.LocationFullName}")
                    </h5>
                </div>
                <div class="card-body table-responsive p-1 mt-1">
                    <div class="kpi-tile shadow-lg rounded p-0 d-flex flex-column justify-content-center align-items-start">
                        <h5 class="kpi-value" style="margin: 0 auto;">@onlinePercent.ToString("0.0")%</h5>
                        <p style="margin: 0 auto;"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.SelectedLocationsId == 0)
{
    <!-- SALES RANKING BY OFFICE -->
    <div class="row" >
        <!-- SALES RANKING BY OFFICE | MTD / YTD -->
        <div class="col-md-6 col-sm-12">
            <div class="card shadow">
                <div class="card">
                    <div class="card-header">
                        <h5>Sales Ranking by Seamless Branch</h5>
                    </div>
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Location</th>
                                <th>MTD</th>
                                <th>YTD</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BranchSalesMetrics)
                            {
                                <tr>
                                    <td class="text-center" style="font-weight: bold;">@item.LocationFullName</td>
                                    <td>@item.MTDSales.ToString("C")</td>
                                    <td>@item.YTDSales.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- Online Ordering by Branch Table -->
        <div class="col-md-6 col-sm-12">
            <div class="card shadow">
                <div class="card">
                    <div class="card-header">
                        <h5>Online Orders by Seamless Branch</h5>
                    </div>
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Location</th>
                                <th>Online $</th>
                                <th>Online %</th>
                                <th>Total $</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BranchSalesMetrics)
                            {
                                <tr>
                                    <td class="text-center" style="font-weight: bold;">@item.LocationFullName</td>
                                    <td>@item.OnlineOrderAmount.ToString("C")</td>
                                    <td>@item.OnlineOrderPercentage.ToString("0.0")%</td>
                                    <td>@item.TotalOrderAmount.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<div class="row mt-2">
    <!-- AR BREAKDOWN CHART -->
    <div class="col-xl-5 col-md-5 col-sm-12">
        <div class="card shadow">
            <div class="card-header">
                <h5>
                    AR Aging Breakdown
                    @(string.IsNullOrEmpty(ViewBag.LocationFullName as string) ? " | All Branches" : $" for {ViewBag.LocationFullName}")
                </h5>
            </div>
            <div class="card-body table-responsive p-2">
                <canvas id="arChart" width="150" height="150"></canvas>
            </div>
        </div>
    </div>
    <!-- AR BRACKDOWN TABLE -->
    <div class="col-xl-7">
        <div class="col-sm-12">
            <div class="card shadow">
                <div class="card-header">
                    <h5>AR Aging by Branch</h5>
                </div>
                <div class="card-body table-responsive p-2">
                    <table class="table table-bordered table-striped text-end">
                        <thead class="table-orange-light text-center">
                            <tr>
                                <th class="text-start text-center">Location</th>
                                <th>Under 30</th>
                                <th>30–60</th>
                                <th>60–90</th>
                                <th>90–120</th>
                                <th>Over 120</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody class="text-center">
                            @foreach (var row in Model.ARBranchBreakdown)
                            {
                                <tr>
                                    <td class="text-start fw-bold">@row.Location</td>
                                    <td>@row.DueUnder30.ToString("C0")</td>
                                    <td>@row.Due30to60.ToString("C0")</td>
                                    <td>@row.Due60to90.ToString("C0")</td>
                                    <td>@row.Due90to120.ToString("C0")</td>
                                    <td>@row.DueOver120.ToString("C0")</td>
                                    <td class="text-center fw-bold">@row.TotalAR.ToString("C0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- INVENTORY SUMMARY BY BRANCH -->
        <div class="col-sm-12">
            <div class="card shadow">
                <div class="card">
                    <div class="card-header">
                        <h5>Inventory Evaluation by Product Class | All Seamless Branches</h5>
                    </div>
                    <div class="card-body table-responsive p-2">
                        <table class="table table-bordered table-striped text-end">
                            <thead class="table-light text-center">
                                <tr>
                                    <th>Product Class</th>
                                    <th>LAX</th>
                                    <th>LSV</th>
                                    <th>CHN</th>
                                    <th>PHX</th>
                                    <th>SND</th>
                                </tr>
                            </thead>
                            <tbody class="text-center">
                                @foreach (var row in Model.InventoryByClass)
                                {
                                    <tr>
                                        <td class="text-start fw-bold">@row.ProductClass</td>
                                        <td>@row.LAX_InventoryCost.ToString("C")</td>
                                        <td>@row.LSV_InventoryCost.ToString("C")</td>
                                        <td>@row.CHN_InventoryCost.ToString("C")</td>
                                        <td>@row.PHX_InventoryCost.ToString("C")</td>
                                        <td>@row.SND_InventoryCost.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row mt-2 align-items-baseline">
    <!-- INSTALLER ACTIVITY BREAKDOWN -->
    <div class="col-6">
        <div class="card shadow mt-4">
            <div class="card-header">

                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-5">
                    <h5 class="mb-0 text-nowrap">
                        Installer Completion Rate by Branch
                    </h5>

                    <div class="input-group input-group-sm w-auto gap-2">
                        <label class="input-group-text text-dark " for="installerRange">
                            Date Range
                        </label>
                        <select id="installerRange" class="form-select border-secondary shadow-sm rounded-pill"
                                style="min-width: 140px;">
                            <option value="week" selected="@(ViewBag.InstallerRange == "week")">This Week</option>
                            <option value="lastweek" selected="@(ViewBag.InstallerRange == "lastweek")">Last Week</option>
                            <option value="mtd" selected="@(ViewBag.InstallerRange == "mtd")">MTD</option>
                            <option value="lastmonth" selected="@(ViewBag.InstallerRange == "lastmonth")">Last Month</option>
                            <option value="lastquarter" selected="@(ViewBag.InstallerRange == "lastquarter")">Last Quarter</option>
                            <option value="ytd" selected="@(ViewBag.InstallerRange == "ytd")">YTD</option>
                        </select>
                    </div>
                </div>


            </div>
            <div class="card-body table-responsive p-2">

                <div id="installerTableContainer">
                    @await Html.PartialAsync("~/Views/GMDash/_InstallerTablePartial.cshtml", Model.InstallerCompletionMetrics)
                </div>

            </div>
        </div>
    </div>
    <!-- RECENT RTJ ACTIVITY -->
    <div class="col-6">
        <div class="card shadow mt-4">
            <div class="card-header">
                <h5>Recent Inventory Adjustments (RTJ)</h5>
            </div>
            <div class="card-body table-responsive p-2">
                @{var groupedRTJs = Model.RecentRTJs
                        .GroupBy(r => r.Location)
                        .Select(g => new
                        {
                            Location = g.Key,
                            Count = g.Count(),
                            TotalDebit = g.Sum(x => x.Debit),
                            TotalCredit = g.Sum(x => x.Credit),
                            Entries = g.ToList()
                        }).ToList();
                }
                <table class="table table-bordered table-striped" id="rtjTable">
                    <thead class="table-light text-center">
                        <tr>
                            <th class="header-orange-subtle">Location</th>
                            <th class="header-orange-subtle"># Entries</th>
                            <th class="header-orange-subtle">Total Debit</th>
                            <th class="header-orange-subtle">Total Credit</th>
                            <th class="header-orange-subtle">Details</th>
                        </tr>
                    </thead>
                    <tbody class="text-center">
                        @foreach (var group in groupedRTJs)
                        {
                            <tr>
                                <td class="text-start text-center fw-bold">@group.Location</td>
                                <td>@group.Count</td>
                                <td>@group.TotalDebit.ToString("C")</td>
                                <td>@group.TotalCredit.ToString("C")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#rtjModal_@group.Location">
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ## MODAL SECTION -->
@await Html.PartialAsync("_RTJModalPartial", Model.RecentRTJs)

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels"></script>

    @{
        var chartData = Model.ARData != null ? Model.ARData.ChartData : new List<GMARChartSlice>();
    }

    <script>
        const ctx = document.getElementById('arChart').getContext('2d');

        const labels = @Html.Raw(Json.Serialize(chartData.Select(x => x.Label)));
        const data = @Html.Raw(Json.Serialize(chartData.Select(x => x.Value)));

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: ['#7aff4d', '#ffff00', '#ffa500', '#ff8989', '#ff0000']
                }]
            },
            options: {
                plugins: {
                    datalabels: {
                        color: '#000',
                        backgroundColor: 'rgba(249,249,245,0.5)',
                        borderRadius: 4,
                        padding: 3,
                        formatter: function(value, context) {
                            return new Intl.NumberFormat('en-US', {
                                style: 'currency',
                                currency: 'USD',
                                minimumFractionDigits: 0
                            }).format(value);
                        }
                    },
                    tooltip: {
                        enabled: true,
                        callbacks: {
                            label: function(context) {
                                let value = context.raw;
                                let formatted = new Intl.NumberFormat('en-US', {
                                    style: 'currency',
                                    currency: 'USD'
                                }).format(value);
                                return context.label + ': ' + formatted;
                            }
                        }
                    }
                }
            },
            plugins: [ChartDataLabels]
        });
    </script>

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />

    <script>
        $(document).ready(function ()
        {
            // When a modal opens, initialize DataTable inside it (once)
            $('[id^=rtjModal_]').on('shown.bs.modal', function ()
            {
                const tableId = $(this).find("table").attr("id");
                const table = $("#" + tableId);

                if (!$.fn.DataTable.isDataTable(table))
                {
                    table.DataTable({
                        order: [[0, 'desc']],
                        responsive: true,
                        paging: true,
                        pageLength: 10,
                        lengthMenu: [5, 10, 25, 50, 100],
                        searching: true,
                        dom: `
                            <"top d-flex justify-content-between align-items-center mb-2" lBf>
                            rt
                            <"bottom d-flex justify-content-between align-items-center mt-2"ip>
                        `,
                        buttons: [
                            {
                                extend: 'excelHtml5',
                                text: '<i class="bi bi-file-earmark-excel"></i> Export to Excel',
                                className: 'btn btn-outline-success rounded-pill shadow-sm me-3',
                                title: 'RTJ Adjustment Details',
                                exportOptions: {
                                    format: {
                                        body: function (data, row, column, node)
                                        {
                                            if (column === 6)
                                            {
                                                const $select = $('<div>' + data + '</div>').find('select');
                                                return $select.length ? $select.find('option:selected').text() : data;
                                            }
                                            return $('<div>').html(data).text();
                                        }
                                    }
                                }
                            }
                        ] // <-- CLOSE buttons array
                    }); // <-- CLOSE DataTable()
                }
            });
        });
    </script>

      
    <script>
        $(document).ready(function () {
            $('#installerRange').change(function () {
                var selected = $(this).val();

                $.get('/GMDash/GetInstallerTable', { range: selected }, function (html) {
                    $('#installerTableContainer').html(html);
                });
            });
        });
    </script>
}