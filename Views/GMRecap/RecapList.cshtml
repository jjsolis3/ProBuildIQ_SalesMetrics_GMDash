@model List<SalesMetrics.Models.GMRecapCardViewModel>
@using SalesMetrics.Models

@{
    ViewBag.Title = "GM Weekly Recap Dashboard";
    var currentUser = User.FindFirst("Users_ID")?.Value;
    var isAdmin = User.IsInRole("Admin") || User.FindFirst("RoleId")?.Value == "1";

    // Use centralized field definitions - SINGLE SOURCE OF TRUTH
    var recapFields = GMRecapFieldDefinitions.AllFields;
    var totalFields = GMRecapFieldDefinitions.TotalFieldCount;
}

@section styles {
    <style>
        /* Company brand colors matching RecapEntry page */
        .dashboard-header {
            background: linear-gradient(135deg, #ff6720 0%, #ff8c42 50%, #ffb366 100%);
            color: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(255, 103, 32, 0.3);
        }

            .dashboard-header h3 {
                margin: 0;
                font-weight: bold;
            }

            .dashboard-header p {
                margin: 8px 0 0 0;
                opacity: 0.9;
            }

        .stats-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
            border-left: 4px solid #ff6720;
            transition: all 0.3s ease;
            margin-bottom: 20px;
        }

            .stats-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 20px rgba(255, 103, 32, 0.2);
            }

            .stats-card h5 {
                color: #2f363D;
                margin-bottom: 10px;
                font-weight: 600;
            }

            .stats-card h2 {
                margin: 0;
                font-weight: bold;
            }

        .stats-primary {
            color: #ff6720 !important;
        }

        .stats-success {
            color: #28a745 !important;
        }

        .stats-info {
            color: #17a2b8 !important;
        }

        .stats-warning {
            color: #ffc107 !important;
        }

        .filter-section {
            background: linear-gradient(135deg, #f8f9fa 0%, #fff5f1 100%);
            border: 2px solid #ff6720;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 2px 8px rgba(255, 103, 32, 0.1);
        }

            .filter-section label {
                color: #2f363D;
                font-weight: 600;
                margin-bottom: 8px;
            }

        .form-select:focus {
            border-color: #ff6720;
            box-shadow: 0 0 0 0.2rem rgba(255, 103, 32, 0.25);
        }

        .week-section {
            margin-bottom: 35px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
            overflow: hidden;
            border: 1px solid #e9ecef;
        }

        .week-header {
            background: linear-gradient(135deg, #2f363D 0%, #7C878E 100%);
            color: white;
            padding: 18px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .week-header h5 {
                margin: 0;
                font-weight: bold;
            }

            .week-header small {
                opacity: 0.9;
            }

        .week-stats-badge {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 600;
        }

        .recap-card {
            border: none;
            border-radius: 12px;
            margin: 20px;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

            .recap-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(255, 103, 32, 0.2);
            }

            .recap-card.my-entry {
                border: 2px solid #ffc107;
                box-shadow: 0 3px 12px rgba(255, 193, 7, 0.3);
            }

                .recap-card.my-entry::before {
                    content: "Your Entry";
                    position: absolute;
                    top: 10px;
                    right: 10px;
                    background: #ffc107;
                    color: white;
                    padding: 4px 8px;
                    border-radius: 12px;
                    font-size: 0.75em;
                    font-weight: bold;
                    z-index: 2;
                }

        .recap-card-header {
            background: linear-gradient(135deg, #ff6720 0%, #ff8c42 100%);
            color: white;
            padding: 15px 20px;
            position: relative;
        }

            .recap-card-header h6 {
                margin: 0;
                font-weight: bold;
                font-size: 1.1em;
            }

            .recap-card-header .entry-count {
                font-size: 0.9em;
                opacity: 0.9;
            }

        .completion-indicator {
            position: absolute;
            top: 12px;
            right: 15px;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 0.85em;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .completion-high {
            background: rgba(40, 167, 69, 0.9);
            color: white;
        }

        .completion-medium {
            background: rgba(255, 193, 7, 0.9);
            color: white;
        }

        .completion-low {
            background: rgba(220, 53, 69, 0.9);
            color: white;
        }

        .recap-card-body {
            padding: 20px;
            background: white;
        }

        .field-summary {
            background: #f8f9fa;
            padding: 12px;
            border-radius: 8px;
            margin-top: 12px;
            border-left: 3px solid #ff6720;
        }

        .field-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: 12px;
        }

        .field-tag {
            background: linear-gradient(135deg, #ff6720 0%, #ff8c42 100%);
            color: white;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.75em;
            font-weight: 600;
        }

        .details-panel {
            background: white;
            border-radius: 15px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.1);
            padding: 25px;
            position: sticky;
            top: 20px; /* Reduced from 100px for better visibility */
            border: 1px solid #e9ecef;
            max-height: calc(100vh - 40px); /* Full viewport height minus small margin */
            overflow-y: auto; /* Enable vertical scrolling within the panel */
            overflow-x: hidden; /* Prevent horizontal scroll */
            align-self: flex-start; /* Important: Allows sticky to work in flexbox */
        }

            /* Custom scrollbar styling for details panel */
            .details-panel::-webkit-scrollbar {
                width: 8px;
            }

            .details-panel::-webkit-scrollbar-track {
                background: #f1f1f1;
                border-radius: 10px;
            }

            .details-panel::-webkit-scrollbar-thumb {
                background: #ff6720;
                border-radius: 10px;
            }

            .details-panel::-webkit-scrollbar-thumb:hover {
                background: #ff8c42;
            }

            .details-panel h4 {
                color: #2f363D;
                margin-bottom: 20px;
                padding-bottom: 10px;
                border-bottom: 2px solid #ff6720;
                position: sticky;
                top: -25px; /* Stick to top of panel when scrolling */
                background: white;
                z-index: 10;
                margin-top: -25px; /* Offset parent padding */
                padding-top: 25px; /* Add back padding for spacing */
            }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #7C878E;
        }

            .empty-state i {
                color: #ff6720;
                margin-bottom: 20px;
            }

        .btn-primary-custom {
            background: linear-gradient(135deg, #ff6720 0%, #ff8c42 100%);
            border: none;
            color: white;
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 3px 12px rgba(255, 103, 32, 0.3);
        }

            .btn-primary-custom:hover {
                background: linear-gradient(135deg, #e55a1c 0%, #ff8c42 100%);
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255, 103, 32, 0.4);
                color: white;
            }

        /* Loading animation */
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #ff6720;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .details-panel {
                position: relative;
                top: auto;
                margin-top: 25px;
                max-height: none; /* Remove height limit on mobile */
                overflow-y: visible; /* Allow natural scrolling on mobile */
            }

            .details-panel h4 {
                position: relative; /* Remove sticky on mobile */
                top: auto;
                margin-top: 0;
                padding-top: 0;
            }

            .dashboard-header {
                text-align: center;
            }

            .recap-card {
                margin: 15px 10px;
            }
        }
    </style>
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h3>🗂️ GM Weekly Recap Dashboard</h3>
            <p>Track and manage weekly recap submissions from all General Managers</p>
        </div>
        <div class="col-md-4 text-md-end">
            <a href="/GMRecap/RecapEntry" class="btn btn-primary btn-lg">
                <i class="fas fa-plus-circle me-2"></i>New Recap Entry
            </a>
        </div>
    </div>
</div>

<!-- Statistics Overview -->
<div class="row mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="stats-card">
            <h5><i class="fas fa-file-alt me-2"></i>Total Entries</h5>
            <h2 class="stats-primary">@Model.Count</h2>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stats-card">
            <h5><i class="fas fa-calendar-week me-2"></i>This Week</h5>
            <h2 class="stats-success">@Model.Count(m => m.WeekStartDate.Date == DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek + 1).Date)</h2>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stats-card">
            <h5><i class="fas fa-users me-2"></i>Active GMs</h5>
            <h2 class="stats-info">@Model.Select(m => m.GMName).Distinct().Count()</h2>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stats-card">
            <h5><i class="fas fa-chart-bar me-2"></i>Avg Fields</h5>
            <h2 class="stats-warning">@(Model.Any() ? Math.Round(Model.Average(m => m.Fields?.Count ?? 0), 1) : 0)</h2>
        </div>
    </div>
</div>

<div class="row">
    <!-- Main Content -->
    <div class="col-xl-8 col-lg-7">
        <!-- Advanced Filters -->
        <div class="filter-section">
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label"><i class="fas fa-calendar me-2"></i>Filter by Week:</label>
                    <select class="form-select" id="weekFilter">
                        <option value="all">All Weeks</option>
                        @foreach (var week in Model.Select(x => x.WeekStartDate).Distinct().OrderByDescending(d => d))
                        {
                            <option value="@week.ToString("yyyy-MM-dd")">@week.ToString("MMMM dd, yyyy")</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label"><i class="fas fa-user me-2"></i>Filter by GM:</label>
                    <select class="form-select" id="gmFilter">
                        <option value="all">All GMs</option>
                        @foreach (var gm in Model.Select(x => x.GMName).Distinct().OrderBy(n => n))
                        {
                            <option value="@gm">@gm</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Recap Entries by Week -->
        @foreach (var weekGroup in Model.GroupBy(x => x.WeekStartDate).OrderByDescending(g => g.Key))
        {
            var weekStats = weekGroup.ToList();
            var avgCompletion = weekStats.Average(w => (double)(w.Fields?.Count ?? 0)) / totalFields * 100; // Dynamic field count

            <div class="week-section week-group" data-week="@weekGroup.Key.ToString("yyyy-MM-dd")">
                <div class="week-header">
                    <div>
                        <h5 class="text-white"><i class="fas fa-calendar-week me-2"></i>Week of @weekGroup.Key.ToString("MMMM dd, yyyy")</h5>
                        <small><i class="fas fa-chart-pie me-1"></i>@weekStats.Count entries • Avg completion: @Math.Round(avgCompletion, 1)%</small>
                    </div>
                    <div>
                        <span class="week-stats-badge">
                            <i class="fas fa-clipboard-list me-1"></i>@weekStats.Count submissions
                        </span>
                    </div>
                </div>

                <div class="row">
                    @foreach (var entry in weekGroup.OrderBy(e => e.GMName))
                    {
                        var fieldCount = entry.Fields?.Count ?? 0;
                        var completionRate = (double)fieldCount / totalFields * 100; // Dynamic field count
                        var completionClass = completionRate >= 80 ? "completion-high" :
                        completionRate >= 50 ? "completion-medium" : "completion-low";
                        var isMyEntry = currentUser != null && entry.GMUserID.ToString() == currentUser;
                        var uniqueFields = entry.Fields?.GroupBy(f => f.FieldName).Select(g => g.Key).Take(5).ToList() ?? new List<string>();
                        var groupedFieldNames = entry.Fields?.GroupBy(f => f.FieldName).Select(g => g.Key).ToList() ?? new List<string>();
                        var totalUniqueFields = groupedFieldNames.Count;
                        var totalEntries = entry.Fields?.Count ?? 0;

                        <div class="col-lg-6 recap-entry-wrapper" data-gm="@entry.GMName" data-completion="@(completionRate >= 80 ? "high" : completionRate >= 50 ? "medium" : "low")">
                            <div class="card recap-card @(isMyEntry ? "my-entry" : "")" onclick="loadRecapDetails(@entry.RecapID)">
                                <div class="recap-card-header">
                                    <div class="completion-indicator @completionClass">
                                        @Math.Round(completionRate, 0)%
                                    </div>
                                    <h6><i class="fas fa-user-tie me-2"></i>@entry.GMName</h6>
                                    <div class="entry-count">
                                        <i class="fas fa-clipboard-list me-1"></i>@totalEntries field entries
                                    </div>
                                </div>

                                <div class="recap-card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span><strong><i class="fas fa-tasks me-1"></i>Unique Fields:</strong> @totalUniqueFields</span>
                                        <span><strong><i class="fas fa-clock me-1"></i></strong> @entry.CreatedDate.ToString("MMM dd, h:mm tt")</span>
                                    </div>

                                    @if (uniqueFields.Any())
                                    {
                                        <div class="field-summary">
                                            <small class="text-muted d-block mb-2"><i class="fas fa-list me-1"></i>Field Categories:</small>
                                            <div class="field-tags">
                                                @foreach (var field in uniqueFields)
                                                {
                                                    <span class="field-tag">@field</span>
                                                }
                                                @if (totalUniqueFields > 5)
                                                {
                                                    <span class="field-tag">+@(totalUniqueFields - 5) more</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <div class="mt-3 text-center">
                                        <small class="text-muted">
                                            <i class="fas fa-mouse-pointer me-1"></i>Click to view details →
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-inbox fa-4x mb-3"></i>
                <h4>📭 No Recap Entries Found</h4>
                <p class="text-muted mb-4">Be the first to submit a weekly recap!</p>
                <a href="/GMRecap/RecapEntry" class="btn btn-primary-custom">
                    <i class="fas fa-plus-circle me-2"></i>Create First Entry
                </a>
            </div>
        }
    </div>

    <!-- Details Panel -->
    <div class="col-xl-4 col-lg-5">
        <div class="details-panel">
            <h4><i class="fas fa-search me-2"></i>Recap Details</h4>
            <div id="recap-details" style="min-height: 350px;">
                <div class="text-center text-muted py-5">
                    <i class="fas fa-mouse-pointer fa-3x mb-3" style="color: #ff6720;"></i>
                    <h5 style="color: #7C878E;">Select a Recap Entry</h5>
                    <p>Click on any recap card to view detailed information and manage entries.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Enhanced filtering functionality
        document.addEventListener('DOMContentLoaded', function() {
            const weekFilter = document.getElementById('weekFilter');
            const gmFilter = document.getElementById('gmFilter');

            function applyFilters() {
                const selectedWeek = weekFilter.value;
                const selectedGM = gmFilter.value;

                document.querySelectorAll('.week-group').forEach(weekSection => {
                    const weekValue = weekSection.getAttribute('data-week');
                    let weekVisible = selectedWeek === 'all' || weekValue === selectedWeek;

                    if (weekVisible) {
                        let hasVisibleEntries = false;

                        weekSection.querySelectorAll('.recap-entry-wrapper').forEach(entry => {
                            const gmName = entry.getAttribute('data-gm');
                            const gmMatch = selectedGM === 'all' || gmName === selectedGM;

                            entry.style.display = gmMatch ? 'block' : 'none';
                            if (gmMatch) hasVisibleEntries = true;
                        });

                        weekSection.style.display = hasVisibleEntries ? 'block' : 'none';
                    } else {
                        weekSection.style.display = 'none';
                    }
                });

                // Add animation effect
                document.querySelectorAll('.recap-card').forEach((card, index) => {
                    if (card.parentElement.style.display !== 'none') {
                        card.style.animationDelay = (index * 0.1) + 's';
                        card.style.animation = 'fadeInUp 0.5s ease forwards';
                    }
                });
            }

            // Add event listeners
            [weekFilter, gmFilter].forEach(filter => {
                filter.addEventListener('change', applyFilters);
            });
        });

        function loadRecapDetails(recapId) {
            // Show loading state with company colors
            document.getElementById("recap-details").innerHTML =
                '<div class="text-center py-4">' +
                    '<div class="loading-spinner mb-3"></div>' +
                    '<h5 style="color: #ff6720;">Loading Recap Details...</h5>' +
                    '<p class="text-muted">Please wait while we fetch the information.</p>' +
                '</div>';

            fetch('/GMRecap/GetRecapDetails?recapId=' + recapId)
                .then(res => res.text())
                .then(html => {
                    document.getElementById("recap-details").innerHTML = html;
                })
                .catch(error => {
                    document.getElementById("recap-details").innerHTML =
                        '<div class="alert alert-danger">' +
                            '<h5><i class="fas fa-exclamation-triangle me-2"></i>Error Loading Details</h5>' +
                            '<p>Unable to load recap details. Please try again.</p>' +
                            '<button class="btn btn-primary-custom btn-sm" onclick="loadRecapDetails(' + recapId + ')">' +
                                '<i class="fas fa-redo me-1"></i>Retry' +
                            '</button>' +
                        '</div>';
                });
        }

        function loadEditRecapModal(recapId) {
            fetch('/GMRecap/EditRecapModal?recapId=' + recapId)
                .then(res => res.text())
                .then(html => {
                    const modalContainer = document.createElement("div");
                    modalContainer.innerHTML = html;
                    document.body.appendChild(modalContainer);
                    const modal = new bootstrap.Modal(modalContainer.querySelector("#editRecapModal"));
                    modal.show();

                    modalContainer.addEventListener("hidden.bs.modal", () => {
                        modal.dispose();
                        modalContainer.remove();
                    });
                });
        }
    </script>
}