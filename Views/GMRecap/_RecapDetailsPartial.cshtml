@model SalesMetrics.Models.GMRecapCardViewModel

<div class="card">
    <div class="card-header bg-primary text-white">
        <div class="d-flex justify-content-between align-items-center">
            <span><strong>📅 Week of:</strong> @Model.WeekStartDate.ToString("MMMM dd, yyyy")</span>
            <span><strong>👤</strong> @Model.GMName</span>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Fields != null && Model.Fields.Count > 0)
        {
            @foreach (var group in Model.Fields.GroupBy(f => f.FieldName))
            {
                <div class="mb-3">
                    <h5 class="text-primary">@group.Key</h5>
                    <ul class="list-group">
                        @foreach (var entry in group.OrderByDescending(f => f.CreatedDate))
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@entry.FieldValue</span>
                                <small class="text-muted">@entry.CreatedDate.ToString("MMM dd, yyyy hh:mm tt")</small>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No fields submitted for this recap.</p>
        }

        <div class="mt-3 d-flex justify-content-between">
            <button class="btn btn-warning" type="button" onclick="loadEditRecapModal(@Model.RecapID)">✏️ Edit</button>

            <form asp-action="DeleteRecap" asp-controller="GMRecap" method="post" onsubmit="return confirm('Are you sure you want to delete this recap entry?');">
                <input type="hidden" name="recapId" value="@Model.RecapID" />
                <button type="submit" class="btn btn-danger">🗑️ Delete</button>
            </form>
        </div>
    </div>
</div>
