@model List<SalesMetrics.Models.Journal.JournalEntry>
@using SalesMetrics.Models

@{
    ViewData["Title"] = "My Journal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@await Html.PartialAsync("_CreateModal", new SalesMetrics.Models.Journal.JournalEntry { EntryDate = DateTime.Now })


@section styles {
    <style>
        .card-title {
            font-weight: 600;
        }

        .card {
            transition: box-shadow 0.2s ease;
        }

            .card:hover {
                box-shadow: 0 0 0.5rem rgba(0, 0, 0, 0.15);
            }

        .text-orange {
            color: #fd7e14;
        }
    </style>
}

<div id="editJournalModalContainer">
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="text-orange">🗒️ Journal</h2>
            <div class="btn-group mb-3">
                <a asp-action="Index" class="btn btn-outline-secondary @(ViewBag.SelectedCategory == null ? "active" : "")">All</a>
                @foreach (var cat in ViewBag.Categories as List<JournalCategory>)
                {
                    <a asp-action="Index" asp-route-categoryId="@cat.CategoryID"
                       class="btn btn-outline-secondary @(cat.CategoryID == (int?)ViewBag.SelectedCategory ? "active" : "")">
                        @cat.Name
                    </a>
                }
            </div>

            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createJournalModal">+ New Entry</button>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (!Model.Any())
        {
            <p>No journal entries yet.</p>
        }
        else
        {
        <div class="row gy-4">
            @foreach (var entry in Model)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-start border-4 border-primary">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="card-title mb-1">@entry.Title</h5>
                                    <p class="text-muted small mb-2">
                                        <i class="mdi mdi-calendar-clock me-1"></i>
                                        @((entry.EntryDate ?? DateTime.Now).ToString("dddd, MMMM d, yyyy • hh:mm tt"))
                                    </p>
                                    @if (!string.IsNullOrEmpty(entry.CategoryName))
                                    {
                                        <span class="badge @entry.CategoryColor ms-2">@entry.CategoryName</span>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            onclick="loadEditModal(@entry.Journal_ID)">
                                        <i class="mdi mdi-pencil-outline"></i>
                                    </button>
                                    <form asp-action="Delete" method="post" asp-route-id="@entry.Journal_ID"
                                          onsubmit="return confirm('Are you sure?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="mdi mdi-delete-outline"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <p class="card-text mt-2">@entry.NoteText</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        }
    </div>
</div>


@section Scripts {

    <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["Success"]'
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'Task status updated',
                showConfirmButton: false,
                timer: 2000
            });
        </script>
    }

    @if (TempData["Warning"] != null)
    {
        <script>
            Swal.fire({
                icon: 'warning',
                title: 'Notice',
                text: '@TempData["Warning"]'
            });
        </script>
    }

    <script>
        function loadEditModal(entryId) {
            $.get('/Journal/EditModal/' + entryId, function (data) {
                $('#editJournalModalContainer').html(data);
                var modal = new bootstrap.Modal(document.getElementById('editJournalModal'));
                modal.show();
            });
        }
    </script>
}
