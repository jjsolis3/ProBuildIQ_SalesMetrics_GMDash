@model SalesMetrics.Models.Journal.JournalEntry

<div class="modal fade" id="editJournalModal" tabindex="-1" aria-labelledby="editJournalModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Edit" method="post">
                <div class="modal-header bg-orange">
                    <h5 class="modal-title text-white" id="editJournalModalLabel">Edit Journal Entry</h5>
                    <button type="button" class="btn-close bg-light-subtle" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Journal_ID" />
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Title</label>
                        <input asp-for="Title" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NoteText" class="form-label">Note</label>
                        <textarea asp-for="NoteText" class="form-control" rows="5"></textarea>
                    </div>
                    @* <div class="mb-3">
                        <label asp-for="EntryDate" class="form-label">Date</label>
                        <input asp-for="EntryDate" type="datetime-local" class="form-control" value="@Model.EntryDate.ToString("yyyy-MM-ddTHH:mm")" />
                    </div> *@
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-orange text-white">Update</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
