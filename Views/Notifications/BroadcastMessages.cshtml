@model List<SalesMetrics.Models.BroadcastMessage>

@{
    ViewData["Title"] = "Broadcast Messages";
    ViewBag.PTitle = "Notifications";
    ViewBag.PLink = "/Notifications";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0"><i class="fas fa-bullhorn me-2"></i>Active Broadcast Messages</h5>
                        <a href="/Notifications/CreateBroadcast" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i> Create New Broadcast
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-inbox text-muted" style="font-size: 4rem;"></i>
                            <p class="text-muted mt-3">No active broadcast messages</p>
                            <a href="/Notifications/CreateBroadcast" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i> Create First Broadcast
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Message</th>
                                        <th>Target</th>
                                        <th>Priority</th>
                                        <th>Created</th>
                                        <th>Expires</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var message in Model)
                                    {
                                        var priorityBadge = message.Priority switch
                                        {
                                            "Urgent" => "bg-danger",
                                            "High" => "bg-warning",
                                            _ => "bg-info"
                                        };

                                        var targetDisplay = message.TargetType switch
                                        {
                                            "AllUsers" => "All Users",
                                            "Location" => $"Location: {message.TargetName}",
                                            "Role" => $"Role: {message.TargetName}",
                                            _ => message.TargetType
                                        };

                                        <tr>
                                            <td>
                                                <strong>@message.Title</strong>
                                            </td>
                                            <td>
                                                <span class="text-truncate d-inline-block" style="max-width: 300px;" title="@message.Message">
                                                    @message.Message
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">@targetDisplay</span>
                                            </td>
                                            <td>
                                                <span class="badge @priorityBadge">@message.Priority</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">@message.CreatedDate.ToString("MMM dd, yyyy hh:mm tt")</small>
                                            </td>
                                            <td>
                                                @if (message.ExpiresDate.HasValue)
                                                {
                                                    <small class="text-muted">@message.ExpiresDate.Value.ToString("MMM dd, yyyy")</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">Never</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
