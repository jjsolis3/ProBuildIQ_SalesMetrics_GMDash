@model SalesMetrics.Models.BroadcastMessageCreateViewModel

@{
    ViewData["Title"] = "Create Broadcast Message";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <h4 class="page-title">Create Broadcast Message</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="/Notifications/BroadcastMessages">Broadcast Messages</a></li>
                        <li class="breadcrumb-item active">Create</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-bullhorn me-2"></i>Send Broadcast Message</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateBroadcast" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Message Title</label>
                            <input asp-for="Title" class="form-control" placeholder="Enter message title" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Message" class="form-label">Message Content</label>
                            <textarea asp-for="Message" class="form-control" rows="5" placeholder="Enter your message..."></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="TargetType" class="form-label">Send To</label>
                                    <select asp-for="TargetType" class="form-select" id="targetTypeSelect">
                                        <option value="AllUsers">All Users</option>
                                        <option value="Location">Specific Location</option>
                                        <option value="Role">Specific Role</option>
                                    </select>
                                    <span asp-validation-for="TargetType" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Priority" class="form-label">Priority</label>
                                    <select asp-for="Priority" class="form-select">
                                        <option value="Normal">Normal</option>
                                        <option value="High">High</option>
                                        <option value="Urgent">Urgent</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6" id="locationTargetDiv" style="display:none;">
                                <div class="mb-3">
                                    <label asp-for="TargetLocationId" class="form-label">Target Location</label>
                                    <select asp-for="TargetLocationId" class="form-select">
                                        <option value="">Select Location</option>
                                        @foreach (var location in ViewBag.Locations)
                                        {
                                            <option value="@location.LocationId">@location.LocationName</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-6" id="roleTargetDiv" style="display:none;">
                                <div class="mb-3">
                                    <label asp-for="TargetRoleId" class="form-label">Target Role</label>
                                    <select asp-for="TargetRoleId" class="form-select">
                                        <option value="">Select Role</option>
                                        @foreach (var role in ViewBag.Roles)
                                        {
                                            <option value="@role.RoleId">@role.RoleName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExpiresDate" class="form-label">Expiration Date (Optional)</label>
                            <input asp-for="ExpiresDate" type="datetime-local" class="form-control" />
                            <small class="text-muted">Leave empty for no expiration</small>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/Notifications/BroadcastMessages" class="btn btn-secondary">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane me-1"></i> Send Broadcast
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#targetTypeSelect').change(function () {
                var targetType = $(this).val();
                $('#locationTargetDiv').hide();
                $('#roleTargetDiv').hide();

                if (targetType === 'Location') {
                    $('#locationTargetDiv').show();
                } else if (targetType === 'Role') {
                    $('#roleTargetDiv').show();
                }
            });
        });
    </script>
}
