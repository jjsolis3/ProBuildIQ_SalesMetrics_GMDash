@model SalesMetrics.Models.NotificationListViewModel

@{
    ViewData["Title"] = "Notifications";
    ViewBag.PTitle = null;
    var announcementsFromNotifications = ViewBag.Announcements as List<SalesMetrics.Models.Notification> ?? new List<SalesMetrics.Models.Notification>();
    var broadcastMessages = ViewBag.BroadcastMessages as List<SalesMetrics.Models.BroadcastMessage> ?? new List<SalesMetrics.Models.BroadcastMessage>();
    var totalAnnouncementsCount = ViewBag.TotalAnnouncementsCount ?? 0;
}

<div class="container-fluid">
    <!-- Stats Cards -->
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h5 class="card-title text-white mb-1">Unread Notifications</h5>
                            <h2 class="mb-0" id="unreadCount">@Model.UnreadCount</h2>
                        </div>
                        <div class="avatar-lg bg-white bg-opacity-25 rounded">
                            <i class="fas fa-bell font-24 avatar-title"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h5 class="card-title text-white mb-1">Total Notifications</h5>
                            <h2 class="mb-0">@Model.TotalCount</h2>
                        </div>
                        <div class="avatar-lg bg-white bg-opacity-25 rounded">
                            <i class="fas fa-list font-24 avatar-title"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs for Announcements and Notifications -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <ul class="nav nav-tabs nav-tabs-custom nav-justified" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#notifications-tab" role="tab">
                                <span class="d-block d-sm-none"><i class="fas fa-bell"></i></span>
                                <span class="d-none d-sm-block">
                                    <i class="fas fa-bell me-1"></i> Notifications
                                    <span class="badge bg-primary ms-2">@Model.TotalCount</span>
                                </span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#announcements-tab" role="tab">
                                <span class="d-block d-sm-none"><i class="fas fa-bullhorn"></i></span>
                                <span class="d-none d-sm-block">
                                    <i class="fas fa-bullhorn me-1"></i> Announcements
                                    <span class="badge bg-danger ms-2">@totalAnnouncementsCount</span>
                                </span>
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content p-3">
                        <!-- Notifications Tab -->
                        <div class="tab-pane active" id="notifications-tab" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0">
                                    <i class="fas fa-bell me-2"></i>Your Notifications
                                </h5>
                                <button class="btn btn-sm btn-primary" onclick="markAllAsRead()">
                                    <i class="fas fa-check-double me-1"></i> Mark All as Read
                                </button>
                            </div>

                            @if (Model.Notifications.Count == 0)
                            {
                                <div class="text-center py-5">
                                    <i class="fas fa-bell-slash text-muted" style="font-size: 4rem;"></i>
                                    <p class="text-muted mt-3">No notifications yet</p>
                                </div>
                            }
                            else
                            {
                                <div class="list-group" id="notificationsList">
                                    @foreach (var notification in Model.Notifications)
                                    {
                                        var iconClass = notification.NotificationType switch
                                        {
                                            "TaskAssigned" => "fas fa-tasks",
                                            "NoteAdded" => "fas fa-comment",
                                            "StatusChanged" => "fas fa-exchange-alt",
                                            "DueDateReminder" => "fas fa-clock",
                                            "DocumentSigning" => "fas fa-file-signature",
                                            _ => "fas fa-bell"
                                        };

                                        var iconColor = notification.NotificationType switch
                                        {
                                            "TaskAssigned" => "primary",
                                            "NoteAdded" => "info",
                                            "StatusChanged" => "success",
                                            "DueDateReminder" => "warning",
                                            "DocumentSigning" => "secondary",
                                            _ => "primary"
                                        };

                                        var timeAgo = (DateTime.Now - notification.CreatedDate).TotalMinutes < 1 ? "just now" :
                                                      (DateTime.Now - notification.CreatedDate).TotalHours < 1 ? $"{(int)(DateTime.Now - notification.CreatedDate).TotalMinutes} min ago" :
                                                      (DateTime.Now - notification.CreatedDate).TotalDays < 1 ? $"{(int)(DateTime.Now - notification.CreatedDate).TotalHours} hr ago" :
                                                      $"{(int)(DateTime.Now - notification.CreatedDate).TotalDays} days ago";

                                        <div class="list-group-item @(notification.IsRead ? "" : "list-group-item-primary")"
                                             id="notification-@notification.NotificationId"
                                             data-notification-id="@notification.NotificationId"
                                             data-is-read="@notification.IsRead.ToString().ToLower()">
                                            <div class="d-flex align-items-start">
                                                <div class="avatar avatar-sm avatar-label-@iconColor me-3">
                                                    <span class="rounded fs-18">
                                                        <i class="@iconClass"></i>
                                                    </span>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <h6 class="mb-0 @(notification.IsRead ? "" : "fw-bold")">
                                                            @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                                            {
                                                                <a href="@notification.ActionUrl" class="text-decoration-none text-dark">
                                                                    @notification.Title
                                                                </a>
                                                            }
                                                            else
                                                            {
                                                                @notification.Title
                                                            }
                                                        </h6>
                                                        <div class="btn-group btn-group-sm ms-2">
                                                            <button type="button" class="btn btn-light"
                                                                    onclick="toggleReadStatus(@notification.NotificationId, @notification.IsRead.ToString().ToLower())"
                                                                    title="@(notification.IsRead ? "Mark as unread" : "Mark as read")">
                                                                <i class="fas fa-@(notification.IsRead ? "envelope" : "envelope-open")"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-light"
                                                                    onclick="deleteNotification(@notification.NotificationId)"
                                                                    title="Delete">
                                                                <i class="fas fa-trash text-danger"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(notification.Message))
                                                    {
                                                        <p class="mb-1 text-muted">@notification.Message</p>
                                                    }
                                                    <small class="text-muted">
                                                        <i class="mdi mdi-clock-outline"></i> @timeAgo
                                                        @if (!notification.IsRead)
                                                        {
                                                            <span class="badge bg-primary ms-2">UNREAD</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary ms-2">READ</span>
                                                        }
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Announcements Tab -->
                        <div class="tab-pane" id="announcements-tab" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0">
                                    <i class="fas fa-bullhorn me-2"></i>Company Announcements
                                </h5>
                                <button class="btn btn-sm btn-primary" onclick="markAllAnnouncementsAsRead()">
                                    <i class="fas fa-check-double me-1"></i> Mark All as Read
                                </button>
                            </div>

                            @if (totalAnnouncementsCount == 0)
                            {
                                <div class="text-center py-5">
                                    <i class="fas fa-bullhorn text-muted" style="font-size: 4rem;"></i>
                                    <p class="text-muted mt-3">No announcements at this time</p>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    @* Display broadcast notification announcements *@
                                    @foreach (var announcement in announcementsFromNotifications)
                                    {
                                        var timeAgo = (DateTime.Now - announcement.CreatedDate).TotalMinutes < 1 ? "just now" :
                                                      (DateTime.Now - announcement.CreatedDate).TotalHours < 1 ? $"{(int)(DateTime.Now - announcement.CreatedDate).TotalMinutes} min ago" :
                                                      (DateTime.Now - announcement.CreatedDate).TotalDays < 1 ? $"{(int)(DateTime.Now - announcement.CreatedDate).TotalHours} hr ago" :
                                                      $"{(int)(DateTime.Now - announcement.CreatedDate).TotalDays} days ago";

                                        <div class="col-md-12 mb-3" id="announcement-@announcement.NotificationId">
                                            <div class="card border-info @(announcement.IsRead ? "" : "bg-light")">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-start">
                                                        <div class="avatar-lg bg-info bg-opacity-10 rounded me-3">
                                                            <i class="fas fa-bullhorn text-info font-24 avatar-title"></i>
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <div class="d-flex justify-content-between align-items-start">
                                                                <h5 class="mb-2 @(announcement.IsRead ? "" : "fw-bold")">@announcement.Title</h5>
                                                                <div class="btn-group btn-group-sm ms-2">
                                                                    <button type="button" class="btn btn-light"
                                                                            onclick="toggleAnnouncementReadStatus(@announcement.NotificationId, @announcement.IsRead.ToString().ToLower())"
                                                                            title="@(announcement.IsRead ? "Mark as unread" : "Mark as read")">
                                                                        <i class="fas fa-@(announcement.IsRead ? "envelope" : "envelope-open")"></i>
                                                                    </button>
                                                                    <button type="button" class="btn btn-light"
                                                                            onclick="deleteAnnouncement(@announcement.NotificationId)"
                                                                            title="Delete">
                                                                        <i class="fas fa-trash text-danger"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(announcement.Message))
                                                            {
                                                                <p class="text-muted mb-2">@announcement.Message</p>
                                                            }
                                                            <small class="text-muted">
                                                                <i class="mdi mdi-clock-outline"></i> @timeAgo
                                                                @if (!announcement.IsRead)
                                                                {
                                                                    <span class="badge bg-primary ms-2">UNREAD</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-secondary ms-2">READ</span>
                                                                }
                                                            </small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @* Display company-wide broadcast messages *@
                                    @foreach (var announcement in broadcastMessages)
                                    {
                                        var priorityClass = announcement.Priority switch
                                        {
                                            "Urgent" => "danger",
                                            "High" => "warning",
                                            _ => "info"
                                        };

                                        var timeAgo = (DateTime.Now - announcement.CreatedDate).TotalMinutes < 1 ? "just now" :
                                                      (DateTime.Now - announcement.CreatedDate).TotalHours < 1 ? $"{(int)(DateTime.Now - announcement.CreatedDate).TotalMinutes} min ago" :
                                                      (DateTime.Now - announcement.CreatedDate).TotalDays < 1 ? $"{(int)(DateTime.Now - announcement.CreatedDate).TotalHours} hr ago" :
                                                      $"{(int)(DateTime.Now - announcement.CreatedDate).TotalDays} days ago";

                                        <div class="col-md-12 mb-3">
                                            <div class="card border-@priorityClass">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-start">
                                                        <div class="avatar-lg bg-@priorityClass bg-opacity-10 rounded me-3">
                                                            <i class="fas fa-bullhorn text-@priorityClass font-24 avatar-title"></i>
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <div class="d-flex justify-content-between align-items-start">
                                                                <h5 class="mb-2">@announcement.Title</h5>
                                                                <span class="badge bg-@priorityClass">@announcement.Priority</span>
                                                            </div>
                                                            <p class="text-muted mb-2">@announcement.Message</p>
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <small class="text-muted">
                                                                    <i class="mdi mdi-clock-outline"></i> @timeAgo
                                                                </small>
                                                                @if (announcement.ExpiresDate.HasValue)
                                                                {
                                                                    <small class="text-muted">
                                                                        <i class="mdi mdi-calendar"></i> Expires: @announcement.ExpiresDate.Value.ToString("MMM dd, yyyy")
                                                                    </small>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Mark single notification as read
    function markAsRead(notificationId) {
        $.ajax({
            url: '/Notifications/MarkAsRead',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            data: JSON.stringify({ NotificationId: notificationId }),
            success: function (response) {
                if (response.success) {
                    const $notification = $(`#notification-${notificationId}`);
                    $notification.removeClass('list-group-item-primary');
                    $notification.find('.fw-bold').removeClass('fw-bold');
                    $notification.find('.badge.bg-primary').remove();
                    $notification.attr('data-is-read', 'true');
                    updateUnreadCount();
                }
            },
            error: function (xhr, status, error) {
                console.error('Error marking notification as read:', error);
            }
        });
    }

    // Toggle read/unread status
    function toggleReadStatus(notificationId, isCurrentlyRead) {
        const newStatus = !isCurrentlyRead;

        $.ajax({
            url: '/Notifications/ToggleRead',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            data: JSON.stringify({ NotificationId: notificationId, IsRead: newStatus }),
            success: function (response) {
                if (response.success) {
                    const $notification = $(`#notification-${notificationId}`);
                    const $title = $notification.find('h6').first();
                    const $icon = $notification.find('.btn-group button:first i');

                    if (newStatus) {
                        // Mark as read
                        $notification.removeClass('list-group-item-primary');
                        $title.removeClass('fw-bold');
                        $notification.find('.badge.bg-primary').remove();
                        $icon.removeClass('fa-envelope-open').addClass('fa-envelope');
                        $notification.attr('data-is-read', 'true');
                    } else {
                        // Mark as unread
                        $notification.addClass('list-group-item-primary');
                        $title.addClass('fw-bold');
                        $notification.find('small.text-muted').first().append('<span class="badge bg-primary ms-2">New</span>');
                        $icon.removeClass('fa-envelope').addClass('fa-envelope-open');
                        $notification.attr('data-is-read', 'false');
                    }

                    updateUnreadCount();

                    // Trigger bell dropdown refresh
                    if (typeof window.loadNotifications === 'function') {
                        window.loadNotifications();
                    }
                }
            },
            error: function (xhr, status, error) {
                console.error('Error toggling notification status:', error);
                if (typeof toastr !== 'undefined') {
                    toastr.error('Failed to update notification status');
                }
            }
        });
    }

    // Mark all notifications as read
    function markAllAsRead() {
        $.ajax({
            url: '/Notifications/MarkAllAsRead',
            type: 'POST',
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                if (response.success) {
                    // Update all notification items
                    $('.list-group-item').removeClass('list-group-item-primary');
                    $('.list-group-item .fw-bold').removeClass('fw-bold');
                    $('.list-group-item .badge.bg-primary').remove();
                    $('.list-group-item').attr('data-is-read', 'true');

                    // Update icons
                    $('.btn-group button:first i').removeClass('fa-envelope-open').addClass('fa-envelope');

                    updateUnreadCount();

                    // Trigger bell dropdown refresh
                    if (typeof window.loadNotifications === 'function') {
                        window.loadNotifications();
                    }

                    if (typeof toastr !== 'undefined') {
                        toastr.success('All notifications marked as read');
                    }
                }
            },
            error: function (xhr, status, error) {
                console.error('Error marking all as read:', error);
                if (typeof toastr !== 'undefined') {
                    toastr.error('Failed to mark all notifications as read');
                }
            }
        });
    }

    // Delete notification
    function deleteNotification(notificationId) {
        if (confirm('Are you sure you want to delete this notification?')) {
            $.ajax({
                url: '/Notifications/Delete',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify({ NotificationId: notificationId }),
                success: function (response) {
                    if (response.success) {
                        $(`#notification-${notificationId}`).fadeOut(300, function () {
                            $(this).remove();
                            updateUnreadCount();

                            // Check if list is empty
                            if ($('#notificationsList .list-group-item').length === 0) {
                                $('#notificationsList').html(`
                                    <div class="text-center py-5">
                                        <i class="fas fa-bell-slash text-muted" style="font-size: 4rem;"></i>
                                        <p class="text-muted mt-3">No notifications yet</p>
                                    </div>
                                `);
                            }
                        });

                        if (typeof toastr !== 'undefined') {
                            toastr.success('Notification deleted');
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error deleting notification:', error);
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Failed to delete notification');
                    }
                }
            });
        }
    }

    // Update unread count
    function updateUnreadCount() {
        $.ajax({
            url: '/Notifications/GetUnreadCount',
            type: 'GET',
            success: function (response) {
                $('#unreadCount').text(response.count);
                // Update badge in tab
                $('#notifications-tab .badge').text($('#notificationsList .list-group-item').length);
            },
            error: function (xhr, status, error) {
                console.error('Error getting unread count:', error);
            }
        });
    }

    // Toggle announcement read/unread status
    function toggleAnnouncementReadStatus(notificationId, isCurrentlyRead) {
        const newStatus = !isCurrentlyRead;

        $.ajax({
            url: '/Notifications/ToggleRead',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            data: JSON.stringify({ NotificationId: notificationId, IsRead: newStatus }),
            success: function (response) {
                if (response.success) {
                    const $announcement = $(`#announcement-${notificationId}`);
                    const $card = $announcement.find('.card');
                    const $title = $announcement.find('h5').first();
                    const $icon = $announcement.find('.btn-group button:first i');

                    if (newStatus) {
                        // Mark as read
                        $card.removeClass('bg-light');
                        $title.removeClass('fw-bold');
                        $announcement.find('.badge.bg-primary').remove();
                        $icon.removeClass('fa-envelope-open').addClass('fa-envelope');
                        $announcement.find('.btn-group button:first').attr('title', 'Mark as unread');
                    } else {
                        // Mark as unread
                        $card.addClass('bg-light');
                        $title.addClass('fw-bold');
                        $announcement.find('small.text-muted').first().append('<span class="badge bg-primary ms-2">New</span>');
                        $icon.removeClass('fa-envelope').addClass('fa-envelope-open');
                        $announcement.find('.btn-group button:first').attr('title', 'Mark as read');
                    }

                    updateUnreadCount();

                    // Trigger bell dropdown refresh
                    if (typeof window.loadNotifications === 'function') {
                        window.loadNotifications();
                    }

                    if (typeof toastr !== 'undefined') {
                        toastr.success(newStatus ? 'Announcement marked as read' : 'Announcement marked as unread');
                    }
                }
            },
            error: function (xhr, status, error) {
                console.error('Error toggling announcement status:', error);
                if (typeof toastr !== 'undefined') {
                    toastr.error('Failed to update announcement status');
                }
            }
        });
    }

    // Delete announcement
    function deleteAnnouncement(notificationId) {
        if (confirm('Are you sure you want to delete this announcement?')) {
            $.ajax({
                url: '/Notifications/Delete',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify({ NotificationId: notificationId }),
                success: function (response) {
                    if (response.success) {
                        $(`#announcement-${notificationId}`).fadeOut(300, function () {
                            $(this).remove();
                            updateUnreadCount();

                            // Update announcements count badge
                            const remainingCount = $('#announcements-tab .col-md-12').length - 1;
                            $('#announcements-tab .badge').text(remainingCount);

                            // Check if announcements list is empty
                            if (remainingCount === 0) {
                                $('#announcements-tab .row').html(`
                                    <div class="text-center py-5">
                                        <i class="fas fa-bullhorn text-muted" style="font-size: 4rem;"></i>
                                        <p class="text-muted mt-3">No announcements at this time</p>
                                    </div>
                                `);
                            }
                        });

                        if (typeof toastr !== 'undefined') {
                            toastr.success('Announcement deleted');
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error deleting announcement:', error);
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Failed to delete announcement');
                    }
                }
            });
        }
    }

    // Mark all announcements as read
    function markAllAnnouncementsAsRead() {
        // Get all announcement notification IDs
        var announcementIds = [];
        $('#announcements-tab [id^="announcement-"]').each(function() {
            var id = $(this).attr('id').replace('announcement-', '');
            if (id) {
                announcementIds.push(parseInt(id));
            }
        });

        if (announcementIds.length === 0) {
            if (typeof toastr !== 'undefined') {
                toastr.info('No announcements to mark as read');
            }
            return;
        }

        // Mark each announcement as read
        var completedCount = 0;
        var totalCount = announcementIds.length;

        announcementIds.forEach(function(announcementId) {
            $.ajax({
                url: '/Notifications/ToggleRead',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify({ NotificationId: announcementId, IsRead: true }),
                success: function (response) {
                    if (response.success) {
                        const $announcement = $(`#announcement-${announcementId}`);
                        const $card = $announcement.find('.card');
                        const $title = $announcement.find('h5').first();
                        const $icon = $announcement.find('.btn-group button:first i');

                        // Mark as read
                        $card.removeClass('bg-light');
                        $title.removeClass('fw-bold');
                        $announcement.find('.badge.bg-primary').removeClass('bg-primary').addClass('bg-secondary').text('READ');
                        $icon.removeClass('fa-envelope-open').addClass('fa-envelope');
                        $announcement.find('.btn-group button:first').attr('title', 'Mark as unread');

                        completedCount++;

                        // Show success message when all are done
                        if (completedCount === totalCount) {
                            updateUnreadCount();

                            // Trigger bell dropdown refresh
                            if (typeof window.loadNotifications === 'function') {
                                window.loadNotifications();
                            }

                            if (typeof toastr !== 'undefined') {
                                toastr.success('All announcements marked as read');
                            }
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error marking announcement as read:', error);
                    completedCount++;
                }
            });
        });
    }
</script>
