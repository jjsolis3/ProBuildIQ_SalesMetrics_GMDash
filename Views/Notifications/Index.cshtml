@model SalesMetrics.Models.NotificationListViewModel

@{
    ViewData["Title"] = "Notifications";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <h4 class="page-title">Notification Center</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
                        <li class="breadcrumb-item active">Notifications</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-bell me-2"></i>All Notifications
                            <span class="badge bg-primary ms-2">@Model.UnreadCount Unread</span>
                        </h5>
                        <button class="btn btn-sm btn-primary" onclick="markAllAsRead()">
                            <i class="fas fa-check-double me-1"></i> Mark All as Read
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Notifications.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-bell-slash text-muted" style="font-size: 4rem;"></i>
                            <p class="text-muted mt-3">No notifications yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var notification in Model.Notifications)
                            {
                                var iconClass = notification.NotificationType switch
                                {
                                    "TaskAssigned" => "fas fa-tasks",
                                    "NoteAdded" => "fas fa-comment",
                                    "StatusChanged" => "fas fa-exchange-alt",
                                    "DueDateReminder" => "fas fa-clock",
                                    "BroadcastMessage" => "fas fa-bullhorn",
                                    "DocumentSigning" => "fas fa-file-signature",
                                    _ => "fas fa-bell"
                                };

                                var iconColor = notification.NotificationType switch
                                {
                                    "TaskAssigned" => "primary",
                                    "NoteAdded" => "info",
                                    "StatusChanged" => "success",
                                    "DueDateReminder" => "warning",
                                    "BroadcastMessage" => "danger",
                                    "DocumentSigning" => "secondary",
                                    _ => "primary"
                                };

                                var timeAgo = (DateTime.Now - notification.CreatedDate).TotalMinutes < 1 ? "just now" :
                                              (DateTime.Now - notification.CreatedDate).TotalHours < 1 ? $"{(int)(DateTime.Now - notification.CreatedDate).TotalMinutes} min ago" :
                                              (DateTime.Now - notification.CreatedDate).TotalDays < 1 ? $"{(int)(DateTime.Now - notification.CreatedDate).TotalHours} hr ago" :
                                              $"{(int)(DateTime.Now - notification.CreatedDate).TotalDays} days ago";

                                <a href="@(notification.ActionUrl ?? "#")"
                                   class="list-group-item list-group-item-action @(notification.IsRead ? "" : "list-group-item-primary")"
                                   onclick="markAsRead(@notification.NotificationId); return true;">
                                    <div class="d-flex align-items-start">
                                        <div class="avatar avatar-sm avatar-label-@iconColor me-3">
                                            <span class="rounded fs-18">
                                                <i class="@iconClass"></i>
                                            </span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1 @(notification.IsRead ? "" : "fw-bold")">@notification.Title</h6>
                                            @if (!string.IsNullOrEmpty(notification.Message))
                                            {
                                                <p class="mb-1 text-muted">@notification.Message</p>
                                            }
                                            <small class="text-muted">
                                                <i class="mdi mdi-clock-outline"></i> @timeAgo
                                            </small>
                                        </div>
                                        @if (!notification.IsRead)
                                        {
                                            <span class="badge bg-primary rounded-pill">New</span>
                                        }
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
