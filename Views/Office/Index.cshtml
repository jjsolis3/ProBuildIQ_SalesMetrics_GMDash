@using SalesMetrics.Controllers
@using SalesMetrics.Models

@{
    ViewData["Title"] = "Office Dashboard";
    var greeting = ViewBag.Greeting;
    var username = ViewBag.Username;
    var envelopeMetrics = ViewBag.EnvelopeMetrics as EnvelopeMetrics;
    var recentEnvelopes = ViewBag.RecentEnvelopes as List<RecentEnvelope>;
    var needsFollowUp = ViewBag.NeedsFollowUp as List<EnvelopeFollowUp>;
    var weeklyOrders = ViewBag.WeeklyOrders as List<DailyOrderCount>;
    var inactiveCustomers = ViewBag.InactiveCustomers as List<InactiveCustomerViewModel>;
    var transactionSummary = ViewBag.TransactionSummary as TransactionSummary;
    var overdueInvoices = ViewBag.OverdueInvoices as List<OverdueInvoice>;
    var weekOffset = ViewBag.WeekOffset ?? 0;
}

@section styles {
    <!-- DataTables CSS -->
    <link href="~/assets/libs/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs5/css/buttons.bootstrap5.min.css" rel="stylesheet" type="text/css" />
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2>@greeting, @username!</h2>
            <p class="text-muted">Office Dashboard - Envelope & Business Metrics</p>
        </div>
    </div>

    <!-- KPI Cards Row -->
    <div class="row mb-4">
        <!-- Envelopes Sent This Month -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Envelopes Sent This Month
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @envelopeMetrics.EnvelopesSentThisMonth
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-envelope fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Completion Rate -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Completion Rate
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @envelopeMetrics.CompletionRate.ToString("F1")%
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Signatures -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Pending Signatures
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @envelopeMetrics.PendingSignatures
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Avg Time to Sign -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Avg Time to Sign
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @if (envelopeMetrics.AvgTimeToSign < 24)
                                {
                                    @envelopeMetrics.AvgTimeToSign.ToString("F1") <text> hrs</text>
                                }
                                else
                                {
                                    @((envelopeMetrics.AvgTimeToSign / 24).ToString("F1")) <text> days</text>
                                }
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-hourglass-half fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Envelope Status Chart, Quick Actions & Recent Activity Row -->
    <div class="row mb-4">
        <!-- Envelope Status Chart -->
        <div class="col-xl-4 col-lg-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Envelope Status Breakdown</h6>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <div style="max-width: 300px; width: 100%;">
                        <canvas id="envelopeStatusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions & Recent Activity -->
        <div class="col-xl-4 col-lg-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/SignAdmin/Create" class="btn btn-lg btn-primary">
                            <i class="fas fa-plus-circle me-2"></i> Send New Envelope
                        </a>
                        <a href="/SignAdmin?scope=mine" class="btn btn-lg btn-outline-primary">
                            <i class="fas fa-folder-open me-2"></i> View My Envelopes
                        </a>
                        <a href="/SignTemplate" class="btn btn-lg btn-outline-secondary">
                            <i class="fas fa-file-alt me-2"></i> Manage Templates
                        </a>
                    </div>

                    <!-- Recent Envelope Activity (Compact) -->
                    <div class="mt-4">
                        <h6 class="font-weight-bold text-muted mb-3">Recent Activity</h6>
                        @if (recentEnvelopes != null && recentEnvelopes.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var envelope in recentEnvelopes.Take(3))
                                {
                                    <a href="/SignAdmin/Details/@envelope.EnvelopeId" class="list-group-item list-group-item-action px-0 py-2 border-0">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="text-truncate" style="max-width: 200px;">
                                                <small class="fw-bold">@envelope.Subject</small><br />
                                                <small class="text-muted">@envelope.CreatedDateUtc.ToLocalTime().ToString("MMM dd, h:mm tt")</small>
                                            </div>
                                            <span class="badge badge-@GetStatusBadgeClass(envelope.Status) ms-2">
                                                @envelope.Status
                                            </span>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0 small">No recent activity</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Documents Needing Follow-up -->
        <div class="col-xl-4 col-lg-4 mb-3">
            <div class="card shadow h-100">
                <div class="card-header py-3 bg-warning-subtle">
                    <h6 class="m-0 font-weight-bold text-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>Documents Needing Follow-up
                    </h6>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    @if (needsFollowUp != null && needsFollowUp.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var doc in needsFollowUp.Take(10))
                            {
                                <div class="list-group-item px-0 py-2 border-bottom">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <strong class="text-truncate" style="max-width: 200px;">@doc.Subject</strong>
                                        <span class="badge bg-@(doc.DaysPending >= 7 ? "danger" : "warning") ms-2">
                                            @doc.DaysPending days
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">@doc.SentAtUtc.ToLocalTime().ToString("MMM dd, yyyy")</small>
                                        <a href="/SignAdmin/Details/@doc.EnvelopeId" class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <p class="text-muted mb-0">No documents need follow-up.<br />Great work!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Weekly Jobs & Inactive Customers Row -->
    <div class="row mb-4">
        <!-- Weekly Jobs Chart -->
        <div class="col-xl-6 col-lg-6 mb-3">
            <div class="card shadow h-100">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Weekly Jobs</h6>
                    <div>
                        <button class="btn btn-sm btn-outline-primary" onclick="changeWeek(-1)">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <span class="mx-2 font-weight-bold">
                            @ViewBag.WeeklyStart.ToString("MMM dd") - @ViewBag.WeeklyEnd.ToString("MMM dd, yyyy")
                        </span>
                        <button class="btn btn-sm btn-outline-primary" onclick="changeWeek(1)" @(weekOffset >= 0 ? "disabled" : "")>
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="weeklyJobsChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Inactive Customers Preview -->
        <div class="col-xl-6 col-lg-6 mb-3">
            <div class="card shadow h-100">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Inactive Customers</h6>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                    @if (inactiveCustomers != null && inactiveCustomers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Customer</th>
                                        <th>Management Co</th>
                                        <th>Last Order</th>
                                        <th>Days</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var customer in inactiveCustomers.Take(8))
                                    {
                                        <tr>
                                            <td>@customer.CustomerName</td>
                                            <td>@customer.MgmtCo</td>
                                            <td>@(customer.LastOrderDate?.ToString("MM/dd/yyyy") ?? "N/A")</td>
                                            <td><span class="badge bg-secondary">@customer.DaysSinceLastOrder</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-center mt-3">
                            <button class="btn btn-primary" onclick="toggleInactiveCustomersTable()">
                                <i class="fas fa-table me-2"></i>View All (@inactiveCustomers.Count customers)
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No inactive customers found.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Full Inactive Customers DataTable (Hidden by default) -->
    <div class="row mb-4" id="fullInactiveCustomersSection" style="display: none;">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Inactive Customers - Full List</h6>
                    <button class="btn btn-sm btn-outline-secondary" onclick="toggleInactiveCustomersTable()">
                        <i class="fas fa-times"></i> Hide
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="inactive-customers-table" class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>Customer #</th>
                                    <th>Customer Name</th>
                                    <th>Management Co</th>
                                    <th>Units</th>
                                    <th>Last Order</th>
                                    <th>Days Since Order</th>
                                    <th>Last Install</th>
                                    <th>Days Since Install</th>
                                    <th>YTD Current</th>
                                    <th>YTD Previous</th>
                                    <th>AR Balance</th>
                                    <th>Salesperson</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (inactiveCustomers != null)
                                {
                                    foreach (var customer in inactiveCustomers)
                                    {
                                        <tr>
                                            <td>@customer.CustomerNumber</td>
                                            <td>@customer.CustomerName</td>
                                            <td>@customer.MgmtCo</td>
                                            <td>@customer.Units</td>
                                            <td>@(customer.LastOrderDate?.ToString("MM/dd/yyyy") ?? "N/A")</td>
                                            <td>@customer.DaysSinceLastOrder</td>
                                            <td>@(customer.LastInstallDate?.ToString("MM/dd/yyyy") ?? "N/A")</td>
                                            <td>@customer.DaysSinceLastInstall</td>
                                            <td>$@customer.YTDCurrent.ToString("N2")</td>
                                            <td>$@customer.YTDPrevious.ToString("N2")</td>
                                            <td>$@customer.Balance.ToString("N2")</td>
                                            <td>@customer.Salesperson</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- AR Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Accounts Receivable</h6>
                </div>
                <div class="card-body">
                    <!-- AR Summary Cards -->
                    <div class="row mb-4">
                        <div class="col-md-2 mb-2">
                            <div class="card bg-light h-100">
                                <div class="card-body text-center p-2">
                                    <small class="d-block mb-1">Under 30</small>
                                    <h5 class="text-success mb-1">$@transactionSummary.DueUnder30Amount.ToString("N0")</h5>
                                    <small class="text-muted">@transactionSummary.DueUnder30 invoices</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 mb-2">
                            <div class="card bg-light h-100">
                                <div class="card-body text-center p-2">
                                    <small class="d-block mb-1">30-60 Days</small>
                                    <h5 class="text-warning mb-1">$@transactionSummary.Due30to60Amount.ToString("N0")</h5>
                                    <small class="text-muted">@transactionSummary.Due30to60 invoices</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 mb-2">
                            <div class="card bg-light h-100">
                                <div class="card-body text-center p-2">
                                    <small class="d-block mb-1">60-90 Days</small>
                                    <h5 class="text-orange mb-1">$@transactionSummary.Due60to90Amount.ToString("N0")</h5>
                                    <small class="text-muted">@transactionSummary.Due60to90 invoices</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 mb-2">
                            <div class="card bg-light h-100">
                                <div class="card-body text-center p-2">
                                    <small class="d-block mb-1">90-120 Days</small>
                                    <h5 class="text-danger mb-1">$@transactionSummary.Due90to120Amount.ToString("N0")</h5>
                                    <small class="text-muted">@transactionSummary.Due90to120 invoices</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 mb-2">
                            <div class="card bg-light h-100">
                                <div class="card-body text-center p-2">
                                    <small class="d-block mb-1">Over 120</small>
                                    <h5 class="text-danger font-weight-bold mb-1">$@transactionSummary.DueOver120Amount.ToString("N0")</h5>
                                    <small class="text-muted">@transactionSummary.DueOver120 invoices</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 mb-2">
                            <div class="card bg-primary text-white h-100">
                                <div class="card-body text-center p-2">
                                    <small class="d-block mb-1">TOTAL AR</small>
                                    <h5 class="mb-1">$@((transactionSummary.DueUnder30Amount + transactionSummary.Due30to60Amount + transactionSummary.Due60to90Amount + transactionSummary.Due90to120Amount + transactionSummary.DueOver120Amount).ToString("N0"))</h5>
                                    <small>@((transactionSummary.DueUnder30 + transactionSummary.Due30to60 + transactionSummary.Due60to90 + transactionSummary.Due90to120 + transactionSummary.DueOver120)) invoices</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- AR Overdue Table -->
                    <div class="table-responsive">
                        <table id="ar_table" class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>Invoice</th>
                                    <th>Customer</th>
                                    <th>Management Co</th>
                                    <th>Amount Due</th>
                                    <th>Due Date</th>
                                    <th>Days Past Due</th>
                                    <th>Aging</th>
                                    <th>Salesperson</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (overdueInvoices != null)
                                {
                                    foreach (var invoice in overdueInvoices)
                                    {
                                        <tr>
                                            <td>@invoice.Invoice</td>
                                            <td>@invoice.CustomerName</td>
                                            <td>@invoice.MgmtCo</td>
                                            <td>$@invoice.OutstandingAmount.ToString("N2")</td>
                                            <td>@invoice.DueDate.ToString("MM/dd/yyyy")</td>
                                            <td>@invoice.DaysPastDue</td>
                                            <td>
                                                <span class="badge bg-@GetAgingBadgeClass(invoice.InvoiceAging)">
                                                    @invoice.InvoiceAging
                                                </span>
                                            </td>
                                            <td>@invoice.Salesperson</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Completed" => "success",
            "Sent" => "primary",
            "Viewed" => "info",
            "Draft" => "secondary",
            "Declined" => "danger",
            "Voided" => "dark",
            "Expired" => "warning",
            _ => "secondary"
        };
    }

    string GetAgingBadgeClass(string aging)
    {
        return aging switch
        {
            "Under 30 Days" => "success",
            "30 to 60 Days" => "warning",
            "60 to 90 Days" => "warning",
            "90 to 120 Days" => "danger",
            "Over 120 Days" => "danger",
            _ => "secondary"
        };
    }
}

@section scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- DataTables JS -->
    <script src="~/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons-bs5/js/buttons.bootstrap5.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script>
        // Store chart instances for cleanup
        let envelopeStatusChartInstance = null;
        let weeklyJobsChartInstance = null;
        let inactiveCustomersTableInstance = null;
        let arTableInstance = null;

        $(document).ready(function() {
            // Envelope Status Doughnut Chart
            var statusData = @Html.Raw(Json.Serialize(envelopeMetrics.StatusBreakdown));

            if (statusData && statusData.length > 0) {
                var ctx = document.getElementById('envelopeStatusChart').getContext('2d');
                var labels = statusData.map(function(x) { return x.status; });
                var data = statusData.map(function(x) { return x.count; });
                var colors = statusData.map(function(x) {
                    switch(x.status) {
                        case 'Completed': return '#28a745';
                        case 'Sent': return '#007bff';
                        case 'Viewed': return '#17a2b8';
                        case 'Draft': return '#6c757d';
                        case 'Declined': return '#dc3545';
                        case 'Voided': return '#343a40';
                        case 'Expired': return '#ffc107';
                        default: return '#6c757d';
                    }
                });

                envelopeStatusChartInstance = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: data,
                            backgroundColor: colors,
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 10,
                                    font: {
                                        size: 11
                                    }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.label + ': ' + context.parsed;
                                    }
                                }
                            }
                        }
                    }
                });
            } else {
                // Show "No data" message
                $('#envelopeStatusChart').parent().html('<p class="text-muted text-center py-5">No envelope data available</p>');
            }

            // Weekly Jobs Bar Chart
            var weeklyData = @Html.Raw(Json.Serialize(weeklyOrders));

            if (weeklyData && weeklyData.length > 0) {
                var ctx2 = document.getElementById('weeklyJobsChart').getContext('2d');
                var labels2 = weeklyData.map(function(x) { return x.weekdayName; });
                var orderCounts = weeklyData.map(function(x) { return x.ordersCount; });

                weeklyJobsChartInstance = new Chart(ctx2, {
                    type: 'bar',
                    data: {
                        labels: labels2,
                        datasets: [{
                            label: 'Orders',
                            data: orderCounts,
                            backgroundColor: '#4e73df',
                            borderColor: '#2e59d9',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            }
                        }
                    }
                });
            }

            // Initialize AR DataTable
            if ($.fn.DataTable.isDataTable('#ar_table')) {
                $('#ar_table').DataTable().destroy();
            }
            arTableInstance = $('#ar_table').DataTable({
                order: [[5, 'desc']], // Sort by Days Past Due
                pageLength: 25,
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="fas fa-file-excel me-1"></i> Export to Excel',
                        className: 'btn btn-success btn-sm'
                    }
                ]
            });
        });

        // Toggle Inactive Customers Full Table
        function toggleInactiveCustomersTable() {
            var section = $('#fullInactiveCustomersSection');

            if (section.is(':visible')) {
                section.slideUp();
                // Destroy DataTable when hiding
                if (inactiveCustomersTableInstance && $.fn.DataTable.isDataTable('#inactive-customers-table')) {
                    inactiveCustomersTableInstance.destroy();
                    inactiveCustomersTableInstance = null;
                }
            } else {
                section.slideDown();
                // Initialize DataTable when showing
                if (!inactiveCustomersTableInstance && !$.fn.DataTable.isDataTable('#inactive-customers-table')) {
                    inactiveCustomersTableInstance = $('#inactive-customers-table').DataTable({
                        order: [[5, 'desc']], // Sort by Days Since Order
                        pageLength: 25,
                        responsive: true,
                        dom: 'Bfrtip',
                        buttons: [
                            {
                                extend: 'excel',
                                text: '<i class="fas fa-file-excel me-1"></i> Export to Excel',
                                className: 'btn btn-success btn-sm'
                            }
                        ]
                    });
                }
            }
        }

        // Change week for Weekly Jobs
        function changeWeek(offset) {
            var currentOffset = @weekOffset;
            var newOffset = currentOffset + offset;
            window.location.href = '/Office/Index?weekOffset=' + newOffset;
        }

        // Cleanup on page unload
        window.addEventListener('beforeunload', function() {
            // Cleanup Chart.js instances
            if (envelopeStatusChartInstance) {
                envelopeStatusChartInstance.destroy();
                envelopeStatusChartInstance = null;
            }
            if (weeklyJobsChartInstance) {
                weeklyJobsChartInstance.destroy();
                weeklyJobsChartInstance = null;
            }

            // Cleanup DataTables
            if (arTableInstance && $.fn.DataTable.isDataTable('#ar_table')) {
                arTableInstance.destroy();
            }
            if (inactiveCustomersTableInstance && $.fn.DataTable.isDataTable('#inactive-customers-table')) {
                inactiveCustomersTableInstance.destroy();
            }
        });
    </script>

