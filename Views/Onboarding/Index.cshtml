@{
    ViewBag.Title = "Forms Center";
    ViewBag.PTitle = "Forms Center";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-4">
    <div class="col">
        <div class="card p-4 bg-orange text-white">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-file-earmark-text fs-1"></i>
                <div>
                    <h4 class="mb-1">Forms Center</h4>
                    <p class="mb-0 opacity-75">Select a form to submit a new request or review existing submissions.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- New Customer Request Form -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle bg-orange d-flex align-items-center justify-content-center"
                         style="width:52px; height:52px; flex-shrink:0;">
                        <i class="bi bi-person-plus text-white fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-0">New Customer Request</h5>
                        <small class="text-muted">Onboarding</small>
                    </div>
                </div>

                <p class="text-muted small flex-grow-1">
                    Submit a new customer set-up request including property information,
                    management company details, billing preferences, income terms, and product selections.
                    The completed form is exported as a professional PDF.
                </p>

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted small">
                        <i class="bi bi-inbox me-1"></i>
                        <strong>@ViewBag.NCRCount</strong> submission@(ViewBag.NCRCount == 1 ? "" : "s")
                    </span>
                </div>

                <div class="d-grid gap-2">
                    <a href="/Onboarding/NewCustomer" class="btn btn-orange text-white">
                        <i class="bi bi-plus-circle me-1"></i> Start New Request
                    </a>
                    <a href="/Onboarding/Submissions" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-table me-1"></i> View Submissions
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Placeholder card — future forms slot in here -->
    <div class="col-md-4">
        <div class="card h-100 border-dashed border-2 text-center d-flex align-items-center justify-content-center"
             style="border-style:dashed !important; min-height:260px;">
            <div class="text-muted p-4">
                <i class="bi bi-plus-square fs-1 d-block mb-2 opacity-50"></i>
                <p class="mb-0 small">Additional forms will appear here as they are added.</p>
            </div>
        </div>
    </div>

</div>
