@model List<SalesMetrics.Models.NewCustomerListItem>
@{
    ViewBag.Title = "Submitted Customer Requests";
    ViewBag.PName = "Forms Center";
    ViewBag.PLink = "/Onboarding";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var scope = ViewBag.Scope?.ToString() ?? "branch";
    var office = ViewBag.Office?.ToString() ?? "";
    var canViewAll = (bool)(ViewBag.CanViewAll ?? false);
    var currentCode = ViewBag.CurrentLocationCode?.ToString() ?? "";

    string branchLabel = currentCode;
    if (ViewBag.Locations != null && !string.IsNullOrEmpty(currentCode))
    {
        var locs = (Dictionary<int, (string Code, string Name)>)ViewBag.Locations;
        var match = locs.Values.FirstOrDefault(l => l.Code == currentCode);
        if (match != default)
            branchLabel = $"{match.Code} – {match.Name}";
    }

    string StatusBadgeClass(string? s) => s switch
    {
        "Approved"  => "bg-success",
        "Rejected"  => "bg-danger",
        "Reviewed"  => "bg-info text-dark",
        _           => "bg-warning text-dark"
    };
}

<div class="card">
    <div class="card-header bg-orange d-flex justify-content-between align-items-center">
        <h4 class="card-title text-white mb-0">Submitted New Customer Requests</h4>
        <a href="/Onboarding/NewCustomer" class="btn btn-sm btn-light">
            <i class="fas fa-plus me-1"></i>New Form
        </a>
    </div>
    <div class="card-body">

        @* ── Scope Filter Buttons ── *@
        <div class="mb-3 d-flex align-items-center gap-3 flex-wrap">
            <div class="btn-group" role="group" aria-label="Submission scope filter">
                <a class="btn btn-sm @(scope == "branch" ? "btn-primary" : "btn-outline-primary")"
                   asp-action="Submissions" asp-route-scope="branch" asp-route-office="@office"
                   title="Show all submissions for your currently selected branch">
                    <i class="fas fa-building me-1"></i>@branchLabel
                </a>
                <a class="btn btn-sm @(scope == "mine" ? "btn-primary" : "btn-outline-primary")"
                   asp-action="Submissions" asp-route-scope="mine" asp-route-office="@office"
                   title="Show only submissions you created">
                    <i class="fas fa-user me-1"></i>My Forms
                </a>
                @if (canViewAll)
                {
                    <a class="btn btn-sm @(scope == "all" ? "btn-primary" : "btn-outline-primary")"
                       asp-action="Submissions" asp-route-scope="all" asp-route-office="@office"
                       title="Show submissions from all branches (admin/manager)">
                        <i class="fas fa-globe me-1"></i>All Locations
                    </a>
                }
            </div>
            <span class="text-muted small ms-2">@ViewBag.Total result@(ViewBag.Total == 1 ? "" : "s")</span>
        </div>

        @* ── Branch Sub-filter (All scope only) ── *@
        @if (scope == "all" && canViewAll)
        {
            <div class="row g-2 mb-3">
                <div class="col-md-3">
                    <label class="form-label small">Filter by Branch:</label>
                    <select class="form-select form-select-sm" id="officeFilter" onchange="applyFilters()">
                        <option value="">All Branches</option>
                        @if (ViewBag.Locations != null)
                        {
                            @foreach (var loc in (Dictionary<int, (string Code, string Name)>)ViewBag.Locations)
                            {
                                <option value="@loc.Value.Code" selected="@(office == loc.Value.Code ? "selected" : null)">
                                    @loc.Value.Code – @loc.Value.Name
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Submissions" asp-route-scope="all">Clear Filter</a>
                </div>
            </div>
        }

        <table class="table table-striped" id="submissionsTable">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Branch</th>
                    <th>Property Name</th>
                    <th>Submitted By</th>
                    <th>Submitted Date</th>
                    <th>Salesperson</th>
                    <th style="width:110px;">Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr data-id="@Model[i].ID">
                        <td>@(i + 1)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(Model[i].LocationCode))
                            {
                                <span class="badge bg-info">@Model[i].LocationCode</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@Model[i].PropertyName</td>
                        <td>@Model[i].SubmittedBy</td>
                        <td>@Model[i].SubmittedDate.ToString("MM/dd/yyyy")</td>
                        <td>@Model[i].SalespersonName</td>
                        <td>
                            <span class="badge @StatusBadgeClass(Model[i].Status)">@(Model[i].Status ?? "Pending")</span>
                        </td>
                        <td class="text-nowrap">
                            <a href="#" class="btn btn-sm btn-primary view-request me-1" data-id="@Model[i].ID" title="View">
                                <i class="bi bi-eye"></i> View
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-outline-info email-form-btn me-1"
                                    data-id="@Model[i].ID"
                                    data-property="@Model[i].PropertyName"
                                    title="Send by Email">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                        type="button" data-bs-toggle="dropdown" title="Update Status">
                                    <i class="fas fa-tag"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">Set Status</h6></li>
                                    <li><a class="dropdown-item status-update-btn" href="#" data-id="@Model[i].ID" data-status="Pending">
                                        <span class="badge bg-warning text-dark me-1">Pending</span>Pending</a></li>
                                    <li><a class="dropdown-item status-update-btn" href="#" data-id="@Model[i].ID" data-status="Reviewed">
                                        <span class="badge bg-info text-dark me-1">Reviewed</span>Reviewed</a></li>
                                    <li><a class="dropdown-item status-update-btn" href="#" data-id="@Model[i].ID" data-status="Approved">
                                        <span class="badge bg-success me-1">Approved</span>Approved</a></li>
                                    <li><a class="dropdown-item status-update-btn" href="#" data-id="@Model[i].ID" data-status="Rejected">
                                        <span class="badge bg-danger me-1">Rejected</span>Rejected</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- View Request Modal -->
<div class="modal fade" id="viewRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-orange text-white">
                <h5 class="modal-title text-white">Customer Request Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="requestDetailsContainer">
                <div class="text-center p-5 text-muted">Loading...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-outline-info" id="btnEmailFromModal">
                    <i class="fas fa-paper-plane me-1"></i>Send by Email
                </button>
                <a id="btnDownloadPDF" href="#" target="_blank" class="btn btn-outline-primary">
                    <i class="bi bi-file-earmark-pdf"></i> Download PDF
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Email Form Modal -->
<div class="modal fade" id="emailFormModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-paper-plane me-2"></i>Send Form by Email</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3" id="emailFormPropertyLabel"></p>
                <label class="form-label fw-semibold">Recipient Email Address</label>
                <input type="email" class="form-control" id="emailFormTo" placeholder="e.g. recipient@company.com" />
                <div class="form-text">The completed PDF will be attached to the email.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="emailFormSendBtn">
                    <i class="fas fa-paper-plane me-1"></i>Send
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        var _currentEmailFormId = null;

        document.addEventListener("DOMContentLoaded", function () {
            $('#submissionsTable').DataTable();

            document.querySelectorAll('.view-request').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const requestId = $(this).data("id");
                    _currentEmailFormId = requestId;
                    $.get(`/Onboarding/ViewCustomerRequest`, { requestId }, function (html) {
                        $("#viewRequestModal .modal-body").html(html);
                        $("#viewRequestModal").modal("show");
                        document.getElementById('btnDownloadPDF').href = `/Onboarding/ExportCustomerRequestPdf?id=${requestId}`;
                        // Store property name for email modal
                        var row = $(`tr[data-id="${requestId}"]`);
                        $('#emailFormModal').data('property', row.find('td').eq(2).text().trim());
                    });
                });
            });
        });

        // Open email modal from the table row button
        $(document).on('click', '.email-form-btn', function () {
            _currentEmailFormId = $(this).data('id');
            var propertyName = $(this).data('property');
            openEmailModal(_currentEmailFormId, propertyName);
        });

        // Open email modal from the view modal footer
        $('#btnEmailFromModal').on('click', function () {
            var propertyName = $('#emailFormModal').data('property') || '';
            $('#viewRequestModal').modal('hide');
            setTimeout(function () { openEmailModal(_currentEmailFormId, propertyName); }, 400);
        });

        function openEmailModal(id, propertyName) {
            _currentEmailFormId = id;
            $('#emailFormPropertyLabel').text(propertyName ? 'Form for: ' + propertyName : '');
            $('#emailFormTo').val('');
            new bootstrap.Modal(document.getElementById('emailFormModal')).show();
        }

        // Send form by email
        $('#emailFormSendBtn').on('click', function () {
            var email = $('#emailFormTo').val().trim();
            if (!email) { toastr.warning('Please enter a recipient email address.'); return; }

            var $btn = $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Sending…');
            $.post('/Onboarding/EmailForm', { id: _currentEmailFormId, toEmail: email })
                .done(function (res) {
                    if (res.success) {
                        toastr.success('Form sent successfully!');
                        bootstrap.Modal.getInstance(document.getElementById('emailFormModal')).hide();
                    } else {
                        toastr.error(res.message || 'Failed to send.');
                    }
                })
                .fail(function () { toastr.error('Request failed. Check SMTP settings.'); })
                .always(function () { $btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i>Send'); });
        });

        // Status update
        $(document).on('click', '.status-update-btn', function (e) {
            e.preventDefault();
            var id = $(this).data('id');
            var status = $(this).data('status');
            $.post('/Onboarding/UpdateFormStatus', { id: id, status: status })
                .done(function (res) {
                    if (res.success) {
                        toastr.success('Status updated to ' + status);
                        setTimeout(function () { location.reload(); }, 800);
                    } else {
                        toastr.error(res.message || 'Update failed.');
                    }
                })
                .fail(function () { toastr.error('Request failed.'); });
        });

        function applyFilters() {
            const office = document.getElementById('officeFilter')?.value ?? '';
            const params = new URLSearchParams({ scope: 'all', office });
            window.location.href = '/Onboarding/Submissions?' + params.toString();
        }
    </script>
}
