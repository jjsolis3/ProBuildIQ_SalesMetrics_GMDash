        <tr><td><strong>Name:</strong></td><td>Bob RM</td><td><strong>Phone:</strong></td><td>555-1111</td><td><strong>Fax:</strong></td><td>555-2222</td></tr>
        <tr><td><strong>Email:</strong></td><td colspan="5">bobrm@example.com</td></tr>
        <tr><td colspan="6" class="print-section-header">Property Manager</td></tr>
        <tr><td><strong>Name:</strong></td><td>Alice PM</td><td><strong>Phone:</strong></td><td>555-3333</td><td><strong>Fax:</strong></td><td>555-4444</td></tr>
        <tr><td><strong>Email:</strong></td><td colspan="5">alicepm@example.com</td></tr>
    </table>

    <table>
        <tr><td colspan="6" class="print-section-header">Billing Information</td></tr>
        <tr><td><strong>Attention:</strong></td><td colspan="2">Billing Dept</td><td><strong>Invoice Email:</strong></td><td colspan="2">billing@example.com</td></tr>
        <tr><td><strong>Address:</strong></td><td colspan="5">789 Billing Blvd, City, ST 90210</td></tr>
        <tr><td><strong>PDF Invoicing:</strong></td><td>Yes</td><td><strong>Spectrum:</strong></td><td>Yes</td><td><strong>PO Required:</strong></td><td>No</td></tr>
    </table>

    <table>
        <tr><td colspan="6" class="print-section-header">Income Information</td></tr>
        <tr><td><strong>Monthly Revenue:</strong></td><td>$10,000</td><td><strong>AR Credit Limit:</strong></td><td>$5,000</td><td><strong>Discount %:</strong></td><td>20%</td></tr>
