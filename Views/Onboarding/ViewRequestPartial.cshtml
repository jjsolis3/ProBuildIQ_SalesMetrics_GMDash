        <tr><td>Vinyl</td><td>VN123</td><td>Gray</td><td>$4.20</td></tr>
    </table>

    <table>
        <tr><td colspan="2" class="print-section-header">Notes</td></tr>
        <tr><td><strong>Special Notes:</strong></td><td>Handle with care, rush order</td></tr>
        <tr><td><strong>Billing Instructions:</strong></td><td>Send PDF only to billing@example.com</td></tr>
    </table>

    <table>
        <tr><td colspan="4" class="print-section-header">Submitted By</td></tr>
        <tr><td><strong>Submitted By:</strong></td><td>Joe Admin</td><td><strong>Salesperson:</strong></td><td>John Doe</td></tr>
    </table>
</div>



