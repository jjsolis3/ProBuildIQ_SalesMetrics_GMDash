@model SalesMetrics.Models.NewCustomerFormRequest

<style>
    .form-section-title {
        background-color: #f26522;
        color: white;
        padding: 0.5rem 1rem;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .info-grid .row {
        margin-bottom: 0.5rem;
    }

    .info-grid .col-label {
        font-weight: bold;
    }

    .info-grid .col-value {
        border-bottom: 1px dotted #ccc;
        padding-left: 0.5rem;
    }

    table.product-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
        margin-bottom: 1rem;
    }

        table.product-table td,
        table.product-table th {
            border: 1px solid #ddd;
            padding: 4px;
        }

    #printArea table {
        border-collapse: collapse;
        width: 90%;
        font-size: 11px;
        margin-left: 5%;
        margin-bottom: 20px;
    }

    #printArea td, #printArea th {
        padding: 6px;
        border: 1px solid #ccc;
    }

    .print-section-header {
        background-color: #f26522;
        color: white;
        font-weight: bold;
        padding: 6px;
        text-align: left;
    }
</style>

<div id="printArea" class="container-fluid">
    <div class="text-center mb-4">
