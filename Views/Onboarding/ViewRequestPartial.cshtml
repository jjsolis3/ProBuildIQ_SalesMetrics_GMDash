        <tr><td><strong># of Units:</strong></td><td colspan="2">300</td><td colspan="3"></td></tr>
        <tr><td><strong>Ship To Name:</strong></td><td colspan="2">123 ABC</td><td><strong>Ship To Address:</strong></td><td colspan="2">123 Main Street</td></tr>
        <tr><td colspan="6" class="print-section-header">Receiving Contact</td></tr>
        <tr><td><strong>Name:</strong></td><td>Jon</td><td><strong>Phone:</strong></td><td>555-1234</td><td><strong>Fax:</strong></td><td>555-5678</td></tr>
        <tr><td><strong>Email:</strong></td><td colspan="5">jon@example.com</td></tr>
        <tr><td colspan="6" class="print-section-header">Property Contact</td></tr>
        <tr><td><strong>Name:</strong></td><td>Jane</td><td><strong>Phone:</strong></td><td>555-4321</td><td><strong>Fax:</strong></td><td>555-8765</td></tr>
        <tr><td><strong>Email:</strong></td><td colspan="5">jane@example.com</td></tr>
