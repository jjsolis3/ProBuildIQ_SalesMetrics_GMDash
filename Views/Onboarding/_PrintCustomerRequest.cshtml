@model SalesMetrics.Models.NewCustomerFormRequest
@{
    Layout = null;
}

<style>
    body {
        font-family: Arial, sans-serif;
        font-size: 14px;
        margin: 20px;
    }

    h4 {
        margin-top: 0;
        font-size: 20px;
    }

    .form-section-title {
        background-color: #f26522;
        color: white;
        padding: 0.5rem 1rem;
        margin: 1.5rem 0 0.75rem;
        font-weight: bold;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1rem;
    }

    th, td {
        border: none; /* remove all default borders */
        padding: 6px 8px;
        vertical-align: top;
    }

    .no-border th, .no-border td {
        border: none;
        padding: 4px 0;
    }

    .section-table th {
        width: 25%;
        font-weight: bold;
        background: none;
    }

    .section-table td {
        border-bottom: 1px solid #ccc; /* ✅ only bottom border */
    }

    .contact-table {
        width: 100%;
        border: none;
        table-layout: fixed;
    }

        .contact-table > td {
            width: 50%;
            vertical-align: top;
            padding-right: 10px;
        }

        .contact-table .section-table {
            margin-bottom: 0;
        }

            .contact-table .section-table td {
                border-bottom: 1px solid #ccc;
            }


    * {
        box-sizing: border-box;
    }

    .row {
        display: block; /* ✅ safer for wkhtmltopdf */
        clear: both;
    }

    [class^="col-"] {
        float: left;
        padding: 5px;
    }

    .col-6 {
        width: 50%;
    }

    .col-3 {
        width: 25%;
    }

    .col-2 {
        width: 16.6666%;
    }

    .col-4 {
        width: 33.3333%;
    }

    .col-9 {
        width: 75%;
    }

    .col-11 {
        width: 91.6666%;
    }

    .col-1 {
        width: 8.3333%;
    }
</style>

<div>
    <div style="display:table; width:100%; margin-bottom:14px;">
        <div style="display:table-cell; vertical-align:middle; text-align:left; width:33%;">
            @if (!string.IsNullOrEmpty(ViewBag.SeamlessLogoSrc as string))
            {
                <img src="@ViewBag.SeamlessLogoSrc" alt="Seamless Flooring" style="height:80px;" />
            }
        </div>
        <div style="display:table-cell; vertical-align:middle; text-align:center; width:34%;">
            <h4 style="margin:0; font-size:18px;">New Customer Set Up Form</h4>
            @if (!string.IsNullOrEmpty(Model.LocationCode))
            {
                <div style="font-size:11px; color:#555; margin-top:4px;">@Model.LocationCode Branch</div>
            }
        </div>
        <div style="display:table-cell; vertical-align:middle; text-align:right; width:33%;">
            @if (!string.IsNullOrEmpty(ViewBag.SMLogoSrc as string))
            {
                <img src="@ViewBag.SMLogoSrc" alt="SalesMetrics" style="height:40px;" />
            }
        </div>
    </div>

    <div class="form-section-title">Property Information</div>

    <table class="section-table">
        <tr>
            <th>Property Name</th>
            <td>@Model.Property.Name</td>
            <th>Credit Line</th>
            <td>@Model.Property.CreditLine.ToString("C")</td>
        </tr>
        <tr><th># of Units</th><td>@Model.Property.Units</td><th>Ship To Name</th><td>@Model.Property.ShipToName</td></tr>
        <tr><th>Ship To Address</th><td colspan="3">@Model.Property.ShipToAddress</td></tr>
    </table>

    <table class="contact-table">
        <tr>
            <td>
                <table class="section-table">
                    <tr><th colspan="4" style="background-color:lightgrey">Receiving Contact</th></tr>
                    <tr><th>Name</th><td>@Model.Property.ReceivingContact?.Name</td><th>Phone</th><td>@Model.Property.ReceivingContact?.Phone</td></tr>
                    <tr><th>Fax</th><td>@Model.Property.ReceivingContact?.Fax</td><th>Email</th><td>@Model.Property.ReceivingContact?.Email</td></tr>
                </table>
            </td>
            <td>

                <table class="section-table">
                    <tr><th colspan="4" style="background-color:lightgrey">Property Contact</th></tr>
                    <tr><th>Name</th><td>@Model.Property.PropertyContact?.Name</td><th>Phone</th><td>@Model.Property.PropertyContact?.Phone</td></tr>
                    <tr><th>Fax</th><td>@Model.Property.PropertyContact?.Fax</td><th>Email</th><td>@Model.Property.PropertyContact?.Email</td></tr>
                </table>
            </td>
        </tr>
    </table>

    <div class="form-section-title">Management Company Information</div>
    <table class="section-table">
        <tr><th>Company Name</th><td>@Model.ManagementCompany.ManagementName</td><th>Address</th><td>@Model.ManagementCompany.ManagementAddress</td></tr>
    </table>

    <table class="contact-table">
        <tr>
            <td>
                <table class="section-table">
                    <tr><th colspan="4" style="background-color:lightgrey">Regional Manager</th></tr>
                    <tr><th>Name</th><td>@Model.ManagementCompany.RegionalManager?.Name</td><th>Phone</th><td>@Model.ManagementCompany.RegionalManager?.Phone</td></tr>
                    <tr><th>Fax</th><td>@Model.ManagementCompany.RegionalManager?.Fax</td><th>Email</th><td>@Model.ManagementCompany.RegionalManager?.Email</td></tr>
                </table>
            </td>
            <td>
                <table class="section-table">
                    <tr><th colspan="4" style="background-color:lightgrey">Manager</th></tr>
                    <tr><th>Name</th><td>@Model.ManagementCompany.PropertyManager?.Name</td><th>Phone</th><td>@Model.ManagementCompany.PropertyManager?.Phone</td></tr>
                    <tr><th>Fax</th><td>@Model.ManagementCompany.PropertyManager?.Fax</td><th>Email</th><td>@Model.ManagementCompany.PropertyManager?.Email</td></tr>
                </table>
            </td>
        </tr>
    </table>

    <div class="form-section-title">Billing Information</div>
    <table class="section-table">
        <tr>
            <th>Invoice Attention</th>
            <td>@Model.Billing.InvoiceAttention</td>
            <th>Email</th>
            <td>@Model.Billing.InvoiceEmail</td>
        </tr>
        <tr>
            <th>Invoice Address</th>
            <td>@Model.Billing.InvoiceAddress</td>
            <th>City / State / Zip</th>
            <td>@Model.Billing.InvoiceCity, @Model.Billing.InvoiceState @Model.Billing.InvoiceZip</td>
        </tr>
        <tr>
            <th>Third Party Vendor</th>
            <td>@Model.Billing.ThirdPartyVendor</td>
            <th>Customer PO Required</th>
            <td>@(Model.Billing.RequiresCustomerPO ? "Yes" : "No")</td>
        </tr>
        <tr>
            <th>PDF Invoicing</th>
            <td>@(Model.Billing.RequiresPDFInvoices ? "Yes" : "No")</td>
            <th>Spectrum Invoicing</th>
            <td>@(Model.Billing.RequiresSpectrumInvoices ? "Yes" : "No")</td>
        </tr>
    </table>

    <table class="contact-table">
        <tr>
            <td>
                <table class="section-table">
                    <tr>
                        <th colspan="4" style="background-color:lightgrey">Accounts Payable Contact</th>
                    </tr>
                    <tr>
                        <th>Name</th>
                        <td>@Model.Billing.AccountsPayable?.Name</td>
                        <th>Phone</th>
                        <td>@Model.Billing.AccountsPayable?.Phone</td>
                    </tr>
                    <tr>
                        <th>Fax</th>
                        <td>@Model.Billing.AccountsPayable?.Fax</td>
                        <th>Email</th>
                        <td>@Model.Billing.AccountsPayable?.Email</td>
                    </tr>
                </table>
            </td>
            <td>
                <table class="section-table">
                    <tr>
                        <th colspan="4" style="background-color:lightgrey">Alternate AP Contact</th>
                    </tr>
                    <tr>
                        <th>Name</th>
                        <td>@Model.Billing.AlternateAPContact?.Name</td>
                        <th>Phone</th>
                        <td>@Model.Billing.AlternateAPContact?.Phone</td>
                    </tr>
                    <tr>
                        <th>Fax</th>
                        <td>@Model.Billing.AlternateAPContact?.Fax</td>
                        <th>Email</th>
                        <td>@Model.Billing.AlternateAPContact?.Email</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <div class="form-section-title">Income Information</div>
    <table class="section-table">
        <tr>
            <th>Salesperson</th>
            <td>@Model.Income.SalespersonName</td>
            <th>Monthly Revenue</th>
            <td>@Model.Income.EstimatedMonthlyRevenue.ToString("C")</td>
        </tr>
        <tr>
            <th>AR Credit Limit</th>
            <td>@Model.Income.ARCreditLimit.ToString("C")</td>
            <th>Terms</th>
            <td>@Model.Income.Terms</td>
        </tr>
        <tr>
            <th>Discount %</th>
            <td>@Model.Income.DiscountPercent</td>
            <td colspan="2"></td>
        </tr>
    </table>

    <div style="page-break-before: always;"></div>

    @if (Model.Products?.Any() == true)
    {
        <div class="form-section-title">Product Information</div>
        <table>
            <thead>
                <tr style="border-bottom: thick; border-bottom-color:gray;">
                    <th>Product Class</th>
                    <th>Style</th>
                    <th>Color</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr>
                        <td>@p.ProductClass</td>
                        <td>@p.Style</td>
                        <td>@p.Color</td>
                        <td>@p.Price.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="form-section-title">Special Notes</div>
    <p>@Model.SpecialNotes</p>

    <div class="form-section-title">Billing Instructions</div>
    <p>@Model.BillingInstructions</p>

    <div class="row">
        <div class="col-6">
            <div class="form-section-title">Submitted By</div>
            <p><strong>@Model.SubmittedBy</strong></p>
        </div>
        <div class="col-6">
            <div class="form-section-title">Salesperson</div>
            <p><strong>@Model.Income.SalespersonName</strong> </p>
        </div>
    </div>


</div>