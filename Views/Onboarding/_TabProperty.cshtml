@model SalesMetrics.Models.NewCustomerFormRequest

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Property.Name" class="form-label">Property Name</label>
        <input asp-for="Property.Name" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Property.CreditLine" class="form-label">Credit Line</label>
        <input asp-for="Property.CreditLine" class="form-control" />
    </div>
    <div class="col-md-3">
        <label asp-for="Property.Units" class="form-label">Units</label>
        <input asp-for="Property.Units" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="Property.ShipToName" class="form-label">Ship To Name</label>
        <input asp-for="Property.ShipToName" class="form-control" />
    </div>
    <div class="col-md-6">
        <label asp-for="Property.ShipToAddress" class="form-label">Ship To Address</label>
        <input asp-for="Property.ShipToAddress" class="form-control" />
    </div>

    <div class="col-md-6">
        <h6 class="mt-3">Receiving Contact</h6>
        <input type="hidden" asp-for="Property.ReceivingContact.ContactType" value="Receiving" />
        <input asp-for="Property.ReceivingContact.Name" class="form-control mb-1" placeholder="Name" />
        <input asp-for="Property.ReceivingContact.Phone" class="form-control mb-1" placeholder="Phone" />
        <input asp-for="Property.ReceivingContact.Fax" class="form-control mb-1" placeholder="Fax" />
        <input asp-for="Property.ReceivingContact.Email" class="form-control mb-1" placeholder="Email" />
    </div>

    <div class="col-md-6">
        <h6 class="mt-3">Property Contact</h6>
        <input type="hidden" asp-for="Property.PropertyContact.ContactType" value="Property" />
        <input asp-for="Property.PropertyContact.Name" class="form-control mb-1" placeholder="Name" />
        <input asp-for="Property.PropertyContact.Phone" class="form-control mb-1" placeholder="Phone" />
        <input asp-for="Property.PropertyContact.Fax" class="form-control mb-1" placeholder="Fax" />
        <input asp-for="Property.PropertyContact.Email" class="form-control mb-1" placeholder="Email" />
    </div>
</div>
