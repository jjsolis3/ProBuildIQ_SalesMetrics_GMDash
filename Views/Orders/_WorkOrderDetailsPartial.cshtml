@model SalesMetrics.Models.WorkOrderDetailViewModel

@if (!Model.LineItems.Any())
{
    <div class="text-danger">No order details found.</div>
}
else
{
    <div class="p-2">
        <div class="card shadow">
            <div class="card-header d-flex justify-content-between">
                <div>
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <h3>Order #@Model.Header.OrderNumber</h3>
                        </div>
                        @if (Model.Header.InvoiceNumber != 0)
                        {
                            <div class="col-auto mb-2">
                                <h3 class="m-2 badge bg-secondary fs-5">Invoice #@Model.Header.InvoiceNumber</h3>
                            </div>
                        }
                    </div>
                    <p class="mb-1 text-sm">Order Date: @Model.Header.OrderDate.ToString("MM/dd/yyyy")</p>
                    <p class="mb-1 text-sm">Install Date: @Model.Header.DeliveryDate.ToString("MM/dd/yyyy")</p>
                    <p class="mb-0 text-sm">Warehouse: <span style="font-weight:bold">@Model.Header.WhsId.ToString()</span></p>
                </div>
                <div class="text-end">
                    <img src="~/assets/images/logo-dark.png" alt="SalesMetrics Logo" height="32">
                    @* <img src="~/assets/images/logo.png" style="height:40px;" /> *@
                    <p class="mb-1 text-sm">Seamless Flooring</p>
                    <p class="mb-0 text-sm">info@seamless.com | (877) 373-3858</p>
                </div>
            </div>

            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div style="background-color: darkorange;">
                            <h6 class="text-light" style="margin-left: 10px;">Issued For:</h6>
                        </div>
                        <table class="table table-borderless table-sm">
                            <tr>
                                <td class="fw-bold">Property: </td>
                                <td class="fs-6">@Model.Header.CustomerName</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Customer #: </td>
                                <td class ="fs-6">@Model.Header.CustomerNumber</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Management Co.: </td>
                                <td class="fs-6">@Model.Header.MgmtCo (@Model.Header.PriceCode)</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Salesperson: </td>
                                <td class="fs-6">@Model.Header.Salesperson</td>
                            </tr>

                        </table>
                    </div>
                    <div class="col-md-6">
                        <div style="background-color: darkorange;">
                            <h6 class="text-light" style="margin-left: 10px;">
                                Details:
                            </h6>
                        </div>
                        <table class="table table-borderless table-sm">
                            <tr>
                                <td class="fw-bold">Customer PO#: </td>
                                <td class="fs-6">@Model.Header.CustomerPO</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Outstanding: </td>
                                <td class="fs-6">@(Model.Header.BalanceAmount.ToString("C") ?? "$0.00")</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Address: </td>
                                <td class="fs-6"><i class="mdi mdi-map-marker" style="color: red;"></i>
                                    <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(Model.Header.DeliveryAddress)"
                                    target="_blank"
                                    rel="noopener noreferrer">
                                        @Model.Header.DeliveryAddress
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                </td>
                                <td>
                                    <span class="fw-bold">Bldg: </span>
                                    <span class="text-primary fs-6" style="margin-left: 10px;">@Model.Header.Bldg</span>
                                    <span style="margin-left: 25px;"></span>
                                    <span class="fw-bold">Apt #: </span>
                                    <span class="text-primary fs-6" style="margin-left: 10px;">@Model.Header.AptNumber</span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-striped border">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Style</th>
                                <th>Color</th>
                                <th>Description</th>
                                <th>Qty</th>
                                <th>UOM</th>
                                <th>Product Class</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = 1;
                                foreach (var item in Model.LineItems)
                                {
                                    <tr>
                                        <td>@index</td>
                                        <td>@item.Prod_Style</td>
                                        <td>@item.Prod_Color</td>
                                        <td>@item.Description</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.UOM</td>
                                        <td>@item.ProdClass</td>
                                        <td class="text-end">@(item.ProductTotal?.ToString("C") ?? "$0.00")</td>
                                    </tr>
                                    index++;
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Notes.Any())
                {
                    <div class="mt-3">
                        <h6>Notes:</h6>
                        <ul class="list-unstyled">
                            @foreach (var note in Model.Notes)
                            {
                                <li><i class="bi bi-info-circle me-2 text-primary"></i>@note.Comment</li>
                            }
                        </ul>
                    </div>
                }

                <div class="mt-4 d-flex justify-content-between align-items-end" style="min-height: 160px;">
                    <div class="align-self-end">
                        <p class="mb-0 text-muted fs-6">Ordered by: @Model.Header.OrderedBy</p>
                        <p class="mb-1 text-muted fs-6">Paid in Full on: @Model.Header.PaidInFullDate.ToString()</p>
                    </div>
                    <div class="align-self-end">
                        <table class="table table-borderless text-end mb-0">
                            @if (!string.IsNullOrEmpty(Model.Header.PaidInFullDate))
                            {
                                <tr>
                                    <td colspan="2" class="text-end">
                                        <img src="~/assets/images/paid_stamp.png" style="width:150px;" />
                                    </td>
                                </tr>
                            }
                            <tr>
                                <td class="fw-bold"><h5>Total:</h5></td>
                                <td><h5>@Model.LineItems.Sum(i => i.ProductTotal ?? 0).ToString("C")</h5></td>
                            </tr>
                        </table>
                    </div>
                </div>


            </div>
        </div>
        <div class="no-print mt-4 text-end">
            <button class="btn btn-outline-secondary" onclick="printWorkOrder()">🖨️ Print</button>
        </div>
    </div>

    <script>
        function printWorkOrder() {
            const content = document.querySelector('#workOrderDetailContent').innerHTML;
            const printWindow = window.open('', '_blank', 'width=900,height=1000');
            printWindow.document.write(`
                <html>
                <head>
                    <title>Print Work Order</title>
                    <link href="/assets/css/bootstrap.min.css" rel="stylesheet" />
                    <style>
                        @@page {
                            margin: 0;
                        }
                        body {
                            font-family: Arial, sans-serif;
                            margin: 30px 0 0;
                            padding: 0;
                        }
                        .no-print {
                            display: none;
                        }
                        .table th, .table td { vertical-align: middle; }
                        .card { border: 1px solid #ddd; padding: 15px; margin: 0; }
                        .card-header { border-bottom: 1px solid #ccc; margin-bottom: 15px; }
                        .text-end { text-align: right; }
                    </style>
                </head>
                <body onload="window.print(); window.close();">
                    ${content}
                </body>
                </html>
            `);
            printWindow.document.close();
        }
    </script>
}