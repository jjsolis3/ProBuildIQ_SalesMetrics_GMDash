@{
    ViewData["Title"] = "Access Denied";
}

<div class="d-flex flex-column align-items-center justify-content-center py-5">
    <div class="text-center" style="max-width:480px;">
        <div style="font-size:4rem;margin-bottom:1rem;">🔒</div>
        <h3 class="fw-bold mb-2">Access Restricted</h3>
        <p class="text-muted mb-4">
            You don't have permission to run this report. Please contact your administrator
            to request access.
        </p>
        <a href="@Url.Action("Index", "ReportBuilder")" class="btn btn-primary">
            <i class="fa fa-arrow-left me-2"></i>Back to Query Builder
        </a>
    </div>
</div>
