@model SalesMetrics.Models.QueryBuilder.ReportBuilderCreateViewModel
@{
    ViewData["Title"] = "Create Report - Query Builder";
}

<style>
    /* Wizard Progress Bar */
    .wizard-progress {
        display: flex;
        justify-content: space-between;
        margin-bottom: 3rem;
        position: relative;
    }

    .wizard-progress::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        height: 3px;
        background: #e9ecef;
        z-index: 0;
    }

    .wizard-step {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .step-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e9ecef;
        color: #6c757d;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
    }

    .wizard-step.active .step-circle {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
    }

    .wizard-step.completed .step-circle {
        background: #28a745;
        color: white;
    }

    .wizard-step.completed .step-circle::before {
        content: '✓';
    }

    .step-label {
        font-size: 0.875rem;
        color: #6c757d;
        font-weight: 500;
    }

    .wizard-step.active .step-label {
        color: #28a745;
        font-weight: 700;
    }

    /* Wizard Content */
    .wizard-content {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-bottom: 2rem;
    }

    .wizard-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 0.5rem;
    }

    .wizard-subtitle {
        font-size: 1rem;
        color: #6c757d;
        margin-bottom: 2rem;
    }

    /* Table Selection */
    .table-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .table-card {
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 1.25rem;
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
    }

    .table-card:hover {
        border-color: #28a745;
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.15);
        transform: translateY(-2px);
    }

    .table-card.selected {
        border-color: #28a745;
        background: linear-gradient(135deg, rgba(40, 167, 69, 0.05) 0%, rgba(32, 201, 151, 0.05) 100%);
    }

    .table-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
    }

    .table-icon {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1rem;
    }

    .table-checkbox {
        width: 20px;
        height: 20px;
        cursor: pointer;
    }

    .table-name {
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 0.25rem;
    }

    .table-description {
        font-size: 0.875rem;
        color: #6c757d;
        line-height: 1.5;
        margin-bottom: 0.5rem;
    }

    .table-meta {
        display: flex;
        gap: 0.75rem;
        font-size: 0.75rem;
        color: #6c757d;
    }

    .table-badge {
        background: #e9ecef;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-weight: 600;
    }

    /* Search Box */
    .table-search {
        margin-bottom: 1.5rem;
    }

    .search-input {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 3rem;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .search-input:focus {
        border-color: #28a745;
        box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.15);
        outline: none;
    }

    .search-wrapper {
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
    }

    /* Category Filters */
    .category-filters {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .category-btn {
        padding: 0.5rem 1rem;
        border: 2px solid #e9ecef;
        border-radius: 6px;
        background: white;
        color: #6c757d;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .category-btn:hover {
        border-color: #28a745;
        color: #28a745;
    }

    .category-btn.active {
        border-color: #28a745;
        background: #28a745;
        color: white;
    }

    /* Wizard Navigation */
    .wizard-navigation {
        display: flex;
        justify-content: space-between;
        padding: 1.5rem 0;
    }

    .btn-wizard {
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-next {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border: none;
        color: white;
    }

    .btn-next:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(40, 167, 69, 0.3);
    }

    .btn-next:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-back {
        background: #6c757d;
        border: none;
        color: white;
    }

    .btn-back:hover {
        background: #5a6268;
    }

    .selected-count {
        background: #28a745;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-weight: 600;
    }

    .no-tables {
        text-align: center;
        padding: 3rem;
        color: #6c757d;
    }

    /* Step 1.5: Table Relationships */
    .relationship-row {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1.5rem;
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        margin-bottom: 1rem;
        position: relative;
    }

    .relationship-row:hover {
        border-color: #28a745;
        box-shadow: 0 2px 8px rgba(40, 167, 69, 0.1);
    }

    .relationship-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .relationship-title {
        font-weight: 600;
        color: #1a1a2e;
        font-size: 0.95rem;
    }

    .relationship-fields {
        display: grid;
        grid-template-columns: 2fr 1fr 2fr;
        gap: 1rem;
        align-items: end;
    }

    .relationship-field {
        display: flex;
        flex-direction: column;
    }

    .relationship-field label {
        font-size: 0.875rem;
        font-weight: 500;
        color: #6c757d;
        margin-bottom: 0.5rem;
    }

    .relationship-field select,
    .relationship-field input {
        padding: 0.5rem;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        font-size: 0.875rem;
    }

    .join-type-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .join-type-INNER {
        background: #d1ecf1;
        color: #0c5460;
    }

    .join-type-LEFT {
        background: #fff3cd;
        color: #856404;
    }

    .join-type-RIGHT {
        background: #f8d7da;
        color: #721c24;
    }

    .join-type-FULL {
        background: #e2e3e5;
        color: #383d41;
    }

    .relationship-empty-state {
        text-align: center;
        padding: 3rem;
        color: #6c757d;
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .relationship-empty-state i {
        font-size: 3rem;
        color: #dee2e6;
        margin-bottom: 1rem;
    }

    .btn-remove-relationship {
        background: #dc3545;
        color: white;
        border: none;
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.875rem;
    }

    .btn-remove-relationship:hover {
        background: #c82333;
    }

    /* Step 2: Column Configuration */
    .column-table-group {
        margin-bottom: 2rem;
    }

    .table-group-header {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 1rem 1.5rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .table-group-header:hover {
        background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
    }

    .table-group-title {
        font-weight: 700;
        color: #1a1a2e;
        font-size: 1.125rem;
    }

    .table-group-stats {
        color: #6c757d;
        font-size: 0.875rem;
    }

    .column-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 0.75rem;
    }

    .column-item {
        display: flex;
        align-items: center;
        padding: 1rem;
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .column-item:hover {
        border-color: #28a745;
        box-shadow: 0 2px 8px rgba(40, 167, 69, 0.1);
    }

    .column-item.selected {
        border-color: #28a745;
        background: rgba(40, 167, 69, 0.05);
    }

    .column-checkbox {
        margin-right: 1rem;
        width: 20px;
        height: 20px;
        cursor: pointer;
    }

    .column-info {
        flex: 1;
    }

    .column-name {
        font-weight: 600;
        color: #1a1a2e;
        margin-bottom: 0.25rem;
    }

    .column-type {
        font-size: 0.875rem;
        color: #6c757d;
    }

    .column-config-icon {
        color: #6c757d;
        font-size: 1.25rem;
        transition: all 0.3s ease;
    }

    .column-item:hover .column-config-icon {
        color: #28a745;
    }

    .select-all-table {
        color: #28a745;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: underline;
        cursor: pointer;
    }

    .select-all-table:hover {
        color: #20a03a;
    }

    /* Step 3: Filter Builder */
    .filter-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .filter-row:hover {
        border-color: #28a745;
        box-shadow: 0 2px 8px rgba(40, 167, 69, 0.1);
    }

    .filter-row select, .filter-row input {
        flex: 1;
        padding: 0.5rem;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        font-size: 0.875rem;
    }

    .filter-row .logical-operator {
        flex: 0 0 80px;
        font-weight: 600;
        color: #6c757d;
        text-align: center;
    }

    .filter-row .btn-remove-filter {
        flex: 0 0 auto;
        background: #dc3545;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .filter-row .btn-remove-filter:hover {
        background: #c82333;
    }

    .filter-empty-state {
        text-align: center;
        padding: 3rem;
        color: #6c757d;
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .filter-empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: #adb5bd;
    }

    /* Query Mode Toggle */
    .query-mode-toggle {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 2rem;
        gap: 1rem;
    }

    .mode-toggle-btn {
        padding: 0.75rem 2rem;
        border: 2px solid #e9ecef;
        background: white;
        color: #6c757d;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .mode-toggle-btn:hover {
        border-color: #28a745;
        color: #28a745;
    }

    .mode-toggle-btn.active {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        border-color: #28a745;
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
    }

    /* SQL Editor */
    .sql-editor-container {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-bottom: 2rem;
    }

    .sql-editor {
        width: 100%;
        min-height: 400px;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 14px;
        padding: 1rem;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        resize: vertical;
    }

    .sql-editor:focus {
        outline: none;
        border-color: #28a745;
        box-shadow: 0 0 0 3px rgba(40, 167, 69, 0.1);
    }

    .sql-editor-hint {
        font-size: 0.875rem;
        color: #6c757d;
        margin-top: 0.5rem;
    }

    .sql-editor-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }

    /* Column Formatting Controls */
    .column-format-controls {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        margin-top: 0.5rem;
        padding: 0.5rem;
        background: #f8f9fa;
        border-radius: 4px;
        font-size: 0.875rem;
    }

    .format-label {
        font-weight: 600;
        color: #495057;
        margin-right: 0.25rem;
    }

    .format-select, .format-input {
        padding: 0.25rem 0.5rem;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 0.875rem;
    }

    .format-select:focus, .format-input:focus {
        outline: none;
        border-color: #28a745;
        box-shadow: 0 0 0 2px rgba(40, 167, 69, 0.1);
    }
</style>

<div class="container-fluid">
    <!-- Query Mode Toggle -->
    <div class="query-mode-toggle">
        <button type="button" id="wizardModeBtn" class="mode-toggle-btn active">
            <i class="fa fa-magic"></i> Wizard Mode
        </button>
        <button type="button" id="sqlModeBtn" class="mode-toggle-btn">
            <i class="fa fa-code"></i> SQL Mode
        </button>
    </div>

    <!-- SQL Editor Container (hidden by default) -->
    <div id="sqlEditorContainer" style="display: none;">
        <div class="sql-editor-container">
            <h2 class="wizard-title"><i class="fa fa-code"></i> SQL Query Editor</h2>
            <p class="wizard-subtitle">Write your custom SQL SELECT query below</p>

            <textarea id="sqlQueryEditor" class="sql-editor" placeholder="-- Simple query:
SELECT column1, column2
FROM TableName
WHERE condition = 'value'

-- CTE (WITH) is supported:
WITH OrderTotals AS (
    SELECT OrderId, SUM(Amount) AS Total
    FROM ORDER_DETAIL
    GROUP BY OrderId
)
SELECT o.OrderId, o.Total
FROM OrderTotals o

-- Use @@ParamName for reusable filters (e.g. @@StartDate, @@ProductClass)
-- Table names resolve against your branch's ERP database automatically"></textarea>

            <div class="sql-editor-hint">
                <i class="fa fa-info-circle"></i>
                <strong>Supported:</strong> SELECT and WITH (CTE) queries. Use <code>@@ParamName</code> for reusable parameters.
                No DDL/DML (INSERT, UPDATE, DELETE, DROP).
                Queries run against your branch's ERP database. Use simple names like <code>INVOICE_HEADER</code> or qualified like <code>[CompUFloorLA].[dbo].[TableName]</code>.
            </div>

            <div class="sql-editor-actions">
                <button type="button" id="btnValidateSql" class="btn btn-info">
                    <i class="fa fa-check-circle"></i> Validate SQL
                </button>
                <button type="button" id="btnPreviewSql" class="btn btn-success">
                    <i class="fa fa-eye"></i> Preview Results
                </button>
            </div>
        </div>
    </div>

    <!-- Wizard Progress -->
    <div id="wizardContainer">
    <div class="wizard-progress">
        <div class="wizard-step @(Model.CurrentStep == 1 ? "active" : "") @(Model.CurrentStep > 1 ? "completed" : "")">
            <div class="step-circle">1</div>
            <div class="step-label">Select Tables</div>
        </div>
        <div class="wizard-step @(Model.CurrentStep == 2 ? "active" : "") @(Model.CurrentStep > 2 ? "completed" : "")">
            <div class="step-circle">2</div>
            <div class="step-label">Configure Columns</div>
        </div>
        <div class="wizard-step @(Model.CurrentStep == 3 ? "active" : "") @(Model.CurrentStep > 3 ? "completed" : "")">
            <div class="step-circle">3</div>
            <div class="step-label">Add Filters</div>
        </div>
        <div class="wizard-step @(Model.CurrentStep == 4 ? "active" : "") @(Model.CurrentStep > 4 ? "completed" : "")">
            <div class="step-circle">4</div>
            <div class="step-label">Preview</div>
        </div>
        <div class="wizard-step @(Model.CurrentStep == 5 ? "active" : "")">
            <div class="step-circle">5</div>
            <div class="step-label">Save Report</div>
        </div>
    </div>

    <!-- Step 1: Table Selection -->
    @if (Model.CurrentStep == 1)
    {
        <div id="step1Container">
        <div class="wizard-content">
            <h2 class="wizard-title"><i class="fa fa-table"></i> Select Tables</h2>
            <p class="wizard-subtitle">Choose one or more tables to include in your report</p>

            <!-- Search -->
            <div class="table-search">
                <div class="search-wrapper">
                    <i class="fa fa-search search-icon"></i>
                    <input type="text"
                           id="tableSearch"
                           class="search-input"
                           placeholder="Search tables by name or description..."
                           autocomplete="off">
                </div>
            </div>

            <!-- Category Filters -->
            <div class="category-filters">
                <button class="category-btn active" data-category="all">All Categories</button>
                @foreach (var category in Model.AvailableTables.Select(t => t.Category).Distinct().OrderBy(c => c))
                {
                    <button class="category-btn" data-category="@category">@category</button>
                }
            </div>

            <!-- Selected Count -->
            <div class="mb-3">
                <span class="selected-count">
                    <span id="selectedCount">0</span> table(s) selected
                </span>
            </div>

            <!-- Table Grid -->
            @if (Model.AvailableTables.Any())
            {
                <div class="table-grid" id="tableGrid">
                    @foreach (var table in Model.AvailableTables)
                    {
                        <div class="table-card"
                             data-table-id="@table.TableId"
                             data-table-name="@table.TableName"
                             data-category="@table.Category"
                             data-search="@(table.TableName.ToLower()) @(table.DisplayName.ToLower()) @(table.Description.ToLower())">
                            <div class="table-card-header">
                                <div class="table-icon">
                                    <i class="fa fa-table"></i>
                                </div>
                                <input type="checkbox" class="table-checkbox" data-table-id="@table.TableId">
                            </div>
                            <div class="table-name">@table.DisplayName</div>
                            <div class="table-description">
                                @(string.IsNullOrEmpty(table.Description) ? "No description available" : table.Description)
                            </div>
                            <div class="table-meta">
                                <span class="table-badge">@table.Category</span>
                                <span class="table-badge">@table.DataSourceType</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-tables">
                    <i class="fa fa-inbox fa-3x mb-3"></i>
                    <h4>No Tables Available</h4>
                    <p>No tables have been whitelisted for the Query Builder yet.</p>
                    @if (Model.IsAdmin)
                    {
                        <p><a href="#">Configure table whitelist</a></p>
                    }
                </div>
            }
        </div>

        <!-- Navigation -->
        <div class="wizard-navigation">
            <a href="@Url.Action("Index")" class="btn btn-back">
                <i class="fa fa-arrow-left"></i> Cancel
            </a>
            <button type="button" id="btnNext" class="btn btn-next" disabled>
                Next: Configure Columns <i class="fa fa-arrow-right"></i>
            </button>
        </div>
        </div>
    }

    <!-- Step 1.5: Configure Relationships (only shown when 2+ tables selected) -->
    <div id="step1_5Container" style="display: none;">
        <div class="wizard-content">
            <h2 class="wizard-title"><i class="fa fa-link"></i> Configure Table Relationships</h2>
            <p class="wizard-subtitle">Define how your tables connect. Relationships are used to join data from multiple tables.</p>

            <!-- Relationships Container -->
            <div id="relationshipsContainer">
                <!-- Relationships will be rendered here dynamically -->
            </div>

            <!-- Add Relationship Button -->
            <button type="button" id="btnAddRelationship" class="btn btn-success mb-3">
                <i class="fa fa-plus"></i> Add Relationship
            </button>

            <!-- Help Text -->
            <div class="alert alert-info mt-3">
                <i class="fa fa-info-circle"></i>
                <strong>Tip:</strong> Most tables use business keys like <code>Customer_Number</code> or <code>Order_Number</code> to relate to each other.
                Choose the appropriate join type based on your needs:
                <ul class="mb-0 mt-2">
                    <li><strong>INNER JOIN:</strong> Only returns rows that have matching values in both tables</li>
                    <li><strong>LEFT JOIN:</strong> Returns all rows from the left table, even if no match exists</li>
                    <li><strong>RIGHT JOIN:</strong> Returns all rows from the right table, even if no match exists</li>
                    <li><strong>FULL OUTER JOIN:</strong> Returns all rows from both tables, matching where possible</li>
                </ul>
            </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="wizard-navigation">
            <button type="button" id="btnBackToStep1" class="btn btn-back">
                <i class="fa fa-arrow-left"></i> Back
            </button>
            <button type="button" id="btnNextStep1_5" class="btn btn-next">
                Next: Configure Columns <i class="fa fa-arrow-right"></i>
            </button>
        </div>
    </div>

    <!-- Step 2: Column Configuration -->
    <div id="step2Container" style="display: none;">
        <div class="wizard-content">
            <h2 class="wizard-title"><i class="fa fa-columns"></i> Configure Columns</h2>
            <p class="wizard-subtitle">Select the columns you want to include in your report</p>

            <!-- Search -->
            <div class="table-search">
                <div class="search-wrapper">
                    <i class="fa fa-search search-icon"></i>
                    <input type="text"
                           id="columnSearch"
                           class="search-input"
                           placeholder="Search columns by name..."
                           autocomplete="off">
                </div>
            </div>

            <!-- Selected Count -->
            <div class="mb-3">
                <span class="selected-count">
                    <span id="selectedColumnCount">0</span> column(s) selected
                </span>
            </div>

            <!-- Column Groups (by table) -->
            <div id="columnGroupsContainer">
                <!-- Will be populated dynamically by JavaScript -->
            </div>
        </div>

        <!-- Navigation -->
        <div class="wizard-navigation">
            <button type="button" id="btnBackToStep1" class="btn btn-back">
                <i class="fa fa-arrow-left"></i> Back
            </button>
            <button type="button" id="btnNextStep2" class="btn btn-next" disabled>
                Next: Add Filters <i class="fa fa-arrow-right"></i>
            </button>
        </div>
    </div>

    <!-- Step 3: Filter Configuration -->
    <div id="step3Container" style="display: none;">
        <div class="wizard-content">
            <h2 class="wizard-title"><i class="fa fa-filter"></i> Add Filters (Optional)</h2>
            <p class="wizard-subtitle">Add conditions to filter your data. You can skip this step if no filtering is needed.</p>

            <!-- Filters List -->
            <div id="filtersContainer">
                <!-- Filters will be added here dynamically -->
            </div>

            <!-- Add Filter Button -->
            <button type="button" id="btnAddFilter" class="btn btn-success mb-3">
                <i class="fa fa-plus"></i> Add Filter
            </button>
        </div>

        <!-- Navigation -->
        <div class="wizard-navigation">
            <button type="button" id="btnBackToStep2" class="btn btn-back">
                <i class="fa fa-arrow-left"></i> Back
            </button>
            <button type="button" id="btnNextStep3" class="btn btn-next">
                Next: Preview <i class="fa fa-arrow-right"></i>
            </button>
        </div>
    </div>

    <!-- Step 4: Preview Query Results -->
    <div id="step4Container" style="display: none;">
        <div class="wizard-content">
            <h2 class="wizard-title"><i class="fa fa-eye"></i> Preview Results</h2>
            <p class="wizard-subtitle">Review your query results before saving the report</p>

            <!-- Query SQL Display -->
            <div class="card mb-4">
                <div class="card-header" style="background: linear-gradient(135deg, #17a2b8 0%, #20c997 100%); color: white;">
                    <h5 class="mb-0"><i class="fa fa-code"></i> Generated SQL Query</h5>
                </div>
                <div class="card-body">
                    <pre id="generatedSqlDisplay" class="bg-light p-3 rounded" style="max-height: 200px; overflow-y: auto; font-family: 'Courier New', monospace; font-size: 0.9em;"></pre>
                </div>
            </div>

            <!-- Execution Stats -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <i class="fa fa-table fa-2x text-primary mb-2"></i>
                            <h4 id="previewRowCount" class="mb-0">-</h4>
                            <small class="text-muted">Rows Returned</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <i class="fa fa-clock fa-2x text-success mb-2"></i>
                            <h4 id="executionTime" class="mb-0">-</h4>
                            <small class="text-muted">Execution Time</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <i class="fa fa-columns fa-2x text-info mb-2"></i>
                            <h4 id="columnCount" class="mb-0">-</h4>
                            <small class="text-muted">Columns</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Preview Data Table -->
            <div class="card">
                <div class="card-header" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white;">
                    <h5 class="mb-0"><i class="fa fa-table"></i> Data Preview (First 100 rows)</h5>
                </div>
                <div class="card-body" style="overflow-x: auto;">
                    <div id="previewTableContainer">
                        <div class="text-center text-muted py-5">
                            <i class="fa fa-spinner fa-spin fa-3x"></i>
                            <p class="mt-3">Loading preview...</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="wizard-navigation">
                <button type="button" id="btnBackToStep3" class="btn btn-back">
                    <i class="fa fa-arrow-left"></i> Back
                </button>
                <button type="button" id="btnNextStep4" class="btn btn-next">
                    Save Report <i class="fa fa-save"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Step 5: Save Report -->
    <div id="step5Container" style="display: none;">
        <div class="wizard-content">
            <h2 class="wizard-title"><i class="fa fa-save"></i> Save Your Report</h2>
            <p class="wizard-subtitle">Give your report a name and description</p>

            <div class="row">
                <div class="col-md-8 offset-md-2">
                    <!-- Report Name -->
                    <div class="mb-4">
                        <label for="reportName" class="form-label">
                            <i class="fa fa-file-alt"></i> Report Name <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control form-control-lg"
                               id="reportName"
                               placeholder="e.g., Monthly Sales by Region"
                               required>
                        <small class="form-text text-muted">Choose a descriptive name that clearly identifies the report's purpose</small>
                    </div>

                    <!-- Report Description -->
                    <div class="mb-4">
                        <label for="reportDescription" class="form-label">
                            <i class="fa fa-align-left"></i> Description
                        </label>
                        <textarea class="form-control"
                                  id="reportDescription"
                                  rows="4"
                                  placeholder="Describe what this report shows and when to use it..."></textarea>
                        <small class="form-text text-muted">Optional: Add details to help others understand this report</small>
                    </div>

                    <!-- Category -->
                    <div class="mb-4">
                        <label for="reportCategory" class="form-label">
                            <i class="fa fa-folder"></i> Category
                        </label>
                        <select class="form-select" id="reportCategory">
                            <option value="Custom Reports" selected>Custom Reports</option>
                            <option value="Sales">Sales</option>
                            <option value="Finance">Finance</option>
                            <option value="Operations">Operations</option>
                            <option value="Management">Management</option>
                        </select>
                    </div>

                    <!-- Summary -->
                    <div class="card bg-light">
                        <div class="card-body">
                            <h6 class="card-title"><i class="fa fa-info-circle"></i> Report Summary</h6>
                            <ul class="mb-0">
                                <li><strong>Tables:</strong> <span id="summaryTables">-</span></li>
                                <li><strong>Columns:</strong> <span id="summaryColumns">-</span></li>
                                <li><strong>Filters:</strong> <span id="summaryFilters">-</span></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="wizard-navigation">
                <button type="button" id="btnBackToStep4" class="btn btn-back">
                    <i class="fa fa-arrow-left"></i> Back
                </button>
                <button type="button" id="btnSaveReport" class="btn btn-success">
                    <i class="fa fa-check"></i> Save Report
                </button>
            </div>
        </div>
    </div>
    </div> <!-- Close wizardContainer -->
</div> <!-- Close container-fluid -->

@section Scripts {
    <script>
        $(document).ready(function() {
            // ============================================
            // Query Mode Toggle
            // ============================================
            let queryMode = 'wizard'; // 'wizard' or 'sql'
            let customSqlQuery = '';
            let sqlParameterValues = {}; // Parameter values for SQL mode

            // Mode toggle buttons
            $('#wizardModeBtn').on('click', function() {
                queryMode = 'wizard';
                $('#wizardModeBtn').addClass('active');
                $('#sqlModeBtn').removeClass('active');
                $('#wizardContainer').show();
                $('#sqlEditorContainer').hide();
            });

            $('#sqlModeBtn').on('click', function() {
                queryMode = 'sql';
                $('#sqlModeBtn').addClass('active');
                $('#wizardModeBtn').removeClass('active');
                $('#wizardContainer').hide();
                $('#sqlEditorContainer').show();
            });

            // Validate SQL button
            $('#btnValidateSql').on('click', function() {
                const sql = $('#sqlQueryEditor').val().trim();
                if (!sql) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Empty Query',
                        text: 'Please enter a SQL query first'
                    });
                    return;
                }

                // Basic client-side validation
                // Strip SQL comments before checking
                const stripped = sql.replace(/--.*$/gm, '').replace(/\/\*[\s\S]*?\*\//g, '').trim();
                const upperSql = stripped.toUpperCase();
                if (!upperSql.startsWith('SELECT') && !upperSql.startsWith('WITH')) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Query',
                        text: 'Query must start with SELECT or WITH (for CTEs)'
                    });
                    return;
                }

                // For CTEs, verify there's a final SELECT after the WITH...AS block
                if (upperSql.startsWith('WITH') && !/\)\s*SELECT\b/.test(upperSql)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid CTE',
                        text: 'CTE query must end with a SELECT statement after the WITH...AS block'
                    });
                    return;
                }

                // Use word-boundary matching to avoid false positives on column/table names
                const blockedKeywords = ['INSERT', 'DELETE', 'DROP', 'ALTER', 'TRUNCATE', 'BACKUP', 'RESTORE', 'GRANT', 'REVOKE', 'DENY'];
                for (let keyword of blockedKeywords) {
                    const re = new RegExp('\\b' + keyword + '\\b');
                    if (re.test(upperSql)) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Blocked Keyword',
                            text: `Query contains blocked keyword: ${keyword}`
                        });
                        return;
                    }
                }

                // Block UPDATE as a statement (not in column names like UPDATE_DATE)
                if (/\bUPDATE\s+\w+\s+SET\b/.test(upperSql)) {
                    Swal.fire({ icon: 'error', title: 'Blocked', text: 'UPDATE statements are not allowed' });
                    return;
                }
                // Block EXEC/EXECUTE as procedure calls
                if (/\bEXEC(UTE)?\s+(SP_|XP_|DBO\.|@@|\[)/.test(upperSql)) {
                    Swal.fire({ icon: 'error', title: 'Blocked', text: 'EXEC/EXECUTE statements are not allowed' });
                    return;
                }

                Swal.fire({
                    icon: 'success',
                    title: 'SQL Validated',
                    text: 'Query passed basic validation. Click "Preview Results" to execute it.'
                });
            });

            // Detect parameter patterns in SQL (skip system variables)
            function detectSqlParameters(sql) {
                const matches = sql.match(/(?<!@@)@@([A-Za-z_]\w*)/g);
                if (!matches) return [];
                // Deduplicate and strip the prefix
                const unique = [...new Set(matches)];
                return unique.map(m => {
                    const name = m.substring(1); // strip the at-sign
                    // Guess input type from parameter name
                    const lower = name.toLowerCase();
                    let type = 'text';
                    if (lower.includes('date') || lower.includes('start') || lower.includes('end') || lower.includes('from') || lower.includes('to')) {
                        type = 'date';
                    }
                    // Check if used in IN() clause
                    const inRegex = new RegExp('IN\\s*\\(\\s*@@' + name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\s*\\)', 'i');
                    const isInClause = inRegex.test(sql);
                    return { name, type, isInClause };
                });
            }

            // Preview SQL button
            $('#btnPreviewSql').on('click', function() {
                const sql = $('#sqlQueryEditor').val().trim();
                if (!sql) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Empty Query',
                        text: 'Please enter a SQL query first'
                    });
                    return;
                }

                customSqlQuery = sql;

                // Detect parameters in the SQL
                const params = detectSqlParameters(sql);

                if (params.length === 0) {
                    // No parameters — execute directly
                    sqlParameterValues = {};
                    loadStep4SqlMode();
                    return;
                }

                // Build a parameter input form using SweetAlert
                let formHtml = '<div style="text-align:left;">';
                params.forEach(p => {
                    const inputType = p.type === 'date' ? 'date' : 'text';
                    const hint = p.isInClause ? '<small class="text-muted">Comma-separated for multiple values</small>' : '';
                    formHtml += `
                        <div class="mb-3">
                            <label class="form-label fw-bold">@@${p.name}</label>
                            ${hint}
                            <input type="${inputType}" class="form-control swal-param-input"
                                   data-param-name="${p.name}" placeholder="Enter value for @@${p.name}">
                        </div>`;
                });
                formHtml += '</div>';

                Swal.fire({
                    title: 'Enter Parameter Values',
                    html: formHtml,
                    width: 500,
                    showCancelButton: true,
                    confirmButtonText: '<i class="fa fa-eye"></i> Preview Results',
                    confirmButtonColor: '#28a745',
                    preConfirm: () => {
                        const values = {};
                        let hasEmpty = false;
                        document.querySelectorAll('.swal-param-input').forEach(input => {
                            const val = input.value.trim();
                            if (!val) hasEmpty = true;
                            values[input.dataset.paramName] = val;
                        });
                        if (hasEmpty) {
                            Swal.showValidationMessage('Please fill in all parameter values');
                            return false;
                        }
                        return values;
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        sqlParameterValues = result.value;
                        loadStep4SqlMode();
                    }
                });
            });

            let selectedTables = [];

            // Table card click
            $('.table-card').on('click', function(e) {
                if ($(e.target).is('input[type="checkbox"]')) return;

                const checkbox = $(this).find('.table-checkbox');
                checkbox.prop('checked', !checkbox.prop('checked')).trigger('change');
            });

            // Checkbox change
            $('.table-checkbox').on('change', function(e) {
                e.stopPropagation();
                const tableCard = $(this).closest('.table-card');
                const tableId = $(this).data('table-id');
                const tableName = tableCard.data('table-name');

                if ($(this).is(':checked')) {
                    tableCard.addClass('selected');
                    selectedTables.push({ id: tableId, name: tableName });
                } else {
                    tableCard.removeClass('selected');
                    selectedTables = selectedTables.filter(t => t.id !== tableId);
                }

                updateSelectedCount();
            });

            // Update selected count
            function updateSelectedCount() {
                $('#selectedCount').text(selectedTables.length);
                $('#btnNext').prop('disabled', selectedTables.length === 0);
            }

            // Search functionality
            $('#tableSearch').on('input', function() {
                const query = $(this).val().toLowerCase();
                filterTables();
            });

            // Category filter
            $('.category-btn').on('click', function() {
                $('.category-btn').removeClass('active');
                $(this).addClass('active');
                filterTables();
            });

            function filterTables() {
                const query = $('#tableSearch').val().toLowerCase();
                const category = $('.category-btn.active').data('category');

                $('.table-card').each(function() {
                    const searchText = $(this).data('search');
                    const cardCategory = $(this).data('category');

                    const matchesSearch = query === '' || searchText.indexOf(query) !== -1;
                    const matchesCategory = category === 'all' || cardCategory === category;

                    if (matchesSearch && matchesCategory) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            // Next button - Submit Step 1 and load Step 2
            $('#btnNext').on('click', function() {
                if (selectedTables.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Tables Selected',
                        text: 'Please select at least one table to continue.'
                    });
                    return;
                }

                // Show loading
                Swal.fire({
                    title: 'Loading columns...',
                    html: 'Please wait while we fetch column information',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // Submit to backend

                $.ajax({
                    url: '@Url.Action("CreateStep1", "ReportBuilder")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        selectedTableIds: selectedTables.map(t => t.id)
                    }),
                    success: function(response) {

                        if (response.success) {
                            Swal.close();

                            // Check if we should go to Step 1.5 (Relationships) or Step 2 (Columns)
                            if (response.nextStep === 1.5) {
                                loadStep1_5(response.tablesWithColumns);
                            } else if (response.nextStep === 2) {
                                loadStep2(response.columns);
                            }
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to load columns'
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            html: `Failed to submit table selection.<br><br><small>Status: ${xhr.status} ${xhr.statusText}<br>Error: ${error}</small>`
                        });
                    }
                });
            });

            // ===========================================
            // Step 1.5: Configure Relationships
            // ===========================================
            let tablesWithColumns = [];
            let relationships = [];
            let relationshipIdCounter = 0;

            function loadStep1_5(tables) {
                tablesWithColumns = tables;

                // Hide Step 1, show Step 1.5
                $('#step1Container').hide();
                $('#step1_5Container').show();

                // Update wizard progress - keep Step 1 active during relationships
                // Don't mark Step 2 as active yet since we're still configuring table relationships
                $('.wizard-step:nth-child(1)').addClass('active');


                // Auto-add first relationship
                addRelationship();

                // Setup Step 1.5 events
                setupStep1_5Events();

            }

            function setupStep1_5Events() {
                // Add relationship button
                $('#btnAddRelationship').off('click').on('click', function() {
                    addRelationship();
                });

                // Back button
                $('#btnBackToStep1').off('click').on('click', function() {
                    $('#step1_5Container').hide();
                    $('#step1Container').show();
                    // Keep Step 1 active
                });

                // Next button - Submit relationships
                $('#btnNextStep1_5').off('click').on('click', function() {
                    submitRelationships();
                });
            }

            function addRelationship() {
                const relationshipId = relationshipIdCounter++;
                const relationship = {
                    id: relationshipId,
                    leftTable: tablesWithColumns.length > 0 ? tablesWithColumns[0].tableName : '',
                    leftColumn: '',
                    rightTable: tablesWithColumns.length > 1 ? tablesWithColumns[1].tableName : '',
                    rightColumn: '',
                    joinType: 'INNER',
                    additionalCondition: ''
                };

                relationships.push(relationship);
                renderRelationships();
            }

            function removeRelationship(relationshipId) {
                relationships = relationships.filter(r => r.id !== relationshipId);
                renderRelationships();
            }

            function renderRelationships() {
                const container = $('#relationshipsContainer');

                if (relationships.length === 0) {
                    container.html(`
                        <div class="relationship-empty-state">
                            <i class="fa fa-link"></i>
                            <h5>No Relationships Yet</h5>
                            <p>Click "Add Relationship" to define how your tables connect</p>
                        </div>
                    `);
                    return;
                }

                let html = '';
                relationships.forEach((rel, index) => {
                    // Get columns for left table
                    const leftTable = tablesWithColumns.find(t => t.tableName === rel.leftTable);
                    const leftColumns = leftTable ? leftTable.columns : [];

                    // Get columns for right table
                    const rightTable = tablesWithColumns.find(t => t.tableName === rel.rightTable);
                    const rightColumns = rightTable ? rightTable.columns : [];

                    html += `
                        <div class="relationship-row" data-relationship-id="${rel.id}">
                            <div class="relationship-header">
                                <span class="relationship-title">
                                    <i class="fa fa-link"></i> Relationship ${index + 1}
                                    <span class="join-type-badge join-type-${rel.joinType}">${rel.joinType} JOIN</span>
                                </span>
                                ${relationships.length > 1 ? `
                                    <button type="button" class="btn-remove-relationship" data-relationship-id="${rel.id}">
                                        <i class="fa fa-times"></i> Remove
                                    </button>
                                ` : ''}
                            </div>

                            <div class="relationship-fields">
                                <!-- Left Table & Column -->
                                <div class="relationship-field">
                                    <label>From Table & Column</label>
                                    <select class="left-table-select" data-relationship-id="${rel.id}">
                                        ${tablesWithColumns.map(t => `
                                            <option value="${t.tableName}" ${t.tableName === rel.leftTable ? 'selected' : ''}>
                                                ${t.displayName}
                                            </option>
                                        `).join('')}
                                    </select>
                                    <select class="left-column-select mt-2" data-relationship-id="${rel.id}">
                                        <option value="">Select column...</option>
                                        ${leftColumns.map(c => `
                                            <option value="${c.columnName}" ${c.columnName === rel.leftColumn ? 'selected' : ''}>
                                                ${c.columnName} (${c.dataType})
                                            </option>
                                        `).join('')}
                                    </select>
                                </div>

                                <!-- Join Type -->
                                <div class="relationship-field">
                                    <label>Join Type</label>
                                    <select class="join-type-select" data-relationship-id="${rel.id}">
                                        <option value="INNER" ${rel.joinType === 'INNER' ? 'selected' : ''}>INNER</option>
                                        <option value="LEFT" ${rel.joinType === 'LEFT' ? 'selected' : ''}>LEFT</option>
                                        <option value="RIGHT" ${rel.joinType === 'RIGHT' ? 'selected' : ''}>RIGHT</option>
                                        <option value="FULL" ${rel.joinType === 'FULL' ? 'selected' : ''}>FULL OUTER</option>
                                    </select>
                                </div>

                                <!-- Right Table & Column -->
                                <div class="relationship-field">
                                    <label>To Table & Column</label>
                                    <select class="right-table-select" data-relationship-id="${rel.id}">
                                        ${tablesWithColumns.map(t => `
                                            <option value="${t.tableName}" ${t.tableName === rel.rightTable ? 'selected' : ''}>
                                                ${t.displayName}
                                            </option>
                                        `).join('')}
                                    </select>
                                    <select class="right-column-select mt-2" data-relationship-id="${rel.id}">
                                        <option value="">Select column...</option>
                                        ${rightColumns.map(c => `
                                            <option value="${c.columnName}" ${c.columnName === rel.rightColumn ? 'selected' : ''}>
                                                ${c.columnName} (${c.dataType})
                                            </option>
                                        `).join('')}
                                    </select>
                                </div>
                            </div>
                        </div>
                    `;
                });

                container.html(html);

                // Bind events
                $('.left-table-select').off('change').on('change', function() {
                    const relId = parseInt($(this).data('relationship-id'));
                    const rel = relationships.find(r => r.id === relId);
                    if (rel) {
                        rel.leftTable = $(this).val();
                        rel.leftColumn = ''; // Reset column when table changes
                        renderRelationships();
                    }
                });

                $('.left-column-select').off('change').on('change', function() {
                    const relId = parseInt($(this).data('relationship-id'));
                    const rel = relationships.find(r => r.id === relId);
                    if (rel) rel.leftColumn = $(this).val();
                });

                $('.join-type-select').off('change').on('change', function() {
                    const relId = parseInt($(this).data('relationship-id'));
                    const rel = relationships.find(r => r.id === relId);
                    if (rel) {
                        rel.joinType = $(this).val();
                        renderRelationships(); // Re-render to update badge
                    }
                });

                $('.right-table-select').off('change').on('change', function() {
                    const relId = parseInt($(this).data('relationship-id'));
                    const rel = relationships.find(r => r.id === relId);
                    if (rel) {
                        rel.rightTable = $(this).val();
                        rel.rightColumn = ''; // Reset column when table changes
                        renderRelationships();
                    }
                });

                $('.right-column-select').off('change').on('change', function() {
                    const relId = parseInt($(this).data('relationship-id'));
                    const rel = relationships.find(r => r.id === relId);
                    if (rel) rel.rightColumn = $(this).val();
                });

                $('.btn-remove-relationship').off('click').on('click', function() {
                    const relId = parseInt($(this).data('relationship-id'));
                    removeRelationship(relId);
                });
            }

            function submitRelationships() {
                // Validate relationships
                if (relationships.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Relationships Defined',
                        text: 'Please add at least one relationship between your tables.'
                    });
                    return;
                }

                // Validate each relationship has all required fields
                for (let i = 0; i < relationships.length; i++) {
                    const rel = relationships[i];
                    if (!rel.leftTable || !rel.leftColumn || !rel.rightTable || !rel.rightColumn) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Incomplete Relationship',
                            text: `Relationship ${i + 1} is missing required fields. Please select both tables and columns.`
                        });
                        return;
                    }
                }

                // Show loading
                Swal.fire({
                    title: 'Saving relationships...',
                    html: 'Please wait',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // Prepare data for submission - use PascalCase to match C# model
                const relationshipsData = relationships.map(r => ({
                    LeftTable: r.leftTable,
                    LeftColumn: r.leftColumn,
                    RightTable: r.rightTable,
                    RightColumn: r.rightColumn,
                    JoinType: r.joinType,
                    AdditionalCondition: r.additionalCondition || null
                }));


                // Submit to backend
                $.ajax({
                    url: '@Url.Action("CreateStep1_5", "ReportBuilder")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        Relationships: relationshipsData
                    }),
                    success: function(response) {

                        if (response.success) {
                            Swal.close();
                            loadStep2(response.columns);
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to save relationships'
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            html: `Failed to save relationships.<br><br><small>Status: ${xhr.status} ${xhr.statusText}</small>`
                        });
                    }
                });
            }

            // ===========================================
            // Step 2: Column Configuration
            // ===========================================
            let allColumns = [];
            let selectedColumns = [];

            function loadStep2(columns) {

                if (!columns || columns.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Columns Found',
                        text: 'No columns were found for the selected tables.'
                    });
                    return;
                }

                allColumns = columns;

                // Hide Step 1 and Step 1.5, show Step 2
                $('#step1Container').hide();
                $('#step1_5Container').hide();
                $('.wizard-step:nth-child(1)').addClass('completed');
                $('.wizard-step:nth-child(2)').addClass('active');
                $('#step2Container').show();


                try {
                    // Group columns by table
                    const groupedColumns = {};
                    columns.forEach(col => {
                        if (!groupedColumns[col.tableName]) {
                            groupedColumns[col.tableName] = {
                                displayName: col.tableDisplayName,
                                columns: []
                            };
                        }
                        groupedColumns[col.tableName].columns.push(col);
                    });


                    // Render column groups
                    let html = '';
                    for (const [tableName, group] of Object.entries(groupedColumns)) {
                        html += `
                            <div class="column-table-group">
                                <div class="table-group-header">
                                    <div>
                                        <div class="table-group-title">${group.displayName}</div>
                                        <div class="table-group-stats">
                                            <span class="selected-in-table">0</span> of ${group.columns.length} columns selected
                                        </div>
                                    </div>
                                    <span class="select-all-table" data-table="${tableName}">Select All</span>
                                </div>
                                <div class="column-list">
                                    ${group.columns.map(col => `
                                        <div class="column-item" data-column-id="${col.columnId}">
                                            <input type="checkbox" class="column-checkbox" data-column-id="${col.columnId}">
                                            <div class="column-info">
                                                <div class="column-name">${col.columnName}</div>
                                                <div class="column-type">${col.dataType}${col.isNullable ? ' (nullable)' : ''}</div>
                                            </div>
                                            <div class="column-format-controls" style="display: none;">
                                                <span class="format-label">Format:</span>
                                                <select class="format-select format-type" data-column-id="${col.columnId}">
                                                    <option value="text">Text</option>
                                                    <option value="currency">Currency</option>
                                                    <option value="number">Number</option>
                                                    <option value="date">Date</option>
                                                    <option value="percentage">Percentage</option>
                                                </select>
                                                <span class="format-options" data-column-id="${col.columnId}"></span>
                                            </div>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        `;
                    }

                    $('#columnGroupsContainer').html(html);

                    // Bind events
                    setupStep2Events();

                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'JavaScript Error',
                        html: `An error occurred while loading columns:<br><br><code>${error.message}</code>`
                    });
                }
            }

            function setupStep2Events() {
                // Column item click
                $('.column-item').on('click', function(e) {
                    if ($(e.target).is('input[type="checkbox"]')) return;
                    const checkbox = $(this).find('.column-checkbox');
                    checkbox.prop('checked', !checkbox.prop('checked')).trigger('change');
                });

                // Column checkbox change
                $('.column-checkbox').on('change', function(e) {
                    e.stopPropagation();
                    const columnItem = $(this).closest('.column-item');
                    const columnId = $(this).data('column-id');

                    if ($(this).is(':checked')) {
                        columnItem.addClass('selected');
                        const column = allColumns.find(c => c.columnId === columnId);

                        // Initialize format properties if not present
                        if (!column.formatType) {
                            column.formatType = 'text';
                            column.dateFormat = 'MM/dd/yyyy';
                            column.decimalPlaces = 2;
                        }

                        selectedColumns.push(column);

                        // Show format controls
                        columnItem.find('.column-format-controls').show();
                    } else {
                        columnItem.removeClass('selected');
                        selectedColumns = selectedColumns.filter(c => c.columnId !== columnId);

                        // Hide format controls
                        columnItem.find('.column-format-controls').hide();
                    }

                    updateColumnCounts();
                });

                // Format type change
                $(document).on('change', '.format-type', function() {
                    const columnId = $(this).data('column-id');
                    const formatType = $(this).val();
                    const optionsSpan = $(`.format-options[data-column-id="${columnId}"]`);
                    const column = allColumns.find(c => c.columnId === columnId);

                    if (column) {
                        column.formatType = formatType;
                    }

                    // Show format-specific options
                    let optionsHtml = '';
                    if (formatType === 'date') {
                        optionsHtml = `
                            <select class="format-select date-format-pattern" data-column-id="${columnId}">
                                <option value="MM/dd/yyyy">MM/dd/yyyy</option>
                                <option value="yyyy-MM-dd">yyyy-MM-dd</option>
                                <option value="MMM dd, yyyy">MMM dd, yyyy</option>
                                <option value="MM/dd/yy">MM/dd/yy</option>
                                <option value="dd/MM/yyyy">dd/MM/yyyy</option>
                            </select>
                        `;
                    } else if (formatType === 'currency' || formatType === 'number' || formatType === 'percentage') {
                        optionsHtml = `
                            <span class="format-label">Decimals:</span>
                            <input type="number" class="format-input decimal-places" data-column-id="${columnId}"
                                   min="0" max="4" value="2" style="width: 60px;">
                        `;
                    }

                    optionsSpan.html(optionsHtml);
                });

                // Date format pattern change
                $(document).on('change', '.date-format-pattern', function() {
                    const columnId = $(this).data('column-id');
                    const pattern = $(this).val();
                    const column = allColumns.find(c => c.columnId === columnId);
                    if (column) {
                        column.dateFormat = pattern;
                    }
                });

                // Decimal places change
                $(document).on('change', '.decimal-places', function() {
                    const columnId = $(this).data('column-id');
                    const decimals = parseInt($(this).val());
                    const column = allColumns.find(c => c.columnId === columnId);
                    if (column) {
                        column.decimalPlaces = decimals;
                    }
                });

                // Select all for table
                $('.select-all-table').on('click', function(e) {
                    e.stopPropagation();
                    const tableName = $(this).data('table');
                    const tableGroup = $(this).closest('.column-table-group');
                    const checkboxes = tableGroup.find('.column-checkbox');

                    const allChecked = checkboxes.filter(':checked').length === checkboxes.length;
                    checkboxes.prop('checked', !allChecked).trigger('change');
                });

                // Search columns
                $('#columnSearch').on('input', function() {
                    const query = $(this).val().toLowerCase();
                    $('.column-item').each(function() {
                        const columnName = $(this).find('.column-name').text().toLowerCase();
                        if (query === '' || columnName.indexOf(query) !== -1) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                });

                // Back button
                $('#btnBackToStep1').on('click', function() {
                    $('#step2Container').hide();
                    $('#step1Container').show();
                    $('.wizard-step:nth-child(2)').removeClass('active');
                    $('.wizard-step:nth-child(1)').removeClass('completed').addClass('active');
                });

                // Next button (Step 2) - Submit and proceed to Step 3
                $('#btnNextStep2').on('click', function() {
                    if (selectedColumns.length === 0) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'No Columns Selected',
                            text: 'Please select at least one column to continue.'
                        });
                        return;
                    }


                    // Submit to backend
                    $.ajax({
                        url: '@Url.Action("CreateStep2", "ReportBuilder")',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            selectedColumns: selectedColumns
                        }),
                        success: function(response) {
                            if (response.success) {
                                loadStep3(response.selectedColumns);
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: response.message || 'Failed to save column configuration'
                                });
                            }
                        },
                        error: function(xhr, status, error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                html: `Failed to submit columns.<br><small>Status: ${xhr.status}</small>`
                            });
                        }
                    });
                });
            }

            function updateColumnCounts() {
                // Update global count
                $('#selectedColumnCount').text(selectedColumns.length);
                $('#btnNextStep2').prop('disabled', selectedColumns.length === 0);

                // Update per-table counts
                $('.column-table-group').each(function() {
                    const tableGroup = $(this);
                    const selectedInTable = tableGroup.find('.column-checkbox:checked').length;
                    tableGroup.find('.selected-in-table').text(selectedInTable);

                    // Update select all text
                    const totalInTable = tableGroup.find('.column-checkbox').length;
                    const selectAllBtn = tableGroup.find('.select-all-table');
                    if (selectedInTable === totalInTable) {
                        selectAllBtn.text('Deselect All');
                    } else {
                        selectAllBtn.text('Select All');
                    }
                });
            }

            // ===========================================
            // Step 3: Filter Configuration
            // ===========================================
            let reportColumns = [];
            let filters = [];
            let filterIdCounter = 0;

            function loadStep3(columns) {

                reportColumns = columns;

                // Hide Step 2, show Step 3
                $('#step2Container').hide();
                $('#step3Container').show();
                $('.wizard-step:nth-child(2)').addClass('completed');
                $('.wizard-step:nth-child(3)').addClass('active');


                // Setup Step 3 events
                setupStep3Events();

                // Show empty state
                showEmptyFilterState();
            }

            function setupStep3Events() {
                // Add filter button
                $('#btnAddFilter').off('click').on('click', function() {
                    addFilter();
                });

                // Back button
                $('#btnBackToStep2').off('click').on('click', function() {
                    $('#step3Container').hide();
                    $('#step2Container').show();
                    $('.wizard-step:nth-child(3)').removeClass('active');
                    $('.wizard-step:nth-child(2)').removeClass('completed').addClass('active');
                });

                // Next button (Step 3) - Proceed to Step 4 (Preview)
                $('#btnNextStep3').off('click').on('click', function() {
                    // Filters are optional, so we can proceed even with 0 filters

                    // Proceed to Step 4 (Preview)
                    loadStep4();
                });
            }

            function showEmptyFilterState() {
                if (filters.length === 0) {
                    $('#filtersContainer').html(`
                        <div class="filter-empty-state">
                            <i class="fa fa-filter"></i>
                            <h4>No Filters Yet</h4>
                            <p>Click "Add Filter" to add conditions to your query.<br>Filters are optional - you can skip this step if you want all data.</p>
                        </div>
                    `);
                }
            }

            function addFilter() {
                const filterId = filterIdCounter++;
                const isFirstFilter = filters.length === 0;

                const filter = {
                    id: filterId,
                    columnId: '',
                    operator: '=',
                    value: '',
                    logicalOperator: 'AND'
                };

                filters.push(filter);

                renderFilters();
            }

            function renderFilters() {
                if (filters.length === 0) {
                    showEmptyFilterState();
                    return;
                }

                let html = '';
                filters.forEach((filter, index) => {
                    const isFirstFilter = index === 0;

                    html += `
                        <div class="filter-row" data-filter-id="${filter.id}">
                            ${!isFirstFilter ? `
                                <div class="logical-operator">
                                    <select class="filter-logical" data-filter-id="${filter.id}">
                                        <option value="AND" ${filter.logicalOperator === 'AND' ? 'selected' : ''}>AND</option>
                                        <option value="OR" ${filter.logicalOperator === 'OR' ? 'selected' : ''}>OR</option>
                                    </select>
                                </div>
                            ` : '<div style="flex: 0 0 80px;"></div>'}

                            <select class="filter-column" data-filter-id="${filter.id}">
                                <option value="">Select Column</option>
                                ${reportColumns.map(col => `
                                    <option value="${col.columnId}" ${filter.columnId === col.columnId ? 'selected' : ''}>
                                        ${col.tableDisplayName}.${col.columnName}
                                    </option>
                                `).join('')}
                            </select>

                            <select class="filter-operator" data-filter-id="${filter.id}">
                                <option value="=" ${filter.operator === '=' ? 'selected' : ''}>Equals (=)</option>
                                <option value="!=" ${filter.operator === '!=' ? 'selected' : ''}>Not Equals (!=)</option>
                                <option value=">" ${filter.operator === '>' ? 'selected' : ''}>Greater Than (>)</option>
                                <option value="<" ${filter.operator === '<' ? 'selected' : ''}>Less Than (<)</option>
                                <option value=">=" ${filter.operator === '>=' ? 'selected' : ''}>Greater or Equal (>=)</option>
                                <option value="<=" ${filter.operator === '<=' ? 'selected' : ''}>Less or Equal (<=)</option>
                                <option value="LIKE" ${filter.operator === 'LIKE' ? 'selected' : ''}>Contains (LIKE)</option>
                                <option value="IN" ${filter.operator === 'IN' ? 'selected' : ''}>In List (IN)</option>
                                <option value="IS NULL" ${filter.operator === 'IS NULL' ? 'selected' : ''}>Is NULL</option>
                                <option value="IS NOT NULL" ${filter.operator === 'IS NOT NULL' ? 'selected' : ''}>Is NOT NULL</option>
                            </select>

                            <input type="text" class="filter-value" data-filter-id="${filter.id}"
                                   value="${filter.value}"
                                   placeholder="Enter value..."
                                   ${(filter.operator === 'IS NULL' || filter.operator === 'IS NOT NULL') ? 'disabled' : ''}>

                            <button type="button" class="btn-remove-filter" data-filter-id="${filter.id}">
                                <i class="fa fa-trash"></i> Remove
                            </button>
                        </div>
                    `;
                });

                $('#filtersContainer').html(html);

                // Bind events
                $('.filter-column').on('change', function() {
                    const filterId = $(this).data('filter-id');
                    const filter = filters.find(f => f.id === filterId);
                    if (filter) {
                        filter.columnId = $(this).val();
                    }
                });

                $('.filter-operator').on('change', function() {
                    const filterId = $(this).data('filter-id');
                    const filter = filters.find(f => f.id === filterId);
                    if (filter) {
                        filter.operator = $(this).val();
                        // Disable value input for IS NULL / IS NOT NULL
                        if (filter.operator === 'IS NULL' || filter.operator === 'IS NOT NULL') {
                            $(`.filter-value[data-filter-id="${filterId}"]`).prop('disabled', true).val('');
                            filter.value = '';
                        } else {
                            $(`.filter-value[data-filter-id="${filterId}"]`).prop('disabled', false);
                        }
                    }
                });

                $('.filter-value').on('input', function() {
                    const filterId = $(this).data('filter-id');
                    const filter = filters.find(f => f.id === filterId);
                    if (filter) {
                        filter.value = $(this).val();
                    }
                });

                $('.filter-logical').on('change', function() {
                    const filterId = $(this).data('filter-id');
                    const filter = filters.find(f => f.id === filterId);
                    if (filter) {
                        filter.logicalOperator = $(this).val();
                    }
                });

                $('.btn-remove-filter').on('click', function() {
                    const filterId = $(this).data('filter-id');
                    filters = filters.filter(f => f.id !== filterId);
                    renderFilters();
                });
            }

            // ============================================
            // Step 4: Preview Query Results
            // ============================================

            // Load Step 4 in SQL Mode
            function loadStep4SqlMode() {

                // Show wizard container to display Step 4
                $('#wizardContainer').show();
                $('#sqlEditorContainer').hide();

                // Hide all steps, show Step 4
                $('#step1Container, #step1_5Container, #step2Container, #step3Container, #step5Container').hide();
                $('#step4Container').show();
                $('.wizard-step').removeClass('active');
                $('.wizard-step:nth-child(4)').addClass('active');

                // Build request payload for SQL mode
                const payload = {
                    queryMode: 'sql',
                    customSql: customSqlQuery,
                    tables: [],
                    relationships: [],
                    columns: [],
                    filters: [],
                    parameterValues: sqlParameterValues
                };


                // Call preview API
                $.ajax({
                    url: '@Url.Action("CreateStep4", "ReportBuilder")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(response) {

                        if (response.success) {
                            // Display generated SQL
                            $('#generatedSqlDisplay').text(response.generatedSql);

                            // Display stats
                            $('#previewRowCount').text(response.rowCount);
                            $('#executionTime').text(response.executionTimeMs + ' ms');
                            $('#columnCount').text(response.columnNames.length);

                            // Build and display preview table
                            displayPreviewTable(response.columnNames, response.previewData);

                            // Store data for Step 5
                            window.previewPayload = payload;
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Preview Error',
                                html: `<p>${response.message}</p><pre class="text-start" style="max-height: 300px; overflow-y: auto;">${response.errorDetails || ''}</pre>`
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error Loading Preview',
                            text: 'Failed to execute query: ' + error
                        });
                    }
                });

                // Setup Step 4 event handlers
                setupStep4Events();
            }

            function loadStep4() {

                // Hide Step 3, show Step 4
                $('#step3Container').hide();
                $('#step4Container').show();
                $('.wizard-step:nth-child(3)').addClass('completed');
                $('.wizard-step:nth-child(4)').addClass('active');

                // Build a stable alias map: tableName -> T1, T2, etc.
                // This ensures every reference to the same table uses the same alias.
                const aliasMap = {};
                tablesWithColumns.forEach((t, index) => {
                    const name = t.tableName || t.TableName;
                    aliasMap[name] = `T${index + 1}`;
                });

                function getAlias(tableName) {
                    return aliasMap[tableName] || 'T0';
                }

                // Build request payload
                const payload = {
                    queryMode: 'wizard',
                    customSql: null,
                    tables: tablesWithColumns.map((t, index) => ({
                        tableName: t.tableName || t.TableName,
                        alias: `T${index + 1}`,
                        isBaseTable: index === 0
                    })),
                    relationships: relationships.map(r => {
                        const fromTable = r.leftTable || r.LeftTable;
                        const toTable = r.rightTable || r.RightTable;
                        return {
                            fromTable: fromTable,
                            fromColumn: r.leftColumn || r.LeftColumn,
                            fromAlias: getAlias(fromTable),
                            toTable: toTable,
                            toColumn: r.rightColumn || r.RightColumn,
                            toAlias: getAlias(toTable),
                            joinType: r.joinType || r.JoinType
                        };
                    }),
                    columns: selectedColumns.map((col, index) => ({
                        tableName: col.tableName || col.TableName,
                        tableAlias: getAlias(col.tableName || col.TableName),
                        columnName: col.columnName || col.ColumnName,
                        displayName: col.displayName || col.DisplayName || col.columnName || col.ColumnName,
                        dataType: col.dataType || col.DataType,
                        aggregateFunction: col.aggregateFunction || col.AggregateFunction,
                        displayOrder: index + 1,
                        formatType: col.formatType || 'text',
                        dateFormat: col.dateFormat || 'MM/dd/yyyy',
                        decimalPlaces: col.decimalPlaces || 2
                    })),
                    filters: filters.map(f => {
                        // Look up the column details from reportColumns using columnId
                        const column = reportColumns.find(c => c.columnId === f.columnId);
                        if (!column) {
                            return null;
                        }

                        return {
                            tableAlias: getAlias(column.tableName || column.TableName),
                            columnName: column.columnName || column.ColumnName,
                            operator: f.operator || f.Operator,
                            value: f.value || f.Value,
                            logicalOperator: f.logicalOperator || f.LogicalOperator || 'AND'
                        };
                    }).filter(f => f !== null)
                };


                // Call preview API
                $.ajax({
                    url: '@Url.Action("CreateStep4", "ReportBuilder")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(response) {

                        if (response.success) {
                            // Display generated SQL
                            $('#generatedSqlDisplay').text(response.generatedSql);

                            // Display stats
                            $('#previewRowCount').text(response.rowCount);
                            $('#executionTime').text(response.executionTimeMs + ' ms');
                            $('#columnCount').text(response.columnNames.length);

                            // Build and display preview table
                            displayPreviewTable(response.columnNames, response.previewData);

                            // Store data for Step 5
                            window.previewPayload = payload;
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Preview Error',
                                html: `<p>${response.message}</p><pre class="text-start" style="max-height: 300px; overflow-y: auto;">${response.errorDetails || ''}</pre>`
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error Loading Preview',
                            text: 'Failed to execute query: ' + error
                        });
                    }
                });

                // Setup Step 4 event handlers
                setupStep4Events();
            }

            function displayPreviewTable(columnNames, data) {
                // Get column format info from preview payload
                const columnsMetadata = window.previewPayload?.columns || [];

                let html = '<table class="table table-sm table-striped table-hover">';

                // Header
                html += '<thead class="table-dark"><tr>';
                columnNames.forEach(col => {
                    html += `<th>${col}</th>`;
                });
                html += '</tr></thead>';

                // Body
                html += '<tbody>';
                data.forEach(row => {
                    html += '<tr>';
                    columnNames.forEach((colName, colIndex) => {
                        const value = row[colName];
                        let displayValue;

                        if (value === null || value === undefined) {
                            displayValue = '<em class="text-muted">NULL</em>';
                        } else {
                            // Find format info for this column
                            const colMetadata = columnsMetadata.find(c =>
                                (c.displayName === colName) || (c.columnName === colName)
                            );

                            displayValue = formatValue(value, colMetadata);
                        }

                        html += `<td>${displayValue}</td>`;
                    });
                    html += '</tr>';
                });
                html += '</tbody>';

                html += '</table>';

                $('#previewTableContainer').html(html);
            }

            // Helper function to format values based on column format type
            function formatValue(value, columnMetadata) {
                if (!columnMetadata || columnMetadata.formatType === 'text') {
                    return value;
                }

                const formatType = columnMetadata.formatType;
                const decimalPlaces = columnMetadata.decimalPlaces || 2;
                const dateFormat = columnMetadata.dateFormat || 'MM/dd/yyyy';

                try {
                    switch (formatType) {
                        case 'currency':
                            const num = parseFloat(value);
                            if (isNaN(num)) return value;
                            return '$' + num.toLocaleString('en-US', {
                                minimumFractionDigits: decimalPlaces,
                                maximumFractionDigits: decimalPlaces
                            });

                        case 'number':
                            const number = parseFloat(value);
                            if (isNaN(number)) return value;
                            return number.toLocaleString('en-US', {
                                minimumFractionDigits: decimalPlaces,
                                maximumFractionDigits: decimalPlaces
                            });

                        case 'percentage':
                            const pct = parseFloat(value);
                            if (isNaN(pct)) return value;
                            return pct.toLocaleString('en-US', {
                                minimumFractionDigits: decimalPlaces,
                                maximumFractionDigits: decimalPlaces
                            }) + '%';

                        case 'date':
                            // Parse date and format according to pattern
                            const date = new Date(value);
                            if (isNaN(date.getTime())) return value;

                            return formatDate(date, dateFormat);

                        default:
                            return value;
                    }
                } catch (e) {
                    return value;
                }
            }

            // Helper function to format dates
            function formatDate(date, pattern) {
                const pad = (n) => n.toString().padStart(2, '0');
                const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

                const replacements = {
                    'yyyy': date.getFullYear(),
                    'yy': date.getFullYear().toString().substr(-2),
                    'MM': pad(date.getMonth() + 1),
                    'MMM': monthNames[date.getMonth()],
                    'dd': pad(date.getDate()),
                    'HH': pad(date.getHours()),
                    'mm': pad(date.getMinutes()),
                    'ss': pad(date.getSeconds())
                };

                let result = pattern;
                for (const [key, val] of Object.entries(replacements)) {
                    result = result.replace(key, val);
                }
                return result;
            }

            function setupStep4Events() {
                // Back button
                $('#btnBackToStep3').off('click').on('click', function() {
                    $('#step4Container').hide();
                    $('#step3Container').show();
                    $('.wizard-step:nth-child(4)').removeClass('active');
                    $('.wizard-step:nth-child(3)').removeClass('completed').addClass('active');
                });

                // Next button (proceed to Step 5)
                $('#btnNextStep4').off('click').on('click', function() {
                    loadStep5();
                });
            }

            // ============================================
            // Step 5: Save Report
            // ============================================
            function loadStep5() {

                // Hide Step 4, show Step 5
                $('#step4Container').hide();
                $('#step5Container').show();
                $('.wizard-step:nth-child(4)').addClass('completed');
                $('.wizard-step:nth-child(5)').addClass('active');

                // Populate summary
                $('#summaryTables').text(tablesWithColumns.map(t => t.DisplayName || t.TableName).join(', '));
                $('#summaryColumns').text(selectedColumns.length + ' column(s)');
                $('#summaryFilters').text(filters.length + ' filter(s)');

                // Setup Step 5 event handlers
                setupStep5Events();
            }

            function setupStep5Events() {
                // Back button
                $('#btnBackToStep4').off('click').on('click', function() {
                    $('#step5Container').hide();
                    $('#step4Container').show();
                    $('.wizard-step:nth-child(5)').removeClass('active');
                    $('.wizard-step:nth-child(4)').removeClass('completed').addClass('active');
                });

                // Save button
                $('#btnSaveReport').off('click').on('click', function() {
                    saveReport();
                });
            }

            function saveReport() {
                const reportName = $('#reportName').val().trim();
                const reportDescription = $('#reportDescription').val().trim();
                const category = $('#reportCategory').val();

                // Validation
                if (!reportName) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Report Name Required',
                        text: 'Please enter a name for your report'
                    });
                    $('#reportName').focus();
                    return;
                }

                // Build save payload (include queryMode and customSql from preview)
                const payload = {
                    reportName: reportName,
                    reportDescription: reportDescription,
                    category: category,
                    queryMode: window.previewPayload.queryMode || 'wizard',
                    customSql: window.previewPayload.customSql || null,
                    tables: window.previewPayload.tables || [],
                    relationships: window.previewPayload.relationships || [],
                    columns: window.previewPayload.columns || [],
                    filters: window.previewPayload.filters || []
                };


                // Show loading
                Swal.fire({
                    title: 'Saving Report...',
                    html: 'Please wait while we save your report',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // Call save API
                $.ajax({
                    url: '@Url.Action("SaveReport", "ReportBuilder")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(response) {

                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Report Saved!',
                                html: `<p>Your report <strong>"${response.reportName}"</strong> has been saved successfully!</p>`,
                                confirmButtonText: 'Go to Reports'
                            }).then((result) => {
                                // Redirect to report catalog
                                window.location.href = '@Url.Action("Index", "ReportBuilder")';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Save Failed',
                                text: response.message
                            });
                        }
                    },
                    error: function(xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error Saving Report',
                            text: 'Failed to save report: ' + error
                        });
                    }
                });
            }
        });
    </script>
}
