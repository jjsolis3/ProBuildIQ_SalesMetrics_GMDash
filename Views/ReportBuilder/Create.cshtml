@{
    ViewData["Title"] = "Create Report - Query Builder";
}

<style>
    .coming-soon-container {
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .coming-soon-card {
        background: white;
        border-radius: 16px;
        padding: 4rem 3rem;
        text-align: center;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        max-width: 600px;
    }

    .coming-soon-icon {
        font-size: 5rem;
        color: #28a745;
        margin-bottom: 2rem;
    }

    .coming-soon-card h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 1rem;
    }

    .coming-soon-card p {
        font-size: 1.1rem;
        color: #6c757d;
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    .feature-list {
        text-align: left;
        margin: 2rem auto;
        max-width: 400px;
    }

    .feature-list li {
        padding: 0.75rem 0;
        border-bottom: 1px solid #e9ecef;
        color: #495057;
    }

    .feature-list li:last-child {
        border-bottom: none;
    }

    .feature-list i {
        color: #28a745;
        margin-right: 0.75rem;
    }
</style>

<div class="coming-soon-container">
    <div class="coming-soon-card">
        <div class="coming-soon-icon">
            <i class="fa fa-tools"></i>
        </div>
        <h1>Coming Soon!</h1>
        <p>The visual Query Builder wizard is currently under development. This powerful tool will let you create custom reports without writing SQL.</p>

        <ul class="feature-list list-unstyled">
            <li><i class="fa fa-check-circle"></i> Visual table and column selection</li>
            <li><i class="fa fa-check-circle"></i> Drag-and-drop query building</li>
            <li><i class="fa fa-check-circle"></i> Advanced filtering and sorting</li>
            <li><i class="fa fa-check-circle"></i> Multi-source data integration</li>
            <li><i class="fa fa-check-circle"></i> Custom calculations and aggregations</li>
            <li><i class="fa fa-check-circle"></i> Real-time query preview</li>
        </ul>

        <div class="mt-4">
            <a href="@Url.Action("Index")" class="btn btn-lg" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; border: none; padding: 0.75rem 2rem; border-radius: 8px; font-weight: 600;">
                <i class="fa fa-arrow-left"></i> Back to Reports
            </a>
        </div>

        <div class="mt-4 text-muted">
            <small><i class="fa fa-info-circle"></i> Phase 2 of the Query Builder will be implemented in an upcoming release.</small>
        </div>
    </div>
</div>
