@model SalesMetrics.Models.QueryBuilder.ReportBuilderCreateViewModel
@{
    ViewData["Title"] = "Create Report - Query Builder";
}

<style>
    /* Wizard Progress Bar */
    .wizard-progress {
        display: flex;
        justify-content: space-between;
        margin-bottom: 3rem;
        position: relative;
    }

    .wizard-progress::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        height: 3px;
        background: #e9ecef;
        z-index: 0;
    }

    .wizard-step {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .step-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #e9ecef;
        color: #6c757d;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
    }

    .wizard-step.active .step-circle {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
    }

    .wizard-step.completed .step-circle {
        background: #28a745;
        color: white;
    }

    .wizard-step.completed .step-circle::before {
        content: '✓';
    }

    .step-label {
        font-size: 0.875rem;
        color: #6c757d;
        font-weight: 500;
    }

    .wizard-step.active .step-label {
        color: #28a745;
        font-weight: 700;
    }

    /* Wizard Content */
    .wizard-content {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-bottom: 2rem;
    }

    .wizard-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 0.5rem;
    }

    .wizard-subtitle {
        font-size: 1rem;
        color: #6c757d;
        margin-bottom: 2rem;
    }

    /* Table Selection */
    .table-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .table-card {
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: 1.25rem;
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
    }

    .table-card:hover {
        border-color: #28a745;
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.15);
        transform: translateY(-2px);
    }

    .table-card.selected {
        border-color: #28a745;
        background: linear-gradient(135deg, rgba(40, 167, 69, 0.05) 0%, rgba(32, 201, 151, 0.05) 100%);
    }

    .table-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
    }

    .table-icon {
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1rem;
    }

    .table-checkbox {
        width: 20px;
        height: 20px;
        cursor: pointer;
    }

    .table-name {
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 0.25rem;
    }

    .table-description {
        font-size: 0.875rem;
        color: #6c757d;
        line-height: 1.5;
        margin-bottom: 0.5rem;
    }

    .table-meta {
        display: flex;
        gap: 0.75rem;
        font-size: 0.75rem;
        color: #6c757d;
    }

    .table-badge {
        background: #e9ecef;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-weight: 600;
    }

    /* Search Box */
    .table-search {
        margin-bottom: 1.5rem;
    }

    .search-input {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 3rem;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .search-input:focus {
        border-color: #28a745;
        box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.15);
        outline: none;
    }

    .search-wrapper {
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
    }

    /* Category Filters */
    .category-filters {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .category-btn {
        padding: 0.5rem 1rem;
        border: 2px solid #e9ecef;
        border-radius: 6px;
        background: white;
        color: #6c757d;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .category-btn:hover {
        border-color: #28a745;
        color: #28a745;
    }

    .category-btn.active {
        border-color: #28a745;
        background: #28a745;
        color: white;
    }

    /* Wizard Navigation */
    .wizard-navigation {
        display: flex;
        justify-content: space-between;
        padding: 1.5rem 0;
    }

    .btn-wizard {
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-next {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border: none;
        color: white;
    }

    .btn-next:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(40, 167, 69, 0.3);
    }

    .btn-next:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .btn-back {
        background: #6c757d;
        border: none;
        color: white;
    }

    .btn-back:hover {
        background: #5a6268;
    }

    .selected-count {
        background: #28a745;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-weight: 600;
    }

    .no-tables {
        text-align: center;
        padding: 3rem;
        color: #6c757d;
    }

    /* Step 2: Column Configuration */
    .column-table-group {
        margin-bottom: 2rem;
    }

    .table-group-header {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 1rem 1.5rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .table-group-header:hover {
        background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
    }

    .table-group-title {
        font-weight: 700;
        color: #1a1a2e;
        font-size: 1.125rem;
    }

    .table-group-stats {
        color: #6c757d;
        font-size: 0.875rem;
    }

    .column-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 0.75rem;
    }

    .column-item {
        display: flex;
        align-items: center;
        padding: 1rem;
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 8px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .column-item:hover {
        border-color: #28a745;
        box-shadow: 0 2px 8px rgba(40, 167, 69, 0.1);
    }

    .column-item.selected {
        border-color: #28a745;
        background: rgba(40, 167, 69, 0.05);
    }

    .column-checkbox {
        margin-right: 1rem;
        width: 20px;
        height: 20px;
        cursor: pointer;
    }

    .column-info {
        flex: 1;
    }

    .column-name {
        font-weight: 600;
        color: #1a1a2e;
        margin-bottom: 0.25rem;
    }

    .column-type {
        font-size: 0.875rem;
        color: #6c757d;
    }

    .column-config-icon {
        color: #6c757d;
        font-size: 1.25rem;
        transition: all 0.3s ease;
    }

    .column-item:hover .column-config-icon {
        color: #28a745;
    }

    .select-all-table {
        color: #28a745;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: underline;
        cursor: pointer;
    }

    .select-all-table:hover {
        color: #20a03a;
    }
</style>

<div class="container-fluid">
    <!-- Wizard Progress -->
    <div class="wizard-progress">
        <div class="wizard-step @(Model.CurrentStep == 1 ? "active" : "") @(Model.CurrentStep > 1 ? "completed" : "")">
            <div class="step-circle">1</div>
            <div class="step-label">Select Tables</div>
        </div>
        <div class="wizard-step @(Model.CurrentStep == 2 ? "active" : "") @(Model.CurrentStep > 2 ? "completed" : "")">
            <div class="step-circle">2</div>
            <div class="step-label">Configure Columns</div>
        </div>
        <div class="wizard-step @(Model.CurrentStep == 3 ? "active" : "") @(Model.CurrentStep > 3 ? "completed" : "")">
            <div class="step-circle">3</div>
            <div class="step-label">Add Filters</div>
        </div>
        <div class="wizard-step @(Model.CurrentStep == 4 ? "active" : "") @(Model.CurrentStep > 4 ? "completed" : "")">
            <div class="step-circle">4</div>
            <div class="step-label">Preview</div>
        </div>
        <div class="wizard-step @(Model.CurrentStep == 5 ? "active" : "")">
            <div class="step-circle">5</div>
            <div class="step-label">Save Report</div>
        </div>
    </div>

    <!-- Step 1: Table Selection -->
    @if (Model.CurrentStep == 1)
    {
        <div class="wizard-content">
            <h2 class="wizard-title"><i class="fa fa-table"></i> Select Tables</h2>
            <p class="wizard-subtitle">Choose one or more tables to include in your report</p>

            <!-- Search -->
            <div class="table-search">
                <div class="search-wrapper">
                    <i class="fa fa-search search-icon"></i>
                    <input type="text"
                           id="tableSearch"
                           class="search-input"
                           placeholder="Search tables by name or description..."
                           autocomplete="off">
                </div>
            </div>

            <!-- Category Filters -->
            <div class="category-filters">
                <button class="category-btn active" data-category="all">All Categories</button>
                @foreach (var category in Model.AvailableTables.Select(t => t.Category).Distinct().OrderBy(c => c))
                {
                    <button class="category-btn" data-category="@category">@category</button>
                }
            </div>

            <!-- Selected Count -->
            <div class="mb-3">
                <span class="selected-count">
                    <span id="selectedCount">0</span> table(s) selected
                </span>
            </div>

            <!-- Table Grid -->
            @if (Model.AvailableTables.Any())
            {
                <div class="table-grid" id="tableGrid">
                    @foreach (var table in Model.AvailableTables)
                    {
                        <div class="table-card"
                             data-table-id="@table.TableId"
                             data-table-name="@table.TableName"
                             data-category="@table.Category"
                             data-search="@(table.TableName.ToLower()) @(table.DisplayName.ToLower()) @(table.Description.ToLower())">
                            <div class="table-card-header">
                                <div class="table-icon">
                                    <i class="fa fa-table"></i>
                                </div>
                                <input type="checkbox" class="table-checkbox" data-table-id="@table.TableId">
                            </div>
                            <div class="table-name">@table.DisplayName</div>
                            <div class="table-description">
                                @(string.IsNullOrEmpty(table.Description) ? "No description available" : table.Description)
                            </div>
                            <div class="table-meta">
                                <span class="table-badge">@table.Category</span>
                                <span class="table-badge">@table.DataSourceType</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-tables">
                    <i class="fa fa-inbox fa-3x mb-3"></i>
                    <h4>No Tables Available</h4>
                    <p>No tables have been whitelisted for the Query Builder yet.</p>
                    @if (Model.IsAdmin)
                    {
                        <p><a href="#">Configure table whitelist</a></p>
                    }
                </div>
            }
        </div>

        <!-- Navigation -->
        <div class="wizard-navigation">
            <a href="@Url.Action("Index")" class="btn btn-back">
                <i class="fa fa-arrow-left"></i> Cancel
            </a>
            <button type="button" id="btnNext" class="btn btn-next" disabled>
                Next: Configure Columns <i class="fa fa-arrow-right"></i>
            </button>
        </div>
    }

    <!-- Step 2: Column Configuration -->
    <div id="step2Container" style="display: none;">
        <div class="wizard-content">
            <h2 class="wizard-title"><i class="fa fa-columns"></i> Configure Columns</h2>
            <p class="wizard-subtitle">Select the columns you want to include in your report</p>

            <!-- Search -->
            <div class="table-search">
                <div class="search-wrapper">
                    <i class="fa fa-search search-icon"></i>
                    <input type="text"
                           id="columnSearch"
                           class="search-input"
                           placeholder="Search columns by name..."
                           autocomplete="off">
                </div>
            </div>

            <!-- Selected Count -->
            <div class="mb-3">
                <span class="selected-count">
                    <span id="selectedColumnCount">0</span> column(s) selected
                </span>
            </div>

            <!-- Column Groups (by table) -->
            <div id="columnGroupsContainer">
                <!-- Will be populated dynamically by JavaScript -->
            </div>
        </div>

        <!-- Navigation -->
        <div class="wizard-navigation">
            <button type="button" id="btnBackToStep1" class="btn btn-back">
                <i class="fa fa-arrow-left"></i> Back
            </button>
            <button type="button" id="btnNextStep2" class="btn btn-next" disabled>
                Next: Add Filters <i class="fa fa-arrow-right"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let selectedTables = [];

            // Table card click
            $('.table-card').on('click', function(e) {
                if ($(e.target).is('input[type="checkbox"]')) return;

                const checkbox = $(this).find('.table-checkbox');
                checkbox.prop('checked', !checkbox.prop('checked')).trigger('change');
            });

            // Checkbox change
            $('.table-checkbox').on('change', function(e) {
                e.stopPropagation();
                const tableCard = $(this).closest('.table-card');
                const tableId = $(this).data('table-id');
                const tableName = tableCard.data('table-name');

                if ($(this).is(':checked')) {
                    tableCard.addClass('selected');
                    selectedTables.push({ id: tableId, name: tableName });
                } else {
                    tableCard.removeClass('selected');
                    selectedTables = selectedTables.filter(t => t.id !== tableId);
                }

                updateSelectedCount();
            });

            // Update selected count
            function updateSelectedCount() {
                $('#selectedCount').text(selectedTables.length);
                $('#btnNext').prop('disabled', selectedTables.length === 0);
            }

            // Search functionality
            $('#tableSearch').on('input', function() {
                const query = $(this).val().toLowerCase();
                filterTables();
            });

            // Category filter
            $('.category-btn').on('click', function() {
                $('.category-btn').removeClass('active');
                $(this).addClass('active');
                filterTables();
            });

            function filterTables() {
                const query = $('#tableSearch').val().toLowerCase();
                const category = $('.category-btn.active').data('category');

                $('.table-card').each(function() {
                    const searchText = $(this).data('search');
                    const cardCategory = $(this).data('category');

                    const matchesSearch = query === '' || searchText.indexOf(query) !== -1;
                    const matchesCategory = category === 'all' || cardCategory === category;

                    if (matchesSearch && matchesCategory) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            // Next button - Submit Step 1 and load Step 2
            $('#btnNext').on('click', function() {
                if (selectedTables.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Tables Selected',
                        text: 'Please select at least one table to continue.'
                    });
                    return;
                }

                // Show loading
                Swal.fire({
                    title: 'Loading columns...',
                    html: 'Please wait while we fetch column information',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // Submit to backend
                $.ajax({
                    url: '@Url.Action("CreateStep1", "ReportBuilder")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        selectedTableIds: selectedTables.map(t => t.id)
                    }),
                    success: function(response) {
                        if (response.success) {
                            Swal.close();
                            loadStep2(response.columns);
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: response.message || 'Failed to load columns'
                            });
                        }
                    },
                    error: function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Failed to submit table selection. Please try again.'
                        });
                    }
                });
            });

            // ===========================================
            // Step 2: Column Configuration
            // ===========================================
            let allColumns = [];
            let selectedColumns = [];

            function loadStep2(columns) {
                allColumns = columns;

                // Hide Step 1, show Step 2
                $('.wizard-step:nth-child(1)').addClass('completed');
                $('.wizard-step:nth-child(2)').addClass('active');
                $('[id^="step"]').parent().hide();
                $('#step2Container').show();

                // Group columns by table
                const groupedColumns = {};
                columns.forEach(col => {
                    if (!groupedColumns[col.tableName]) {
                        groupedColumns[col.tableName] = {
                            displayName: col.tableDisplayName,
                            columns: []
                        };
                    }
                    groupedColumns[col.tableName].columns.push(col);
                });

                // Render column groups
                let html = '';
                for (const [tableName, group] of Object.entries(groupedColumns)) {
                    html += `
                        <div class="column-table-group">
                            <div class="table-group-header">
                                <div>
                                    <div class="table-group-title">${group.displayName}</div>
                                    <div class="table-group-stats">
                                        <span class="selected-in-table">0</span> of ${group.columns.length} columns selected
                                    </div>
                                </div>
                                <span class="select-all-table" data-table="${tableName}">Select All</span>
                            </div>
                            <div class="column-list">
                                ${group.columns.map(col => `
                                    <div class="column-item" data-column-id="${col.columnId}">
                                        <input type="checkbox" class="column-checkbox" data-column-id="${col.columnId}">
                                        <div class="column-info">
                                            <div class="column-name">${col.columnName}</div>
                                            <div class="column-type">${col.dataType}${col.isNullable ? ' (nullable)' : ''}</div>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    `;
                }
                $('#columnGroupsContainer').html(html);

                // Bind events
                setupStep2Events();
            }

            function setupStep2Events() {
                // Column item click
                $('.column-item').on('click', function(e) {
                    if ($(e.target).is('input[type="checkbox"]')) return;
                    const checkbox = $(this).find('.column-checkbox');
                    checkbox.prop('checked', !checkbox.prop('checked')).trigger('change');
                });

                // Column checkbox change
                $('.column-checkbox').on('change', function(e) {
                    e.stopPropagation();
                    const columnItem = $(this).closest('.column-item');
                    const columnId = $(this).data('column-id');

                    if ($(this).is(':checked')) {
                        columnItem.addClass('selected');
                        const column = allColumns.find(c => c.columnId === columnId);
                        selectedColumns.push(column);
                    } else {
                        columnItem.removeClass('selected');
                        selectedColumns = selectedColumns.filter(c => c.columnId !== columnId);
                    }

                    updateColumnCounts();
                });

                // Select all for table
                $('.select-all-table').on('click', function(e) {
                    e.stopPropagation();
                    const tableName = $(this).data('table');
                    const tableGroup = $(this).closest('.column-table-group');
                    const checkboxes = tableGroup.find('.column-checkbox');

                    const allChecked = checkboxes.filter(':checked').length === checkboxes.length;
                    checkboxes.prop('checked', !allChecked).trigger('change');
                });

                // Search columns
                $('#columnSearch').on('input', function() {
                    const query = $(this).val().toLowerCase();
                    $('.column-item').each(function() {
                        const columnName = $(this).find('.column-name').text().toLowerCase();
                        if (query === '' || columnName.indexOf(query) !== -1) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                });

                // Back button
                $('#btnBackToStep1').on('click', function() {
                    $('#step2Container').hide();
                    $('.wizard-step:nth-child(2)').removeClass('active');
                    $('.wizard-step:nth-child(1)').removeClass('completed');
                    $('[id^="step"]').parent().show();
                });

                // Next button (Step 2)
                $('#btnNextStep2').on('click', function() {
                    if (selectedColumns.length === 0) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'No Columns Selected',
                            text: 'Please select at least one column to continue.'
                        });
                        return;
                    }

                    // TODO: Proceed to Step 3
                    Swal.fire({
                        icon: 'info',
                        title: 'Step 3: Coming Soon',
                        html: `<p>You selected <strong>${selectedColumns.length}</strong> columns!</p>
                               <p class="mt-3">Step 3: Filter Configuration will be implemented next!</p>`
                    });
                });
            }

            function updateColumnCounts() {
                // Update global count
                $('#selectedColumnCount').text(selectedColumns.length);
                $('#btnNextStep2').prop('disabled', selectedColumns.length === 0);

                // Update per-table counts
                $('.column-table-group').each(function() {
                    const tableGroup = $(this);
                    const selectedInTable = tableGroup.find('.column-checkbox:checked').length;
                    tableGroup.find('.selected-in-table').text(selectedInTable);

                    // Update select all text
                    const totalInTable = tableGroup.find('.column-checkbox').length;
                    const selectAllBtn = tableGroup.find('.select-all-table');
                    if (selectedInTable === totalInTable) {
                        selectAllBtn.text('Deselect All');
                    } else {
                        selectAllBtn.text('Select All');
                    }
                });
            }
        });
    </script>
}
