@model SalesMetrics.Models.Reports.ReportRunViewModel
@{
    ViewData["Title"] = Model.Definition?.Name ?? "Report";
}

<div class="row mb-3">
    <div class="col-12">
        <h2>@Model.Definition?.Name</h2>
        <p class="text-muted">@Model.Definition?.Description</p>
        @if (TempData["ReportError"] != null)
        {
            <div class="alert alert-danger">@TempData["ReportError"]</div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Run" method="post">
            <input type="hidden" name="DefinitionId" value="@Model.Definition?.Id" />
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label asp-for="Parameters.FromDate" class="form-label">From Date</label>
                    <input asp-for="Parameters.FromDate" class="form-control" type="date" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Parameters.ToDate" class="form-label">To Date</label>
                    <input asp-for="Parameters.ToDate" class="form-control" type="date" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Parameters.MinMargin" class="form-label">Min Margin</label>
                    <input asp-for="Parameters.MinMargin" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Parameters.TargetMargin" class="form-label">Target Margin</label>
                    <input asp-for="Parameters.TargetMargin" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-2 mb-3">
                    <label asp-for="Parameters.WarehouseId" class="form-label">Warehouse</label>
                    <input asp-for="Parameters.WarehouseId" class="form-control" type="number" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Parameters.MgmtName" class="form-label">Management Name (optional)</label>
                    <input asp-for="Parameters.MgmtName" class="form-control" />
                </div>
                <div class="col-md-3 mb-3 d-flex align-items-center">
                    <div class="form-check mt-4">
                        <input type="hidden" name="Parameters.FilterByMgmt" value="false" />
                        <input asp-for="Parameters.FilterByMgmt" class="form-check-input" type="checkbox" />
                        <label asp-for="Parameters.FilterByMgmt" class="form-check-label">Filter by Management Code</label>
                    </div>
                </div>
            </div>
            <p class="text-muted">Date range is limited to 12 months to keep results responsive.</p>
            <div class="d-flex align-items-center">
                <button type="submit" class="btn btn-primary me-2">Run Report</button>
                <a class="btn btn-secondary" href="@Url.Action("Index")">Back to catalog</a>
            </div>
        </form>
    </div>
</div>

@if (Model.ShowResults && Model.Rows.Any())
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <strong>@Model.TotalRows</strong> results
        </div>
        <form asp-action="Export" method="post" class="mb-0 d-flex gap-2">
            <input type="hidden" name="DefinitionId" value="@Model.Definition?.Id" />
            <input type="hidden" name="Parameters.FromDate" value="@Model.Parameters.FromDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="Parameters.ToDate" value="@Model.Parameters.ToDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="Parameters.MinMargin" value="@Model.Parameters.MinMargin" />
            <input type="hidden" name="Parameters.TargetMargin" value="@Model.Parameters.TargetMargin" />
            <input type="hidden" name="Parameters.MgmtName" value="@Model.Parameters.MgmtName" />
            <input type="hidden" name="Parameters.FilterByMgmt" value="@Model.Parameters.FilterByMgmt" />
            <input type="hidden" name="Parameters.WarehouseId" value="@Model.Parameters.WarehouseId" />
            <button type="submit" name="ExportFormat" value="csv" class="btn btn-outline-success">Export CSV</button>
            <button type="submit" name="ExportFormat" value="excel" class="btn btn-outline-primary">Export Excel</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    @foreach (var column in Model.Columns)
                    {
                        <th>@column</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @foreach (var column in Model.Columns)
                        {
                            <td>@(row.ContainsKey(column) ? row[column] : null)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Report pagination" class="mt-3">
        @{
            var totalPages = (int)Math.Ceiling(Model.TotalRows / (double)Model.PageSize);
            var previousPage = Model.PageNumber - 1;
            var nextPage = Model.PageNumber + 1;
        }
        <ul class="pagination">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : string.Empty)">
                <form asp-action="Run" method="post" class="mb-0">
                    <input type="hidden" name="DefinitionId" value="@Model.Definition?.Id" />
                    <input type="hidden" name="PageNumber" value="@previousPage" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input type="hidden" name="Parameters.FromDate" value="@Model.Parameters.FromDate?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="Parameters.ToDate" value="@Model.Parameters.ToDate?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="Parameters.MinMargin" value="@Model.Parameters.MinMargin" />
                    <input type="hidden" name="Parameters.TargetMargin" value="@Model.Parameters.TargetMargin" />
                    <input type="hidden" name="Parameters.MgmtName" value="@Model.Parameters.MgmtName" />
                    <input type="hidden" name="Parameters.FilterByMgmt" value="@Model.Parameters.FilterByMgmt" />
                    <input type="hidden" name="Parameters.WarehouseId" value="@Model.Parameters.WarehouseId" />
                    <button class="page-link" type="submit">Previous</button>
                </form>
            </li>

            <li class="page-item disabled"><span class="page-link">Page @Model.PageNumber of @totalPages</span></li>

            <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : string.Empty)">
                <form asp-action="Run" method="post" class="mb-0">
                    <input type="hidden" name="DefinitionId" value="@Model.Definition?.Id" />
                    <input type="hidden" name="PageNumber" value="@nextPage" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input type="hidden" name="Parameters.FromDate" value="@Model.Parameters.FromDate?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="Parameters.ToDate" value="@Model.Parameters.ToDate?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="Parameters.MinMargin" value="@Model.Parameters.MinMargin" />
                    <input type="hidden" name="Parameters.TargetMargin" value="@Model.Parameters.TargetMargin" />
                    <input type="hidden" name="Parameters.MgmtName" value="@Model.Parameters.MgmtName" />
                    <input type="hidden" name="Parameters.FilterByMgmt" value="@Model.Parameters.FilterByMgmt" />
                    <input type="hidden" name="Parameters.WarehouseId" value="@Model.Parameters.WarehouseId" />
                    <button class="page-link" type="submit">Next</button>
                </form>
            </li>
        </ul>
    </nav>
}
else if (Model.ShowResults)
{
    <div class="alert alert-info">No data found for the selected parameters.</div>
}
