        *@

        <div class="table-wrapper p-3">
            <table class="results-table table table-bordered table-striped nowrap" id="resultsTable" style="width:100%">
                <thead>
                    <tr>
                        @foreach (var column in Model.Columns)
                        {
                            <th>@column</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var meetsCommissionGate = row.ContainsKey("MeetsCommissionGate") ? row["MeetsCommissionGate"]?.ToString() : "YES";
                        var meetsTargetMargin = row.ContainsKey("MeetsTargetMargin") ? row["MeetsTargetMargin"]?.ToString() : "YES";
                        <tr data-commission-gate="@meetsCommissionGate" data-target-margin="@meetsTargetMargin">
                            @foreach (var column in Model.Columns)
                            {
                                <td>@(row.ContainsKey(column) ? row[column] : "")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.ShowResults)
{
    <div class="results-container">
        <div class="no-results-message">
            <div class="no-results-icon">🔍</div>
            <h4>No Data Found</h4>
            <p>No data was found for the selected parameters. Try adjusting your filters and running the report again.</p>
        </div>
    </div>
}

<!-- Order Details Modal -->
<div class="modal fade" id="orderDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-receipt"></i> Order Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="orderDetailContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- jQuery (required by DataTables) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.colVis.min.js"></script>

    <!-- Required for export buttons -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function() {
            // Convert percentage inputs to decimals before form submission
            $('#reportForm').on('submit', function(e) {
                const minMarginInput = $('#minMarginInput');
                const targetMarginInput = $('#targetMarginInput');

                // Convert percentage to decimal (15 → 0.15)
                if (minMarginInput.val()) {
                    minMarginInput.val(parseFloat(minMarginInput.val()) / 100);
                }
                if (targetMarginInput.val()) {
                    targetMarginInput.val(parseFloat(targetMarginInput.val()) / 100);
                }
            });

            // Apply conditional row highlighting based on commission gate and target margin
            function normalizeGateValue(value) {
                if (value === undefined || value === null) {
                    return '';
                }

                return value.toString().trim().toUpperCase();
            }

            function applyRowHighlighting() {
                try {
                    $('#resultsTable tbody tr').each(function() {
                        try {
                            var $row = $(this);

                            // Try to get data from attributes - use attr() instead of data()
                            var commissionGate = $row.attr('data-commission-gate');
                            var targetMargin = $row.attr('data-target-margin');

                            // Normalize values
                            commissionGate = normalizeGateValue(commissionGate);
                            targetMargin = normalizeGateValue(targetMargin);

                            // Check conditions
                            var commisionNo = commissionGate === 'NO';
                            var targetNo = targetMargin === 'NO';

                            // Remove any existing highlight classes
                            $row.removeClass('row-warning row-danger');

                            // Apply highlighting based on conditions
                            if (commisionNo && targetNo) {
                                // Both are NO - Red highlighting
                                $row.addClass('row-danger');
                            } else if (commisionNo || targetNo) {
                                // One is NO - Yellow highlighting
                                $row.addClass('row-warning');
                            }
                            // Otherwise no highlighting (both are YES)
                        } catch (rowError) {
                            // Row processing error - skip row
                        }
                    });
                } catch (error) {
                    // Highlighting error - skip highlighting
                }
            }

            // Initialize DataTable with export buttons and features
            var resultsTable = $('#resultsTable').DataTable({
                order: [
                    [2, 'desc' ],   // 2 by status
                    [6, 'asc'],     // 6 by Price Code
                    [5, 'asc']      // 5 by Property
                ],
                responsive: true,
                paging: true,
                pageLength: 10,
                searching: true,
                dom: `
                    <"top d-flex justify-content-between align-items-center mb-3" lBf>
                    rt
                    <"bottom d-flex justify-content-between align-items-center mt-3" ip>
                `,
                scrollX: true,
                buttons: [
                    {
                        extend: 'colvis',
                        text: '<i class="bi bi-eye"></i> Show/Hide Columns',
                        className: 'btn btn-outline-primary rounded-pill shadow-sm me-2'
                    },
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bi bi-file-earmark-excel"></i> Excel',
                        className: 'btn btn-outline-success rounded-pill shadow-sm me-2',
                        exportOptions: {
                            columns: ':visible'
                        },
                        title: '@(Model.Definition?.Name ?? "Report") - Results',
                        filename: '@(Model.Definition?.Name ?? "Report")_@DateTime.Now.ToString("yyyyMMdd")'
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                        className: 'btn btn-outline-danger rounded-pill shadow-sm',
                        exportOptions: {
                            columns: ':visible'
                        },
                        title: '@(Model.Definition?.Name ?? "Report") - Results',
                        filename: '@(Model.Definition?.Name ?? "Report")_@DateTime.Now.ToString("yyyyMMdd")',
                        orientation: 'landscape',
                        pageSize: 'LEGAL'
                    },
                ],
                columnDefs: [
                    // Hide certain columns
                    { targets: [0, 10, 11, 12, 15, 16, 17], visible: false },

                    // Format OrderDate column (column 7) as MM/dd/yyyy
                    {
                        targets: 7,
                        render: function(data, type, row) {
                            if (type === 'display' && data) {
                                // Parse and format date as MM/dd/yyyy
                                const date = new Date(data);
                                if (!isNaN(date.getTime())) {
                                    const month = String(date.getMonth() + 1).padStart(2, '0');
                                    const day = String(date.getDate()).padStart(2, '0');
                                    const year = date.getFullYear();
                                    return `${month}/${day}/${year}`;
                                }
                            }
                            return data;
                        }
                    },

                    // Format OrderAmount column (column 9) as currency
                    {
                        targets: 9,
                        render: function(data, type, row) {
                            if (type === 'display' && data != null) {
                                return '$' + parseFloat(data).toLocaleString('en-US', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                            }
                            return data;
                        }
                    },

                    // Format ProjectedProfit column (column 13) as currency
                    {
                        targets: 13,
                        render: function(data, type, row) {
                            if (type === 'display' && data != null) {
                                return '$' + parseFloat(data).toLocaleString('en-US', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                            }
                            return data;
                        }
                    },

                    // Format ProjectedMargin column (column 14) as percentage with 2 decimals
                    {
                        targets: 14,
                        render: function(data, type, row) {
                            if (type === 'display' && data != null) {
                                const percentage = (parseFloat(data) * 100).toFixed(2);
                                return percentage + '%';
                            }
                            return data;
                        }
                    }
                ],
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    search: "Search results:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ results",
                    infoEmpty: "Showing 0 to 0 of 0 results",
                    infoFiltered: "(filtered from _MAX_ total results)",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next ›",
                        previous: "‹ Previous"
                    }
                },
                // Apply row highlighting after every draw (pagination, search, sort)
                //drawCallback: function() {
                //    applyRowHighlighting();
                //},
                // Hide loading overlay after DataTable is fully initialized
                initComplete: function() {
                    $('#loadingOverlay').fadeOut(600);
                    // Apply row highlighting on initial load
                    applyRowHighlighting();
                }
            });

            // Re-apply highlighting on every redraw (pagination, search, sort)
            resultsTable.on('draw.dt', function() {
                applyRowHighlighting();
            });

            // Add click handler for OrderID column (column 3) to show order details
            $('#resultsTable').on('click', 'tbody tr td:nth-child(3)', function() {
                const row = resultsTable.row($(this).parents('tr'));
                const rowData = row.data();

                // OrderID is in column index 3 (4th column in data array)
                const orderIdValue = rowData[3]; // Column index, not display index

                if (orderIdValue && orderIdValue !== '0') {
                    // Parse the order ID
                    const orderId = parseInt(orderIdValue);

                    if (!isNaN(orderId)) {
                        // Show modal with loading spinner
                        $('#orderDetailModal').modal('show');
                        $('#orderDetailContent').html(`
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        `);

                        // Load order details via AJAX
                        $.get('/Reports/GetOrderDetails', { orderId: orderId }, function(html) {
                            $('#orderDetailContent').html(html);
                        }).fail(function() {
                            $('#orderDetailContent').html(`
                                <div class="alert alert-danger">
                                    <i class="bi bi-exclamation-triangle"></i> Failed to load order details.
                                </div>
                            `);
                        });
                    }
                }
            });

            // Add hover effect to OrderID column to indicate it's clickable
            $('#resultsTable').on('mouseenter', 'tbody tr td:nth-child(3)', function() {
                $(this).css({'cursor': 'pointer', 'text-decoration': 'underline', 'color': '#667eea'});
            }).on('mouseleave', 'tbody tr td:nth-child(3)', function() {
                $(this).css({'cursor': 'default', 'text-decoration': 'none', 'color': ''});
            });
        });
    </script>
}
