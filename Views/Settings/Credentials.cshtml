@model SalesMetrics.Models.Settings.CredentialsViewModel
@{
    ViewData["Title"] = "App Credentials";
}

@section Styles {
    <style>
        .cred-section-title {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: .07em;
            text-transform: uppercase;
            color: #9aa0aa;
            padding: 10px 0 6px;
            border-bottom: 1px solid #e9ecef;
            margin-bottom: 1rem;
        }
        .cred-row {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem 0;
            border-bottom: 1px solid #f0f0f0;
        }
        .cred-row:last-child {
            border-bottom: none;
        }
        .cred-key {
            font-family: monospace;
            font-size: 0.875rem;
            font-weight: 600;
            min-width: 170px;
            color: #343a40;
        }
        .cred-desc {
            font-size: 0.8rem;
            color: #6c757d;
            flex: 1;
        }
        .cred-input {
            width: 260px;
        }
        .badge-configured {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
            border-radius: 4px;
            font-size: 0.72rem;
            padding: 2px 8px;
            white-space: nowrap;
        }
        .badge-notset {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            border-radius: 4px;
            font-size: 0.72rem;
            padding: 2px 8px;
            white-space: nowrap;
        }
    </style>
}

<div class="container-fluid">

    <!-- Page Header / Breadcrumb -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/Settings/Hub">Settings Hub</a></li>
                    <li class="breadcrumb-item active">App Credentials</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-3">
                <div style="width:42px;height:42px;background:#fef3cd;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-key" style="font-size:1.1rem;color:#856404;"></i>
                </div>
                <div>
                    <h1 class="h3 mb-0 fw-bold">App Credentials</h1>
                    <p class="text-muted mb-0" style="font-size:.875rem;">
                        These credentials are stored AES-256 encrypted in the database — not in config files.
                        After saving, blank out the matching values in <code>appsettings.json</code>.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-10 col-xl-8">

            <!-- Google OAuth -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="cred-section-title"><i class="fab fa-google me-1"></i> Google OAuth</div>
                    <p class="text-muted mb-3" style="font-size:.83rem;">
                        Used for all Google sign-in and Google Calendar/Tasks integrations.
                        After saving here, set <code>Authentication:Google:ClientId</code> and
                        <code>Authentication:Google:ClientSecret</code> to empty strings in
                        <code>appsettings.json</code>, then restart the app.
                    </p>

                    @foreach (var cred in Model.GoogleCredentials)
                    {
                        <form method="post" action="/Settings/SaveCredential" class="cred-row">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="credentialKey" value="@cred.CredentialKey" />
                            <input type="hidden" name="category" value="@cred.Category" />
                            <div class="cred-key">@cred.CredentialKey</div>
                            <div class="cred-desc">@cred.Description</div>
                            <span class="@(cred.HasValue ? "badge-configured" : "badge-notset")">
                                @(cred.HasValue ? "Configured" : "Not Set")
                            </span>
                            <input type="password"
                                   name="plainValue"
                                   class="form-control form-control-sm cred-input"
                                   placeholder="@(cred.HasValue ? "••••••••  (leave blank to keep)" : "Enter value...")"
                                   autocomplete="new-password" />
                            <button type="submit" class="btn btn-sm btn-primary">Save</button>
                        </form>
                    }
                </div>
            </div>

            <!-- SMTP -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="cred-section-title"><i class="fas fa-envelope me-1"></i> SMTP Email</div>
                    <p class="text-muted mb-3" style="font-size:.83rem;">
                        Used to send envelope completion emails and announcements.
                        After saving here, blank out the <code>Smtp</code> section values in
                        <code>appsettings.json</code> (except <code>Host</code>, <code>Port</code>,
                        and <code>EnableSsl</code> which are non-sensitive).
                    </p>

                    @foreach (var cred in Model.SmtpCredentials)
                    {
                        <form method="post" action="/Settings/SaveCredential" class="cred-row">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="credentialKey" value="@cred.CredentialKey" />
                            <input type="hidden" name="category" value="@cred.Category" />
                            <div class="cred-key">@cred.CredentialKey</div>
                            <div class="cred-desc">@cred.Description</div>
                            <span class="@(cred.HasValue ? "badge-configured" : "badge-notset")">
                                @(cred.HasValue ? "Configured" : "Not Set")
                            </span>
                            <input type="@(cred.CredentialKey == "Smtp_Pass" ? "password" : "text")"
                                   name="plainValue"
                                   class="form-control form-control-sm cred-input"
                                   placeholder="@(cred.HasValue ? "••••••••  (leave blank to keep)" : "Enter value...")"
                                   autocomplete="new-password" />
                            <button type="submit" class="btn btn-sm btn-primary">Save</button>
                        </form>
                    }
                </div>
            </div>

            <!-- Restart reminder -->
            <div class="alert alert-warning d-flex align-items-start gap-2" style="font-size:.83rem;">
                <i class="fas fa-redo-alt mt-1"></i>
                <div>
                    <strong>Restart required for Google OAuth changes.</strong>
                    Google credentials are loaded once at startup. After saving new Google values,
                    restart the application for them to take effect.
                    SMTP changes are picked up on the next email send without a restart.
                </div>
            </div>

        </div>
    </div>
</div>
