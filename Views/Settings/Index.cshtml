@model SalesMetrics.Models.SettingsDashboardViewModel
@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Settings/Hub"><i class="fas fa-th me-1"></i>Settings Hub</a></li>
                    <li class="breadcrumb-item active" aria-current="page">System Settings</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-1">⚙️ System Settings</h1>
                    <p class="text-muted mb-0">Configure notifications, security, and access controls</p>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* Hidden form ensures the antiforgery token is always present for AJAX calls *@
    <form id="antiforgery-form" style="display:none">
        @Html.AntiForgeryToken()
    </form>

    <!-- Tabs -->
    <ul class="nav nav-tabs nav-fill mb-4" id="settingsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "notifications" ? "active" : "")" id="notifications-tab" data-bs-toggle="tab" data-bs-target="#notifications" type="button" role="tab">
                <i class="fas fa-bell"></i> Notification Settings
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "security" ? "active" : "")" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button" role="tab">
                <i class="fas fa-shield-alt"></i> Security Settings
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "envelope-notifications" ? "active" : "")" id="envelope-notifications-tab" data-bs-toggle="tab" data-bs-target="#envelope-notifications" type="button" role="tab">
                <i class="fas fa-envelope"></i> Envelope Notifications
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "branding" ? "active" : "")" id="branding-tab" data-bs-toggle="tab" data-bs-target="#branding" type="button" role="tab">
                <i class="fas fa-palette"></i> Company Branding
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "general" ? "active" : "")" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">
                <i class="fas fa-cog"></i> General Settings
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="settingsTabContent">
        <!-- Notifications Tab -->
        <div class="tab-pane fade @(Model.ActiveTab == "notifications" ? "show active" : "")" id="notifications" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Notification Categories</h5>
                    <p class="mb-0 text-muted small">Configure which events trigger notifications and who receives them</p>
                </div>
                <div class="card-body">
                    @if (Model.NotificationSettings.Any())
                    {
                        @foreach (var setting in Model.NotificationSettings)
                        {
                            <div class="notification-setting-card card mb-3 border">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-4">
                                            <div class="d-flex align-items-center">
                                                <div class="form-check form-switch me-3">
                                                    <input class="form-check-input notification-enabled-toggle"
                                                           type="checkbox"
                                                           id="enabled_@setting.NotificationSettingsId"
                                                           data-setting-id="@setting.NotificationSettingsId"
                                                           @(setting.IsEnabled ? "checked" : "") />
                                                </div>
                                                <div>
                                                    <h6 class="mb-1">@setting.CategoryDisplayName</h6>
                                                    <p class="text-muted small mb-0">@setting.CategoryDescription</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-8">
                                            <div class="row">
                                                <div class="col-md-3">
                                                    <div class="form-check">
                                                        <input class="form-check-input notify-setting"
                                                               type="checkbox"
                                                               id="assignee_@setting.NotificationSettingsId"
                                                               data-setting-id="@setting.NotificationSettingsId"
                                                               data-field="NotifyAssignee"
                                                               @(setting.NotifyAssignee ? "checked" : "")
                                                               @(!setting.IsEnabled ? "disabled" : "") />
                                                        <label class="form-check-label small" for="assignee_@setting.NotificationSettingsId">
                                                            Assignee
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-check">
                                                        <input class="form-check-input notify-setting"
                                                               type="checkbox"
                                                               id="manager_@setting.NotificationSettingsId"
                                                               data-setting-id="@setting.NotificationSettingsId"
                                                               data-field="NotifyManager"
                                                               @(setting.NotifyManager ? "checked" : "")
                                                               @(!setting.IsEnabled ? "disabled" : "") />
                                                        <label class="form-check-label small" for="manager_@setting.NotificationSettingsId">
                                                            Manager
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-check">
                                                        <input class="form-check-input notify-setting"
                                                               type="checkbox"
                                                               id="owner_@setting.NotificationSettingsId"
                                                               data-setting-id="@setting.NotificationSettingsId"
                                                               data-field="NotifyTaskOwner"
                                                               @(setting.NotifyTaskOwner ? "checked" : "")
                                                               @(!setting.IsEnabled ? "disabled" : "") />
                                                        <label class="form-check-label small" for="owner_@setting.NotificationSettingsId">
                                                            Task Owner
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-check">
                                                        <input class="form-check-input notify-setting"
                                                               type="checkbox"
                                                               id="inapp_@setting.NotificationSettingsId"
                                                               data-setting-id="@setting.NotificationSettingsId"
                                                               data-field="EnableInAppNotification"
                                                               @(setting.EnableInAppNotification ? "checked" : "")
                                                               @(!setting.IsEnabled ? "disabled" : "") />
                                                        <label class="form-check-label small" for="inapp_@setting.NotificationSettingsId">
                                                            In-App
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>

                                            @if (setting.CategoryName == "DueDateReminder")
                                            {
                                                <div class="row mt-2">
                                                    <div class="col-md-6">
                                                        <label class="form-label small">Remind (hours before due date)</label>
                                                        <input type="number"
                                                               class="form-control form-control-sm reminder-hours"
                                                               data-setting-id="@setting.NotificationSettingsId"
                                                               value="@(setting.ReminderHoursBefore ?? 24)"
                                                               min="1"
                                                               max="168"
                                                               @(!setting.IsEnabled ? "disabled" : "") />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="text-end mt-3">
                            <button type="button" class="btn btn-primary" id="saveNotificationSettings">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>No notification settings found.
                            <form method="post" action="@Url.Action("InitializeDefaults", "Settings")" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary">Initialize Default Settings</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Security Tab -->
        <div class="tab-pane fade @(Model.ActiveTab == "security" ? "show active" : "")" id="security" role="tabpanel">
            <div class="row">
                @if (Model.SecuritySettings.Any())
                {
                    <!-- Group by category -->
                    @foreach (var category in Model.SecuritySettings.GroupBy(s => s.Category).OrderBy(g => g.Key))
                    {
                        <div class="col-lg-6 mb-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">@category.Key Settings</h5>
                                </div>
                                <div class="card-body">
                                    @foreach (var setting in category)
                                    {
                                        <div class="mb-3">
                                            <label class="form-label">
                                                @setting.SettingKey.Replace("Password", "Password ").Replace("Require", "Require ").Replace("Session", "Session ")
                                                @if (!string.IsNullOrEmpty(setting.Description))
                                                {
                                                    <i class="fas fa-info-circle text-muted" title="@setting.Description" data-bs-toggle="tooltip"></i>
                                                }
                                            </label>

                                            @if (setting.InputType == "boolean")
                                            {
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input security-setting"
                                                           type="checkbox"
                                                           id="setting_@setting.SecuritySettingsId"
                                                           data-setting-id="@setting.SecuritySettingsId"
                                                           @(setting.SettingValue.ToLower() == "true" ? "checked" : "") />
                                                    <label class="form-check-label" for="setting_@setting.SecuritySettingsId">
                                                        @(setting.SettingValue.ToLower() == "true" ? "Enabled" : "Disabled")
                                                    </label>
                                                </div>
                                            }
                                            else if (setting.InputType == "number")
                                            {
                                                <input type="number"
                                                       class="form-control security-setting"
                                                       id="setting_@setting.SecuritySettingsId"
                                                       data-setting-id="@setting.SecuritySettingsId"
                                                       value="@setting.SettingValue"
                                                       min="0" />
                                            }
                                            else
                                            {
                                                <input type="text"
                                                       class="form-control security-setting"
                                                       id="setting_@setting.SecuritySettingsId"
                                                       data-setting-id="@setting.SecuritySettingsId"
                                                       value="@setting.SettingValue" />
                                            }
                                            @if (!string.IsNullOrEmpty(setting.Description))
                                            {
                                                <small class="form-text text-muted">@setting.Description</small>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="col-12">
                        <div class="text-end mt-3">
                            <button type="button" class="btn btn-primary" id="saveSecuritySettings">
                                <i class="fas fa-save"></i> Save Security Settings
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>No security settings found.
                            <form method="post" action="@Url.Action("InitializeDefaults", "Settings")" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary">Initialize Default Settings</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Envelope Notifications Tab -->
        <div class="tab-pane fade @(Model.ActiveTab == "envelope-notifications" ? "show active" : "")" id="envelope-notifications" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Envelope Completion Notifications</h5>
                    <p class="mb-0 text-muted small">
                        Configure email addresses that receive a notification (with PDF download link) when an envelope is completed by all signers.
                        The <strong>Company</strong> row sends to every completed envelope regardless of branch.
                        Each branch row only sends when an envelope matches that branch's location code.
                    </p>
                </div>
                <div class="card-body p-0">
                    @if (Model.EnvelopeNotificationSettings.Any())
                    {
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:220px;">Location</th>
                                    <th>Notification Email</th>
                                    <th style="width:110px;" class="text-center">Enabled</th>
                                    <th style="width:90px;" class="text-center">Save</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var envSetting in Model.EnvelopeNotificationSettings)
                                {
                                    <tr class="envelope-notification-row" data-setting-id="@envSetting.EnvelopeNotificationSettingsId">
                                        <td>
                                            @if (envSetting.LocationCode == null)
                                            {
                                                <span class="badge bg-primary me-1">Company</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary me-1">@envSetting.LocationCode</span>
                                            }
                                            <span class="fw-semibold">@envSetting.LocationName</span>
                                        </td>
                                        <td>
                                            <input type="email"
                                                   class="form-control form-control-sm env-notif-email"
                                                   placeholder="Enter email address..."
                                                   value="@(envSetting.NotificationEmail ?? "")" />
                                        </td>
                                        <td class="text-center">
                                            <div class="form-check form-switch d-inline-block">
                                                <input class="form-check-input env-notif-enabled"
                                                       type="checkbox"
                                                       @(envSetting.IsEnabled ? "checked" : "") />
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary env-notif-save-btn"
                                                    title="Save this row">
                                                <i class="fas fa-save"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="p-4">
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-info-circle me-2"></i>No envelope notification settings found.
                                <form method="post" action="@Url.Action("InitializeDefaults", "Settings")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary ms-2">Initialize Defaults</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
                @if (Model.EnvelopeNotificationSettings.Any())
                {
                    <div class="card-footer text-muted small">
                        <i class="fas fa-info-circle me-1"></i>
                        Leave the email field blank to disable notifications for that row without turning off the toggle.
                        Notifications are only sent when <strong>Enabled</strong> is on <em>and</em> an email is entered.
                    </div>
                }
            </div>
        </div>

        <!-- Company Branding Tab -->
        <div class="tab-pane fade @(Model.ActiveTab == "branding" ? "show active" : "")" id="branding" role="tabpanel">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0"><i class="fas fa-palette me-2"></i>Company Branding</h5>
                        <p class="mb-0 text-muted small">Customize logos, company name, and contact info used in emails and throughout the app. DB values override appsettings.json.</p>
                    </div>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="SaveAllBrandingSettings" asp-controller="Settings">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            @foreach (var s in Model.BrandingSettings)
                            {
                                <div class="col-12">
                                    <label class="form-label fw-semibold" for="Branding_@s.SettingKey">@s.DisplayName</label>
                                    @if (!string.IsNullOrWhiteSpace(s.Description))
                                    {
                                        <div class="text-muted small mb-1">@s.Description</div>
                                    }
                                    <div class="input-group">
                                        @if (s.InputType == "url")
                                        {
                                            <span class="input-group-text"><i class="fas fa-link"></i></span>
                                        }
                                        else
                                        {
                                            <span class="input-group-text"><i class="fas fa-font"></i></span>
                                        }
                                        <input type="text" class="form-control branding-field"
                                               id="Branding_@s.SettingKey"
                                               name="Branding_@s.SettingKey"
                                               value="@(s.SettingValue ?? "")"
                                               placeholder="@(s.InputType == "url" ? "https://..." : "")"
                                               data-key="@s.SettingKey"
                                               data-type="@s.InputType" />
                                        @if (s.InputType == "url")
                                        {
                                            <button type="button" class="btn btn-outline-secondary branding-preview-btn"
                                                    data-target="Branding_@s.SettingKey" title="Preview image">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                        }
                                    </div>
                                    @if (s.InputType == "url")
                                    {
                                        <div id="preview_@s.SettingKey" class="mt-2" style="display:none;">
                                            <img src="" alt="Preview" class="img-thumbnail"
                                                 style="max-height:80px;max-width:320px;background:#DBDBDB;" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <hr class="my-4" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save me-1"></i> Save Branding Settings
                            </button>
                            <a asp-action="Index" asp-route-tab="branding" class="btn btn-outline-secondary">
                                <i class="fas fa-undo me-1"></i> Reset
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- General Tab -->
        <div class="tab-pane fade @(Model.ActiveTab == "general" ? "show active" : "")" id="general" role="tabpanel">
            @if (Model.GeneralSettings.Any())
            {
                <div class="row g-3">
                    @foreach (var setting in Model.GeneralSettings)
                    {
                        <div class="col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <label class="form-label fw-semibold" for="gen_@setting.SecuritySettingsId">
                                        @{
                                            var genDisplayName = setting.SettingKey switch
                                            {
                                                "AppTheme"           => "App Theme",
                                                "DefaultTimezone"    => "Default Timezone",
                                                "DateFormat"         => "Date Format",
                                                "TimeFormat"         => "Time Format",
                                                "DefaultLandingPage" => "Default Landing Page",
                                                "ItemsPerPage"       => "Items Per Page",
                                                "MaintenanceMode"    => "Maintenance Mode",
                                                _                    => setting.SettingKey
                                            };
                                        }
                                        @genDisplayName
                                        @if (!string.IsNullOrEmpty(setting.Description))
                                        {
                                            <i class="fas fa-info-circle text-muted ms-1"
                                               title="@setting.Description"
                                               data-bs-toggle="tooltip"></i>
                                        }
                                    </label>
                                    <small class="d-block text-muted mb-2">@setting.Description</small>

                                    @if (setting.InputType == "boolean")
                                    {
                                        <div class="form-check form-switch">
                                            <input class="form-check-input general-setting"
                                                   type="checkbox"
                                                   id="gen_@setting.SecuritySettingsId"
                                                   data-setting-id="@setting.SecuritySettingsId"
                                                   data-setting-key="@setting.SettingKey"
                                                   @(setting.SettingValue.ToLower() == "true" ? "checked" : "") />
                                            <label class="form-check-label" for="gen_@setting.SecuritySettingsId">
                                                @(setting.SettingValue.ToLower() == "true" ? "Enabled" : "Disabled")
                                            </label>
                                        </div>
                                    }
                                    else if (setting.InputType == "select" && setting.AvailableOptions != null)
                                    {
                                        <select class="form-select general-setting"
                                                id="gen_@setting.SecuritySettingsId"
                                                data-setting-id="@setting.SecuritySettingsId"
                                                data-setting-key="@setting.SettingKey">
                                            @foreach (var opt in setting.AvailableOptions)
                                            {
                                                if (setting.SettingValue == opt)
                                                {
                                                    <option value="@opt" selected>@opt</option>
                                                }
                                                else
                                                {
                                                    <option value="@opt">@opt</option>
                                                }
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input type="text"
                                               class="form-control general-setting"
                                               id="gen_@setting.SecuritySettingsId"
                                               data-setting-id="@setting.SecuritySettingsId"
                                               data-setting-key="@setting.SettingKey"
                                               value="@setting.SettingValue" />
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="text-end mt-4">
                    <button type="button" class="btn btn-primary" id="saveGeneralSettings">
                        <i class="fas fa-save me-1"></i> Save General Settings
                    </button>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>No general settings found.
                    <form method="post" action="@Url.Action("InitializeDefaults", "Settings")" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-primary ms-2">Initialize Defaults</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });

            // Toggle dependent checkboxes when main toggle changes
            $('.notification-enabled-toggle').on('change', function() {
                var settingId = $(this).data('setting-id');
                var isEnabled = $(this).is(':checked');

                // Enable/disable dependent checkboxes
                $(`[data-setting-id="${settingId}"].notify-setting`).prop('disabled', !isEnabled);
                $(`.reminder-hours[data-setting-id="${settingId}"]`).prop('disabled', !isEnabled);
            });

            // Save notification settings
            $('#saveNotificationSettings').on('click', function() {
                var settings = [];
                $('.notification-setting-card').each(function() {
                    var $card = $(this);
                    var settingId = $card.find('.notification-enabled-toggle').data('setting-id');

                    var setting = {
                        NotificationSettingsId: settingId,
                        IsEnabled: $card.find('.notification-enabled-toggle').is(':checked'),
                        NotifyAssignee: $card.find('[data-field="NotifyAssignee"]').is(':checked'),
                        NotifyManager: $card.find('[data-field="NotifyManager"]').is(':checked'),
                        NotifyTaskOwner: $card.find('[data-field="NotifyTaskOwner"]').is(':checked'),
                        EnableInAppNotification: $card.find('[data-field="EnableInAppNotification"]').is(':checked'),
                        EnableEmailNotification: false,
                        ReminderHoursBefore: parseInt($card.find('.reminder-hours').val()) || null
                    };

                    settings.push(setting);
                });

                // Save each setting
                var promises = settings.map(function(setting) {
                    return $.ajax({
                        url: '@Url.Action("UpdateNotificationSetting", "Settings")',
                        type: 'POST',
                        contentType: 'application/json',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        data: JSON.stringify(setting)
                    });
                });

                Promise.all(promises)
                    .then(function() {
                        toastr.success('Notification settings saved successfully!');
                    })
                    .catch(function(error) {
                        toastr.error('Error saving notification settings');
                    });
            });

            // Save individual envelope notification setting
            $(document).on('click', '.env-notif-save-btn', function() {
                var $row = $(this).closest('.envelope-notification-row');
                var settingId = parseInt($row.data('setting-id'));
                var email = $row.find('.env-notif-email').val().trim();
                var isEnabled = $row.find('.env-notif-enabled').is(':checked');

                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                $.ajax({
                    url: '@Url.Action("SaveEnvelopeNotificationSetting", "Settings")',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify({
                        EnvelopeNotificationSettingsId: settingId,
                        NotificationEmail: email || null,
                        IsEnabled: isEnabled
                    })
                })
                .done(function(result) {
                    if (result.success) {
                        toastr.success('Envelope notification setting saved!');
                    } else {
                        toastr.error(result.message || 'Error saving setting');
                    }
                })
                .fail(function() {
                    toastr.error('Request failed. Please try again.');
                })
                .always(function() {
                    $btn.prop('disabled', false).html('<i class="fas fa-save"></i>');
                });
            });

            // Branding URL preview buttons
            $(document).on('click', '.branding-preview-btn', function() {
                var targetId = $(this).data('target');
                var url = $('#' + targetId).val().trim();
                var $preview = $('#preview_' + targetId.replace('Branding_', ''));
                if (url) {
                    $preview.find('img').attr('src', url);
                    $preview.show();
                } else {
                    $preview.hide();
                }
            });

            // Save security settings
            $('#saveSecuritySettings').on('click', function() {
                var settings = [];
                $('.security-setting').each(function() {
                    var $input = $(this);
                    var settingId = $input.data('setting-id');
                    var value;

                    if ($input.attr('type') === 'checkbox') {
                        value = $input.is(':checked') ? 'true' : 'false';
                    } else {
                        value = $input.val();
                    }

                    settings.push({
                        SecuritySettingsId: settingId,
                        SettingValue: value
                    });
                });

                // Save each setting
                var promises = settings.map(function(setting) {
                    return $.ajax({
                        url: '@Url.Action("UpdateSecuritySetting", "Settings")',
                        type: 'POST',
                        contentType: 'application/json',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        data: JSON.stringify(setting)
                    });
                });

                Promise.all(promises)
                    .then(function() {
                        toastr.success('Security settings saved successfully!');
                    })
                    .catch(function(error) {
                        toastr.error('Error saving security settings');
                        console.error(error);
                    });
            });

            // Save general settings — reuse the same UpdateSecuritySetting endpoint
            $('#saveGeneralSettings').on('click', function() {
                var settings = [];
                $('.general-setting').each(function() {
                    var $input = $(this);
                    var settingId = parseInt($input.data('setting-id'));
                    if (!settingId) return; // skip uninitialized (id=0 means not yet in DB)
                    var value = $input.attr('type') === 'checkbox'
                        ? ($input.is(':checked') ? 'true' : 'false')
                        : $input.val();
                    settings.push({ SecuritySettingsId: settingId, SettingValue: value });
                });

                // Update label on maintenance mode toggle live
                $('.general-setting[type="checkbox"]').on('change', function() {
                    $(this).next('label').text($(this).is(':checked') ? 'Enabled' : 'Disabled');
                });

                if (settings.length === 0) {
                    toastr.warning('No settings to save. Click "Initialize Defaults" first.');
                    return;
                }

                var promises = settings.map(function(s) {
                    return $.ajax({
                        url: '@Url.Action("UpdateSecuritySetting", "Settings")',
                        type: 'POST',
                        contentType: 'application/json',
                        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                        data: JSON.stringify(s)
                    });
                });

                Promise.all(promises)
                    .then(function() { toastr.success('General settings saved successfully!'); })
                    .catch(function() { toastr.error('Error saving general settings'); });
            });

            // Live label update for General Settings boolean toggles
            $(document).on('change', '.general-setting[type="checkbox"]', function() {
                $(this).next('label').text($(this).is(':checked') ? 'Enabled' : 'Disabled');
            });
        });
    </script>
}

