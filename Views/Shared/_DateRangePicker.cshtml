@model (DateTime StartDate, DateTime EndDate)

<div class="date-range-wrapper mb-0">
    <label for="daterange" class="form-label">Date Range:</label>
    <input type="text" id="daterange" name="daterange" class="form-control shadow-sm" autocomplete="off" />
    <input type="hidden" name="startDate" id="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="endDate" id="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
</div>
