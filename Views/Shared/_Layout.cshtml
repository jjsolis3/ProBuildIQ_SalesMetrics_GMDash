<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title  | SalesMetrics - Task Mgr & Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Sales Metrics and Task Management" name="description" />
    <meta content="774EntFX" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">
    <!-- dark layout js -->
    <script src="~/assets/js/pages/layout.js"></script>

    @RenderSection("styles", required: false)
    
    <!-- Bootstrap Css -->
    <link href="~/assets/css/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Icons Css -->
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- simplebar css -->
    <link href="~/assets/libs/simplebar/simplebar.min.css" rel="stylesheet">
    <!-- App Css-->
    <link href="~/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" />

    <style>
        .dropdown-menu .dropdown-item.active {
            background-color: #e9ecef; /* Light gray */
            color: #000 !important; /* Force black text */
            font-weight: 600;
        }

        #loadingOverlay {
            animation: fadeIn 0.3s ease-in-out;
        }  

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }
    </style>
</head>

@using SalesMetrics.Services.Helpers
@using SalesMetrics.Data
@inject SalesMetricsDbContext DbContext

@{
    var userId = int.Parse(Context.User.FindFirst("Users_ID")?.Value ?? "0");
    var currentLocation = Context.Session.GetString("OfficeLocation") ?? "LAX";
    var assignedLocs = DbContext.UserLocationAssignments
        .Where(x => x.UserID == userId && x.IsActive == "YES")
        .Select(x => x.LocationID)
        .ToList();

    var switchModel = new SalesMetrics.Models.UserLocationSwitcherViewModel
            {
                CurrentLocation = currentLocation,
                AvailableLocations = assignedLocs.Select(loc => new SelectListItem
                {
                    Value = LocationHelper.GetBranchCode(loc),
                    Text = LocationHelper.GetLocationName(loc),
                    Selected = LocationHelper.GetBranchCode(loc) == currentLocation
                }).ToList()
            };
}

<body>
    @{
        var currentBranchCode = Context.Session.GetString("OfficeLocation") ?? "LAX";
        var currentBranchName = SalesMetrics.Services.Helpers.LocationHelper.GetLocationName(
            SalesMetrics.Services.Helpers.LocationHelper.GetLocationId(currentBranchCode)
        );
    }

    <div id="layout-wrapper">
        <!-- Loading Overlay -->
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

            var showOverlay =
                (currentController == "GMDash" && currentAction == "Index") ||
                (currentController == "Dashboard" && currentAction == "Index") ||
                (currentController == "Properties" && currentAction == "Properties") ||
                (currentController == "Dashboard" && currentAction == "Index") ||
                (currentController == "Orders" && currentAction == "Orders") ||
                (currentController == "Tasks" && currentAction == "Task") ||
                (currentController == "Tasks" && currentAction == "AdminTask") ||
                (currentController == "Yardi" && currentAction == "YardiProperties") ||
                (currentController == "Reports" && currentAction == "Run");
        }

        @if (showOverlay)
        {
            @Html.Partial("~/Views/Shared/loading.cshtml")
        }
                
        @Html.Partial("~/Views/Shared/menu.cshtml")

        <div class="main-content">
            
            <div class="page-content">
                <div class="container-fluid">

                    @Html.Partial("~/Views/Shared/pagetitle.cshtml")

                    @RenderBody()
                </div> 
            </div>
            @Html.Partial("~/Views/Shared/footer.cshtml")

        </div>
        <!-- end main content-->
    </div>

    <!-- Session Expired Modal -->
    <div class="modal fade" id="sessionExpiredModal" tabindex="-1" aria-labelledby="sessionExpiredLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="sessionExpiredLabel">Session Expired</h5>
                </div>
                <div class="modal-body">
                    <p>Your session has expired due to inactivity. You will be redirected to the login page.</p>
                    <i class="fas fa-hourglass-end fa-2x text-danger mt-2"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Switch Location Modal -->
    @using SalesMetrics.Services.Helpers
    @{
        var hideLocationSwitcher = PageHelper.ShouldHideLocationSwitcher(currentController, currentAction);

        var showSwitchLocationModal = !hideLocationSwitcher
        && (User.IsInRole("Admin") || User.IsInRole("General Manager") || User.IsInRole("Office Manager") || User.FindFirst("RoleId")?.Value == "1" || User.FindFirst("RoleId")?.Value == "4" || User.FindFirst("RoleId")?.Value == "5");
    }

    @if (showSwitchLocationModal)
    {
        @await Component.InvokeAsync("UserLocationSwitcher", new { viewName = "_SwitchLocationModal" })
    }

    <!-- Journal Entry Modal -->
    @await Html.PartialAsync("_JournalCreateModal", new SalesMetrics.Models.Journal.JournalEntry())

    <!-- JAVASCRIPT -->
    <script src="~/assets/libs/jquery/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
    <script src="~/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/assets/libs/node-waves/waves.min.js"></script>

    <!-- App JS -->
    <script src="~/assets/js/app.js"></script>

    <!-- jsPDF Implementation (with html2canvas) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @RenderSection("scripts", required: false)

    <script>
        const minDisplayTime = 850; // 3 seconds (or 4000 for 4s)
        const startTime = Date.now();

        $(window).on('load', function () {
            const timeElapsed = Date.now() - startTime;
            const timeLeft = minDisplayTime - timeElapsed;

            setTimeout(() => {
                $('#loadingOverlay').fadeOut(600);
            }, timeLeft > 0 ? timeLeft : 0);
        });
    </script>
    <script>
        let sessionTimeout = 89 * 60 * 1000; // 15 minutes
        let sessionTimer;

        function resetSessionTimer() {
            clearTimeout(sessionTimer);
            sessionTimer = setTimeout(showSessionExpiredModal, sessionTimeout);
        }

        function showSessionExpiredModal() {
            $('#sessionExpiredModal').modal('show');
            setTimeout(() => {
                window.location.href = "/Auth/Login";
            }, 8000); // redirect after 5 seconds
        }

        document.addEventListener("DOMContentLoaded", resetSessionTimer);
        document.addEventListener("mousemove", resetSessionTimer);
        document.addEventListener("keypress", resetSessionTimer);
        document.addEventListener("click", resetSessionTimer);
    </script>
    <script>
        $(document).ready(function () {
            const success = '@TempData["Success"]';
            if (success) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: success,
                    showConfirmButton: false,
                    timer: 5000,
                    timerProgressBar: true
                });
            }
        });
    </script>
    <script>
            $(document).ready(function () {
            @if (TempData["TaskFormError"] != null)
            {
                <text>
                            Swal.fire({
                              icon: 'error',
                              title: 'Incomplete Task Form',
                              text: '@TempData["TaskFormError"]',
                              confirmButtonColor: '#f57c00'
                            }).then(() => {
                              $('#createTaskModal').modal('show');
                            });
                </text>
            }

            @if (TempData["TaskSuccess"] != null)
            {
                <text>
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'Success!',
                                            text: '@TempData["TaskSuccess"]',
                                            confirmButtonColor: '#28a745'
                                        });
                </text>
            }
            });
        </script>    
</body>
</html>
