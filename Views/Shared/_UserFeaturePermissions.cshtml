@model SalesMetrics.Models.RegisterViewModel

<div class="row">
    <div class="col-12">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0">Feature Permissions</h6>
                <small>Select which features this user can access</small>
            </div>
            <div class="card-body">
                @if (Model.AllFeatures != null && Model.AllFeatures.Any())
                {
                    <div class="row">
                        @foreach (var feature in Model.AllFeatures)
                        {
                            <div class="col-md-4 col-sm-6 mb-2">
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           name="AssignedFeatureIds"
                                           id="feature_@feature.Value"
                                           value="@feature.Value"
                                           @(Model.AssignedFeatureIds.Contains(int.Parse(feature.Value)) ? "checked" : "") />
                                    <label class="form-check-label" for="feature_@feature.Value">
                                        @feature.Text
                                    </label>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Quick select buttons -->
                    <div class="mt-3 border-top pt-3">
                        <button type="button" class="btn btn-sm btn-outline-primary me-2" onclick="selectAllFeatures()">
                            Select All
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="deselectAllFeatures()">
                            Clear All
                        </button>
                    </div>

                    <script>
                        function selectAllFeatures() {
                            document.querySelectorAll('input[name="AssignedFeatureIds"]').forEach(cb => cb.checked = true);
                        }
                        function deselectAllFeatures() {
                            document.querySelectorAll('input[name="AssignedFeatureIds"]').forEach(cb => cb.checked = false);
                        }
                    </script>
                }
                else
                {
                    <p class="text-muted">No features available. Please run the database migration to create the Features table.</p>
                }
            </div>
        </div>
    </div>
</div>
