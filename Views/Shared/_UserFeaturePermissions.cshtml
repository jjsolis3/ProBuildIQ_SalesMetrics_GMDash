@model SalesMetrics.Models.RegisterViewModel

<div class="row">
    <div class="col-12">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0">Feature Permissions</h6>
                <small>Select which features this user can access</small>
            </div>
            <div class="card-body">
                @if (Model.GroupedFeatures != null && Model.GroupedFeatures.Any())
                {
                    @foreach (var categoryGroup in Model.GroupedFeatures.OrderBy(g => g.Key))
                    {
                        <div class="feature-category-group mb-4">
                            <!-- Category Header -->
                            <h6 class="text-uppercase fw-bold mb-3 pb-2 border-bottom">
                                <i class="fas fa-folder me-2"></i>@categoryGroup.Key
                            </h6>

                            <!-- Features in this category -->
                            <div class="row">
                                @foreach (var feature in categoryGroup.Value)
                                {
                                    <div class="col-md-4 col-sm-6 mb-2">
                                        <div class="form-check">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   name="AssignedFeatureIds"
                                                   id="feature_@feature.FeatureId"
                                                   value="@feature.FeatureId"
                                                   @(Model.AssignedFeatureIds.Contains(feature.FeatureId) ? "checked" : "") />
                                            <label class="form-check-label" for="feature_@feature.FeatureId">
                                                @feature.FeatureName
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Quick select buttons -->
                    <div class="mt-3 border-top pt-3">
                        <button type="button" class="btn btn-sm btn-outline-primary me-2" onclick="selectAllFeatures()">
                            Select All
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="deselectAllFeatures()">
                            Clear All
                        </button>
                    </div>

                    <script>
                        function selectAllFeatures() {
                            document.querySelectorAll('input[name="AssignedFeatureIds"]').forEach(cb => cb.checked = true);
                        }
                        function deselectAllFeatures() {
                            document.querySelectorAll('input[name="AssignedFeatureIds"]').forEach(cb => cb.checked = false);
                        }
                    </script>
                }
                else
                {
                    <p class="text-muted">No features available. Please run the database migration to create the Features table.</p>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .feature-category-group h6 {
        color: #495057;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
    }

    .feature-category-group h6 i {
        color: #667eea;
    }

    .feature-category-group:last-child {
        margin-bottom: 0 !important;
    }
</style>
