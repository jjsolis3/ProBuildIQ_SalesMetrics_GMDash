                        <div class="menu-section-header" data-bs-toggle="collapse" data-bs-target="#salesRepsSection" aria-expanded="true">
                            <span>📊 SALES REPS</span>
                            <span class="chevron">▼</span>
                        </div>
                        <div id="salesRepsSection" class="collapse show menu-section-content">
                            <ul class="list-unstyled">
                                <li class="ms-3">
                                    <a href="/Salesperson/Index">
                                        <i class="fa fa-users"></i>
