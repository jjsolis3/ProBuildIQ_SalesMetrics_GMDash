                        <span>👤 ACCOUNT</span>
                        <span class="chevron">▼</span>
                    </div>
                    <div id="accountSection" class="collapse show menu-section-content">
                        <ul class="list-unstyled">
                            <li class="ms-3">
                                <a href="/Accounts/Profile">
                                    <i class="fa fa-user"></i>
                                    <span>Profile</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                @if (roleId == "1")
                {
                    <!-- Admin / Settings -->
                    <li>
                        <div class="menu-section-header" data-bs-toggle="collapse" data-bs-target="#adminSection" aria-expanded="false">
                            <span>⚙️ ADMIN / SETTINGS</span>
