@using SalesMetrics.Services.Permissions
@inject IPermissionService PermissionService

@{
    var roleId = Context.Session.GetString("RoleId");
    var usersId = int.Parse(Context.User.FindFirst("Users_ID")?.Value ?? "0");

    // Check feature permissions for all sidebar sections
    var hasGMDashboardAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "GMDashboard") : false;
    var hasGMRecapAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "GMRecap") : false;
    var hasDashboardAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Dashboard") : false;
    var hasOfficeDashboardAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "OfficeDashboard") : false;
    var hasTasksAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Tasks") : false;
    var hasSalesPulseAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "SalesPulse") : false;
    var hasJournalAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Journal") : false;
    var hasOrdersAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Orders") : false;
    var hasManagementAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Management") : false;
    var hasPropertiesAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Properties") : false;
    var hasYardiAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Yardi") : false;
    var hasReportsAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Reports") : false;
    var hasAnnouncementsAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Announcements") : false;
    var hasUsersAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Users") : false;
    var hasSettingsAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Settings") : false;
    var hasYardiUploadAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "YardiUpload") : false;
    var hasErrorLogsAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "ErrorLogs") : false;
    var hasSigningAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Signing") : false;
    var hasEnvelopesAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "Envelopes") : false;
    var hasEnvelopeTemplatesAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "EnvelopeTemplates") : false;

    // Query Builder feature permissions (use FeatureCode from seed-data.sql)
    var hasQueryBuilderAccess = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "REPORT_BUILDER_ACCESS") : false;
    var canCreateReports = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "REPORT_BUILDER_CREATE") : false;
    var canEditReports = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "REPORT_BUILDER_EDIT") : false;
    var isQueryBuilderAdmin = usersId > 0 ? await PermissionService.HasFeatureAccessAsync(usersId, "REPORT_BUILDER_ADMIN") : false;

    // Keep role-based flag for conditional display within sections
    // Management roles: Admin(1), Sales Admin(3), GM(4), President/Owner(7), Regional Manager(8)
    var isGMOrAdmin = roleId == "1" || roleId == "4" || roleId == "7" || roleId == "8";
    var isSalesManagerOrAbove = roleId == "1" || roleId == "3" || roleId == "4" || roleId == "7" || roleId == "8";
}

<style>
    /* Improved sidebar styles */
    .menu-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 0.5rem 0.75rem 0.5rem;
        margin-top: 0.90rem;
        margin-bottom: 0.1rem;
        color: #6c757d;
        border-bottom: 2px solid #e9ecef;
    }

    .menu-title:first-child {
        margin-top: 0.5rem;
    }

    #side-menu li.ms-3 {
        margin-bottom: 0.1rem;
    }

    #side-menu li.ms-3 a {
        padding: 0.65rem .085rem;
        border-radius: 6px;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.9rem;
    }

    #side-menu li.ms-3 a:hover {
        background-color: rgba(102, 126, 234, 0.1);
        transform: translateX(3px);
    }

    #side-menu li.ms-3 a i {
        width: 1.25rem;
        text-align: center;
        opacity: 0.8;
    }
</style>

<!-- ========== Left Sidebar Start ========== -->
<div class="sidebar-left">

    <div data-simplebar class="h-100">

        <!--- Sidebar-menu -->
        <div id="sidebar-menu">
            <!-- Left Menu Start -->
            <ul class="left-menu list-unstyled" id="side-menu">
                @if(hasGMDashboardAccess || hasGMRecapAccess)
                {
                    <!-- GM DASHBOARD and RECAP ENTRY/LIST-->
                    <li class="menu-title">GENERAL MGR</li>
                    @if (hasGMDashboardAccess)
                    {
                        <li class="ms-3">
                            <a href="/GMDash/Index">
                                <i class="fas fa-chart-bar"></i>
                                <span>GM Dashboard</span>
                            </a>
                        </li>
                    }
                    @if (hasGMRecapAccess)
                    {
                        <li class="ms-3">
                            <a href="/GMRecap/RecapEntry">
                                <i class="fas fa-inbox"></i>
                                <span>Enter Weekly Recap</span>
                            </a>
                        </li>
                        <li class="ms-3">
                            <a href="/GMRecap/RecapList">
                                <i class="fas fa-list-ol"></i>
                                <span>View Weekly Recap</span>
                            </a>
                        </li>
                    }
                }

                <!-- DASHBOARD -->
                @if (hasDashboardAccess || hasOfficeDashboardAccess)
                {
                    <li class="menu-title">DASHBOARD</li>

                    @if (hasOfficeDashboardAccess)
                    {
                        <!-- Office Dashboard - shown if user has Office Dashboard permission -->
                        <li class="ms-3">
                            <a href="/Office/Index">
                                <i class="fas fa-chart-line"></i>
                                <span>Office Dashboard</span>
                            </a>
                        </li>
                    }

                    @if (hasDashboardAccess)
                    {
                        <!-- Sales Dashboard - shown if user has Dashboard permission -->
                        <li class="ms-3">
                            <a href="/Dashboard/Index">
                                <i class="fas fa-chart-line"></i>
                                <span>Sales Dashboard</span>
                            </a>
                        </li>
                    }
                }

                @if (hasTasksAccess)
                {
                    <!-- SALES TASK ACTIVITIES -->
                    <li class="menu-title">TASKS</li>
                    @if (isSalesManagerOrAbove)
                    {
                        <li class="ms-3">
                            <a href="/Tasks/AdminTask">
                                <i class="fa fa-clipboard-check"></i>
                                <span>View All Tasks</span>
                            </a>
                        </li>
                    }
                    <li class="ms-3">
                        <a href="/Tasks/Task">
                            <i class="fa fa-tasks"></i>
                            <span>My Tasks</span>
                        </a>
                    </li>
                    <li class="ms-3">
                        <a href="/Tasks/Schedule">
                            <i class="fa fa-calendar"></i>
                            <span>Calendar</span>
                        </a>
                    </li>
                }

                @if (hasSalesPulseAccess)
                {
                    <!-- SALESPERSON METRICS -->
                    <li class="menu-title">SALES REPS</li>
                    <li class="ms-3">
                        <a href="/Salesperson/Index">
                            <i class="fa fa-users"></i>
                            <span>Sales Pulse</span>
                        </a>
                    </li>
                }

                <!-- SALES JOURNAL -->
                @if (hasJournalAccess)
                {
                    <li class="menu-title">JOURNAL</li>
                    <li class="ms-3">
                        <a href="/Journal/Index">
                            <i class="fa fa-book"></i>
                            <span>My Journal</span>
                        </a>
                    </li>
                }

                <!-- JOB SCHEDULE / ORDERS -->
                @if (hasOrdersAccess)
                {
                    <li class="menu-title">JOB SCHEDULE</li>
                    <li class="ms-3">
                        <a href="/Orders/Orders">
                            <i class="fa fa-truck"></i>
                            <span>Work Orders</span>
                        </a>
                    </li>
                }

                <!-- MANAGEMENT -->
                @if (hasManagementAccess)
                {
                    <li class="menu-title">MANAGEMENT</li>
                    <li class="ms-3">
                        <a href="/Management/Management">
                            <i class="fa fa-building"></i>
                            <span>Management Co.</span>
                        </a>
                    </li>
                }

                <!-- PROPERTIES -->
                @if (hasPropertiesAccess)
                {
                    <li class="menu-title">PROPERTIES</li>
                    <li class="ms-3">
                        <a href="/Properties/Properties">
                            <i class="fa fa-building"></i>
                            <span>Properties</span>
                        </a>
                    </li>
                }

                <!-- PROSPECTING (YARDI) -->
                @if (hasYardiAccess)
                {
                    <li class="menu-title">PROSPECTING</li>
                    <li class="ms-3">
                        <a href="/Yardi/YardiProperties">
                            <i class="mdi mdi-briefcase-account "></i>
                            <span>Yardi Properties</span>
                        </a>
                    </li>
                }

                @if (hasEnvelopesAccess || hasEnvelopeTemplatesAccess)
                {
                    <!-- DOCUMENTS & SIGNING -->
                    <li class="menu-title">DOCUMENTS & SIGNING</li>
                    @if (hasEnvelopesAccess)
                    {
                        <li class="ms-3">
                            <a href="/SignAdmin/Index">
                                <i class="fa fa-envelope"></i>
                                <span>My Envelopes</span>
                            </a>
                        </li>
                        <li class="ms-3">
                            <a href="/SignAdmin/Create">
                                <i class="fa fa-paper-plane"></i>
                                <span>Send Document</span>
                            </a>
                        </li>
                    }
                    @if (hasEnvelopeTemplatesAccess)
                    {
                        <li class="ms-3">
                            <a href="/SignTemplates/Index">
                                <i class="fa fa-file-alt"></i>
                                <span>Templates</span>
                            </a>
                        </li>
                    }
                }

                @if (hasReportsAccess || hasQueryBuilderAccess)
                {
                    <!-- Reporting & Analytics -->
                    <li class="menu-title">REPORTS</li>

                    @if (hasReportsAccess)
                    {
                        <li class="ms-3">
                            <a href="/Reports">
                                <i class="fa fa-chart-line"></i>
                                <span>Reports</span>
                            </a>
                        </li>
                    }

                    @if (hasQueryBuilderAccess)
                    {
                        <li class="ms-3">
                            <a href="/ReportBuilder">
                                <i class="fa fa-table"></i>
                                <span>Query Builder</span>
                            </a>
                        </li>
                    }

                    @if (canCreateReports)
                    {
                        <li class="ms-3">
                            <a href="/ReportBuilder/Create">
                                <i class="fa fa-plus-circle"></i>
                                <span>Create Report</span>
                            </a>
                        </li>
                    }
                }

                @if (hasAnnouncementsAccess)
                {
                    <!-- Communication -->
                    <li class="menu-title">COMMUNICATION</li>
                    <li class="ms-3">
                        <a href="/Announcements/Index">
                            <i class="fas fa-bullhorn"></i>
                            <span>Announcements</span>
                        </a>
                    </li>
                }

                @if (hasUsersAccess || hasSettingsAccess)
                {
                    <!-- Admin / Settings -->
                    <li class="menu-title">ADMIN / SETTINGS</li>

                    @if (hasSettingsAccess)
                    {
                        <li class="ms-3">
                            <a href="/Settings/Index">
                                <i class="fas fa-cog"></i>
                                <span>System Settings</span>
                            </a>
                        </li>
                    }

                    @if (hasUsersAccess)
                    {
                        <li class="ms-3">
                            <a href="/Accounts/Index">
                                <i class="fa fa-user-cog"></i>
                                <span>Access Controls</span>
                            </a>
                        </li>
                    }
                }

                @if (hasYardiUploadAccess)
                {
                    <li class="ms-3">
                        <a href="/Yardi/Upload">
                            <i class="fa fa-upload"></i>
                            <span>Yardi Upload</span>
                        </a>
                    </li>
                }

                @if (hasErrorLogsAccess)
                {
                    <!-- Web App Errors -->
                    <li class="menu-title">WEB APP ERRORS</li>
                    <li class="ms-3">
                        <a href="/ErrorLog/Dashboard">
                            <i class="fa fa-exclamation-triangle"></i>
                            <span>Error Dashboard</span>
                        </a>
                    </li>
                    <li class="ms-3">
                        <a href="/ErrorLog/Index">
                            <i class="fa fa-list"></i>
                            <span>Error Logs</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
        <!-- Sidebar -->
    </div>
</div>
<!-- Left Sidebar End -->