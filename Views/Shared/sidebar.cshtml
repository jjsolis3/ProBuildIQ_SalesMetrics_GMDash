                </li>

                <!-- SALES PROPERTIES -->
                <li>
                    <div class="menu-section-header" data-bs-toggle="collapse" data-bs-target="#managementSection" aria-expanded="true">
                        <span>🏢 MANAGEMENT</span>
                        <span class="chevron">▼</span>
                    </div>
                    <div id="managementSection" class="collapse show menu-section-content">
                        <ul class="list-unstyled">
                            <li class="ms-3">
                                <a href="/Management/Management">
                                    <i class="fa fa-building"></i>
                                    <span>Management Co.</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- SALES PROPERTIES -->
                <li>
                    <div class="menu-section-header" data-bs-toggle="collapse" data-bs-target="#propertiesSection" aria-expanded="true">
                        <span>🏢 PROPERTIES</span>
                        <span class="chevron">▼</span>
                    </div>
                    <div id="propertiesSection" class="collapse show menu-section-content">
                        <ul class="list-unstyled">
                            <li class="ms-3">
                                <a href="/Properties/Properties">
                                    <i class="fa fa-building"></i>
