                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                }

                <!-- SALES JOURNALIGN -->
                <li>
                    <div class="menu-section-header" data-bs-toggle="collapse" data-bs-target="#journalSection" aria-expanded="true">
                        <span>✎ JOURNAL</span>
                        <span class="chevron">▼</span>
                    </div>
                    <div id="journalSection" class="collapse show menu-section-content">
                        <ul class="list-unstyled">
                            <li class="ms-3">
                                <a href="/Journal/Index">
                                    <i class="fa fa-book"></i>
                                    <span>My Journal</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>

                <!-- JOB SCHEDULE / ORDERS -->
                <li>
                    <div class="menu-section-header" data-bs-toggle="collapse" data-bs-target="#jobScheduleSection" aria-expanded="true">
