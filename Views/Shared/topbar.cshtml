@using SalesMetrics.Services.Helpers
@using System.Security.Claims

@{
    var currentBranchCode = Context.Session.GetString("OfficeLocation") ?? "LAX";
    var currentBranchName = LocationHelper.GetLocationName(LocationHelper.GetLocationId(currentBranchCode));

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var hideLocationSwitcher = PageHelper.ShouldHideLocationSwitcher(currentController, currentAction);

}

<!-- Start topbar -->
<header id="page-topbar">
    <div class="navbar-header">

        <!-- Logo -->
        <!-- Start Navbar-Brand -->
        <div class="navbar-logo-box">
            <a href="/" class="logo logo-dark">
                <span class="logo-sm">
                    <img src="~/assets/images/logo-sm.png" alt="logo-sm-dark" height="32">
                </span>
                <span class="logo-lg">
                    <img src="~/assets/images/logo-dark.png" alt="logo-dark" height="32">
                </span>
            </a>

            <a href="/" class="logo logo-light">
                <span class="logo-sm">
                    <img src="~/assets/images/logo-sm.png" alt="logo-sm-light" height="32">
                </span>
                <span class="logo-lg">
                    <img src="~/assets/images/logo-light.png" alt="logo-light" height="32">
                </span>
            </a>

            <button type="button" class="btn btn-sm top-icon sidebar-btn" id="sidebar-btn">
                <i class="mdi mdi-menu-open align-middle fs-19"></i>
            </button>
        </div>
        <!-- End navbar brand -->
        <!-- Start menu -->
        <div class="d-flex justify-content-between menu-sm px-3 ms-auto">
            <div class="d-flex align-items-center gap-2">
                <div class="dropdown d-none d-lg-block">
                    <button type="button" class="btn btn-primary btn-sm fs-14 d-inline" data-bs-toggle="dropdown">
                        Quick Links
                        <i class="mdi mdi-chevron-down align-middle"></i>
                    </button>

                    <div class="dropdown-menu dropdown-menu-start dropdown-menu-animated">
                        <!-- JOURNAL ENTRY -->
                        <div class="dropdown-submenu">
                            <a href="#" class="dropdown-item">
                                <div class="dropdown-icon"><i class="fa fa-book-open"></i></div>
                                <span class="dropdown-content">My Journal</span>
                                <div class="dropdown-addon"><i class="mdi mdi-chevron-right align-middle"></i></div>
                            </a>
                            <div class="dropdown-submenu-menu dropdown-submenu-end">
                                <a href="/Journal/Index" class="dropdown-item">
                                    <i class="fa fa-search me-3"></i><span class="dropdown-content text-align-end">View Timeline</span>
                                </a>
                                <a href="javascript:void(0);" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#createJournalModal">
                                    <i class="fa fa-pen-nib me-3"></i><span class="dropdown-content text-align-end">New Entry</span>
                                </a>
                            </div>
                        </div>
                        <!--DIVIDER-- >
                        < div class="dropdown-divider"></div>

                        <!-- FORMS ENTRY -->
                    @if (!hideLocationSwitcher && (User.IsInRole("Admin") || User.FindFirst("RoleId")?.Value == "1"))
                    {
                        <div class="dropdown-submenu">
                            <a href="#" class="dropdown-item">
                                <div class="dropdown-icon"><i class="fa fa-clipboard-list"></i></div>
                                <span class="dropdown-content">Form Request</span>
                                <div class="dropdown-addon"><i class="mdi mdi-chevron-right align-middle"></i></div>
                            </a>
                            <div class="dropdown-submenu-menu dropdown-submenu-end">
                                <a href="/Onboarding/NewCustomer" class="dropdown-item">
                                    <i class="fa fa-address-card me-3"></i><span class="dropdown-content text-align-end">New Customer Form</span>
                                </a>
                                <a href="/Onboarding/Submissions" class="dropdown-item">
                                    <i class="fa fa-table me-3"></i><span class="dropdown-content text-align-end">Submissions</span>
                                </a>
                            @* <a href="javascript:void(0);" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#createJournalModal">
                                <i class="fa fa-pen-nib me-3"></i><span class="dropdown-content text-align-end">New Entry</span>
                            </a> *@
                            </div>
                        </div>
                    }
                        <!-- DIVIDER -->
                    @* <div class="dropdown-divider"></div> *@
                    @* <!-- My Proline Link -->
                        <a href="/Accounts/Profile" class="dropdown-item">
                            <div class="dropdown-icon"><i class="fa fa-user-cog"></i></div>
                            <span class="dropdown-content">My Profile</span>
                        </a> *@
                    </div>
                </div>
            </div>

            <!-- Current Branch Indicator -->
        @if (!hideLocationSwitcher && (User.IsInRole("Admin") || User.IsInRole("General Manager") || User.IsInRole("Office Manager") || User.FindFirst("RoleId")?.Value == "1" || User.FindFirst("RoleId")?.Value == "4" || User.FindFirst("RoleId")?.Value == "5"))
        {
            <!-- Current Branch Indicator Switch Button -->
            <div class="d-none d-md-flex align-items-center ms-2">
                <button type="button" class="btn btn-orange text-white fw-bold px-3 py-1 rounded-pill fs-14 border-0 shadow-sm" data-bs-toggle="modal" data-bs-target="#switchLocationModal">
                    <i class="fas fa-map-marker-alt me-1 text-light"></i>
                @currentBranchName Branch
                </button>
                <p style="display:none;">
                    Controller: @currentController <br />
                    Action: @currentAction
                </p>
            </div>
        }
        else
        {
            <!-- Current Branch Indicator -->
            <div class="d-none d-md-flex align-items-center ms-2">
                <span class="badge bg-orange text-white fw-bold px-3 py-1 rounded-pill fs-14 border-0 shadow-sm" style="display:none;">
                    <i class="fas fa-map-marker-alt me-1 text-light"></i>
                @currentBranchName Branch
                </span>
                <p style="display:none;">
                    Controller: @currentController <br />
                    Action: @currentAction
                </p>
            </div>
        }

            <div class="d-flex align-items-center gap-2">
                <!--Start App Search-->
            @* <form class="app-search d-none d-lg-block">
                    <div class="position-relative">
                        <input type="text" class="form-control" placeholder="Search...">
                        <span class="fab fa-sistrix fs-17 align-middle"></span>
                    </div>
                </form> *@
                <!--End App Search-->
                <!-- Start Notification -->
                <div class="dropdown d-inline-block">
                    <button type="button" class="btn btn-sm top-icon" id="page-header-notifications-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-bell align-middle"></i>
                        <!-- Notification Dot Marker -->
                        <span class="btn-marker" style="display:none;"><i class="marker marker-dot text-danger"></i></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-lg dropdown-menu-md dropdown-menu-end p-0" aria-labelledby="page-header-notifications-dropdown">
                        <div class="p-3 bg-info">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h6 class="text-white m-0"><i class="far fa-bell me-2"></i> Notifications </h6>
                                </div>
                                <div class="col-auto">
                                    <span id="notification-count-badge" class="badge bg-info-subtle text-info">0</span>
                                </div>
                            </div>
                        </div>
                        <div id="notification-list" data-simplebar style="max-height: 300px;">
                            <!-- Notifications will be loaded here by JavaScript -->
                            <div class="text-center p-4">
                                <i class="fas fa-spinner fa-spin text-muted fs-1"></i>
                                <p class="text-muted mt-2">Loading notifications...</p>
                            </div>
                        </div>
                        <div class="p-2 border-top">
                            <div class="row g-2">
                                <div class="col-6">
                                    <a class="btn btn-sm btn-link font-size-13 text-center w-100" href="javascript:void(0)" onclick="markAllAsRead()">
                                        <i class="mdi mdi-check-all me-1"></i> Mark All Read
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a class="btn btn-sm btn-link font-size-13 text-center w-100" href="/Notifications/Index">
                                        <i class="mdi mdi-arrow-right-circle me-1"></i> View All
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- End Notification -->
                <!-- Start Profile -->
                @{
                    var userFullName = User.FindFirst("FullName")?.Value ?? "User";
                    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "User";
                    var userLocation = Context.Session.GetString("OfficeLocation") ?? "LAX";
                    var isAdmin = User.IsInRole("Admin") || User.FindFirst("RoleId")?.Value == "1";
                    var isGM = User.IsInRole("GM") || User.FindFirst("RoleId")?.Value == "4";
                    var isAdminOrGM = User.IsInRole("Admin") || User.IsInRole("GM") || User.FindFirst("RoleId")?.Value == "1" || User.FindFirst("RoleId")?.Value == "4";
                }
                <div class="dropdown d-inline-block">
                    <button type="button" class="btn btn-sm top-icon p-0" id="page-header-user-dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <img class="rounded avatar-2xs p-0" src="~/assets/images/users/GenericPhoto.png" alt="Header Avatar">
                    </button>
                    <div class="dropdown-menu dropdown-menu-wide dropdown-menu-end dropdown-menu-animated overflow-hidden py-0">
                        <div class="card border-0">
                            <!-- User Info Header -->
                            <div class="card-header bg-primary rounded-0">
                                <div class="rich-list-item w-100 p-0">
                                    <div class="rich-list-prepend">
                                        <div class="avatar avatar-label-light avatar-circle">
                                            <div class="avatar-display"><i class="fa fa-user-alt"></i></div>
                                        </div>
                                    </div>
                                    <div class="rich-list-content">
                                        <h3 class="rich-list-title text-white mb-0">@userFullName</h3>
                                        <span class="rich-list-subtitle text-white-50 small">@userRole</span>
                                    </div>
                                    <div class="rich-list-append">
                                        <span class="badge badge-label-light fs-6" title="Current Location">@userLocation</span>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body p-0">
                                <!-- Main Navigation Grid -->
                                <div class="grid-nav grid-nav-flush grid-nav-action grid-nav-no-rounded">
                                    <div class="grid-nav-row">
                                        <a href="/Accounts/Profile" class="grid-nav-item" aria-label="View Profile">
                                            <div class="grid-nav-icon"><i class="far fa-address-card"></i></div>
                                            <span class="grid-nav-content">Profile</span>
                                        </a>
                                        <a href="/Tasks/Task" class="grid-nav-item" aria-label="View Tasks">
                                            <div class="grid-nav-icon"><i class="far fa-calendar-check"></i></div>
                                            <span class="grid-nav-content">Tasks</span>
                                        </a>
                                        <a href="/Orders/Orders" class="grid-nav-item" aria-label="View Job Schedule">
                                            <div class="grid-nav-icon"><i class="far fa-calendar"></i></div>
                                            <span class="grid-nav-content">Job Schedule</span>
                                        </a>
                                    </div>

                                    <div class="grid-nav-row">
                                        <a href="/Properties/Properties" class="grid-nav-item" aria-label="View Properties">
                                            <div class="grid-nav-icon"><i class="far fa-building"></i></div>
                                            <span class="grid-nav-content">Properties</span>
                                        </a>
                                        <a href="/Yardi/YardiProperties" class="grid-nav-item" aria-label="View Yardi">
                                            <div class="grid-nav-icon"><i class="far fa-address-book"></i></div>
                                            <span class="grid-nav-content">Yardi</span>
                                        </a>
                                        <a href="/Journal/Index" class="grid-nav-item" aria-label="View Journal">
                                            <div class="grid-nav-icon"><i class="far fa-comments"></i></div>
                                            <span class="grid-nav-content">Journal</span>
                                        </a>
                                    </div>

                                    @if (isAdmin)
                                {
                                    <!-- Documents & Signing Section -->
                                    <div class="nav-menu-divider">
                                        <span class="nav-menu-divider-text">Documents & Signing</span>
                                    </div>
                                    <div class="grid-nav-row">
                                        <a href="/SignAdmin/Index" class="grid-nav-item" aria-label="View Envelopes">
                                            <div class="grid-nav-icon"><i class="fa fa-envelope"></i></div>
                                            <span class="grid-nav-content">My Envelopes</span>
                                        </a>
                                        <a href="/SignAdmin/Create" class="grid-nav-item" aria-label="Send Document">
                                            <div class="grid-nav-icon"><i class="fa fa-paper-plane"></i></div>
                                            <span class="grid-nav-content">Send Document</span>
                                        </a>
                                        <a href="/SignTemplates/Index" class="grid-nav-item" aria-label="Manage Templates">
                                            <div class="grid-nav-icon"><i class="fa fa-file-alt"></i></div>
                                            <span class="grid-nav-content">Templates</span>
                                        </a>
                                    </div>
                                }
                                    @if (isAdminOrGM)
                                    {

                                        <!-- Office Location Section -->
                                        <div class="nav-menu-divider">
                                            <span class="nav-menu-divider-text">Settings</span>
                                        </div>
                                        <div class="location-switcher-section">
                                            <div class="d-flex align-items-center px-3 py-3">
                                                <div class="me-3">
                                                    <i class="fas fa-map-marker-alt text-primary fs-4"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <label class="form-label mb-1 small fw-semibold text-muted">Office Location</label>
                                                    @await Component.InvokeAsync("UserLocationSwitcher")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Sign Out Footer -->
                                <div class="card-footer card-footer-bordered rounded-0">
                                    <form method="post" action="/auth/logout" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-label-danger w-100" aria-label="Sign Out">
                                            <i class="mdi mdi-logout me-1"></i> Sign out
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- End Profile -->
            </div>
        </div>
        <!-- End menu -->
    </div>
</header>
<!-- End topbar -->