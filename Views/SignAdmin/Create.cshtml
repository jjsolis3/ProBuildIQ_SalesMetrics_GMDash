@* Views/SignAdmin/Create.cshtml *@
@model SalesMetrics.Models.Signing.CreateEnvelopeVm
@{
    ViewData["Title"] = "New Envelope";
    ViewBag.PTitle = "My Envelopes";
    ViewBag.PLink  = "/SignAdmin";
    var i = 0;
}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-warning text-dark fw-bold">Create & Send Envelope</div>
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Envelope Type</label>
                    <select asp-for="EnvelopeType" class="form-select" id="envelopeTypeSelect">
                        <option value="Consent">✍️ Consent (Signature Required)</option>
                        <option value="Communication">📧 Communication (Tracked Delivery)</option>
                    </select>
                    <small class="form-text text-muted">
                        <span id="typeHintConsent">Recipient must review and sign the document.</span>
                        <span id="typeHintComm" style="display:none;">Recipient receives and acknowledges the document — no signature collected.</span>
                    </small>
                </div>
                <div class="col-md-3" id="templateGroup">
                    <label class="form-label">Template <span id="templateRequired" class="text-danger">*</span></label>
                    <select asp-for="TemplateKey" id="templateKeySelect" class="form-select">
                        <option value="">-- Select a template --</option>
                        @foreach (var t in Model.Templates)
                        {
                            <option value="@t.Key" data-type="@t.Type">@t.Display</option>
                        }
                    </select>
                    <div id="noTemplatesMsg" class="form-text text-warning" style="display:none;">
                        No templates available for this envelope type. <a asp-controller="SignTemplates" asp-action="Create">Create one.</a>
                    </div>
                    <span asp-validation-for="TemplateKey" class="text-danger small"></span>
                </div>
                <div class="col-md-6" id="subjectGroup">
                    <label class="form-label">Subject <span class="text-danger">*</span></label>
                    <input asp-for="Subject" class="form-control" />
                    <span asp-validation-for="Subject" class="text-danger"></span>
                </div>
                <div class="col-md-12">
                    <label class="form-label" id="messageLabel">Message <span class="text-muted small">(Optional)</span></label>
                    <textarea asp-for="MessageBody" id="messageBody" class="form-control" rows="3" placeholder="Enter your message here..."></textarea>
                    <div class="form-text" id="messageHint">
                        <small class="text-muted">Property, Order, and Branch details will be automatically appended when you make selections below</small>
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Branch</label>
                    @if (ViewBag.HasMultipleLocations == true)
                    {
                        @* User has multiple location access - show dropdown *@
                        <select asp-for="LocationCode" id="branchSelect" class="form-select" required>
                            @if (ViewBag.Locations != null)
                            {
                                @foreach (var loc in (Dictionary<int, (string Code, string Name)>)ViewBag.Locations)
                                {
                                    <option value="@loc.Value.Code">@loc.Value.Code - @loc.Value.Name</option>
                                }
                            }
                        </select>
                    }
                    else
                    {
                        @* User has single location - show as read-only *@
                        @if (ViewBag.Locations != null)
                        {
                            var singleLoc = ((Dictionary<int, (string Code, string Name)>)ViewBag.Locations).Values.FirstOrDefault();
                            <input type="text" class="form-control" value="@singleLoc.Code - @singleLoc.Name" readonly style="background-color: #e9ecef;" />
                            <input type="hidden" asp-for="LocationCode" id="branchSelect" />
                        }
                    }
                    <span asp-validation-for="LocationCode" class="text-danger"></span>
                    <small class="form-text text-muted">
                        <i class="bi bi-info-circle"></i> Property and order searches will use this branch location
                    </small>
                </div>

                @* <div class="col-md-3">
                    <label class="form-label">Property ID</label>
                    <input asp-for="PropertyID" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Order ID</label>
                    <input asp-for="OrderId" class="form-control" />
                </div> *@

                <div class="col-md-3 position-relative">
                    <label class="form-label">Property</label>
                    <input id="propSearch" name="CustomPropertyName" class="form-control" placeholder="Search by property name..." autocomplete="off" />
                    <input type="hidden" asp-for="PropertyID" id="propId" />
                    <div id="propResults" class="list-group position-absolute w-100" style="z-index: 1050;"></div>
                    <div class="form-text text-muted small">
                        Search ERP, or type a name and fill in Order&nbsp;# and Unit below.
                    </div>
                </div>

                @* ERP order dropdown — only visible after an ERP property is selected *@
                <div class="col-md-3" id="erpOrderSection" style="display:none;">
                    <label class="form-label">Order</label>
                    <select asp-for="OrderId" id="orderSelect" class="form-select" disabled>
                        <option value="">Select a property first</option>
                    </select>
                </div>

                @* Free-text order + unit — visible by default (no ERP match) *@
                <div class="col-md-2" id="freeOrderSection">
                    <label class="form-label">Order #</label>
                    <input asp-for="CustomOrderNumber" id="freeOrderInput" class="form-control" placeholder="e.g. 90805.4" />
                    <div class="form-text text-muted small">Manual entry</div>
                </div>
                <div class="col-md-1" id="freeUnitSection">
                    <label class="form-label">Unit</label>
                    <input asp-for="CustomUnitNumber" id="freeUnitInput" class="form-control" placeholder="e.g. 101" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Expires</label>
                    <input asp-for="ExpiresAtUtc" type="datetime-local" class="form-control" />
                </div>
            </div>

            <hr />
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="fw-bold">Recipients</div>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addRecipient()">+ Add Recipient</button>
            </div>

            <div id="recipients">
                @for (i = 0; i < Math.Max(Model.Recipients.Count, 1); i++)
                {
                    <div class="row g-2 align-items-end mb-2 recipient-row">
                        <div class="col-md-2">
                            <label class="form-label">Role</label>
                            @* <input name="Recipients[@i].Role" class="form-control" value="@(Model.Recipients.ElementAtOrDefault(i)?.Role ?? "Manager")" /> *@
                            <select name="Recipients[@i].Role" class="form-select">
                                <option value="Manager" selected>Manager</option>
                                <option value="Supervisor">Supervisor</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Tenant">Tenant</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label">Order</label>
                            <input name="Recipients[@i].SignerOrder" class="form-control" value="@(Model.Recipients.ElementAtOrDefault(i)?.SignerOrder ?? 1)" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Full Name</label>
                            <input name="Recipients[@i].FullName" class="form-control"
                                   value="@(Model.Recipients.ElementAtOrDefault(i)?.FullName ?? "")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Email</label>
                            <input name="Recipients[@i].Email" type="email" class="form-control"
                                   value="@(Model.Recipients.ElementAtOrDefault(i)?.Email ?? "")" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Phone</label>
                            <input name="Recipients[@i].Phone" class="form-control"
                                   value="@(Model.Recipients.ElementAtOrDefault(i)?.Phone ?? "")" />
                        </div>
                        <div class="col-md-1 text-end">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-recipient"
                                    title="Remove this recipient">
                                Remove
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3">
                <button class="btn btn-success">Send Envelope</button>
                <a asp-action="Index" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function addRecipient(){
          const idx = document.querySelectorAll('#recipients .recipient-row').length;
          const row = document.createElement('div');
          row.className='row g-2 align-items-end mb-2 recipient-row';
          row.innerHTML = `
            <div class="col-md-2"><label class="form-label">Role</label><input name="Recipients[${idx}].Role" class="form-control" value="Manager"/></div>
            <div class="col-md-1"><label class="form-label">Order</label><input name="Recipients[${idx}].SignerOrder" class="form-control" value="1"/></div>
            <div class="col-md-3"><label class="form-label">Full Name</label><input name="Recipients[${idx}].FullName" class="form-control"/></div>
            <div class="col-md-3"><label class="form-label">Email</label><input name="Recipients[${idx}].Email" type="email" class="form-control"/></div>
            <div class="col-md-3"><label class="form-label">Phone</label><input name="Recipients[${idx}].Phone" class="form-control"/></div>`;
          document.getElementById('recipients').appendChild(row);
        }
    </script>

    <script>
        function reindexRecipients() {
          document.querySelectorAll('#recipients .recipient-row').forEach((row, idx) => {
            row.querySelectorAll('input[name^="Recipients["], select[name^="Recipients["]').forEach(el => {
              const field = el.name.substring(el.name.indexOf('].') + 2); // e.g. "FullName"
              el.name = `Recipients[${idx}].${field}`;
            });
          });
        }

        function addRecipient() {
          const idx = document.querySelectorAll('#recipients .recipient-row').length;
          const row = document.createElement('div');
          row.className = 'row g-2 align-items-end mb-2 recipient-row';
          row.innerHTML = `
            <div class="col-md-2">
              <label class="form-label">Role</label>
              <select name="Recipients[${idx}].Role" class="form-select">
                <option value="Manager" selected>Manager</option>
                <option value="Tenant">Tenant</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="col-md-1">
              <label class="form-label">Order</label>
              <input name="Recipients[${idx}].SignerOrder" class="form-control" value="1" />
            </div>
            <div class="col-md-3">
              <label class="form-label">Full Name</label>
              <input name="Recipients[${idx}].FullName" class="form-control" />
            </div>
            <div class="col-md-3">
              <label class="form-label">Email</label>
              <input name="Recipients[${idx}].Email" type="email" class="form-control" />
            </div>
            <div class="col-md-2">
              <label class="form-label">Phone</label>
              <input name="Recipients[${idx}].Phone" class="form-control" />
            </div>
            <div class="col-md-1 text-end">
              <button type="button" class="btn btn-outline-danger btn-sm remove-recipient">Remove</button>
            </div>`;
          document.getElementById('recipients').appendChild(row);
          reindexRecipients();
        }

        // event delegation to handle remove clicks on current + future rows
        document.getElementById('recipients').addEventListener('click', (e) => {
          if (e.target.classList.contains('remove-recipient')) {
            const row = e.target.closest('.recipient-row');
            row?.remove();
            reindexRecipients();
          }
        });
    </script>

    <script>
        // --- Property search with ERP/free-text mode switching ---
        let propTimer;
        const propSearch = document.getElementById('propSearch');
        const propId     = document.getElementById('propId');
        const propResults = document.getElementById('propResults');
        const orderSelect = document.getElementById('orderSelect');

        // Switch between ERP mode (property found in ERP → show order dropdown)
        // and free-text mode (no ERP match → show manual order# + unit fields).
        function setPropertyMode(erp) {
            document.getElementById('erpOrderSection').style.display  = erp ? '' : 'none';
            document.getElementById('freeOrderSection').style.display = erp ? 'none' : '';
            document.getElementById('freeUnitSection').style.display  = erp ? 'none' : '';
            // Disable the ERP order select when hidden so it won't submit
            orderSelect.disabled = !erp;
        }
        // Default: free-text mode (nothing selected from ERP yet)
        setPropertyMode(false);

        const propSearchHandler = function () {
            clearTimeout(propTimer);
            const q = propSearch.value.trim();
            // If the user is re-typing after an ERP selection, drop back to free-text mode
            if (propId.value) {
                propId.value = '';
                setPropertyMode(false);
            }
            if (!q) { propResults.innerHTML = ''; return; }
            propTimer = setTimeout(async () => {
                try {
                    const branchSelect = document.getElementById('branchSelect');
                    const locationCode = branchSelect?.value || '';
                    const url = `/api/properties/search?term=${encodeURIComponent(q)}${locationCode ? '&locationCode=' + encodeURIComponent(locationCode) : ''}`;
                    const res = await fetch(url);
                    if (!res.ok) throw new Error(`HTTP ${res.status}: ${res.statusText}`);
                    const items = await res.json();
                    propResults.innerHTML = items.map(i =>
                        `<button type="button" class="list-group-item list-group-item-action" data-id="${i.id}" data-name="${i.name}">${i.name}</button>`
                    ).join('');
                } catch (error) {
                    console.error('Property search error:', error);
                    propResults.innerHTML = '<div class="list-group-item text-danger">Error loading properties. Please try again.</div>';
                }
            }, 250);
        };
        propSearch.addEventListener('input', propSearchHandler);

        const propResultsClickHandler = async function (e) {
            const btn = e.target.closest('button[data-id]');
            if (!btn) return;
            propId.value    = btn.dataset.id;
            propSearch.value = btn.dataset.name;
            propResults.innerHTML = '';
            // Switch to ERP mode: show order dropdown, hide free-text fields
            setPropertyMode(true);
            orderSelect.innerHTML = '<option value="">Loading orders…</option>';
            orderSelect.disabled  = true;
            try {
                const branchSelect = document.getElementById('branchSelect');
                const locationCode = branchSelect?.value || '';
                const orderUrl = `/api/orders/by-property?propertyId=${encodeURIComponent(propId.value)}${locationCode ? '&locationCode=' + encodeURIComponent(locationCode) : ''}`;
                const res = await fetch(orderUrl);
                if (!res.ok) throw new Error(`HTTP ${res.status}: ${res.statusText}`);
                const items = await res.json();
                orderSelect.innerHTML = '<option value="">Select an order (optional)</option>' +
                    items.map(o => `<option value="${o.id}">${o.display}</option>`).join('');
                orderSelect.disabled = false;
            } catch (error) {
                console.error('Order loading error:', error);
                orderSelect.innerHTML = '<option value="">Error loading orders – please try again</option>';
                orderSelect.disabled = false;
            }
        };
        propResults.addEventListener('click', propResultsClickHandler);

        // Dismiss suggestions when clicking elsewhere
        const documentClickHandler = function (e) {
            if (!propResults.contains(e.target) && e.target !== propSearch)
                propResults.innerHTML = '';
        };
        document.addEventListener('click', documentClickHandler);

        // Cleanup on page unload
        function cleanupCreateEventListeners() {
            if (propTimer) clearTimeout(propTimer);
            propSearch?.removeEventListener('input', propSearchHandler);
            propResults?.removeEventListener('click', propResultsClickHandler);
            document.removeEventListener('click', documentClickHandler);
        }
        window.addEventListener('beforeunload', cleanupCreateEventListeners);
    </script>

    <script>
        // Envelope type: adapt form layout based on Consent vs Communication
        const typeSelect = document.getElementById('envelopeTypeSelect');
        const templateGroup = document.getElementById('templateGroup');
        const templateKeySelect = document.getElementById('templateKeySelect');
        const subjectGroup = document.getElementById('subjectGroup');
        const messageBody = document.getElementById('messageBody');
        const messageLabel = document.getElementById('messageLabel');
        const messageHint = document.getElementById('messageHint');

        function updateEnvelopeTypeUi() {
            const isComm = typeSelect && typeSelect.value === 'Communication';
            const selectedType = isComm ? 'Communication' : 'Consent';

            // Hint text
            document.getElementById('typeHintConsent').style.display = isComm ? 'none' : '';
            document.getElementById('typeHintComm').style.display    = isComm ? '' : 'none';

            // Template field: required for Consent, hidden for Communication
            if (templateGroup) templateGroup.style.display = isComm ? 'none' : '';
            if (templateKeySelect) templateKeySelect.required = !isComm;

            // Filter template options to only show those matching the selected envelope type
            if (templateKeySelect) {
                let visibleCount = 0;
                templateKeySelect.querySelectorAll('option[data-type]').forEach(opt => {
                    const show = opt.dataset.type === selectedType;
                    opt.style.display = show ? '' : 'none';
                    if (show) visibleCount++;
                    // Deselect hidden options
                    if (!show && opt.selected) opt.selected = false;
                });
                const noMsg = document.getElementById('noTemplatesMsg');
                if (noMsg) noMsg.style.display = visibleCount === 0 ? '' : 'none';
            }

            // Subject: wider when no template col
            if (subjectGroup) {
                subjectGroup.className = isComm
                    ? 'col-md-9'   // Communication: Subject takes the space freed by Template
                    : 'col-md-6';  // Consent: Template + Subject side-by-side
            }

            // Message: more prominent for Communication (the body IS the communication)
            if (messageBody) {
                messageBody.rows = isComm ? 6 : 3;
                messageBody.placeholder = isComm
                    ? 'Enter the communication message to send to the recipient...'
                    : 'Enter your message here...';
            }
            if (messageLabel) messageLabel.innerHTML = isComm
                ? 'Message Body <span class="text-danger">*</span>'
                : 'Message <span class="text-muted small">(Optional)</span>';
            if (messageHint) messageHint.style.display = isComm ? 'none' : '';
        }

        if (typeSelect) {
            typeSelect.addEventListener('change', updateEnvelopeTypeUi);
            updateEnvelopeTypeUi();
        }
    </script>
}

