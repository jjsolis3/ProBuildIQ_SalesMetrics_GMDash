@* Views/SignAdmin/Details.cshtml *@
@model SalesMetrics.Models.Signing.EnvelopeDetailsVm
@{
    ViewData["Title"] = "Envelope Details";
}
<div class="card mb-3 border-0 shadow-sm">
    <div class="card-header bg-warning text-dark fw-bold">
        Envelope #@Model.EnvelopeId – @Model.Subject
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-8">
                @if (!string.IsNullOrEmpty(Model.PropertyName) || !string.IsNullOrEmpty(Model.OrderNumber) || !string.IsNullOrEmpty(Model.LocationCode))
                {
                    <div class="card border-0 mb-3">
                        <div class="card-header bg-info text-white">Property Information</div>
                        <div class="card-body">
                            <div class="row g-2">
                                @if (!string.IsNullOrEmpty(Model.PropertyName))
                                {
                                    <div class="col-md-12">
                                        <strong>Property:</strong> @Model.PropertyName
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.OrderNumber))
                                {
                                    <div class="col-md-6">
                                        <strong>Order #:</strong> @Model.OrderNumber
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.LocationCode))
                                {
                                    <div class="col-md-6">
                                        <strong>Branch:</strong> @Model.LocationCode
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="card border-0 mb-3">
                    <div class="card-header bg-gradient" style="background:linear-gradient(90deg,#ff8c00,#ffb347)">Recipients</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var r in Model.Recipients)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <div>
                                    <div class="fw-semibold">@r.FullName (@r.Role) • <span class="text-muted">@r.Email</span></div>
                                    <div class="small text-muted">Viewed: @r.ViewedAtUtc?.ToLocalTime().ToString("g") • Signed: @r.SignedAtUtc?.ToLocalTime().ToString("g")</div>
                                </div>
                                <span class="badge rounded-pill @(r.SignedAtUtc != null ? "bg-success" : "bg-warning text-dark")">
                                    @(r.SignedAtUtc != null ? "Signed" : "Pending")
                                </span>
                            </li>
                        }
                    </ul>
                </div>

                <div class="card border-0">
                    <div class="card-header bg-gradient" style="background:linear-gradient(90deg,#ff8c00,#ffb347)">Timeline</div>
                    <div class="list-group list-group-flush">
                        @foreach (var e in Model.Events)
                        {
                            <div class="list-group-item">
                                <div class="fw-semibold">@e.EventType</div>
                                <div class="small text-muted">@e.OccurredAtUtc.ToLocalTime().ToString("g") • @e.Recipient</div>
                                @if (!string.IsNullOrWhiteSpace(e.Meta))
                                {
                                    <pre class="small text-muted mb-0">@e.Meta</pre>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 mb-3">
                    <div class="card-body">
                        <div>Status: <span class="badge rounded-pill @(Model.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@Model.Status</span></div>
                        <div class="small text-muted mt-2">Sent: @Model.SentAtUtc?.ToLocalTime().ToString("g")</div>
                        <div class="small text-muted">Completed: @Model.CompletedAtUtc?.ToLocalTime().ToString("g")</div>
                        <div class="small text-muted">Expires: @Model.ExpiresAtUtc?.ToLocalTime().ToString("g")</div>
                        @if (!string.IsNullOrEmpty(Model.PdfPath))
                        {
                            <div class="mt-3">
                                <a class="btn btn-outline-success w-100" href="@Model.PdfPath" target="_blank">Download PDF</a>
                                <div class="small text-muted mt-2">Hash: <code>@Model.PdfSha256Hex</code></div>
                            </div>
                        }
                        <form asp-action="Resend" asp-route-id="@Model.EnvelopeId" method="post" class="mt-3">
                            <button class="btn btn-outline-primary w-100">Resend Emails</button>
                            @Html.AntiForgeryToken()
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
