@* Views/SignAdmin/Details.cshtml *@
@model SalesMetrics.Models.Signing.EnvelopeDetailsVm
@{
    ViewData["Title"] = "Envelope Details";
}
<div class="card mb-3 border-0 shadow-sm">
    <div class="card-header bg-warning text-dark fw-bold">
        Envelope #@Model.EnvelopeId – @Model.Subject
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-8">
                @if (!string.IsNullOrEmpty(Model.PropertyName) || !string.IsNullOrEmpty(Model.OrderNumber) || !string.IsNullOrEmpty(Model.LocationCode))
                {
                    <div class="card border-0 mb-3">
                        <div class="card-header bg-info text-white">Property Information</div>
                        <div class="card-body">
                            <div class="row g-2">
                                @if (!string.IsNullOrEmpty(Model.PropertyName))
                                {
                                    <div class="col-md-12">
                                        <strong>Property:</strong> @Model.PropertyName
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.OrderNumber) || !string.IsNullOrEmpty(Model.UnitNumber))
                                {
                                    <div class="col-md-6">
                                        <strong>Order #:</strong> @Model.OrderNumber
                                        @if (!string.IsNullOrEmpty(Model.UnitNumber))
                                        {
                                            <text> - Unit: @Model.UnitNumber</text>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.LocationCode))
                                {
                                    <div class="col-md-6">
                                        <strong>Branch:</strong> @Model.LocationCode
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.MessageBody))
                {
                    <div class="card border-0 mb-3">
                        <div class="card-header bg-gradient" style="background:linear-gradient(90deg,#ff8c00,#ffb347)">Message</div>
                        <div class="card-body">
                            <p class="mb-0" style="white-space:pre-wrap;">@Model.MessageBody</p>
                        </div>
                    </div>
                }

                <div class="card border-0 mb-3">
                    <div class="card-header bg-gradient" style="background:linear-gradient(90deg,#ff8c00,#ffb347)">Recipients</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var r in Model.Recipients)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="fw-semibold">@r.FullName (@r.Role) • <span class="text-muted">@r.Email</span></div>
                                    @if (!string.IsNullOrWhiteSpace(r.Phone))
                                    {
                                        <div class="small text-muted"><i class="fas fa-phone me-1"></i>@r.Phone</div>
                                    }
                                    <div class="small text-muted">
                                        Viewed: @(r.ViewedAtUtc.HasValue ? r.ViewedAtUtc.Value.ToLocalTime().ToString("g") : "—")
                                        @if (r.SignedAtUtc.HasValue)
                                        {
                                            <text> • Signed: @r.SignedAtUtc.Value.ToLocalTime().ToString("g")</text>
                                        }
                                        @if (r.DeclinedAtUtc.HasValue)
                                        {
                                            <text> • Declined: @r.DeclinedAtUtc.Value.ToLocalTime().ToString("g")</text>
                                        }
                                    </div>
                                </div>
                                @if (r.SignedAtUtc != null)
                                {
                                    <span class="badge rounded-pill bg-success">Signed</span>
                                }
                                else if (r.DeclinedAtUtc != null)
                                {
                                    <span class="badge rounded-pill bg-danger">Declined</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-warning text-dark">Pending</span>
                                }
                            </li>
                        }
                    </ul>
                </div>

                <div class="card border-0">
                    <div class="card-header bg-gradient" style="background:linear-gradient(90deg,#ff8c00,#ffb347)">Timeline</div>
                    <div class="list-group list-group-flush">
                        @foreach (var e in Model.Events)
                        {
                            <div class="list-group-item">
                                <div class="fw-semibold">@e.EventType</div>
                                <div class="small text-muted">@e.OccurredAtUtc.ToLocalTime().ToString("g") • @e.Recipient</div>
                                @if (!string.IsNullOrWhiteSpace(e.Meta))
                                {
                                    <pre class="small text-muted mb-0">@e.Meta</pre>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 mb-3">
                    <div class="card-body">
                        <div>Status: <span class="badge rounded-pill @(Model.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@Model.Status</span></div>
                        <div class="small text-muted mt-2">Sent: @Model.SentAtUtc?.ToLocalTime().ToString("g")</div>
                        <div class="small text-muted">Completed: @Model.CompletedAtUtc?.ToLocalTime().ToString("g")</div>
                        <div class="small text-muted">Expires: @Model.ExpiresAtUtc?.ToLocalTime().ToString("g")</div>
                        @if (!string.IsNullOrEmpty(Model.PdfPath))
                        {
                            <div class="mt-3">
                                <a class="btn btn-outline-success w-100" href="@Model.PdfPath" target="_blank">Download PDF</a>
                                <div class="small text-muted mt-2">Hash: <code>@Model.PdfSha256Hex</code></div>
                            </div>
                        }
                        <form asp-action="Resend" asp-route-id="@Model.EnvelopeId" method="post" class="mt-3">
                            <button class="btn btn-outline-primary w-100">Resend Emails</button>
                            @Html.AntiForgeryToken()
                        </form>

                        @* Edit and Void buttons — only when envelope is still active *@
                        @if (Model.Status != "Completed" && Model.Status != "Voided")
                        {
                            <a asp-action="Edit" asp-route-id="@Model.EnvelopeId"
                               class="btn btn-outline-warning w-100 mt-2">
                                <i class="fas fa-edit me-1"></i> Edit Envelope
                            </a>
                            <button type="button" class="btn btn-outline-danger w-100 mt-2" data-bs-toggle="modal" data-bs-target="#voidModal">
                                Void / Cancel Envelope
                            </button>
                        }

                        @* Show TempData messages *@
                        @if (TempData["msg"] != null)
                        {
                            <div class="alert alert-success mt-3 small">@TempData["msg"]</div>
                        }
                        @if (TempData["error"] != null)
                        {
                            <div class="alert alert-danger mt-3 small">@TempData["error"]</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Void Confirmation Modal *@
<div class="modal fade" id="voidModal" tabindex="-1" aria-labelledby="voidModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="voidModalLabel">Void Envelope</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Void" asp-route-id="@Model.EnvelopeId" method="post">
                <div class="modal-body">
                    <p>Are you sure you want to void this envelope? This action cannot be undone.</p>
                    <p class="fw-bold">Envelope: @Model.Subject</p>
                    <div class="mb-3">
                        <label for="voidReason" class="form-label">Reason (optional):</label>
                        <textarea class="form-control" id="voidReason" name="reason" rows="3" placeholder="Enter reason for voiding this envelope..."></textarea>
                    </div>
                    <p class="text-muted small">Recipients will be notified that this signature request has been cancelled.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Void Envelope</button>
                </div>
                @Html.AntiForgeryToken()
            </form>
        </div>
    </div>
</div>
