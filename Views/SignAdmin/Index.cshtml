@* Views/SignAdmin/Index.cshtml *@
@model IReadOnlyList<SalesMetrics.Models.Signing.EnvelopeListItemVm>
@{
    ViewData["Title"] = "E-Sign Envelopes";
    var scope = ViewBag.Scope?.ToString() ?? "all";
    var status = ViewBag.Status?.ToString() ?? "";
    var office = ViewBag.Office?.ToString() ?? "";
    var currentLocationCode = ViewBag.CurrentLocationCode?.ToString() ?? "LAX";
    var roleId = (int)(ViewBag.RoleId ?? 0);

    // Determine which scopes are available based on role
    var canViewAll = roleId == 1 || roleId == 3 || roleId == 4 || roleId == 5 || roleId == 7 || roleId == 8;
    var canViewBranch = roleId == 5; // Office Manager

    // Check if user has access to multiple locations
    var userLocations = (Dictionary<int, (string Code, string Name)>?)ViewBag.Locations;
    var hasMultipleLocations = userLocations != null && userLocations.Count > 1;
}
<div class="card mb-3 border-0 shadow-sm">
    <div class="card-header bg-warning text-dark fw-bold">E-Sign Hub</div>
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <a class="btn btn-success" asp-action="Create">+ New Envelope</a>
            </div>
            <div class="text-muted">Total: @ViewBag.Total</div>
        </div>

        @* Scope Filter Buttons *@
        <div class="mb-3">
            <div class="btn-group" role="group" aria-label="Envelope scope filter">
                <a class="btn btn-sm @(scope == "mine" ? "btn-primary" : "btn-outline-primary")"
                   asp-action="Index" asp-route-scope="mine" asp-route-status="@status" asp-route-office="@office">
                    My Envelopes
                </a>
                @if (canViewBranch)
                {
                    <a class="btn btn-sm @(scope == "branch" ? "btn-primary" : "btn-outline-primary")"
                       asp-action="Index" asp-route-scope="branch" asp-route-status="@status" asp-route-office="@office">
                        Branch Envelopes
                    </a>
                }
                @if (canViewAll)
                {
                    <a class="btn btn-sm @(scope == "all" ? "btn-primary" : "btn-outline-primary")"
                       asp-action="Index" asp-route-scope="all" asp-route-status="@status" asp-route-office="@office">
                        All Envelopes
                    </a>
                }
            </div>
        </div>

        @* Status and Office Filters *@
        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <label class="form-label small">Filter by Status:</label>
                <select class="form-select form-select-sm" id="statusFilter" onchange="applyFilters()">
                    <option value="">All Statuses</option>
                    <option value="Draft" selected="@(status == "Draft" ? "selected" : null)">Draft</option>
                    <option value="Sent" selected="@(status == "Sent" ? "selected" : null)">Sent</option>
                    <option value="Viewed" selected="@(status == "Viewed" ? "selected" : null)">Viewed</option>
                    <option value="Completed" selected="@(status == "Completed" ? "selected" : null)">Completed</option>
                    <option value="Expired" selected="@(status == "Expired" ? "selected" : null)">Expired</option>
                    <option value="Declined" selected="@(status == "Declined" ? "selected" : null)">Declined</option>
                    <option value="Voided" selected="@(status == "Voided" ? "selected" : null)">Voided</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Filter by Branch:</label>
                <select class="form-select form-select-sm" id="officeFilter" onchange="applyFilters()">
                    @if (userLocations != null)
                    {
                        @foreach (var loc in userLocations)
                        {
                            <option value="@loc.Value.Code" selected="@(office == loc.Value.Code ? "selected" : null)">
                                @loc.Value.Code - @loc.Value.Name
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-scope="@scope" asp-route-office="@office">Clear Filters</a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-warning">
                    <tr>
                        <th>ID</th>
                        <th>Subject</th>
                        <th>Branch</th>
                        <th>Property</th>
                        <th>Order#</th>
                        <th>Status</th>
                        <th>Recipients</th>
                        <th>Sent</th>
                        <th>Completed</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.EnvelopeId</td>
                            <td>@r.Subject</td>
                            <td><span class="badge bg-secondary">@(r.LocationCode ?? "—")</span></td>
                            <td><span class="text-muted small">@(r.PropertyName ?? "—")</span></td>
                            <td><span class="text-muted small">@(r.OrderNumber ?? "—")</span></td>
                            <td>
                                <span class="badge rounded-pill @(r.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@r.Status</span>
                            </td>
                            <td>@r.SignedCount / @r.RecipientCount</td>
                            <td>@r.SentAtUtc?.ToLocalTime().ToString("g")</td>
                            <td>@r.CompletedAtUtc?.ToLocalTime().ToString("g")</td>
                            <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@r.EnvelopeId">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function applyFilters() {
            const status = document.getElementById('statusFilter').value;
            const office = document.getElementById('officeFilter').value;
            const scope = '@scope';

            // Build query string
            let url = '/SignAdmin?scope=' + encodeURIComponent(scope);
            if (status) url += '&status=' + encodeURIComponent(status);
            if (office) url += '&office=' + encodeURIComponent(office);

            window.location.href = url;
        }
    </script>
}
