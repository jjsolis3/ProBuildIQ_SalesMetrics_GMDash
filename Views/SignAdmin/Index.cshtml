@* Views/SignAdmin/Index.cshtml *@
@model IReadOnlyList<SalesMetrics.Models.Signing.EnvelopeListItemVm>
@{
    ViewData["Title"] = "My Envelopes";
    var scope = ViewBag.Scope?.ToString() ?? "branch";
    var status = ViewBag.Status?.ToString() ?? "";
    var office = ViewBag.Office?.ToString() ?? "";
    var roleId = (int)(ViewBag.RoleId ?? 0);

    // Everyone can see their location's envelopes (branch scope).
    // Only managers / admins can widen the view to all locations.
    var canViewAll = roleId == 1 || roleId == 3 || roleId == 4 || roleId == 5 || roleId == 7 || roleId == 8;

    // Resolve the display name of the current active location for the branch button label
    int currentLocationId = (int)(ViewBag.CurrentLocationId ?? 0);
    string currentLocationLabel = "My Location";
    if (ViewBag.Locations != null && currentLocationId > 0)
    {
        var locs = (Dictionary<int, (string Code, string Name)>)ViewBag.Locations;
        if (locs.TryGetValue(currentLocationId, out var locInfo))
            currentLocationLabel = $"{locInfo.Code} – {locInfo.Name}";
    }
}
<div class="card mb-3 border-0 shadow-sm">
    <div class="card-header bg-warning text-dark fw-bold">E-Sign Hub</div>
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <a class="btn btn-success" asp-action="Create">+ New Envelope</a>
            </div>
            <div class="text-muted">Total: @ViewBag.Total</div>
        </div>

        @* Scope Filter Buttons *@
        <div class="mb-3 d-flex align-items-center gap-3 flex-wrap">
            <div class="btn-group" role="group" aria-label="Envelope scope filter">
                @* "My Location" – default for every user; shows all envelopes for the currently selected branch *@
                <a class="btn btn-sm @(scope == "branch" ? "btn-primary" : "btn-outline-primary")"
                   asp-action="Index" asp-route-scope="branch" asp-route-status="@status" asp-route-office="@office"
                   title="Show all envelopes for your currently selected branch">
                    <i class="fas fa-building me-1"></i>@currentLocationLabel
                </a>
                @* "My Envelopes" – only envelopes this user created *@
                <a class="btn btn-sm @(scope == "mine" ? "btn-primary" : "btn-outline-primary")"
                   asp-action="Index" asp-route-scope="mine" asp-route-status="@status" asp-route-office="@office"
                   title="Show only envelopes you created">
                    <i class="fas fa-user me-1"></i>My Envelopes
                </a>
                @* "All Locations" – admin / manager only *@
                @if (canViewAll)
                {
                    <a class="btn btn-sm @(scope == "all" ? "btn-primary" : "btn-outline-primary")"
                       asp-action="Index" asp-route-scope="all" asp-route-status="@status" asp-route-office="@office"
                       title="Show envelopes from all branches (admin/manager)">
                        <i class="fas fa-globe me-1"></i>All Locations
                    </a>
                }
            </div>
        </div>

        @* Status and Office Filters *@
        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <label class="form-label small">Filter by Status:</label>
                <select class="form-select form-select-sm" id="statusFilter" onchange="applyFilters()">
                    <option value="">All Statuses</option>
                    <option value="Draft" selected="@(status == "Draft" ? "selected" : null)">Draft</option>
                    <option value="Sent" selected="@(status == "Sent" ? "selected" : null)">Sent</option>
                    <option value="Viewed" selected="@(status == "Viewed" ? "selected" : null)">Viewed</option>
                    <option value="Completed" selected="@(status == "Completed" ? "selected" : null)">Completed</option>
                    <option value="Expired" selected="@(status == "Expired" ? "selected" : null)">Expired</option>
                    <option value="Declined" selected="@(status == "Declined" ? "selected" : null)">Declined</option>
                    <option value="Voided" selected="@(status == "Voided" ? "selected" : null)">Voided</option>
                </select>
            </div>
            @* Branch filter is only relevant in "All Locations" mode — in branch/mine scope the location is fixed *@
            @if (scope == "all" && canViewAll)
            {
                <div class="col-md-3">
                    <label class="form-label small">Filter by Branch:</label>
                    <select class="form-select form-select-sm" id="officeFilter" onchange="applyFilters()">
                        <option value="">All Branches</option>
                        @if (ViewBag.Locations != null)
                        {
                            @foreach (var loc in (Dictionary<int, (string Code, string Name)>)ViewBag.Locations)
                            {
                                <option value="@loc.Value.Code" selected="@(office == loc.Value.Code ? "selected" : null)">
                                    @loc.Value.Code - @loc.Value.Name
                                </option>
                            }
                        }
                    </select>
                </div>
            }
            <div class="col-md-2 d-flex align-items-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-scope="@scope">Clear Filters</a>
            </div>
        </div>

        <div class="table-responsive">
            <table id="envelopesTable" class="table align-middle" style="width:100%">
                <thead class="table-warning">
                    <tr>
                        <th>ID</th>
                        <th>Subject</th>
                        <th>Property</th>
                        <th>Order#</th>
                        <th>Status</th>
                        <th>Recipients</th>
                        <th>Sent</th>
                        <th>Completed</th>
                        <th class="no-sort"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.EnvelopeId</td>
                            <td>@r.Subject</td>
                            <td><span class="text-muted small">@(r.PropertyName ?? "—")</span></td>
                            <td><span class="text-muted small">@(r.OrderNumber ?? "—")</span></td>
                            <td>
                                @{
                                    var badgeClass = r.Status switch {
                                        "Completed" => "bg-success",
                                        "Voided"    => "bg-secondary",
                                        "Declined"  => "bg-danger",
                                        "Expired"   => "bg-dark",
                                        _           => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge rounded-pill @badgeClass">@r.Status</span>
                            </td>
                            <td>@r.SignedCount / @r.RecipientCount</td>
                            <td data-order="@(r.SentAtUtc?.Ticks ?? 0)">@r.SentAtUtc?.ToLocalTime().ToString("g")</td>
                            <td data-order="@(r.CompletedAtUtc?.Ticks ?? 0)">@r.CompletedAtUtc?.ToLocalTime().ToString("g")</td>
                            <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@r.EnvelopeId">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @* DataTables *@
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>

    <script>
        function applyFilters() {
            const status = document.getElementById('statusFilter').value;
            const officeEl = document.getElementById('officeFilter');
            const office = officeEl ? officeEl.value : '';
            const scope = '@scope';

            let url = '/SignAdmin?scope=' + encodeURIComponent(scope);
            if (status) url += '&status=' + encodeURIComponent(status);
            if (office) url += '&office=' + encodeURIComponent(office);

            window.location.href = url;
        }

        $(document).ready(function () {
            $('#envelopesTable').DataTable({
                pageLength: 25,
                lengthMenu: [10, 25, 50, 100],
                order: [[6, 'desc']], // default sort: Sent date descending
                columnDefs: [
                    { orderable: false, targets: -1 } // disable sort on the action column
                ],
                dom: '<"d-flex justify-content-between align-items-center mb-2"lf>rtip',
                language: {
                    lengthMenu:  'Show _MENU_ envelopes',
                    info:        'Showing _START_ to _END_ of _TOTAL_ envelopes',
                    infoEmpty:   'No envelopes found',
                    infoFiltered:'(filtered from _MAX_ total)',
                    search:      'Search:',
                    zeroRecords: 'No matching envelopes found'
                }
            });
        });
    </script>
}
