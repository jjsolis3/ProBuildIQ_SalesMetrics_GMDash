@{
    Layout = "~/Views/Shared/PublicSigningLayout.cshtml";
    ViewData["Title"] = "Already Signed";
    var downloadUrl = ViewBag.DownloadUrl as string;
    var recipientName = ViewBag.RecipientName as string;
    var signedDate = ViewBag.SignedDate as DateTime?;
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-info-subtle text-black fw-bold">
        <i class="bi bi-check-circle-fill me-2"></i> Document Already Signed
    </div>
    <div class="card-body">
        <div class="alert alert-info mb-1 align-content-center flex-column">
            <h5 class="alert-heading mb-3">
                <i class="bi bi-info-circle"></i> You've already signed this document
            </h5>
            <div class="mb-2">
                <strong>Signed by:</strong> @recipientName
            </div>
            <div class="mb-2">
                <strong>Signed on:</strong> @signedDate?.ToString("MMMM dd, yyyy 'at' h:mm tt")
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(downloadUrl))
        {
            <div class="alert alert-success align-content-center flex-column">
                <h5 class="alert-heading mb-3">
                    <i class="bi bi-check-circle-fill text-white me-3"></i> Document Complete
                </h5>
                <p class="mb-3">All parties have signed. You can download the completed document below:</p>
                <a class="btn btn-info btn-lg" href="@downloadUrl" target="_blank">
                    <i class="bi bi-download"></i> Download Signed PDF
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                <h5 class="alert-heading mb-3">
                    <i class="bi bi-clock-history"></i> Waiting for Additional Signatures
                </h5>
                <p class="mb-2">This document is waiting for other parties to sign.</p>
                <p class="mb-0">You will receive an email notification when all parties have signed and the final PDF is ready for download.</p>
            </div>
        }
    </div>
</div>