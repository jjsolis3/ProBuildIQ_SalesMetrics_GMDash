@* Views/SignPublic/Review.cshtml *@
@model SalesMetrics.Models.Signing.ReviewVm
@{
    Layout = "~/Views/Shared/PublicSigningLayout.cshtml";
    ViewData["Title"] = "Review & Sign";
    var token = (string)ViewBag.Token;
    var manager = Model.Envelope.Recipients?.FirstOrDefault(r => r.Role == "Manager");
    var tenant = Model.Envelope.Recipients?.FirstOrDefault(r => r.Role == "Tenant");
}

<!-- Display validation errors prominently -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <h4>Please correct the following errors:</h4>
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form action="/sign/@token" method="post" id="signForm">
    @Html.AntiForgeryToken()

    <!-- Envelope Information Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-envelope-fill"></i> Envelope #@Model.Envelope.EnvelopeId</h5>
        </div>
        <div class="card-body">
            <!-- Envelope Title -->
            <div class="mb-3">
                <h6 class="text-primary fw-bold mb-1">Document:</h6>
                <p class="mb-0">@Model.Envelope.Subject</p>
            </div>

            <!-- Envelope Message -->
            @if (!string.IsNullOrWhiteSpace(Model.Envelope.MessageBody))
            {
                <div class="mb-3">
                    <h6 class="text-primary fw-bold mb-1">Message:</h6>
                    <p class="mb-0">@Model.Envelope.MessageBody</p>
                </div>
            }

            <!-- Property / Order Information -->
            @if (Model.Property != null || !string.IsNullOrWhiteSpace(Model.Envelope.OrderNumber) || !string.IsNullOrWhiteSpace(Model.Envelope.LocationCode))
            {
                <div class="mb-3">
                    @if (Model.Property != null)
                    {
                        <h6 class="text-primary fw-bold mb-1">Property:</h6>
                        <p class="mb-0">@Model.Property.Name</p>
                        @if (!string.IsNullOrWhiteSpace(Model.Property.Address))
                        {
                            <p class="mb-0 text-muted small">@Model.Property.Address</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Property.Unit))
                        {
                            <p class="mb-0 small"><strong>Unit:</strong> @Model.Property.Unit</p>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Envelope.OrderNumber))
                    {
                        <p class="mb-0 mt-1 small"><strong>Order #:</strong> @Model.Envelope.OrderNumber</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Envelope.LocationCode))
                    {
                        <p class="mb-0 small text-muted"><strong>Branch:</strong> @Model.Envelope.LocationCode</p>
                    }
                </div>
            }

            <!-- Recipients Information -->
            <div class="row">
                @if (manager != null)
                {
                    <div class="col-md-6 mb-3">
                        <h6 class="text-primary fw-bold mb-1">Property Manager:</h6>
                        <p class="mb-0">@manager.FullName</p>
                        @if (!string.IsNullOrWhiteSpace(manager.Email))
                        {
                            <p class="mb-0 text-muted small">@manager.Email</p>
                        }
                    </div>
                }
                @if (tenant != null)
                {
                    <div class="col-md-6 mb-3">
                        <h6 class="text-primary fw-bold mb-1">Tenant:</h6>
                        <p class="mb-0">@tenant.FullName</p>
                        @if (!string.IsNullOrWhiteSpace(tenant.Email))
                        {
                            <p class="mb-0 text-muted small">@tenant.Email</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(tenant.Phone))
                        {
                            <p class="mb-0 text-muted small">@tenant.Phone</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Document Preview Section with PDF Viewer -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center bg-light">
            <h5 class="mb-0">
                <i class="bi bi-file-earmark-pdf "></i> Document Preview
            </h5>
            <a href="/sign/@token/pdf" target="_blank" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrows-fullscreen"></i> View Full PDF
            </a>
        </div>
        <div class="card-body p-0">
            <div id="pdfContainer" style="max-height: 600px; overflow-y: auto; background: #e9ecef;">
                <canvas id="pdfCanvas" style="display: block; margin: 0 auto; background: white;"></canvas>
            </div>
            <div class="text-center p-2 border-top">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="prevPage" disabled>
                    <i class="bi bi-chevron-left"></i> Previous
                </button>
                <span class="mx-3">Page <span id="pageNum">1</span> of <span id="pageCount">1</span></span>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="nextPage" disabled>
                    Next <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Manager: Capture Tenant Info -->
    @if (Model.Recipient.Role == "Manager" && !Model.HasTenantRecipient)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center bg-light">
                <h5 class="mb-0"><i class="bi bi-person-plus"></i> Add Tenant Information</h5>
                <div class="form-check mb-0">
                    {{!-- Default: Skip is CHECKED. Staff must uncheck to include tenant. --}}
                    <input class="form-check-input" style="border-color:darkorange" type="checkbox"
                           id="SkipTenant" name="SkipTenant" value="true" checked>
                    <label class="form-check-label fw-semibold" for="SkipTenant" style="color:#E87600;">
                        Skip tenant signature
                    </label>
                </div>
            </div>

            {{!-- Disclaimer shown ONLY when staff unchecks Skip (i.e. wants to add tenant) --}}
            <div id="tenantDisclaimer" class="alert alert-info d-flex gap-2 mx-3 mt-3 mb-0" style="display:none!important;">
                <i class="fas fa-info-circle mt-1 flex-shrink-0"></i>
                <div class="small">
                    <strong>Important:</strong> By entering tenant information, a signing invitation will be
                    sent to the tenant. <strong>This consent form will not be marked as complete until
                    the tenant also signs.</strong> If the tenant is not available or has already consented
                    verbally, leave "Skip tenant signature" checked.
                </div>
            </div>

            <div class="card-body" id="tenantFields" style="opacity:0.4;pointer-events:none;">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Tenant Full Name <span class="text-danger">*</span></label>
                        <input name="TenantFullName" id="TenantFullName" class="form-control"
                               placeholder="Enter tenant's full name" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Tenant Email <span class="text-danger">*</span></label>
                        <input name="TenantEmail" id="TenantEmail" type="email" class="form-control"
                               placeholder="tenant@example.com" disabled />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Tenant Phone</label>
                        <input name="TenantPhone" id="TenantPhone" type="tel" class="form-control"
                               placeholder="(555) 123-4567" disabled />
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Signature Section -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="bi bi-pen"></i> Your Signature</h5>
        </div>
        <div class="card-body">
            <!-- Consent Checkbox -->
            <span class="badge rounded-pill consent-badge">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> Required
            </span>
            <div class="form-check mb-4 p-3 bg-light rounded">
                <input class="form-check-input ms-0" style="border-color:darkorange" type="checkbox" id="Accept" name="Accept" value="true">
                <label class="form-check-label fw-bold ms-2" for="Accept">
                    I have read and agree to the terms, and I adopt the signature below as my electronic signature.
                </label>
                
                <small id="consentHint" class="d-block mt-1 fw-semibold text-orange">
                    <i class="bi bi-check2-square me-1"></i>
                    This box must be checked before you can sign.
                </small>
            </div>
            

            <!-- Signature Canvas -->
            <div class="mb-4">
                <label class="form-label fw-bold">Draw your signature <span class="text-danger">*</span></label>
                <div class="border rounded p-2 bg-white">
                    <canvas id="sigPad" style="width:100%;height:150px;border:2px dashed #dee2e6;border-radius:4px;"></canvas>
                    <input type="hidden" id="SigData" name="SigData" />
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="clearSig">
                    <i class="bi bi-x-circle"></i> Clear Signature
                </button>
            </div>

            <!-- Typed Name -->
            <div class="mb-4">
                <label class="form-label fw-bold">Type your full name <span class="text-danger">*</span></label>
                <input class="form-control" id="TypedFullName" name="TypedFullName" placeholder="Enter your full legal name" />
            </div>

            <button class="btn btn-success btn-lg w-100" type="submit" id="submitBtn">
                <i class="bi bi-check-circle-fill"></i> Sign & Finish
            </button>

            <button type="button" class="btn btn-outline-danger w-100 mt-3" data-bs-toggle="modal" data-bs-target="#declineModal">
                <i class="bi bi-x-circle"></i> Decline to Sign
            </button>
        </div>
    </div>
</form>

<!-- Decline Modal -->
<div class="modal fade" id="declineModal" tabindex="-1" aria-labelledby="declineModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="declineModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i> Decline Signature Request
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/sign/@token/decline" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p class="fw-bold">Are you sure you want to decline this signature request?</p>
                    <p class="text-muted">By declining, you are refusing to sign this document. All parties involved will be notified of your decision.</p>

                    <div class="mb-3">
                        <label for="declineReason" class="form-label">Reason (optional):</label>
                        <textarea class="form-control" id="declineReason" name="reason" rows="3" placeholder="Enter your reason for declining..."></textarea>
                        <div class="form-text">Providing a reason helps the sender understand your decision.</div>
                    </div>

                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-info-circle"></i>
                        <strong>Note:</strong> This action cannot be undone. If you decline in error, you'll need to contact the sender directly.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle"></i> Decline Signature
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- PDF.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        // PDF Viewer Variables
        let pdfDoc = null;
        let pageNum = 1;
        let pageRendering = false;
        let pageNumPending = null;
        let currentRenderTask = null;
        const scale = 1.5;
        const canvas = document.getElementById('pdfCanvas');
        const ctx = canvas.getContext('2d');

        // Load PDF
        const pdfUrl = '/sign/@token/pdf';
        pdfjsLib.getDocument(pdfUrl).promise.then(function(pdf) {
            pdfDoc = pdf;
            document.getElementById('pageCount').textContent = pdf.numPages;
            renderPage(pageNum);

            // Enable/disable navigation buttons
            if (pdf.numPages > 1) {
                document.getElementById('nextPage').disabled = false;
            }
        }).catch(function(error) {
            console.error('PDF loading error:', error);
            document.getElementById('pdfContainer').innerHTML = '<div class="alert alert-warning m-3"><i class="bi bi-exclamation-triangle"></i> Unable to load PDF preview. Please use the "View Full PDF" button above or refresh the page.</div>';
        });

        function renderPage(num) {
            pageRendering = true;

            // Cancel previous render task if still running
            if (currentRenderTask) {
                currentRenderTask.cancel();
                currentRenderTask = null;
            }

            pdfDoc.getPage(num).then(function(page) {
                const viewport = page.getViewport({ scale: scale });
                canvas.height = viewport.height;
                canvas.width = viewport.width;

                const renderContext = {
                    canvasContext: ctx,
                    viewport: viewport
                };

                currentRenderTask = page.render(renderContext);
                currentRenderTask.promise.then(function() {
                    pageRendering = false;
                    currentRenderTask = null;
                    if (pageNumPending !== null) {
                        renderPage(pageNumPending);
                        pageNumPending = null;
                    }
                }).catch(function(error) {
                    // Ignore cancellation errors
                    if (error.name !== 'RenderingCancelledException') {
                        console.error('Page rendering error:', error);
                    }
                    pageRendering = false;
                    currentRenderTask = null;
                });
            }).catch(function(error) {
                console.error('Failed to get page:', error);
                pageRendering = false;
            });

            document.getElementById('pageNum').textContent = num;

            // Update button states
            document.getElementById('prevPage').disabled = (num <= 1);
            document.getElementById('nextPage').disabled = (num >= pdfDoc.numPages);
        }

        // Cleanup function for PDF.js resources
        function cleanupPdf() {
            if (currentRenderTask) {
                currentRenderTask.cancel();
                currentRenderTask = null;
            }
            if (pdfDoc) {
                pdfDoc.destroy();
                pdfDoc = null;
            }
        }

        // Register cleanup on page unload
        window.addEventListener('beforeunload', function() {
            cleanupPdf();
            cleanupSignatureCanvas();
        });

        function queueRenderPage(num) {
            if (pageRendering) {
                pageNumPending = num;
            } else {
                renderPage(num);
            }
        }

        document.getElementById('prevPage').addEventListener('click', function() {
            if (pageNum <= 1) return;
            pageNum--;
            queueRenderPage(pageNum);
        });

        document.getElementById('nextPage').addEventListener('click', function() {
            if (pageNum >= pdfDoc.numPages) return;
            pageNum++;
            queueRenderPage(pageNum);
        });

        // Skip Tenant Checkbox Handler
        const skipTenantCheckbox = document.getElementById('SkipTenant');
        if (skipTenantCheckbox) {
            function applySkipTenantState(isSkipped) {
                const tenantFields   = document.getElementById('tenantFields');
                const tenantName     = document.getElementById('TenantFullName');
                const tenantEmail    = document.getElementById('TenantEmail');
                const tenantPhone    = document.getElementById('TenantPhone');
                const disclaimer     = document.getElementById('tenantDisclaimer');

                if (isSkipped) {
                    tenantFields.style.opacity = '0.4';
                    tenantFields.style.pointerEvents = 'none';
                    tenantName.disabled  = true;
                    tenantEmail.disabled = true;
                    tenantPhone.disabled = true;
                    tenantName.value  = '';
                    tenantEmail.value = '';
                    tenantPhone.value = '';
                    if (disclaimer) disclaimer.style.setProperty('display', 'none', 'important');
                } else {
                    tenantFields.style.opacity = '1';
                    tenantFields.style.pointerEvents = '';
                    tenantName.disabled  = false;
                    tenantEmail.disabled = false;
                    tenantPhone.disabled = false;
                    if (disclaimer) disclaimer.style.setProperty('display', 'flex', 'important');
                }
            }

            // Apply correct initial state on page load (default: checked → skip is on)
            applySkipTenantState(skipTenantCheckbox.checked);

            skipTenantCheckbox.addEventListener('change', function() {
                applySkipTenantState(this.checked);
            });
        }

        // Signature Pad Setup
        let drawing = false, hasInk = false;

        function resize() {
          const r = canvas.getBoundingClientRect();
          const ratio = window.devicePixelRatio || 1;
          canvas.width = r.width * ratio;
          canvas.height = r.height * ratio;
          ctx.scale(ratio, ratio);
          ctx.lineWidth = 2;
          ctx.lineCap = 'round';
          ctx.strokeStyle = '#000';
        }

        const sigCanvas = document.getElementById('sigPad');
        const sigCtx = sigCanvas.getContext('2d');

        function resizeSigPad() {
          const r = sigCanvas.getBoundingClientRect();
          const ratio = window.devicePixelRatio || 1;
          sigCanvas.width = r.width * ratio;
          sigCanvas.height = r.height * ratio;
          sigCtx.scale(ratio, ratio);
          sigCtx.lineWidth = 2;
          sigCtx.lineCap = 'round';
          sigCtx.strokeStyle = '#000';
        }
        resizeSigPad();
        window.addEventListener('resize', resizeSigPad);

        function pos(e, targetCanvas) {
          const rect = targetCanvas.getBoundingClientRect();
          const x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
          const y = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;
          return {x,y};
        }

        function start(e){
          e.preventDefault();
          drawing = true;
          hasInk = true;
          const p = pos(e, sigCanvas);
          sigCtx.beginPath();
          sigCtx.moveTo(p.x, p.y);
        }

        function move(e){
          if(!drawing) return;
          e.preventDefault();
          const p = pos(e, sigCanvas);
          sigCtx.lineTo(p.x, p.y);
          sigCtx.stroke();
        }

        function end(e){
          if(!drawing) return;
          e.preventDefault();
          drawing = false;
          const dataUrl = sigCanvas.toDataURL('image/png');
          document.getElementById('SigData').value = dataUrl;
        }

        // Attach event listeners
        sigCanvas.addEventListener('mousedown', start);
        sigCanvas.addEventListener('mousemove', move);
        sigCanvas.addEventListener('mouseup', end);
        sigCanvas.addEventListener('mouseleave', end);

        sigCanvas.addEventListener('touchstart', start);
        sigCanvas.addEventListener('touchmove', move);
        sigCanvas.addEventListener('touchend', end);
        sigCanvas.addEventListener('touchcancel', end);

        const clearSigHandler = function() {
          sigCtx.clearRect(0, 0, sigCanvas.width, sigCanvas.height);
          document.getElementById('SigData').value = '';
          hasInk = false;
        };
        document.getElementById('clearSig').addEventListener('click', clearSigHandler);

        // Cleanup function for signature canvas
        function cleanupSignatureCanvas() {
          // Remove event listeners
          sigCanvas.removeEventListener('mousedown', start);
          sigCanvas.removeEventListener('mousemove', move);
          sigCanvas.removeEventListener('mouseup', end);
          sigCanvas.removeEventListener('mouseleave', end);
          sigCanvas.removeEventListener('touchstart', start);
          sigCanvas.removeEventListener('touchmove', move);
          sigCanvas.removeEventListener('touchend', end);
          sigCanvas.removeEventListener('touchcancel', end);

          // Remove resize listener
          window.removeEventListener('resize', resizeSigPad);

          // Remove clear button listener
          const clearBtn = document.getElementById('clearSig');
          if (clearBtn) {
            clearBtn.removeEventListener('click', clearSigHandler);
          }
        }

        // Form Submission Validation
        document.getElementById('signForm').addEventListener('submit', function(e){
          const accept = document.getElementById('Accept').checked;
          const name = document.getElementById('TypedFullName').value.trim();
          const sig = document.getElementById('SigData').value;

          // Check if manager needs to add tenant
          const skipTenantCheckbox = document.getElementById('SkipTenant');
          const isTenantSection = document.getElementById('TenantFullName');
          if (isTenantSection) {
            const skipTenant = skipTenantCheckbox && skipTenantCheckbox.checked;
            const tenantName = document.getElementById('TenantFullName').value.trim();
            const tenantEmail = document.getElementById('TenantEmail').value.trim();

            if (!skipTenant && (!tenantName || !tenantEmail)) {
              e.preventDefault();
              alert('Please enter the tenant name and email, or check "Skip tenant signature".');
              return false;
            }
          }

          if (!accept) {
            e.preventDefault();
            alert('Please check the consent checkbox.');
            return false;
          }

          if (!name) {
            e.preventDefault();
            alert('Please type your full name.');
            return false;
          }

          if (!sig || sig.length < 100) {
            e.preventDefault();
            alert('Please draw your signature.');
            return false;
          }

          document.getElementById('submitBtn').disabled = true;
          document.getElementById('submitBtn').innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';
        });
    </script>
}
