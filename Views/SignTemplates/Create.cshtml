@model SalesMetrics.Domain.Signing.SignTemplate
@{

    ViewData["Title"] = "New Template";
    ViewBag.PTitle = "Sign Templates";
    ViewBag.PLink = "/SignTemplates";

    var viewPaths = (List<string>)ViewBag.ViewPaths;

}

<style>
    /* Wizard Progress Indicator */
    .wizard-progress {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2rem;
        position: relative;
    }

    .wizard-progress::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        height: 2px;
        background: #dee2e6;
        z-index: 0;
    }

    .wizard-step {
        flex: 1;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .wizard-step-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: white;
        border: 2px solid #dee2e6;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-bottom: 0.5rem;
        transition: all 0.3s ease;
    }

    .wizard-step.active .wizard-step-circle {
        background: #0d6efd;
        border-color: #0d6efd;
        color: white;
    }

    .wizard-step.completed .wizard-step-circle {
        background: #198754;
        border-color: #198754;
        color: white;
    }

    .wizard-step.completed .wizard-step-circle::before {
        content: '✓';
        font-weight: bold;
    }

    .wizard-step-label {
        font-size: 0.875rem;
        color: #6c757d;
    }

    .wizard-step.active .wizard-step-label {
        color: #0d6efd;
        font-weight: 600;
    }

    /* Wizard Content */
    .wizard-content {
        min-height: 400px;
    }

    .wizard-step-content {
        display: none;
    }

    .wizard-step-content.active {
        display: block;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Template Cards */
    .template-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .template-card {
        border: 2px solid #dee2e6;
        border-radius: 8px;
        padding: 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
    }

    .template-card:hover {
        border-color: #0d6efd;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        transform: translateY(-2px);
    }

    .template-card.selected {
        border-color: #0d6efd;
        background: #e7f1ff;
        box-shadow: 0 4px 12px rgba(13,110,253,0.2);
    }

    .template-card-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .template-card-title {
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .template-card-description {
        font-size: 0.875rem;
        color: #6c757d;
    }

    /* Field Selection */
    .field-category {
        margin-bottom: 1.5rem;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1rem;
        background: #f8f9fa;
    }

    .field-category-header {
        font-weight: 600;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .field-checkbox-group {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.5rem;
    }

    .field-checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
        background: white;
        border-radius: 4px;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .field-checkbox-label:hover {
        background: #e7f1ff;
    }

    /* PDF Preview */
    .pdf-preview-container {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1rem;
        background: #f8f9fa;
        margin-top: 1rem;
    }

    .pdf-preview-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    #pdfCanvas {
        border: 1px solid #dee2e6;
        background: white;
        display: block;
        margin: 0 auto;
    }

    #pdfPreviewContent {
        max-height: 800px;
        overflow: auto;
        text-align: center;
    }

    .pdf-preview-controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
    }

    /* Review Page */
    .review-section {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        background: white;
    }

    .review-section-title {
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 1rem;
        color: #0d6efd;
    }

    .review-item {
        display: flex;
        margin-bottom: 0.5rem;
    }

    .review-item-label {
        font-weight: 500;
        width: 150px;
        color: #6c757d;
    }

    .review-item-value {
        flex: 1;
    }

    .field-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: #e7f1ff;
        border: 1px solid #0d6efd;
        border-radius: 20px;
        font-size: 0.875rem;
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
    }

    /* Wizard Navigation */
    .wizard-navigation {
        display: flex;
        justify-content: space-between;
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid #dee2e6;
    }

    .validation-error {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.5rem;
        display: none;
    }

    .validation-error.show {
        display: block;
    }

    /* Phase 3: Field Configurator Styles */
    .field-palette {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 0.5rem;
    }

    .field-palette-item {
        padding: 0.75rem;
        border: 2px solid #dee2e6;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: white;
        text-align: center;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .field-palette-item:hover {
        border-color: #0d6efd;
        background: #e7f1ff;
        transform: translateY(-2px);
    }

    .field-palette-item.selected {
        border-color: #0d6efd;
        background: #0d6efd;
        color: white;
    }

    .field-palette-item.placed {
        border-color: #198754;
        background: #d1e7dd;
        cursor: default;
        opacity: 0.6;
    }

    .field-palette-item.placed:hover {
        transform: none;
    }

    .placed-fields-list {
        max-height: 300px;
        overflow-y: auto;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 0.5rem;
        background: white;
    }

    .placed-field-item {
        padding: 0.5rem;
        border-left: 3px solid #0d6efd;
        background: #f8f9fa;
        margin-bottom: 0.5rem;
        border-radius: 4px;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .placed-field-item:hover {
        background: #e7f1ff;
    }

    .placed-field-item.active {
        background: #e7f1ff;
        border-left-color: #198754;
    }

    .pdf-canvas-wrapper {
        cursor: crosshair;
    }

    .pdf-canvas-wrapper.placement-mode {
        cursor: crosshair;
    }

    .pdf-canvas-wrapper.drag-mode {
        cursor: move;
    }

    /* Field boxes on PDF */
    .field-box {
        fill: rgba(13, 110, 253, 0.1);
        stroke: #0d6efd;
        stroke-width: 2;
        cursor: move;
        pointer-events: all;
    }

    .field-box:hover {
        fill: rgba(13, 110, 253, 0.2);
        stroke-width: 3;
    }

    .field-box.selected {
        fill: rgba(25, 135, 84, 0.2);
        stroke: #198754;
        stroke-width: 3;
    }

    .field-label {
        font-size: 10px;
        fill: #0d6efd;
        font-weight: bold;
        pointer-events: none;
        user-select: none;
    }
</style>

<div class="card p-4">
    <h4 class="mb-4">Create New Template</h4>

    <!-- Wizard Progress Indicator -->
    <div class="wizard-progress">
        <div class="wizard-step active" data-step="1">
            <div class="wizard-step-circle">1</div>
            <div class="wizard-step-label">Basic Info</div>
        </div>
        <div class="wizard-step" data-step="2">
            <div class="wizard-step-circle">2</div>
            <div class="wizard-step-label">Template</div>
        </div>
        <div class="wizard-step" data-step="3">
            <div class="wizard-step-circle">3</div>
            <div class="wizard-step-label">Fields & PDF</div>
        </div>
        <div class="wizard-step" data-step="4">
            <div class="wizard-step-circle">4</div>
            <div class="wizard-step-label">Review</div>
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="templateForm">
        <div class="wizard-content">

            <!-- Step 1: Basic Information & Category -->
            <div class="wizard-step-content active" data-step="1">
                <h5 class="mb-3">Basic Information</h5>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Display Name *</label>
                        <input asp-for="DisplayName" id="displayName" class="form-control" placeholder="e.g., Installation Release Form" required />
                        <small class="text-muted">User-friendly name for the template</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Template Key</label>
                        <input asp-for="TemplateKey" id="templateKey" class="form-control" readonly />
                        <small class="text-muted">Auto-generated from display name</small>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Category *</label>
                        <select id="templateCategory" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            <option value="Installation Release">Installation Release</option>
                            <option value="Work Order">Work Order</option>
                            <option value="Inspection">Inspection</option>
                            <option value="General Consent">General Consent</option>
                            <option value="Custom">Custom</option>
                        </select>
                        <small class="text-muted">Helps organize templates</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Active Status</label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true" selected>Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Default Subject</label>
                    <input asp-for="DefaultSubject" class="form-control" placeholder="e.g., Please sign: Installation Release" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Default Message</label>
                    <textarea asp-for="DefaultMessage" class="form-control" rows="3" placeholder="Please review and sign the attached document..."></textarea>
                </div>

                <div class="mb-3 p-3 border rounded bg-light">
                    <div class="form-check form-switch">
                        <input asp-for="RequiresTenantSection" class="form-check-input" type="checkbox" role="switch" id="requiresTenantSection" checked />
                        <label class="form-check-label fw-semibold" for="requiresTenantSection">
                            Allow Manager to add or skip Tenant information when signing
                        </label>
                    </div>
                    <small class="text-muted d-block mt-1">
                        When enabled, the signing page shows a section where the Manager can enter Tenant details to send a separate signing invitation,
                        or skip tenant signature entirely. Disable this for templates that never involve a tenant (e.g. staff-only consent forms).
                    </small>
                </div>

                <div class="validation-error" id="step1Error">Please fill in all required fields (Display Name and Category)</div>
            </div>

            <!-- Step 2: Document Template Selection -->
            <div class="wizard-step-content" data-step="2">
                <h5 class="mb-3">Select Document Template</h5>
                <p class="text-muted">Choose the template type that best fits your needs</p>

                <div class="template-cards">
                    @{
                        var templateMetadata = ViewBag.TemplateMetadata as Dictionary<string, SalesMetrics.Models.Signing.TemplateMetadata>;

                        // Group templates by metadata availability
                        var templatesWithMetadata = new List<(string Key, SalesMetrics.Models.Signing.TemplateMetadata Metadata)>();
                        var templatesWithoutMetadata = new List<string>();

                        foreach (var viewPath in viewPaths)
                        {
                            var fileName = viewPath.Split('/').Last().Replace(".cshtml", "");

                            // Try to find metadata by filename match
                            var matchingKey = templateMetadata?.Keys.FirstOrDefault(k =>
                                fileName.Equals(k, StringComparison.OrdinalIgnoreCase) ||
                                viewPath.Contains(k, StringComparison.OrdinalIgnoreCase));

                            if (matchingKey != null && templateMetadata != null)
                            {
                                templatesWithMetadata.Add((matchingKey, templateMetadata[matchingKey]));
                            }
                            else
                            {
                                templatesWithoutMetadata.Add(viewPath);
                            }
                        }

                        // Render templates WITH metadata (enhanced cards)
                        foreach (var (key, meta) in templatesWithMetadata)
                        {
                            <div class="template-card" data-view-path="@meta.ViewPath">
                                <div class="template-card-icon">@meta.Icon</div>
                                <div class="template-card-title">@meta.DisplayName</div>
                                <div class="mb-2">
                                    <span class="badge bg-primary">@meta.Category</span>
                                </div>
                                <div class="template-card-description mb-2">@meta.Description</div>
                                <div class="small text-muted" style="font-style: italic;">
                                    @meta.UseCase
                                </div>
                            </div>
                        }

                        // Render templates WITHOUT metadata (basic cards)
                        foreach (var viewPath in templatesWithoutMetadata)
                        {
                            var displayName = viewPath.Split('/').Last().Replace(".cshtml", "");
                            var icon = displayName.Contains("Installation") ? "📋" :
                                       displayName.Contains("Work") ? "🔧" :
                                       displayName.Contains("Inspection") ? "✅" : "📄";

                            <div class="template-card" data-view-path="@viewPath">
                                <div class="template-card-icon">@icon</div>
                                <div class="template-card-title">@displayName</div>
                                <div class="template-card-description">@viewPath</div>
                            </div>
                        }
                    }
                </div>

                <input type="hidden" asp-for="RazorViewPath" id="razorViewPath" />

                <!-- ── OR: Author custom HTML ──────────────────────────────── -->
                <div class="my-4 d-flex align-items-center gap-3">
                    <hr class="flex-grow-1" />
                    <span class="text-muted fw-semibold px-2">OR</span>
                    <hr class="flex-grow-1" />
                </div>

                <div class="mb-1">
                    <h6 class="fw-semibold">
                        <i class="bi bi-code-slash"></i> Author Custom HTML Content
                        <span class="badge bg-success ms-2">Overrides Razor View</span>
                    </h6>
                    <p class="text-muted small mb-3">
                        Write the signing page HTML directly. Dynamic values are inserted
                        using <code>{{TokenName}}</code> placeholders — no code deployment needed.
                        If you provide HTML here, the Razor View selection above is ignored.
                    </p>

                    <div class="d-flex justify-content-end mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="toggleTokenPanelCreate">
                            <i class="bi bi-code-square"></i> Insert Token
                        </button>
                    </div>

                    <!-- Token panel -->
                    <div id="tokenPanelCreate" class="mb-3 border rounded p-3 bg-light" style="display:none;">
                        <p class="mb-2 small fw-semibold">Click a token to insert it at the cursor:</p>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var (token, desc) in SalesMetrics.Services.Signing.ErpMergeService.AvailableTokens)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary token-insert-btn-create"
                                        data-token="@token" title="@desc">
                                    @token
                                </button>
                            }
                        </div>
                        <small class="text-muted mt-2 d-block">Tokens are replaced with live data when a signer opens the document.</small>
                    </div>

                    <textarea asp-for="HtmlBodyContent" id="htmlBodyContent" class="form-control"
                              rows="18" style="font-family:monospace;font-size:0.85rem;"
                              placeholder="Leave blank to use the Razor View selected above. Enter full HTML here to create a custom consent form body."></textarea>
                    <small class="text-muted">Tip: include standard HTML structure — headings, paragraphs, tables, signature blocks.</small>
                </div>
                <!-- ─────────────────────────────────────────────────────────── -->

                <div class="validation-error" id="step2Error">Please select a Razor View template above OR enter custom HTML content below</div>
            </div>

            <!-- Step 3: Field Selection & PDF Upload -->
            <div class="wizard-step-content" data-step="3">
                <h5 class="mb-3">Configure Fields & Upload PDF</h5>

                <!-- Field Selection -->
                <div class="mb-4">
                    <h6>Select Fields to Include</h6>

                    <!-- Property Fields -->
                    <div class="field-category">
                        <div class="field-category-header">
                            <input type="checkbox" class="form-check-input select-all-category" data-category="property" id="selectAllProperty" />
                            <label for="selectAllProperty">🏢 Property Information</label>
                        </div>
                        <div class="field-checkbox-group">
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyName" />
                                Property Name
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyAddress" />
                                Property Address
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyPhone" />
                                Property Phone
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyCity" />
                                Property City
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyState" />
                                Property State
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyZip" />
                                Property Zip Code
                            </label>
                        </div>
                    </div>

                    <!-- Customer Contact Fields -->
                    <div class="field-category">
                        <div class="field-category-header">
                            <input type="checkbox" class="form-check-input select-all-category" data-category="customer" id="selectAllCustomer" />
                            <label for="selectAllCustomer">👤 Customer Contact Information</label>
                        </div>
                        <div class="field-checkbox-group">
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="customer" value="CustomerName" />
                                Customer Name
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="customer" value="CustomerPhone" />
                                Customer Phone
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="customer" value="CustomerEmail" />
                                Customer Email
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="customer" value="CustomerCompany" />
                                Customer Company
                            </label>
                        </div>
                    </div>

                    <!-- Order Fields -->
                    <div class="field-category">
                        <div class="field-category-header">
                            <input type="checkbox" class="form-check-input select-all-category" data-category="order" id="selectAllOrder" />
                            <label for="selectAllOrder">📦 Work Order Information</label>
                        </div>
                        <div class="field-checkbox-group">
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="order" value="OrderNumber" />
                                Order Number
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="order" value="InstallationDate" />
                                Installation Date
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="order" value="UnitNumber" />
                                Unit Number
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="order" value="DeliveryDate" />
                                Delivery Date
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="order" value="OrderStartDate" />
                                Order Start Date
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="order" value="OrderEndDate" />
                                Order End Date
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="order" value="OrderSignedDate" />
                                Order Signed Date
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="order" value="LeaseStartDate" />
                                Lease Start Date
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="order" value="LeaseEndDate" />
                                Lease End Date
                            </label>
                        </div>
                    </div>

                    <!-- Signature Fields -->
                    <div class="field-category">
                        <div class="field-category-header">
                            <input type="checkbox" class="form-check-input select-all-category" data-category="signature" id="selectAllSignature" />
                            <label for="selectAllSignature">✍️ Signature Fields</label>
                        </div>
                        <div class="field-checkbox-group">
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="signature" value="PropertyStaffName" />
                                Property Staff Name
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="signature" value="PropertyStaffSignature" />
                                Property Staff Signature
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="signature" value="PropertyStaffDate" />
                                Property Staff Date
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="signature" value="ResidentName" />
                                Resident Name
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="signature" value="ResidentSignature" />
                                Resident Signature
                            </label>
                            <label class="field-checkbox-label">
                                <input type="checkbox" class="field-checkbox" data-category="signature" value="ResidentPhone" />
                                Resident Phone
                            </label>
                        </div>
                    </div>

                    <!-- Custom Fields Section -->
                    <div class="field-category">
                        <div class="field-category-header">
                            <span>🎨 Custom Fields</span>
                            <button type="button" class="btn btn-sm btn-outline-primary ms-2" id="addCustomFieldBtn">
                                + Add Custom Field
                            </button>
                        </div>
                        <div id="customFieldsList" class="mt-2">
                            <p class="text-muted small mb-0">No custom fields added yet. Click "+ Add Custom Field" to create one.</p>
                        </div>
                    </div>
                </div>

                <!-- Hidden field for MergeSpec JSON -->
                <input type="hidden" asp-for="MergeSpecJson" id="mergeSpecJson" />

                <!-- PDF Upload -->
                <div class="mb-3">
                    <h6>Upload Base PDF (Optional)</h6>
                    <input type="file" name="pdfFile" id="pdfFile" class="form-control" accept=".pdf" />
                    <small class="text-muted">Upload a PDF template for pdf-stamp rendering</small>
                </div>

                <!-- PDF Preview -->
                <div class="pdf-preview-container" id="pdfPreviewContainer" style="display: none;">
                    <div class="pdf-preview-header">
                        <h6>PDF Preview</h6>
                        <div>
                            <button type="button" class="btn btn-sm btn-info" id="enableFieldPlacement" style="display: none;">
                                <i class="bi bi-cursor"></i> Place Fields on PDF
                            </button>
                            <button type="button" class="btn btn-sm btn-secondary" id="togglePreview">
                                <i class="bi bi-arrows-angle-contract"></i> Collapse
                            </button>
                        </div>
                    </div>
                    <div id="pdfPreviewContent">
                        <div class="text-center mb-2">
                            <strong id="pdfFileName"></strong>
                            <span class="text-muted">(<span id="pdfFileSize"></span>)</span>
                        </div>

                        <!-- PDF Canvas with Field Overlay -->
                        <div class="pdf-canvas-wrapper" style="position: relative; display: inline-block;">
                            <canvas id="pdfCanvas"></canvas>
                            <svg id="fieldOverlay" style="position: absolute; top: 0; left: 0; pointer-events: none; display: none;"></svg>
                        </div>

                        <div class="pdf-preview-controls">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="prevPage">
                                <i class="bi bi-chevron-left"></i> Previous
                            </button>
                            <span>Page <span id="currentPage">1</span> of <span id="totalPages">1</span></span>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="nextPage">
                                Next <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Visual Field Configurator (Phase 3) -->
                <div id="fieldConfiguratorPanel" style="display: none;">
                    <div class="card mt-3 p-3 bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">
                                <i class="bi bi-pin-map"></i> Visual Field Configurator
                            </h6>
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-danger" id="clearAllFields">
                                    <i class="bi bi-trash"></i> Clear All
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="disableFieldPlacement">
                                    <i class="bi bi-x"></i> Done
                                </button>
                            </div>
                        </div>

                        <!-- Field Placement Instructions -->
                        <div class="alert alert-info mb-3">
                            <strong>How to use:</strong>
                            <ol class="mb-0 mt-2">
                                <li>Select a field from the palette below</li>
                                <li>Click on the PDF where you want to place it</li>
                                <li>Drag placed fields to reposition them</li>
                                <li>Click "Done" when finished</li>
                            </ol>
                        </div>

                        <!-- Field Palette -->
                        <div class="row">
                            <div class="col-md-8">
                                <label class="form-label fw-bold">Field Palette (Click to select, then click PDF to place)</label>
                                <div id="fieldPalette" class="field-palette">
                                    <!-- Dynamically populated based on selected checkboxes -->
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Placed Fields</label>
                                <div id="placedFieldsList" class="placed-fields-list">
                                    <p class="text-muted small">No fields placed yet</p>
                                </div>
                            </div>
                        </div>

                        <!-- Field Properties Panel (appears when field is selected) -->
                        <div id="fieldPropertiesPanel" class="mt-3" style="display: none;">
                            <hr />
                            <h6>Field Properties</h6>
                            <div class="row">
                                <div class="col-md-3">
                                    <label class="form-label small">Field Name</label>
                                    <input type="text" id="fieldPropName" class="form-control form-control-sm" readonly />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">X Position</label>
                                    <input type="number" id="fieldPropX" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">Y Position</label>
                                    <input type="number" id="fieldPropY" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">Width</label>
                                    <input type="number" id="fieldPropWidth" class="form-control form-control-sm" value="150" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">Height</label>
                                    <input type="number" id="fieldPropHeight" class="form-control form-control-sm" value="20" />
                                </div>
                                <div class="col-md-1 d-flex align-items-end">
                                    <button type="button" class="btn btn-sm btn-danger w-100" id="deleteFieldBtn">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="validation-error" id="step3Error">Please select at least one field</div>
            </div>

            <!-- Step 4: Review & Save -->
            <div class="wizard-step-content" data-step="4">
                <h5 class="mb-3">Review Your Template</h5>
                <p class="text-muted mb-4">Please review all information before saving</p>

                <!-- Basic Information Review -->
                <div class="review-section">
                    <div class="review-section-title">📋 Basic Information</div>
                    <div class="review-item">
                        <div class="review-item-label">Display Name:</div>
                        <div class="review-item-value" id="reviewDisplayName"></div>
                    </div>
                    <div class="review-item">
                        <div class="review-item-label">Template Key:</div>
                        <div class="review-item-value"><code id="reviewTemplateKey"></code></div>
                    </div>
                    <div class="review-item">
                        <div class="review-item-label">Category:</div>
                        <div class="review-item-value" id="reviewCategory"></div>
                    </div>
                    <div class="review-item">
                        <div class="review-item-label">Status:</div>
                        <div class="review-item-value" id="reviewStatus"></div>
                    </div>
                </div>

                <!-- Document Template Review -->
                <div class="review-section">
                    <div class="review-section-title">📄 Document Template</div>
                    <div class="review-item">
                        <div class="review-item-label">Razor View:</div>
                        <div class="review-item-value"><code id="reviewRazorView"></code></div>
                    </div>
                    <div class="review-item">
                        <div class="review-item-label">HTML Body:</div>
                        <div class="review-item-value" id="reviewHtmlBody"></div>
                    </div>
                </div>

                <!-- Fields Review -->
                <div class="review-section">
                    <div class="review-section-title">✅ Selected Fields</div>
                    <div id="reviewFields"></div>
                </div>

                <!-- PDF Review -->
                <div class="review-section" id="reviewPdfSection" style="display: none;">
                    <div class="review-section-title">📎 PDF File</div>
                    <div class="review-item">
                        <div class="review-item-label">File Name:</div>
                        <div class="review-item-value" id="reviewPdfFileName"></div>
                    </div>
                    <div class="review-item">
                        <div class="review-item-label">File Size:</div>
                        <div class="review-item-value" id="reviewPdfFileSize"></div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Wizard Navigation -->
        <div class="wizard-navigation">
            <button type="button" class="btn btn-secondary" id="prevBtn" style="display: none;">
                <i class="bi bi-chevron-left"></i> Previous
            </button>
            <div>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
            <button type="button" class="btn btn-primary" id="nextBtn">
                Next <i class="bi bi-chevron-right"></i>
            </button>
            <button type="submit" class="btn btn-success" id="submitBtn" style="display: none;">
                <i class="bi bi-check-circle"></i> Create Template
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <!-- TinyMCE -->
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        // Initialize TinyMCE for the custom HTML body (lazy — init when Step 2 becomes visible)
        var tinymceInitialized = false;
        function ensureTinyMCEInit() {
            if (tinymceInitialized) return;
            tinymceInitialized = true;
            tinymce.init({
                selector: '#htmlBodyContent',
                height: 500,
                menubar: 'file edit view insert format tools',
                plugins: [
                    'advlist', 'autolink', 'lists', 'link', 'image', 'charmap',
                    'preview', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
                    'insertdatetime', 'table', 'wordcount', 'help'
                ],
                toolbar:
                    'undo redo | styles | bold italic underline | ' +
                    'alignleft aligncenter alignright alignjustify | ' +
                    'bullist numlist outdent indent | link image table | ' +
                    'removeformat code fullscreen | help',
                content_style: 'body { font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; }',
                setup: function (editor) {
                    editor.on('change', function () { editor.save(); });
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Observe step 2 becoming active to lazily init TinyMCE
            var step2Content = document.querySelector('.wizard-step-content[data-step="2"]');
            if (step2Content) {
                var observer = new MutationObserver(function (mutations) {
                    mutations.forEach(function (m) {
                        if (m.target.classList.contains('active')) {
                            ensureTinyMCEInit();
                        }
                    });
                });
                observer.observe(step2Content, { attributes: true, attributeFilter: ['class'] });

                // Also init immediately if step2 is already active on load (unlikely but safe)
                if (step2Content.classList.contains('active')) {
                    ensureTinyMCEInit();
                }
            }

            // Token panel toggle
            document.getElementById('toggleTokenPanelCreate').addEventListener('click', function () {
                var panel = document.getElementById('tokenPanelCreate');
                panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
            });

            // Insert token into TinyMCE at cursor
            document.querySelectorAll('.token-insert-btn-create').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var token = this.dataset.token;
                    var ed = tinymce.get('htmlBodyContent');
                    if (ed) {
                        ed.insertContent(token);
                        ed.focus();
                    } else {
                        var ta = document.getElementById('htmlBodyContent');
                        var pos = ta.selectionStart;
                        ta.value = ta.value.substring(0, pos) + token + ta.value.substring(ta.selectionEnd);
                        ta.selectionStart = ta.selectionEnd = pos + token.length;
                        ta.focus();
                    }
                });
            });

            // Save TinyMCE before form submit
            document.getElementById('templateForm').addEventListener('submit', function () {
                if (typeof tinymce !== 'undefined') tinymce.triggerSave();
            });
        });
    </script>

    <!-- PDF.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // Set PDF.js worker
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    </script>

    <!-- Template Field Selector (from Phase 1) -->
    <script src="~/assets/js/template-field-selector.js"></script>

    <!-- Template Wizard (Phase 2) -->
    <script src="~/assets/js/template-wizard.js"></script>

    <!-- PDF Field Configurator (Phase 3) -->
    <script src="~/assets/js/pdf-field-configurator.js"></script>

    <!-- Custom Fields Manager -->
    <script>
        const CustomFieldsManager = {
            customFieldCount: 0,
            customFields: [],

            init() {
                const addBtn = document.getElementById('addCustomFieldBtn');
                if (addBtn) {
                    addBtn.addEventListener('click', () => this.addCustomField());
                }
            },

            addCustomField() {
                const container = document.getElementById('customFieldsList');
                const index = this.customFieldCount++;

                // Remove "no fields" message if this is the first field
                if (this.customFieldCount === 1) {
                    container.innerHTML = '';
                }

                const fieldHtml = `
                    <div class="card mb-2 custom-field-item" data-field-index="${index}">
                        <div class="card-body p-3">
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label class="form-label small mb-1">Field Name *</label>
                                    <input type="text" class="form-control form-control-sm custom-field-name"
                                           placeholder="e.g., TenantID" data-index="${index}" required />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-1">Type</label>
                                    <select class="form-select form-select-sm custom-field-type" data-index="${index}">
                                        <option value="text">Text</option>
                                        <option value="signature">Signature</option>
                                        <option value="date">Date</option>
                                        <option value="number">Number</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-1">Default Value</label>
                                    <input type="text" class="form-control form-control-sm custom-field-default"
                                           placeholder="Optional" data-index="${index}" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-1">Required?</label>
                                    <select class="form-select form-select-sm custom-field-required" data-index="${index}">
                                        <option value="false">No</option>
                                        <option value="true">Yes</option>
                                    </select>
                                </div>
                                <div class="col-md-2 d-flex align-items-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger w-100 remove-custom-field"
                                            data-index="${index}">
                                        <i class="bi bi-trash"></i> Remove
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                container.insertAdjacentHTML('beforeend', fieldHtml);

                // Add event listener to remove button
                const removeBtn = container.querySelector(`[data-index="${index}"].remove-custom-field`);
                removeBtn.addEventListener('click', () => this.removeCustomField(index));

                // Add to checkbox list so it can be placed on PDF
                this.syncToFieldCheckboxes();
            },

            removeCustomField(index) {
                const fieldElement = document.querySelector(`.custom-field-item[data-field-index="${index}"]`);
                if (fieldElement) {
                    fieldElement.remove();
                }

                // Check if we need to show "no fields" message
                const container = document.getElementById('customFieldsList');
                if (container.children.length === 0) {
                    container.innerHTML = '<p class="text-muted small mb-0">No custom fields added yet. Click "+ Add Custom Field" to create one.</p>';
                }

                this.syncToFieldCheckboxes();
            },

            // Sync custom fields to the field checkbox system so they can be placed on PDF
            syncToFieldCheckboxes() {
                const customFieldNames = this.getCustomFieldNames();

                // Update field palette and checkbox system
                if (typeof TemplateFieldSelector !== 'undefined' && TemplateFieldSelector.updateCustomFields) {
                    TemplateFieldSelector.updateCustomFields(customFieldNames);
                }
            },

            getCustomFieldNames() {
                const fields = [];
                document.querySelectorAll('.custom-field-name').forEach(input => {
                    const name = input.value.trim();
                    if (name) {
                        fields.push({
                            name: name,
                            type: document.querySelector(`.custom-field-type[data-index="${input.dataset.index}"]`).value,
                            defaultValue: document.querySelector(`.custom-field-default[data-index="${input.dataset.index}"]`).value,
                            required: document.querySelector(`.custom-field-required[data-index="${input.dataset.index}"]`).value === 'true'
                        });
                    }
                });
                return fields;
            },

            // Get custom fields for review page
            getCustomFieldsForReview() {
                return this.getCustomFieldNames();
            }
        };
    </script>

    <script>
        // Initialize all modules
        document.addEventListener('DOMContentLoaded', function() {
            CustomFieldsManager.init();
            TemplateFieldSelector.init();
            TemplateWizard.init();
            PDFFieldConfigurator.init();

            // Auto-save field coordinates when form is submitted
            // This ensures coordinates are saved even if user forgets to click "Done"
            const templateForm = document.getElementById('templateForm');
            if (templateForm) {
                templateForm.addEventListener('submit', function(e) {
                    if (typeof PDFFieldConfigurator !== 'undefined' && PDFFieldConfigurator.saveCoordinatesToMergeSpec) {
                        PDFFieldConfigurator.saveCoordinatesToMergeSpec();
                    }
                });
            }
        });
    </script>
}
