@model SalesMetrics.Domain.Signing.SignTemplate
@{
    ViewData["Title"] = "Edit Template";
    var viewPaths = (List<string>)ViewBag.ViewPaths;
}
<div class="card p-4">
    <h4 class="mb-3">Edit Template</h4>
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Template Key</label>
                <input asp-for="TemplateKey" class="form-control" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label">Display Name</label>
                <input asp-for="DisplayName" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Active</label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Razor View Path (for Review page)</label>
            <select asp-for="RazorViewPath" class="form-select">
                <option value="">-- choose --</option>
                @foreach (var p in viewPaths)
                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Default Subject</label>
            <input asp-for="DefaultSubject" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Default Message</label>
            <textarea asp-for="DefaultMessage" class="form-control" rows="2"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">MergeSpec (JSON)</label>
            <textarea asp-for="MergeSpecJson" class="form-control" rows="8" spellcheck="false"></textarea>
            <small class="text-muted">e.g. { "merge":"property,order,customer", "fields": { "PropertyName":"ERP.Properties.Name" } }</small>
        </div>

        <div class="mb-3">
            <label class="form-label">Base PDF (optional for pdf-stamp)</label>
            <input type="file" name="pdfFile" class="form-control" accept=".pdf" />
            <small class="text-muted">Uploaded to Content/Templates.</small>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-success" type="submit">Save</button>
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
