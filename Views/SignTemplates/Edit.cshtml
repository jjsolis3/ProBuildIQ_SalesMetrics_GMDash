@model SalesMetrics.Domain.Signing.SignTemplate
@{
    ViewData["Title"] = "Edit Template";
    ViewBag.PTitle = "Sign Templates";
    ViewBag.PLink = "/SignTemplates";
    var viewPaths = (List<string>)ViewBag.ViewPaths;
}

<style>
    /* Field Selection */
    .field-category {
        margin-bottom: 1.5rem;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1rem;
        background: #f8f9fa;
    }

    .field-category-header {
        font-weight: 600;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .field-checkbox-group {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.5rem;
    }

    .field-checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
        background: white;
        border-radius: 4px;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .field-checkbox-label:hover {
        background: #e7f1ff;
    }

    /* PDF Preview */
    .pdf-preview-container {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1rem;
        background: #f8f9fa;
        margin-top: 1rem;
    }

    .pdf-preview-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    #pdfCanvas {
        border: 1px solid #dee2e6;
        background: white;
        display: block;
        margin: 0 auto;
    }

    #pdfPreviewContent {
        max-height: 800px;
        overflow: auto;
        text-align: center;
    }

    .pdf-preview-controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
    }

    /* Field Configurator Styles */
    .field-palette {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 0.5rem;
    }

    .field-palette-item {
        padding: 0.75rem;
        border: 2px solid #dee2e6;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: white;
        text-align: center;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .field-palette-item:hover {
        border-color: #0d6efd;
        background: #e7f1ff;
        transform: translateY(-2px);
    }

    .field-palette-item.selected {
        border-color: #0d6efd;
        background: #0d6efd;
        color: white;
    }

    .field-palette-item.placed {
        border-color: #198754;
        background: #d1e7dd;
        cursor: default;
        opacity: 0.6;
    }

    .field-palette-item.placed:hover {
        transform: none;
    }

    .placed-fields-list {
        max-height: 300px;
        overflow-y: auto;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 0.5rem;
        background: white;
    }

    .placed-field-item {
        padding: 0.5rem;
        border-left: 3px solid #0d6efd;
        background: #f8f9fa;
        margin-bottom: 0.5rem;
        border-radius: 4px;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .placed-field-item:hover {
        background: #e7f1ff;
    }

    .placed-field-item.active {
        background: #e7f1ff;
        border-left-color: #198754;
    }

    .pdf-canvas-wrapper {
        cursor: crosshair;
    }

    .pdf-canvas-wrapper.placement-mode {
        cursor: crosshair;
    }

    .pdf-canvas-wrapper.drag-mode {
        cursor: move;
    }

    /* Field boxes on PDF */
    .field-box {
        fill: rgba(13, 110, 253, 0.1);
        stroke: #0d6efd;
        stroke-width: 2;
        cursor: move;
        pointer-events: all;
    }

    .field-box:hover {
        fill: rgba(13, 110, 253, 0.2);
        stroke-width: 3;
    }

    .field-box.selected {
        fill: rgba(25, 135, 84, 0.2);
        stroke: #198754;
        stroke-width: 3;
    }

    .field-label {
        font-size: 10px;
        fill: #0d6efd;
        font-weight: bold;
        pointer-events: none;
        user-select: none;
    }
</style>

<div class="card p-4">
    <h4 class="mb-3">Edit Template</h4>
    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="templateForm">
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Template Key</label>
                <input asp-for="TemplateKey" class="form-control" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label">Display Name</label>
                <input asp-for="DisplayName" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Active</label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Template Type</label>
                <select asp-for="TemplateType" class="form-select">
                    <option value="Consent">✍️ Consent (Signature Required)</option>
                    <option value="Communication">📧 Communication (Tracked Delivery)</option>
                </select>
                <small class="text-muted">
                    Controls which envelope types this template appears in when creating an envelope.
                </small>
            </div>
        </div>

        <div class="mb-3 p-3 border rounded bg-light">
            <div class="form-check form-switch">
                <input asp-for="RequiresTenantSection" class="form-check-input" type="checkbox" role="switch" id="requiresTenantSection" />
                <label class="form-check-label fw-semibold" for="requiresTenantSection">
                    Allow Manager to add or skip Tenant information when signing
                </label>
            </div>
            <small class="text-muted d-block mt-1">
                When enabled, the signing page shows a section where the Manager can enter Tenant details to send a separate signing invitation,
                or skip tenant signature entirely. Disable this for templates that never involve a tenant (e.g. staff-only consent forms).
            </small>
        </div>

        <div class="mb-3">
            <label class="form-label">Razor View Path <small class="text-muted">(legacy — used only when HTML Body below is empty)</small></label>
            <select asp-for="RazorViewPath" class="form-select">
                <option value="">-- none --</option>
                @foreach (var p in viewPaths)
                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>

        <!-- ── HTML Body Content (DB-stored, overrides Razor View) ───────────── -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0 fw-semibold">
                    HTML Body Content
                    <span class="badge bg-success ms-2">Overrides Razor View</span>
                </label>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="toggleTokenPanel">
                    <i class="bi bi-code-square"></i> Insert Token
                </button>
            </div>

            <!-- Token panel -->
            <div id="tokenPanel" class="mb-3 border rounded p-3 bg-light" style="display:none;">
                <p class="mb-2 small fw-semibold">Click a token to insert it at the cursor position in the editor:</p>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var (token, desc) in SalesMetrics.Services.Signing.ErpMergeService.AvailableTokens)
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary token-insert-btn"
                                data-token="@token" title="@desc">
                            @token
                        </button>
                    }
                </div>
                <small class="text-muted mt-2 d-block">Tokens are replaced with live data when a signer opens the document.</small>
            </div>

            <textarea asp-for="HtmlBodyContent" id="htmlBodyContent" class="form-control"
                      rows="18" style="font-family:monospace;font-size:0.85rem;"
                      placeholder="Leave blank to use the Razor View above. Enter HTML here to create a fully custom consent form body."></textarea>
            <small class="text-muted">When set, this HTML is displayed to the signer instead of the Razor view. Use <code>{{TokenName}}</code> placeholders for dynamic data.</small>
        </div>
        <!-- ──────────────────────────────────────────────────────────────────── -->

        <div class="mb-3">
            <label class="form-label">Default Subject</label>
            <input asp-for="DefaultSubject" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Default Message</label>
            <textarea asp-for="DefaultMessage" class="form-control" rows="2"></textarea>
        </div>

        <!-- Field Selection -->
        <div class="mb-4">
            <h6>Select Fields to Include</h6>

            <!-- Property Fields -->
            <div class="field-category">
                <div class="field-category-header">
                    <input type="checkbox" class="form-check-input select-all-category" data-category="property" id="selectAllProperty" />
                    <label for="selectAllProperty">🏢 Property Information</label>
                </div>
                <div class="field-checkbox-group">
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyName" />
                        Property Name
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyAddress" />
                        Property Address
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyPhone" />
                        Property Phone
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyCity" />
                        Property City
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyState" />
                        Property State
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="property" value="PropertyZip" />
                        Property Zip Code
                    </label>
                </div>
            </div>

            <!-- Customer Contact Fields -->
            <div class="field-category">
                <div class="field-category-header">
                    <input type="checkbox" class="form-check-input select-all-category" data-category="customer" id="selectAllCustomer" />
                    <label for="selectAllCustomer">👤 Customer Contact Information</label>
                </div>
                <div class="field-checkbox-group">
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="customer" value="CustomerName" />
                        Customer Name
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="customer" value="CustomerPhone" />
                        Customer Phone
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="customer" value="CustomerEmail" />
                        Customer Email
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="customer" value="CustomerCompany" />
                        Customer Company
                    </label>
                </div>
            </div>

            <!-- Order Fields -->
            <div class="field-category">
                <div class="field-category-header">
                    <input type="checkbox" class="form-check-input select-all-category" data-category="order" id="selectAllOrder" />
                    <label for="selectAllOrder">📦 Work Order Information</label>
                </div>
                <div class="field-checkbox-group">
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="order" value="OrderNumber" />
                        Order Number
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="order" value="InstallationDate" />
                        Installation Date
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="order" value="UnitNumber" />
                        Unit Number
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="order" value="DeliveryDate" />
                        Delivery Date
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="order" value="OrderStartDate" />
                        Order Start Date
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="order" value="OrderEndDate" />
                        Order End Date
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="order" value="OrderSignedDate" />
                        Order Signed Date
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="order" value="LeaseStartDate" />
                        Lease Start Date
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="order" value="LeaseEndDate" />
                        Lease End Date
                    </label>
                </div>
            </div>

            <!-- Signature Fields -->
            <div class="field-category">
                <div class="field-category-header">
                    <input type="checkbox" class="form-check-input select-all-category" data-category="signature" id="selectAllSignature" />
                    <label for="selectAllSignature">✍️ Signature Fields</label>
                </div>
                <div class="field-checkbox-group">
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="signature" value="PropertyStaffName" />
                        Property Staff Name
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="signature" value="PropertyStaffSignature" />
                        Property Staff Signature
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="signature" value="PropertyStaffDate" />
                        Property Staff Date
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="signature" value="ResidentName" />
                        Resident Name
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="signature" value="ResidentSignature" />
                        Resident Signature
                    </label>
                    <label class="field-checkbox-label">
                        <input type="checkbox" class="field-checkbox" data-category="signature" value="ResidentPhone" />
                        Resident Phone
                    </label>
                </div>
            </div>
        </div>

        <!-- Hidden field for MergeSpec JSON -->
        <input type="hidden" asp-for="MergeSpecJson" id="mergeSpecJson" />

        <!-- PDF Upload -->
        <div class="mb-3">
            <h6>Upload Base PDF @(string.IsNullOrWhiteSpace(Model.PdfFilePath) ? "(Required)" : "(Optional - currently using: " + Model.PdfFilePath + ")")</h6>
            <input type="file" name="pdfFile" id="pdfFile" class="form-control" accept=".pdf" />
            <small class="text-muted">Upload a PDF template for pdf-stamp rendering. Leave empty to keep current PDF.</small>
            @if (!string.IsNullOrWhiteSpace(Model.PdfFilePath))
            {
                <input type="hidden" id="existingPdfPath" value="@Model.PdfFilePath" />
                <div class="mt-2">
                    <small class="text-success">
                        <i class="bi bi-check-circle"></i> Current PDF: @Model.PdfFilePath
                    </small>
                </div>
            }
        </div>

        <!-- PDF Preview -->
        <div class="pdf-preview-container" id="pdfPreviewContainer" style="display: none;">
            <div class="pdf-preview-header">
                <h6>PDF Preview</h6>
                <div>
                    <button type="button" class="btn btn-sm btn-info" id="enableFieldPlacement" style="display: none;">
                        <i class="bi bi-cursor"></i> Place Fields on PDF
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" id="togglePreview">
                        <i class="bi bi-arrows-angle-contract"></i> Collapse
                    </button>
                </div>
            </div>
            <div id="pdfPreviewContent">
                <div class="text-center mb-2">
                    <strong id="pdfFileName"></strong>
                    <span class="text-muted">(<span id="pdfFileSize"></span>)</span>
                </div>

                <!-- PDF Canvas with Field Overlay -->
                <div class="pdf-canvas-wrapper" style="position: relative; display: inline-block;">
                    <canvas id="pdfCanvas"></canvas>
                    <svg id="fieldOverlay" style="position: absolute; top: 0; left: 0; pointer-events: none; display: none;"></svg>
                </div>

                <div class="pdf-preview-controls">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="prevPage">
                        <i class="bi bi-chevron-left"></i> Previous
                    </button>
                    <span>Page <span id="currentPage">1</span> of <span id="totalPages">1</span></span>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="nextPage">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Visual Field Configurator -->
        <div id="fieldConfiguratorPanel" style="display: none;">
            <div class="card mt-3 p-3 bg-light">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">
                        <i class="bi bi-pin-map"></i> Visual Field Configurator
                    </h6>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-danger" id="clearAllFields">
                            <i class="bi bi-trash"></i> Clear All
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="disableFieldPlacement">
                            <i class="bi bi-x"></i> Done
                        </button>
                    </div>
                </div>

                <!-- Field Placement Instructions -->
                <div class="alert alert-info mb-3">
                    <strong>How to use:</strong>
                    <ol class="mb-0 mt-2">
                        <li>Select a field from the palette below</li>
                        <li>Click on the PDF where you want to place it</li>
                        <li>Drag placed fields to reposition them</li>
                        <li>Click "Done" when finished</li>
                    </ol>
                </div>

                <!-- Field Palette -->
                <div class="row">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Field Palette (Click to select, then click PDF to place)</label>
                        <div id="fieldPalette" class="field-palette">
                            <!-- Dynamically populated based on selected checkboxes -->
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Placed Fields</label>
                        <div id="placedFieldsList" class="placed-fields-list">
                            <p class="text-muted small">No fields placed yet</p>
                        </div>
                    </div>
                </div>

                <!-- Field Properties Panel (appears when field is selected) -->
                <div id="fieldPropertiesPanel" class="mt-3" style="display: none;">
                    <hr />
                    <h6>Field Properties</h6>
                    <div class="row">
                        <div class="col-md-3">
                            <label class="form-label small">Field Name</label>
                            <input type="text" id="fieldPropName" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">X Position</label>
                            <input type="number" id="fieldPropX" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Y Position</label>
                            <input type="number" id="fieldPropY" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Width</label>
                            <input type="number" id="fieldPropWidth" class="form-control form-control-sm" value="150" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">Height</label>
                            <input type="number" id="fieldPropHeight" class="form-control form-control-sm" value="20" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-sm btn-danger w-100" id="deleteFieldBtn">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-success" type="submit">Save Changes</button>
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <!-- TinyMCE (no API key required for self-hosted / community use) -->
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        tinymce.init({
            selector: '#htmlBodyContent',
            height: 500,
            menubar: 'file edit view insert format tools',
            plugins: [
                'advlist', 'autolink', 'lists', 'link', 'image', 'charmap',
                'preview', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
                'insertdatetime', 'table', 'wordcount', 'help'
            ],
            toolbar:
                'undo redo | styles | bold italic underline | ' +
                'alignleft aligncenter alignright alignjustify | ' +
                'bullist numlist outdent indent | link image table | ' +
                'removeformat code fullscreen | help',
            content_style: 'body { font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; }',
            // Sync back to the hidden textarea on any change
            setup: function (editor) {
                editor.on('change', function () { editor.save(); });
            }
        });

        // Token panel toggle
        document.getElementById('toggleTokenPanel').addEventListener('click', function () {
            var panel = document.getElementById('tokenPanel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        });

        // Insert token into TinyMCE at cursor
        document.querySelectorAll('.token-insert-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var token = this.dataset.token;
                var ed = tinymce.get('htmlBodyContent');
                if (ed) {
                    ed.insertContent(token);
                    ed.focus();
                } else {
                    // Fallback: plain textarea insert
                    var ta = document.getElementById('htmlBodyContent');
                    var pos = ta.selectionStart;
                    ta.value = ta.value.substring(0, pos) + token + ta.value.substring(ta.selectionEnd);
                    ta.selectionStart = ta.selectionEnd = pos + token.length;
                    ta.focus();
                }
            });
        });

        // Before form submit, ensure TinyMCE content is saved to textarea
        document.getElementById('templateForm').addEventListener('submit', function () {
            tinymce.triggerSave();
        });
    </script>

    <!-- PDF.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // Set PDF.js worker
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    </script>

    <!-- Template Field Selector -->
    <script src="~/assets/js/template-field-selector.js"></script>

    <!-- PDF Field Configurator -->
    <script src="~/assets/js/pdf-field-configurator.js"></script>

    <script>
        // Initialize modules for edit mode
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize field selector
            TemplateFieldSelector.init();

            // Load existing MergeSpec and pre-select fields
            const existingMergeSpec = document.getElementById('mergeSpecJson').value;
            if (existingMergeSpec) {
                try {
                    const mergeSpec = JSON.parse(existingMergeSpec);

                    // Pre-select checkboxes based on existing fields
                    if (mergeSpec.fields && Array.isArray(mergeSpec.fields)) {
                        mergeSpec.fields.forEach(fieldName => {
                            const checkbox = document.querySelector(`.field-checkbox[value="${fieldName}"]`);
                            if (checkbox) {
                                checkbox.checked = true;
                            }
                        });
                    }

                    // Trigger field selection update to regenerate MergeSpec
                    if (typeof TemplateFieldSelector !== 'undefined' && TemplateFieldSelector.updateMergeSpec) {
                        TemplateFieldSelector.updateMergeSpec();
                    }

                    // Show "Place Fields on PDF" button if fields are selected and PDF is loaded
                    updateFieldPlacementButtonVisibility();
                } catch (e) {
                    // Error parsing existing MergeSpec - will use empty spec
                }
            }

            // Watch for field checkbox changes to show/hide the "Place Fields on PDF" button
            const fieldCheckboxes = document.querySelectorAll('.field-checkbox');
            fieldCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', updateFieldPlacementButtonVisibility);
            });

            // Function to show/hide "Place Fields on PDF" button
            function updateFieldPlacementButtonVisibility() {
                const selectedFields = document.querySelectorAll('.field-checkbox:checked');
                const pdfLoaded = window.pdfDoc !== undefined;
                const enableBtn = document.getElementById('enableFieldPlacement');

                if (enableBtn && pdfLoaded && selectedFields.length > 0) {
                    enableBtn.style.display = 'inline-block';
                } else if (enableBtn) {
                    enableBtn.style.display = 'none';
                }
            }

            // Initialize PDF configurator
            PDFFieldConfigurator.init();

            // Auto-save field coordinates before form submit
            const templateForm = document.getElementById('templateForm');
            if (templateForm) {
                templateForm.addEventListener('submit', function(e) {
                    // If configurator is active, save coordinates
                    if (PDFFieldConfigurator && PDFFieldConfigurator.saveCoordinatesToMergeSpec) {
                        PDFFieldConfigurator.saveCoordinatesToMergeSpec();
                    }
                });
            }

            // Load existing PDF if available
            const existingPdfPath = document.getElementById('existingPdfPath');
            if (existingPdfPath && existingPdfPath.value) {
                loadExistingPDF(existingPdfPath.value);
            }

            // Handle PDF file selection
            const pdfFileInput = document.getElementById('pdfFile');
            pdfFileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file && file.type === 'application/pdf') {
                    // Show PDF preview
                    const container = document.getElementById('pdfPreviewContainer');
                    container.style.display = 'block';

                    // Update file info
                    document.getElementById('pdfFileName').textContent = file.name;
                    const sizeKB = (file.size / 1024).toFixed(2);
                    document.getElementById('pdfFileSize').textContent = sizeKB + ' KB';

                    // Load PDF with PDF.js
                    const fileReader = new FileReader();
                    fileReader.onload = function(e) {
                        const typedarray = new Uint8Array(e.target.result);

                        pdfjsLib.getDocument(typedarray).promise.then(function(pdf) {
                            window.pdfDoc = pdf;
                            window.currentPage = 1;
                            document.getElementById('totalPages').textContent = pdf.numPages;

                            // Render first page
                            renderPage(1);

                            // Show field placement button if fields are selected
                            updateFieldPlacementButtonVisibility();
                        });
                    };
                    fileReader.readAsArrayBuffer(file);
                }
            });

            // PDF page navigation
            document.getElementById('prevPage').addEventListener('click', function() {
                if (window.currentPage > 1) {
                    window.currentPage--;
                    renderPage(window.currentPage);
                }
            });

            document.getElementById('nextPage').addEventListener('click', function() {
                if (window.currentPage < window.pdfDoc.numPages) {
                    window.currentPage++;
                    renderPage(window.currentPage);
                }
            });

            // Toggle preview
            document.getElementById('togglePreview').addEventListener('click', function() {
                const content = document.getElementById('pdfPreviewContent');
                if (content.style.display === 'none') {
                    content.style.display = 'block';
                    this.innerHTML = '<i class="bi bi-arrows-angle-contract"></i> Collapse';
                } else {
                    content.style.display = 'none';
                    this.innerHTML = '<i class="bi bi-arrows-angle-expand"></i> Expand';
                }
            });

            // Render PDF page
            function renderPage(pageNum) {
                window.pdfDoc.getPage(pageNum).then(function(page) {
                    const canvas = document.getElementById('pdfCanvas');
                    const context = canvas.getContext('2d');

                    // FIXED: Use fixed scale of 1.0 (100%) for consistent coordinates across all screen sizes
                    // This ensures coordinates are PDF-native and screen-independent
                    const scale = 1.0;
                    const viewport = page.getViewport({ scale: scale });

                    // Set canvas dimensions to actual PDF size
                    canvas.height = viewport.height;
                    canvas.width = viewport.width;

                    // Store scale for field configurator coordinate conversion
                    window.pdfScale = scale;

                    const renderContext = {
                        canvasContext: context,
                        viewport: viewport
                    };

                    page.render(renderContext).promise.then(function() {
                        document.getElementById('currentPage').textContent = pageNum;

                        // Update SVG overlay size
                        const overlay = document.getElementById('fieldOverlay');
                        overlay.setAttribute('width', canvas.width);
                        overlay.setAttribute('height', canvas.height);

                        // Reload existing field placements from MergeSpec if in configurator mode
                        if (PDFFieldConfigurator && PDFFieldConfigurator.isActive) {
                            PDFFieldConfigurator.loadExistingPlacements();
                        }
                    });
                });
            }

            // Function to load existing PDF
            function loadExistingPDF(pdfFileName) {
                // Show PDF preview container
                const container = document.getElementById('pdfPreviewContainer');
                container.style.display = 'block';

                // Update file info
                document.getElementById('pdfFileName').textContent = pdfFileName;
                document.getElementById('pdfFileSize').textContent = 'Existing file';

                // Fetch and load the PDF via controller action (not direct file access)
                const templateKey = '@Model.TemplateKey';
                const pdfUrl = `/SignTemplates/GetTemplatePdf/${encodeURIComponent(templateKey)}`;

                fetch(pdfUrl)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.arrayBuffer();
                    })
                    .then(arrayBuffer => {
                        const typedarray = new Uint8Array(arrayBuffer);

                        pdfjsLib.getDocument(typedarray).promise.then(function(pdf) {
                            window.pdfDoc = pdf;
                            window.currentPage = 1;
                            document.getElementById('totalPages').textContent = pdf.numPages;

                            // Render first page
                            renderPage(1);

                            // Show field placement button if fields are selected
                            updateFieldPlacementButtonVisibility();
                        }).catch(error => {
                            if (typeof toastr !== 'undefined') {
                                toastr.error('Error loading PDF. The PDF file may be corrupted. Please upload a new one.');
                            } else {
                                alert('Error loading PDF. The PDF file may be corrupted. Please upload a new one.');
                            }
                        });
                    })
                    .catch(error => {
                        if (typeof toastr !== 'undefined') {
                            toastr.error('Could not fetch PDF file from server. Please upload a new PDF.');
                        } else {
                            alert('Could not fetch PDF file from server. Please upload a new PDF.');
                        }
                    });
            }
        });
    </script>
}
