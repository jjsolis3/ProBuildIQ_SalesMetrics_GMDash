@model IEnumerable<SalesMetrics.Domain.Signing.SignTemplate>
@{
    ViewData["Title"] = "Templates";
}
<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">E-Sign Templates</h4>
        <a class="btn btn-success" asp-action="Create">+ New Template</a>
    </div>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Key</th>
                <th>Active</th>
                <th>View</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.DisplayName</td>
                    <td><code>@t.TemplateKey</code></td>
                    <td>@(t.IsActive ? "Yes" : "No")</td>
                    <td>@t.RazorViewPath</td>
                    <td class="text-end">
                        <div class="btn-group">
                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@t.TemplateKey" title="Edit template">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button type="button" class="btn btn-sm btn-secondary" onclick="duplicateTemplate('@t.TemplateKey')" title="Duplicate template">
                                <i class="bi bi-files"></i> Duplicate
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        function duplicateTemplate(templateKey) {
            if (confirm('Create a copy of this template?')) {

                // Create a form and submit it
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("Duplicate")';

                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'templateKey';
                input.value = templateKey;

                const token = document.querySelector('input[name="__RequestVerificationToken"]');

                if (token) {
                    form.appendChild(token.cloneNode());
                }

                form.appendChild(input);
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
    @Html.AntiForgeryToken()
}
