@model IEnumerable<SalesMetrics.Domain.Signing.SignTemplate>
@{
    ViewData["Title"] = "Templates";
}
<div class="card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">E-Sign Templates</h4>
        <a class="btn btn-success" asp-action="Create">+ New Template</a>
    </div>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Key</th>
                <th>Active</th>
                <th>View</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.DisplayName</td>
                    <td><code>@t.TemplateKey</code></td>
                    <td>@(t.IsActive ? "Yes" : "No")</td>
                    <td>@t.RazorViewPath</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@t.TemplateKey">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
