@using SalesMetrics.Services.Helpers

@{
    ViewBag.Title = "Yardi Properties";
    ViewBag.PTitle = "Yardi Properties";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model IEnumerable<SalesMetrics.Models.YardiPropertyViewModel>

@section styles {
<link href="~/assets/libs/datatables.net-searchpanes-bs5/css/searchPanes.bootstrap5.min.css" rel="stylesheet" />
<link href="~/assets/libs/select2/css/select2.min.css" rel="stylesheet" />
}

<style>
    table.dataTable thead th {
    background-color: darkorange !important;
    color: white !important;
    }

    div.dataTables_length {
    margin-right: 1.5rem;
    }

    div.dataTables_filter {
    max-width: 300px;
    margin-left: auto;
    }

</style>

<div class="table-responsive">
    <table id="yardiTable" class="table table-bordered table-striped nowrap" style="width:100%">
        <thead>
            <tr>
                <th>Market</th>
                <th>Submarket</th>
                <th>Property Name</th>
                <th>Address</th>
                <th>City</th>
                <th>State</th>
                <th>ZIP</th>
                <th>Units</th>
                <th>SqFt</th>
                <th>Owner</th>
                <th>Owner Phone</th>
                <th>Owner Email</th>
                <th>Owner Website</th>
                <th>Manager</th>
                <th>Manager Phone</th>
                <th>Manager Website</th>
                <th>Action</th> <!-- This should always be visible -->
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Market</td>
                    <td>@p.Submarket</td>
                    <td>
                        @{
                            var site = "https://matrix.pi-ei.com/PropertyDetail/All?";
                            var MarkID = $"MarketID={p.YardiMarketID}&";
                            var PropId = $"PropertyID={p.YardiPropertyID}";
                            var propSiteUrl = $"{site}{MarkID}{PropId}";
                            if (!string.IsNullOrEmpty(propSiteUrl) && !propSiteUrl.StartsWith("http"))
                            {
                                propSiteUrl = "https://" + propSiteUrl;
                            }
                        }
                        <a href="@propSiteUrl" style="color:darkblue" target="_blank">@p.PropertyName</a>
                    </td>
                    <td>@p.PropertyAddress</td>
                    <td>@p.PropertyCity</td>
                    <td>@p.PropertyState</td>
                    <td>@p.PropertyZipCode</td>
                    <td>@p.Units</td>
                    <td>@p.SqFt</td>
                    <td>@($"{p.OwnerFName} {p.OwnerLName}")</td>
                    <td>@p.OwnerPhone</td>
                    <td>@p.OwnerEmail</td>
                    <td>@p.OwnerWebsite</td>
                    <td>@p.Manager</td>
                    <td>@p.ManagerPhone</td>
                    <td>
                        @{
                            var siteUrl = p.ManagerWebsite;
                            if (!string.IsNullOrEmpty(siteUrl) && !siteUrl.StartsWith("http"))
                            {
                                siteUrl = "https://" + siteUrl;
                            }
                        }
                        <a href="@siteUrl" style="color:darkblue" target="_blank">@p.ManagerWebsite</a>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary create-task" data-id="@p.Property_ID" data-name="@p.PropertyName">Create Task</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


@* Create the Task Modal *@
<div class="modal fade" id="taskModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <form asp-controller="Tasks" asp-action="CreateFromYardi" method="post">
            @* <form asp-action="CreateTask" method="post"> *@
            @Html.AntiForgeryToken()
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Task for Property</h5>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Task.PropertyID" />
                    <div class="form-group">
                        <label>Title</label>
                        <input type="text" class="form-control" name="Task.Title" placeholder="Enter task title" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="Description">Description</label>
                        <textarea name="Task.Description" class="form-control"></textarea>
                    </div>

                    <div class="form-group">
                        <label>Due Date</label>
                        <input type="datetime-local" class="form-control" name="Task.DueDate" />
                    </div>

                    <div class="form-group">
                        <label>Task Type</label>
                        <select class="form-control" name="Task.Type" required>
                            <option disabled selected value="">-- Select Type --</option>
                            @foreach (var type in TaskTypeHelper.GetTaskTypes("Properties"))
                            {
                                <option value="@type.Value">@type.Text</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Property</label>
                        <input type="text" class="form-control" name="Task.Property" readonly />
                    </div>
                    <div class="form-group">
                        <label>Status</label>
                        <select class="form-control" name="Task.Status">
                            <option value="Pending">Pending</option>
                            <option value="Assigned">Assigned</option>
                            <option value="In Progress">In Progress</option>
                            <option value="In Review">In Review</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    
                    <!-- AssignTo Field -->
                    @if (ViewBag.Users is List<SalesMetrics.Models.User> userList && userList.Any())
                    {
                        <div class="form-group">
                            <label>Assigned To</label>
                            <select class="form-control" name="Task.AssignedTo">
                                @if ((ViewBag.RoleId as int? ?? 0) == 2)
                                {
                                    var currentUser = userList.FirstOrDefault(u => u.UserID == (int)ViewBag.UserId);
                                    if (currentUser != null)
                                    {
                                        <option value="@currentUser.UserID">@currentUser.FirstName @currentUser.LastName (You)</option>
                                    }
                                }
                                else
                                {
                                    <option value="">-- Select User --</option>
                                    @foreach (var u in userList)
                                    {
                                        <option value="@u.UserID">@u.FirstName @u.LastName</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label>Assigned To</label>
                            <p class="text-danger">⚠️ No users available for assignment.</p>
                        </div>
                    }


                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save Task</button>
                </div>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />

    <!-- jQuery + DataTables JS -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.colVis.min.js"></script>

    <!-- ✅ Required for export buttons -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

    <script src="~/assets/libs/datatables.net-searchpanes/js/dataTables.searchPanes.min.js"></script>
    <script src="~/assets/libs/datatables.net-searchpanes-bs5/js/searchPanes.bootstrap5.min.js"></script>
    <script src="~/assets/libs/datatables.net-select/js/dataTables.select.min.js"></script>

    <script src="~/assets/libs/select2/js/select2.full.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#yardiTable').DataTable({
                order: [
                    [3, 'asc'], // 3 Mgmt Co
                    [1, 'asc']  // 1 Property
                ],
                dom: `
                  <"top mb-2"P>
                  <"top d-flex justify-content-between align-items-center mb-3" lBf>
                  rt
                  <"bottom d-flex justify-content-between align-items-center mt-3" ip>
                `,
                scrollX: true,
                searchPanes: {
                    cascadePanes: true,
                    viewTotal: true,
                    layout: 'columns-4',
                    initCollapsed: true,
                    innerHeight: 30
                },
                buttons: [
                    {
                        extend: 'colvis',
                        text: '<i class="bi bi-eye"></i> Show/Hide Columns',
                        className: 'btn btn-outline-primary rounded-pill shadow-sm me-2'
                    },
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bi bi-file-earmark-excel"></i> Excel',
                        className: 'btn btn-outline-success rounded-pill shadow-sm me-2'
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                        className: 'btn btn-outline-danger rounded-pill shadow-sm'
                    }
                ],
                columnDefs: [
                    { targets: [6, 8, 9, 10, 11, 12, 14], visible: false },
                    { searchPanes: { show: true }, targets: [0, 2, 4, 13] }, // Mgmt Co, City
                    { searchPanes: { show: false }, targets: '_all' }
                ]
            });

            table.on('searchPanes.statesLoaded', function () {
                updateFilterCount();
            });

            table.on('searchPanes.selectionChanged', function () {
                updateFilterCount();
            });

            function updateFilterCount() {
                const count = table.searchPanes.getSelections().reduce((total, pane) => total + pane.rows.length, 0);
                $('#filtersCount').text(count);
            }

            // ✅ Delegated binding for dynamic content
            $('#yardiTable tbody').on('click', '.create-task', function () {
                const propertyId = $(this).data('id');
                const name = $(this).data('name');
                const defaultTitle = `Follow up for ${name}`;               

                $('#taskModal input[name="Task.PropertyID"]').val(propertyId);
                $('#taskModal input[name="Task.Property"]').val(name);
                $('#taskModal input[name="Task.Title"]').val(defaultTitle);

                // Default due date to 24 hours from now
                const dueDate = new Date();
                dueDate.setHours(dueDate.getHours() + 24);
                $('#taskModal input[name="Task.DueDate"]').val(dueDate.toISOString().slice(0, 16));

                const assignedToField = $('#taskModal [name="Task.AssignedTo"]');
                if (!assignedToField.val()) {
                    const userId = '@ViewBag.UserId';
                    assignedToField.val(userId);
                }


                $('#taskModal').modal('show');
            });
        });

    </script>
    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["Success"]'
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'Task status updated',
                showConfirmButton: false,
                timer: 2000
            });
        </script>
    }

    @if (TempData["Warning"] != null)
    {
        <script>
            Swal.fire({
                icon: 'warning',
                title: 'Notice',
                text: '@TempData["Warning"]'
            });
        </script>
    }


}