{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "LAX": "Data Source=${DB_HOST};Initial Catalog=CompUFloorLA;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True",
    "LSV": "Data Source=${DB_HOST};Initial Catalog=CompUFloorLV;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True",
    "CHN": "Data Source=${DB_HOST};Initial Catalog=CompUFloorChino;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True",
    "SND": "Data Source=${DB_HOST};Initial Catalog=CompUFloorSD;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True",
    "PHX": "Data Source=${DB_HOST};Initial Catalog=CompUFloorPHX;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True",
    "SalesMetrics": "Data Source=${DB_HOST};Initial Catalog=SalesMetrics;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True",
    "SalesMetricsEF": "Server=${DB_HOST},1433;Database=SalesMetrics;User Id=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True;"
  },

  "ErpSettings": {
    "DefaultProvider": "CompUFloor",
    "WarehouseMappings": {
      "LAX": [ 1, 3 ],
      "LSV": [ 1, 2, 3, 6 ],
      "CHN": [ 1 ],
      "PHX": [ 1, 3 ],
      "SND": [ 1 ]
    },
    "Locations": {
      "LAX": {
        "LocationCode": "LAX",
        "Provider": "CompUFloor",
        "ConnectionString": "Data Source=${DB_HOST};Initial Catalog=CompUFloorLA;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True"
      },
      "LSV": {
        "LocationCode": "LSV",
        "Provider": "CompUFloor",
        "ConnectionString": "Data Source=${DB_HOST};Initial Catalog=CompUFloorLV;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True"
      },
      "CHN": {
        "LocationCode": "CHN",
        "Provider": "CompUFloor",
        "ConnectionString": "Data Source=${DB_HOST};Initial Catalog=CompUFloorChino;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True"
      },
      "PHX": {
        "LocationCode": "PHX",
        "Provider": "CompUFloor",
        "ConnectionString": "Data Source=${DB_HOST};Initial Catalog=CompUFloorPHX;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True"
      },
      "SND": {
        "LocationCode": "SND",
        "Provider": "CompUFloor",
        "ConnectionString": "Data Source=${DB_HOST};Initial Catalog=CompUFloorSD;User ID=${DB_USER};Password=${DB_PASSWORD};Encrypt=True;TrustServerCertificate=True"
      }
    }
  },

  "Authentication": {
    "Google": {
      "ClientId": "${GOOGLE_CLIENT_ID}",
      "ClientSecret": "${GOOGLE_CLIENT_SECRET}"
    }
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "${SMTP_USER}",
    "Pass": "${SMTP_PASS}",
    "FromEmail": "${SMTP_FROM_EMAIL}",
    "FromName": "SalesMetrics Envelopes",
    "EnableSsl": true
  },

  "App": {
    "BaseUrl": "https://localhost:7080"
  },

  "CompanyBranding": {
    "CompanyName": "Seamless Flooring, LLC",
    "LogoUrl": "https://seamlessflooring.com/wp-content/uploads/2023/08/Seamless-Flooring-LLC-3-1.png",
    "EnvelopeLogoUrl": "",
    "Website": "https://www.seamlessflooring.com",
    "Phone": "(877) 373-3858"
  },

  "Pdf": {
    "DebugMarkers": "false"
  }

}
